{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seenlang.dev/schemas/native-boundaries.schema.json",
  "title": "Seen native-boundary ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "inventory", "boundaries"],
  "properties": {
    "version": {"const": 1},
    "inventory": {"const": "native-inventory.json"},
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subsystem", "purpose", "abi", "platforms", "symbols", "production"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
          "subsystem": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 512},
          "abi": {"type": "string", "minLength": 1, "maxLength": 64},
          "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["linux-x86_64", "linux-aarch64", "macos", "windows"]}},
          "symbols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
          "production": {"type": "boolean"}
        }
      }
    }
  }
}
