{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seenlang.dev/schemas/compatibility-manifest.schema.json",
  "title": "Seen release compatibility manifest",
  "description": "Exact canonical input consumed by the Seen compiler and version-coupled package client; omitted or mismatched values are never inferred or repaired.",
  "$comment": "The components.compiler.package_interface_schema entry binds reusable source-package compatibility; seen-package-interface-v2 includes the independently versioned native seen-package-layout-v1 contract. The components.compiler.object_cache_abi identity seen-object-cache-abi-v3 binds seen-import-graph-v1 canonical module ordering, the seen-global-initialization-plan-v1 dependency-first constructor schedule, the seen-production-ir-policy-v1 unmodified optimizer handoff, the seen-production-source-policy-v1 unmodified compiler-input handoff, the seen-machine-diagnostic-v1 stable diagnostic envelope, seen-build-instrumentation-evidence-v1, seen-release-optimization-plan-v1, seen-test-discovery-v1, seen-test-run-v1, seen-test-assertion-v1, seen-test-snapshot-v1, seen-test-fixture-v1, seen-test-report-v1, seen-test-migration-v1, seen-error-v1, seen-typed-error-v1, seen-error-api-migration-v1, seen-error-policy-v1, seen-owned-resource-v1, seen-secret-marker-v1, seen-byte-slices-v1, seen-byte-storage-v1, seen-byte-streams-v1, seen-byte-adapters-v1, seen-byte-codecs-v1, seen-async-byte-streams-v1, seen-test-instrumentation-v1, seen-test-fuzz-corpus-v1, seen-benchmark-evidence-v1, seen-test-leak-soak-v1, seen-sync-v1, seen-structured-async-v1, seen-deterministic-context-v1, seen-program-build-input-v1, seen-object-cache-record-v1, seen-release-lto-cache-record-v1, seen-program-artifacts-v1, seen-program-reproducibility-v1, seen-bootstrap-reproducibility-v1, seen-release-artifact-manifest-v1, and seen-gate0-certification-v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["components", "determinism", "platforms", "release_version", "schema", "schema_version", "targets"],
  "properties": {
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler", "llvm", "package_client", "runtime", "standard_library"],
      "properties": {
        "compiler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["layout_abi", "object_cache_abi", "package_interface_schema", "package_object_manifest_schema", "prebuilt_package_schema", "version"],
          "properties": {
            "layout_abi": {"$ref": "#/$defs/identity"},
            "object_cache_abi": {
              "description": "Compiler compatibility identity binding seen-import-graph-v1 canonical module ordering, the seen-global-initialization-plan-v1 dependency-first constructor schedule, the seen-production-ir-policy-v1 unmodified optimizer handoff, the seen-production-source-policy-v1 unmodified compiler-input handoff, seen-machine-diagnostic-v1, and seen-build-instrumentation-evidence-v1.",
              "const": "seen-object-cache-abi-v3"
            },
            "package_interface_schema": {
              "description": "Compatibility entry binding package interfaces and the native seen-package-layout-v1 reusable-source tree contract.",
              "const": "seen-package-interface-v2"
            },
            "package_object_manifest_schema": {"$ref": "#/$defs/identity"},
            "prebuilt_package_schema": {"$ref": "#/$defs/identity"},
            "version": {"$ref": "#/$defs/semver"}
          }
        },
        "llvm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum_major"],
          "properties": {"minimum_major": {"type": "integer", "minimum": 18, "maximum": 255}}
        },
        "package_client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol", "version"],
          "properties": {
            "protocol": {"$ref": "#/$defs/identity"},
            "version": {"$ref": "#/$defs/semver"}
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["abi"],
          "properties": {"abi": {"$ref": "#/$defs/identity"}}
        },
        "standard_library": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module_manifest_version", "version"],
          "properties": {
            "module_manifest_version": {"type": "integer", "minimum": 1, "maximum": 255},
            "version": {"$ref": "#/$defs/semver"}
          }
        }
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certification", "context_schema", "object_cache_record_schema", "program_artifacts_schema", "program_build_input_schema", "program_reproducibility_schema", "release_lto_cache_record_schema", "required_provenance"],
      "properties": {
        "certification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_comparison", "builder_count", "complete_corpus_required", "distinct_builder_identities", "distinct_root_identities", "installed_archive_required", "signed_evidence_required"],
          "properties": {
            "artifact_comparison": {"const": "raw-bytes"},
            "builder_count": {"const": 2},
            "complete_corpus_required": {"const": true},
            "distinct_builder_identities": {"const": true},
            "distinct_root_identities": {"const": true},
            "installed_archive_required": {"const": true},
            "signed_evidence_required": {"const": true}
          }
        },
        "context_schema": {"const": "seen-deterministic-context-v1"},
        "object_cache_record_schema": {"const": "seen-object-cache-record-v1"},
        "program_artifacts_schema": {"const": "seen-program-artifacts-v1"},
        "program_build_input_schema": {"const": "seen-program-build-input-v1"},
        "program_reproducibility_schema": {"const": "seen-program-reproducibility-v1"},
        "release_lto_cache_record_schema": {"const": "seen-release-lto-cache-record-v1"},
        "required_provenance": {
          "const": ["artifact-hash", "artifact-size", "build-input-digest", "builder-identity", "cancellation-state", "command", "compiler-identity", "containment-readback", "epoch", "lock-digest", "mode", "root-identity", "source-digest", "target-identity", "toolchain-identity"]
        }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linux-arm64", "linux-x86_64", "macos", "windows"],
      "properties": {
        "linux-arm64": {"const": "declared-toolchain-dependent"},
        "linux-x86_64": {"const": "required"},
        "macos": {"const": "declared-toolchain-dependent"},
        "windows": {"const": "declared-toolchain-dependent"}
      }
    },
    "release_version": {"$ref": "#/$defs/semver"},
    "schema": {"const": "seen-compatibility-manifest-v1"},
    "schema_version": {"const": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "support", "triple"],
        "properties": {
          "name": {"enum": ["android-arm64", "ios-arm64", "ios-sim-arm64", "linux-arm64", "linux-riscv64", "linux-x86_64", "macos-arm64", "macos-x86_64", "windows-x86_64"]},
          "support": {"enum": ["required", "declared-toolchain-dependent"]},
          "triple": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._+-]+$"}
        }
      }
    }
  },
  "$defs": {
    "identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._+-]+$"},
    "semver": {"type": "string", "minLength": 5, "maxLength": 64, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"}
  }
}
