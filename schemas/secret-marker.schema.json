{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seenlang.dev/schemas/secret-marker.schema.json",
  "title": "Seen redaction-safe secret marker contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["fields", "max_secret_bytes", "schema"],
  "properties": {
    "schema": {"const": "seen-secret-marker-v1"},
    "max_secret_bytes": {"type": "integer", "minimum": 1, "maximum": 4096},
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "value"],
        "properties": {
          "kind": {"enum": ["public", "secret"]},
          "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9._-]+$"},
          "value": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    }
  }
}
