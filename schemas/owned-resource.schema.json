{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seenlang.dev/schemas/owned-resource.schema.json",
  "title": "Seen move-only owned-resource trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["max_resources", "operations", "schema"],
  "properties": {
    "max_resources": {"type": "integer", "minimum": 1, "maximum": 4096},
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 16384,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "owner", "resource", "target"],
        "properties": {
          "kind": {"enum": ["acquire", "move", "use", "release"]},
          "owner": {"$ref": "#/$defs/identity"},
          "resource": {"$ref": "#/$defs/identity"},
          "target": {"anyOf": [{"const": ""}, {"$ref": "#/$defs/identity"}]}
        }
      }
    },
    "schema": {"const": "seen-owned-resource-v1"}
  },
  "$defs": {
    "identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9._-]+$"}
  }
}
