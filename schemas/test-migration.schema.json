{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seenlang.dev/schemas/test-migration.schema.json",
  "title": "Seen compiler, standard-library, and external-package test migration",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries", "schema", "total_tests"],
  "properties": {
    "schema": {"const": "seen-test-migration-v1"},
    "total_tests": {"type": "integer", "minimum": 3, "maximum": 100000},
    "entries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "manifest_path", "package_root", "platform", "source", "test_count", "tests_root"],
        "properties": {
          "category": {"enum": ["unit", "integration"]},
          "manifest_path": {"type": "string", "maxLength": 4096},
          "package_root": {"type": "string", "maxLength": 4096},
          "platform": {"const": "all"},
          "source": {"enum": ["compiler", "stdlib", "external-package"]},
          "test_count": {"type": "integer", "minimum": 1, "maximum": 100000},
          "tests_root": {"type": "string", "maxLength": 4096}
        }
      }
    }
  }
}
