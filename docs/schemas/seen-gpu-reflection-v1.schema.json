{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seen GPU reflection v1",
  "description": "Software IR reflection only. Enforce the 4 MiB UTF-8 ceiling and verify linked IR, layout constraints, domain ranges and hashes independently. A selected backend does not establish device execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "module",
    "ir_schema",
    "ir_sha256",
    "backend",
    "target",
    "fallback",
    "hardware_verified",
    "gpu_execution_verified",
    "specializations",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "seen-gpu-reflection-v1"
    },
    "module": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "ir_schema": {
      "const": "seen-gpu-ir-v1"
    },
    "ir_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "backend": {
      "enum": [
        "none",
        "spirv",
        "cuda",
        "hip",
        "metal"
      ]
    },
    "target": {
      "type": "string",
      "maxLength": 128
    },
    "fallback": {
      "enum": [
        "error",
        "cpu"
      ]
    },
    "hardware_verified": {
      "const": false
    },
    "gpu_execution_verified": {
      "const": false
    },
    "specializations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/specialization"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "binding",
        "kind",
        "access",
        "type",
        "value_type",
        "scalar_type",
        "lanes",
        "element_stride",
        "minimum_binding_bytes"
      ],
      "properties": {
        "group": {
          "const": 0
        },
        "binding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "kind": {
          "enum": [
            "storage",
            "uniform"
          ]
        },
        "access": {
          "enum": [
            "read",
            "write",
            "read_write"
          ]
        },
        "type": {
          "type": "integer",
          "minimum": 1001,
          "maximum": 4052
        },
        "value_type": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52
        },
        "scalar_type": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "lanes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "element_stride": {
          "enum": [
            4,
            8,
            16
          ]
        },
        "minimum_binding_bytes": {
          "enum": [
            0,
            16
          ]
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "function",
        "abi_sha256",
        "workgroup",
        "bindings",
        "required_capabilities",
        "shared_bytes",
        "requires_fault_buffer",
        "fault_binding"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "function": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "abi_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "workgroup": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          }
        },
        "bindings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "required_capabilities": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108863
        },
        "shared_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "requires_fault_buffer": {
          "type": "boolean"
        },
        "fault_binding": {
          "type": "integer",
          "minimum": -1,
          "maximum": 64
        }
      }
    },
    "specialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "default",
        "minimum",
        "maximum",
        "function"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "type": {
          "enum": [
            2,
            3
          ]
        },
        "default": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 4294967295
        },
        "minimum": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 4294967295
        },
        "maximum": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 4294967295
        },
        "function": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  }
}
