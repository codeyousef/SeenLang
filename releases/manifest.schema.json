{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seenlang.dev/releases/manifest.schema.json",
  "title": "Seen release evidence manifests",
  "oneOf": [
    {"$ref": "#/$defs/bootstrap_manifest"},
    {"$ref": "#/$defs/release_artifact_manifest"}
  ],
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[ -~]+$"},
    "safe_name": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9._+][A-Za-z0-9._+-]*$"},
    "semver": {"type": "string", "minLength": 5, "maxLength": 64, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
    "builder_base": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_bytes", "build_root_digest", "builder_sha256", "id", "normalized_artifact_sha256", "raw_artifact_sha256", "toolchain"],
      "properties": {
        "artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "build_root_digest": {"$ref": "#/$defs/digest"},
        "builder_sha256": {"$ref": "#/$defs/digest"},
        "id": {"type": "string"},
        "normalized_artifact_sha256": {"$ref": "#/$defs/digest"},
        "raw_artifact_sha256": {"$ref": "#/$defs/digest"},
        "toolchain": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[ -~]+$"}
      }
    },
    "builder_a": {"allOf": [{"$ref": "#/$defs/builder_base"}, {"properties": {"id": {"const": "builder-a"}}}]},
    "builder_b": {"allOf": [{"$ref": "#/$defs/builder_base"}, {"properties": {"id": {"const": "builder-b"}}}]},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["jobs", "memory_max_bytes", "memory_swap_max_bytes", "opt_jobs", "pids_max"],
      "properties": {
        "jobs": {"const": 1}, "memory_max_bytes": {"type": "integer", "minimum": 1},
        "memory_swap_max_bytes": {"const": 0}, "opt_jobs": {"const": 1},
        "pids_max": {"type": "integer", "minimum": 1, "maximum": 24}
      }
    },
    "bootstrap_manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["builders", "command", "limits", "normalization", "schema", "source_commit", "source_date_epoch", "source_digest", "target"],
      "properties": {
        "builders": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/builder_a"}, {"$ref": "#/$defs/builder_b"}], "items": false},
        "command": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[ -~]+$"},
        "limits": {"$ref": "#/$defs/limits"},
        "normalization": {"enum": ["none", "elf64-x86_64-v1"]},
        "schema": {"const": "seen-bootstrap-reproducibility-v1"},
        "source_commit": {"$ref": "#/$defs/commit"},
        "source_date_epoch": {"type": "integer", "minimum": 0},
        "source_digest": {"$ref": "#/$defs/digest"},
        "target": {"const": "linux-x86_64"}
      }
    },
    "release_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle", "bundle_sha256", "bytes", "checksum", "name", "role", "sha256"],
      "properties": {
        "bundle": {"$ref": "#/$defs/safe_name"},
        "bundle_sha256": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648},
        "checksum": {"$ref": "#/$defs/safe_name"},
        "name": {"$ref": "#/$defs/safe_name"},
        "role": {"enum": ["compiler", "runtime", "stdlib", "package-client"]},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "release_artifact_manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["artifacts", "schema", "signer", "source_commit", "source_digest", "target", "version"],
      "properties": {
        "artifacts": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/release_artifact"}, {"properties": {"role": {"const": "compiler"}}}]},
            {"allOf": [{"$ref": "#/$defs/release_artifact"}, {"properties": {"role": {"const": "runtime"}}}]},
            {"allOf": [{"$ref": "#/$defs/release_artifact"}, {"properties": {"role": {"const": "stdlib"}}}]},
            {"allOf": [{"$ref": "#/$defs/release_artifact"}, {"properties": {"role": {"const": "package-client"}}}]}
          ],
          "items": false
        },
        "schema": {"const": "seen-release-artifact-manifest-v1"},
        "signer": {
          "type": "object", "additionalProperties": false,
          "required": ["identity", "issuer", "mode"],
          "properties": {"identity": {"$ref": "#/$defs/identity"}, "issuer": {"$ref": "#/$defs/identity"}, "mode": {"enum": ["keyless", "key", "kms"]}}
        },
        "source_commit": {"$ref": "#/$defs/commit"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "target": {"const": "linux-x86_64"},
        "version": {"$ref": "#/$defs/semver"}
      }
    }
  }
}
