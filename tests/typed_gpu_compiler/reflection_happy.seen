@device fun reflected_increment(value: Int32) r: Int32 { return value + 1 }
@compute(64) fun first(input: ReadBuffer<Int32>, output: WriteBuffer<Int32>) { output[0] = reflected_increment(input[0]) }
@compute(32) fun second(output: WriteBuffer<Float32>) { output[0] = 1.0 }
fun main() r: Int { return 0 }
