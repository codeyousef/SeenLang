import bootstrap.frontend.{runFrontendCompat}
import codegen.gpu_lower_program.{lowerGpuProgram}
import codegen.gpu_ir_model.{GpuIrModule}
import codegen.gpu_ir_serialize.{serializeGpuIr}
import ir_fixture_support.{irRequire}

fun irLowerSource(source: String) r: GpuIrModule {
    let frontend = runFrontendCompat(source, "source-ir.seen", "en"); irRequire(frontend.success)
    let result = lowerGpuProgram(frontend.program, "source-ir.seen"); irRequire(result.isOkay())
    let module = result.unwrap(); result.releaseContainer(); return module
}
fun irLowerReject(source: String, code: String) r: Void {
    let frontend = runFrontendCompat(source, "source-ir.seen", "en")
    let result = lowerGpuProgram(frontend.program, "source-ir.seen"); irRequire(result.isErr())
    let validation = result.unwrapErr(); result.releaseContainer(); var found = false; var i = 0
    while i < validation.diagnostics.length() {
        if validation.diagnostics[i].code == code { found = true }; i = i + 1
    }
    irRequire(found); validation.release()
}
fun irCountOpcode(borrow module: GpuIrModule, opcode: Int) r: Int {
    var count = 0; var functionIndex = 0
    while functionIndex < module.functions.length() {
        let function = module.functions[functionIndex]; var blockIndex = 0
        while blockIndex < function.blocks.length() {
            let block = function.blocks[blockIndex]; var i = 0
            while i < block.instructions.length() { if block.instructions[i].opcode == opcode { count = count + 1 }; i = i + 1 }
            blockIndex = blockIndex + 1
        }
        functionIndex = functionIndex + 1
    }
    return count
}
fun irSerialized(borrow module: GpuIrModule) r: String {
    let result = serializeGpuIr(module); irRequire(result.isOkay())
    let text = result.unwrap(); result.releaseContainer(); return text
}
