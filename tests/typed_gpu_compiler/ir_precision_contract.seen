import ir_fixture_support.{irRequire, irExpect}
import ir_lowering_support.{irLowerSource, irLowerReject, irCountOpcode}
import ir_precision_support.{precisionTarget, precisionExpectTarget, precisionExpectOverride, precisionCooperativeSource}
import codegen.gpu_precision_formats.{gpuPrecisionBits, gpuPrecisionWordLanes, gpuPrecisionBlockElements, gpuPrecisionBlockBytes, gpuPrecisionValueType}
import codegen.gpu_matrix_types.{gpuMatrixType, gpuMatrixTypeValid, gpuMatrixRows, gpuMatrixColumns}
import codegen.gpu_ir_ops.{GPU_IR_UNPACK, GPU_IR_PACK, GPU_IR_SPECIALIZE, GPU_IR_COOP_LOAD, GPU_IR_COOP_MMA, GPU_IR_COOP_STORE}
import codegen.gpu_specialization.{collectGpuSpecializations, releaseGpuSpecializations}
import ir_scalar_state.{IrScalarState}
import ir_scalar_machine.{runIrScalarWitness}
extern "C" fun seen_memory_used_bytes() r: Int64

fun precisionFormatContract() r: Void {
    let widths = [32, 16, 16, 8, 8, 4, 4, 2, 2, 8, 4, 32, 32]
    let types = [4, 4, 4, 2, 3, 2, 3, 2, 3, 4, 4, 2, 3]; var i = 0
    while i < 13 {
        irRequire(gpuPrecisionBits(i + 1) == widths[i] and gpuPrecisionWordLanes(i + 1) == 32 / widths[i])
        irRequire(gpuPrecisionValueType(i + 1) == types[i]); i = i + 1
    }
    widths.free(); types.free()
    irRequire(gpuPrecisionBits(0) == 0 and gpuPrecisionWordLanes(14) == 0)
    irRequire(gpuPrecisionBlockElements(11) == 32 and gpuPrecisionBlockBytes(11) == 17)
    let matrix = gpuMatrixType(1, 2, 0)
    irRequire(gpuMatrixTypeValid(matrix) and gpuMatrixRows(matrix) == 16 and gpuMatrixColumns(matrix) == 16)
    irRequire(gpuMatrixType(0, 2, 2) == 0 and not gpuMatrixTypeValid(9999))
    println("PASS: GPU-001C closed packed precision and matrix descriptors")
}
fun precisionIntegerContract() r: Void {
    let module = irLowerSource("@compute(1) fun packed(input: ReadBuffer<UInt32>, signed: WriteBuffer<Int32>, words: WriteBuffer<UInt32>) { let word = input[0]; signed[0] = unpackInt8(word, 0 as UInt32); signed[1] = unpackInt4(word, 7 as UInt32); signed[2] = unpackInt2(word, 15 as UInt32); words[0] = unpackUInt8(word, 3 as UInt32); words[1] = insertInt4(word, 0 as UInt32, 1); words[2] = insertInt2(word, 15 as UInt32, 1); words[3] = insertInt8(word, 1 as UInt32, -2); words[4] = unpackUInt2(word, 16 as UInt32); words[5] = insertUInt2(word, 16 as UInt32, 0 as UInt32) }")
    irRequire(irCountOpcode(module, GPU_IR_UNPACK) == 5 and irCountOpcode(module, GPU_IR_PACK) == 4)
    let baseline = seen_memory_used_bytes(); var iteration = 0
    while iteration < 100 {
        let state = IrScalarState.create(); let input = [2309737967]; let signed = [0, 0, 0]; let words = [0, 0, 0, 0, 0, 0]
        irRequire(state.addBuffer(input) == 0 and state.addBuffer(signed) == 1 and state.addBuffer(words) == 2)
        let arguments = [0, 1, 2]; irRequire(runIrScalarWitness(module, state, 0, arguments)); arguments.free()
        irRequire(signed[0] == -17 and signed[1] == -8 and signed[2] == -2)
        irRequire(words[0] == 137 and words[1] == 2309737953 and words[2] == 1235996143 and words[3] == 2309750511)
        irRequire(words[4] == 0 and words[5] == 2309737967 and state.faults == 2)
        state.release(); irRequire(seen_memory_used_bytes() == baseline); iteration = iteration + 1
    }
    module.release()
    println("PASS: GPU-001C packed integer golden words neighboring bits faults and cleanup")
}
fun precisionFloatingContract() r: Void {
    let module = irLowerSource("@compute(64) fun words(input: ReadBuffer<UInt32>, output: WriteBuffer<Float32>, packed: WriteBuffer<UInt32>) { let word = input[0]; output[0] = unpackFp32(word, 0 as UInt32); output[1] = unpackFp16(word, 1 as UInt32); output[2] = unpackBf16(word, 0 as UInt32); output[3] = unpackFp8E4M3FN(word, 3 as UInt32); output[4] = unpackMxfp4(word, 7 as UInt32, 127 as UInt32); packed[0] = insertFp16(word, 0 as UInt32, 1.0); packed[1] = insertBf16(word, 1 as UInt32, 2.0); packed[2] = insertFp8E4M3FN(word, 2 as UInt32, 3.0); packed[3] = insertMxfp4(word, 3 as UInt32, 4.0, 127 as UInt32) }")
    irRequire(irCountOpcode(module, GPU_IR_UNPACK) == 5 and irCountOpcode(module, GPU_IR_PACK) == 4)
    irExpect(module, ""); module.release()
    irLowerReject("@compute(1) fun invalid() { let x = unpackFp16(0, 0 as UInt32) }", "E_GPU_IR_TYPE")
    irLowerReject("@compute(1) fun invalid() { let x = unpackMxfp4(0 as UInt32, 0 as UInt32) }", "E_GPU_PRECISION")
    println("PASS: GPU-001C explicit floating word conversions and MXFP4 scales")
}
fun precisionSpecializationContract() r: Void {
    let module = irLowerSource("@compute(1) fun specialized(output: WriteBuffer<UInt32>) { output[0] = specializeUInt32(7, 32 as UInt32, 1 as UInt32, 1024 as UInt32) }")
    irRequire(irCountOpcode(module, GPU_IR_SPECIALIZE) == 1)
    let collected = collectGpuSpecializations(module); irRequire(collected.isOkay())
    let records = collected.unwrap(); collected.releaseContainer()
    irRequire(records.length() == 1 and records[0].id == 7 and records[0].typeCode == 3 and records[0].minimum == 1 and records[0].maximum == 1024)
    releaseGpuSpecializations(records); let baseline = seen_memory_used_bytes(); var iteration = 0
    while iteration < 100 {
        precisionExpectOverride(module, Array<Int>(), Array<Int>(), true, 32)
        precisionExpectOverride(module, [7], [1024], true, 1024)
        precisionExpectOverride(module, [7], [0], false, 0)
        precisionExpectOverride(module, [8], [32], false, 0)
        precisionExpectOverride(module, [7, 7], [32, 64], false, 0)
        precisionExpectOverride(module, [7], Array<Int>(), false, 0)
        irRequire(seen_memory_used_bytes() == baseline); iteration = iteration + 1
    }
    module.release()
    irLowerReject("@compute(1) fun invalid() { let x = specializeInt32(7, 0, 1, 8) }", "E_GPU_IR_TYPE")
    irLowerReject("@compute(1) fun invalid() { let x = specializeInt32(7, 1, 0, 8); let y = specializeInt32(7, 2, 0, 8) }", "E_GPU_SPECIALIZATION")
    println("PASS: GPU-001C bounded specialization domains explicit overrides and cleanup")
}
fun precisionCooperativeContract() r: Void {
    let module = irLowerSource(precisionCooperativeSource()); irExpect(module, "")
    irRequire(irCountOpcode(module, GPU_IR_COOP_LOAD) == 2 and irCountOpcode(module, GPU_IR_COOP_MMA) == 1 and irCountOpcode(module, GPU_IR_COOP_STORE) == 1)
    let target = precisionTarget(module); irRequire(target.addMatrix(0, 2)); precisionExpectTarget(module, target, "")
    target.maxWorkgroupInvocations = 32; precisionExpectTarget(module, target, "E_GPU_CAPABILITY"); target.maxWorkgroupInvocations = 1024
    target.subgroupSize = 3; precisionExpectTarget(module, target, "E_GPU_CAPABILITY_PROFILE"); target.subgroupSize = 32
    let features = target.features; target.features = 0 as UInt64; precisionExpectTarget(module, target, "E_GPU_CAPABILITY_PROFILE"); target.features = features
    target.matrixKeys[0] = gpuMatrixType(1, 2, 0); precisionExpectTarget(module, target, "E_GPU_CAPABILITY")
    target.matrixKeys[0] = gpuMatrixType(0, 2, 0); precisionExpectTarget(module, target, "")
    target.release(); module.release()
    irLowerReject("@compute(64) fun invalid(input: ReadBuffer<UInt32>) { let a = coopLoadA(input, globalInvocationId.x, 16 as UInt32, FP16, Tile16x16x16, RowMajor) }", "E_GPU_IR_CONVERGENCE")
    irLowerReject("@compute(64) fun invalid(input: ReadBuffer<UInt32>) { let a = coopLoadA(input, 0 as UInt32, 16 as UInt32, MXFP4_E2M1_UE8M0, Tile16x16x16, RowMajor) }", "E_GPU_COOPERATIVE")
    irLowerReject("@compute(64) fun invalid() { var c = coopFillFp32(0.0, Tile16x16x16) }", "E_GPU_TYPE")
    println("PASS: GPU-001C cooperative shape precision convergence and target admission")
}
fun main() r: Int {
    precisionFormatContract(); precisionIntegerContract(); precisionFloatingContract(); precisionSpecializationContract(); precisionCooperativeContract()
    println("{\"schema\":\"seen-gpu-precision-contract-v1\",\"scope\":\"software-ir-and-integer-model\",\"hardware_verified\":false,\"gpu_execution_verified\":false}")
    return 0
}
