///
SIMD Codegen Verification Test Program
A math-heavy program with loops that should be vectorizable
Used by test_simd_integration_linux_x86_64.sh to verify scalar/SIMD parity
///

fun dotProduct(n: Int) r: Float {
    var a = Array<Float>()
    var b = Array<Float>()
    var i = 0
    while i < n {
        let fi: Float = i.toFloat()
        a.push(fi * 1.5)
        b.push(fi * 0.5)
        i = i + 1
    }

    var sum: Float = 0.0
    i = 0
    while i < n {
        sum = sum + a[i] * b[i]
        i = i + 1
    }
    a.free()
    b.free()
    return sum
}

fun arraySum(n: Int) r: Float {
    var arr = Array<Float>()
    var i = 0
    while i < n {
        let fi: Float = i.toFloat()
        arr.push(fi * 2.0 + 1.0)
        i = i + 1
    }

    var total: Float = 0.0
    i = 0
    while i < n {
        total = total + arr[i]
        i = i + 1
    }
    arr.free()
    return total
}

fun main() r: Int {
    let n = 1000
    let dot = dotProduct(n)
    let sum = arraySum(n)

    // These binary-exact inputs have exact representable Float64 totals.
    let dotInt: Int = dot.toInt()
    let sumInt: Int = sum.toInt()
    println("dot_product(1000) ~ " + dotInt.toString())
    println("array_sum(1000) ~ " + sumInt.toString())

    if dotInt == 249625125 {
        println("PASS: dot product exact")
    } else {
        println("FAIL: dot product differs from exact total")
        return 1
    }
    if sumInt == 1000000 {
        println("PASS: array sum exact")
    } else {
        println("FAIL: array sum differs from exact total")
        return 1
    }
    return 0
}

main()
