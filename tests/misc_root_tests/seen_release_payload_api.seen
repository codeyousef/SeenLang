import crypto.sha256.{sha256}
import json.strict.{StrictJsonLimits, parseStrictJson}
import json.parser.{destroyJsonParseResult}
import accelerator.cuda.mod.{CudaAlgorithm, CudaStreamLaunchToken}
import accelerator.cuda.error.{CudaNativeStatus}
import inference.scalars.{BFloat16}
import core.result.{Result, Ok}

@repr(C)
@trivially_copyable
class InstalledPointerView {
    var data: *const UInt8
    var byteLength: UInt64
}

fun installedPointerView(address: *const UInt8) r: InstalledPointerView {
    return InstalledPointerView{
        data: address,
        byteLength: 32 as UInt64
    }
}

fun installedBFloat16Bits(value: BFloat16) r: Int {
    return value.bits as Int
}

fun installedBFloat16Result() r: Result<BFloat16, Int> {
    return Ok<BFloat16, Int>(BFloat16{ bits: 23 as UInt16 })
}

class InstalledAggregateOwner {
    var bits: BFloat16
    var algorithm: CudaAlgorithm

    fun reset(value: UInt16) {
        this.bits = BFloat16{ bits: value }
        this.algorithm = CudaAlgorithm{
            algorithmId: 7 as Int32,
            tileId: 11 as Int32,
            splitK: 13 as Int32,
            reductionScheme: 17 as Int32,
            workspaceBytes: 19 as UInt64,
            cacheIdentity: 23 as UInt64
        }
    }
}

fun require(condition: Bool, message: String) r: Void {
    if not condition { abort(message) }
}

fun main() r: Int {
    let digest = sha256("abc")
    require(digest.isOkay() and digest.unwrap() ==
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
        "installed SHA-256 module")
    let parsed = parseStrictJson("{\"installed\":true}",
        StrictJsonLimits.manifests())
    require(parsed.isOkay() and
        parsed.unwrap().value.unwrap().valueAt(0).unwrap().getBool(),
        "installed strict JSON module")
    destroyJsonParseResult(parsed.unwrap(), true)
    let token = CudaStreamLaunchToken{
        abiVersion: 1 as UInt32,
        flags: 0 as UInt32,
        deviceOrdinal: 0 as Int32,
        reserved: 0 as UInt32,
        nativeStream: 0 as UInt64,
        generation: 1 as UInt64
    }
    let status = CudaNativeStatus{
        code: 0 as Int32,
        nativeCode: 0 as Int32,
        deviceOrdinal: 0 as Int32,
        maturity: 0 as Int32,
        operation: null as *const Char,
        message: null as *const Char
    }
    require(token.abiVersion == (1 as UInt32) and
        token.nativeStream == (0 as UInt64) and
        status.code == (0 as Int32),
        "installed CUDA standard-library surface")
    let pointerView = installedPointerView(null as *const UInt8)
    require((pointerView.data as Int) + 9 == 9,
        "installed repr(C) pointer-field integer cast")
    require(installedBFloat16Bits(BFloat16{ bits: 17 as UInt16 }) == 17,
        "installed repr(C) aggregate literal call argument")
    let bitsResult = installedBFloat16Result()
    require(bitsResult.isOkay() and
        bitsResult.unwrap().bits == (23 as UInt16),
        "installed repr(C) aggregate Result literal")
    let aggregateOwner = InstalledAggregateOwner{
        bits: BFloat16{ bits: 31 as UInt16 },
        algorithm: CudaAlgorithm{
            algorithmId: 1 as Int32,
            tileId: 2 as Int32,
            splitK: 3 as Int32,
            reductionScheme: 4 as Int32,
            workspaceBytes: 5 as UInt64,
            cacheIdentity: 6 as UInt64
        }
    }
    aggregateOwner.reset(37 as UInt16)
    require(aggregateOwner.bits.bits == (37 as UInt16),
        "installed repr(C) aggregate class-field assignment")
    require(aggregateOwner.algorithm.algorithmId == (7 as Int32) and
        aggregateOwner.algorithm.cacheIdentity == (23 as UInt64),
        "installed CUDA aggregate class-field assignment")
    println("PASS: installed release standard-library payload")
    return 0
}

main()
