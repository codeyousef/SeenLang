    print(","); natural(cpu14)
    print(","); natural(cpu15)
    print(","); natural(cpu16)
    print(","); natural(cpu17)
    print(","); natural(cpu18)
    print(","); natural(cpu19)
    print(","); natural(cpu20)
    print(","); natural(cpu21)
    print(","); natural(cpu22)
    print(","); natural(cpu23)
    print(","); natural(cpu24)
    print(","); natural(cpu25)
    print(","); natural(cpu26)
    print(","); natural(cpu27)
    print(","); natural(cpu28)
    print(","); natural(cpu29)
    print("],\"soak_count\":1024,\"successful_hot_cycles\":"); natural(cycles as Int64)
    print(",\"native_query_count\":"); natural(queries as Int64)
    print(",\"transfer\":{\"cold_upload_bytes\":"); natural(uploaded as Int64)
    print(",\"final_readback_bytes\":"); natural(downloaded as Int64)
    print(",\"hot_upload_bytes\":0,\"hot_readback_bytes\":0,\"uniform_argument_bytes_per_launch\":16}")
    print(",\"fallback_count\":0,\"cpu_fallback_count\":0,\"fallback_attempt_count\":0,\"fallback_policy\":\"error\"")
    print(",\"resources_drained\":true,\"allocations_drained\":true,\"atomics_drained\":true,\"physical_vram_bytes\":null,\"physical_vram_status\":\"unmeasured\"")
    print(",\"device_allocation_bytes\":300,\"host_arena_bytes\":2048,\"native_status\":0,\"checked_fault\":0,\"validated_elements\":37")
    print(",\"self_peak_rss_kib\":"); natural(rssKiB)
    print(",\"rss_scope\":\"native-process-rusage-self\"")
    print(",\"timing\":{\"gpu_source\":\"cuda-event-milliseconds-f32\",\"gpu_resolution_nanoseconds\":500,\"gpu_conversion\":\"truncate-ms-times-1000000\",\"cpu_source\":\"monotonic-clock-reference-loop\"}")
    println(",\"classification\":\"experimental-hardware\"}")
    if seen_memory_used_bytes() != baseline or seen_sync_live_atomics() != atomics { return 1 }
    return 0
}
