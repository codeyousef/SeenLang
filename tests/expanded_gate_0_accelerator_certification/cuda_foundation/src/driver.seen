/// Linux LP64 CUDA Driver API; checked against cuda.h by sdk_abi_oracle.c.
/// No toolkit runtime wrapper, generated host launcher, or CPU fallback exists.
import memory.aligned_buffer.{seen_try_aligned_realloc, seen_aligned_buffer_free}
import reflection.{parameterOffset, parameterBytes}
extern "C" fun cuInit(flags: UInt32) r: Int32
extern "C" fun cuDriverGetVersion(version: *Int32) r: Int32
extern "C" fun cuDeviceGetCount(count: *Int32) r: Int32
extern "C" fun cuDeviceGet(device: *Int32, ordinal: Int32) r: Int32
extern "C" fun cuDeviceGetName(name: *UInt8, length: Int32, device: Int32) r: Int32
extern "C" fun cuDeviceGetUuid_v2(uuid: *UInt8, device: Int32) r: Int32
extern "C" fun cuDeviceGetAttribute(value: *Int32, attribute: Int32, device: Int32) r: Int32
extern "C" fun cuCtxCreate_v2(context: **Void, flags: UInt32, device: Int32) r: Int32
extern "C" fun cuCtxDestroy_v2(context: *Void) r: Int32
extern "C" fun cuModuleLoad(module: **Void, filename: *const UInt8) r: Int32
extern "C" fun cuModuleUnload(module: *Void) r: Int32
extern "C" fun cuModuleGetFunction(function: **Void, module: *Void, name: *const UInt8) r: Int32
extern "C" fun cuFuncGetParamInfo(function: *Void, index: UInt64, offset: *UInt64, bytes: *UInt64) r: Int32
extern "C" fun cuMemAlloc_v2(address: *UInt64, bytes: UInt64) r: Int32
extern "C" fun cuMemFree_v2(address: UInt64) r: Int32
extern "C" fun cuMemcpyHtoD_v2(destination: UInt64, source: *const Void, bytes: UInt64) r: Int32
extern "C" fun cuMemcpyDtoH_v2(destination: *Void, source: UInt64, bytes: UInt64) r: Int32
extern "C" fun cuStreamCreate(stream: **Void, flags: UInt32) r: Int32
extern "C" fun cuStreamQuery(stream: *Void) r: Int32
extern "C" fun cuStreamDestroy_v2(stream: *Void) r: Int32
extern "C" fun cuEventCreate(event: **Void, flags: UInt32) r: Int32
extern "C" fun cuEventRecord(event: *Void, stream: *Void) r: Int32
extern "C" fun cuEventQuery(event: *Void) r: Int32
extern "C" fun cuEventElapsedTime(milliseconds: *Float32, start: *Void, stop: *Void) r: Int32
extern "C" fun cuEventDestroy_v2(event: *Void) r: Int32
extern "C" fun cuLaunchKernel(function: *Void, gx: UInt32, gy: UInt32, gz: UInt32,
    bx: UInt32, by: UInt32, bz: UInt32, shared: UInt32, stream: *Void, parameters: **Void, extra: **Void) r: Int32
extern "C" fun seen_time_monotonic_nanos() r: Int64
extern "C" fun seen_string_view_bytes(data: *const UInt8, length: Int64) r: String

fun nativeOkay(status: Int32, operation: String) r: Bool {
    if status == (0 as Int32) { return true }
    println(operation); println(status); return false
}
class FoundationDriver {
    var context: *Void
    var module: *Void
    var function: *Void
    var stream: *Void
    var start: *Void
    var stop: *Void
    var input: UInt64
    var output: UInt64
    var fault: UInt64
    var inputCount: UInt32
    var outputCount: UInt32
    var host: *UInt8
    var version: Int32
    var major: Int32
    var minor: Int32
    var selected: Int32
    var pending: Bool
    var recorded: Bool
    var cycles: Int
    var queries: Int
    var uploaded: Int
    var downloaded: Int
    var milliseconds: Float32

    static fun prepare() r: FoundationDriver {
        return FoundationDriver{context: null as *Void, module: null as *Void, function: null as *Void,
            stream: null as *Void, start: null as *Void, stop: null as *Void,
            input: 0 as UInt64, output: 0 as UInt64, fault: 0 as UInt64,
            inputCount: 37 as UInt32, outputCount: 37 as UInt32, host: null as *UInt8,
            version: 0 as Int32, major: 0 as Int32, minor: 0 as Int32, selected: -1 as Int32,
            pending: false, recorded: false, cycles: 0, queries: 0, uploaded: 0, downloaded: 0, milliseconds: 0.0 as Float32}
    }
    fun address(offset: Int) r: *UInt8 { return ((this.host as UInt64) + (offset as UInt64)) as *UInt8 }
    fun words(offset: Int) r: *UInt32 { return this.address(offset) as *UInt32 }
    fun samples(offset: Int) r: *Int64 { return this.address(offset) as *Int64 }
    fun open(filename: *const UInt8, entry: *const UInt8) r: Bool {
        this.host = seen_try_aligned_realloc(null as *Void, 0 as Int64, 2048 as Int64, 16 as Int64) as *UInt8
        if this.host == (null as *UInt8) { return false }
        var i = 0; while i < 2048 { this.host[i] = 0 as UInt8; i = i + 1 }
        if not nativeOkay(cuInit(0 as UInt32), "cuInit") or not nativeOkay(cuDriverGetVersion(&this.version), "cuDriverGetVersion") { return false }
        var count = 0 as Int32
        if not nativeOkay(cuDeviceGetCount(&count), "cuDeviceGetCount") or count < (1 as Int32) or count > (64 as Int32) { return false }
        var matches = 0; i = 0
        while i < (count as Int) {
            var device = -1 as Int32
            if not nativeOkay(cuDeviceGet(&device, i as Int32), "cuDeviceGet") or
                not nativeOkay(cuDeviceGetName(this.host, 256 as Int32, device), "cuDeviceGetName") { return false }
            var length = 0; while length < 256 and this.host[length] != (0 as UInt8) { length = length + 1 }
            if length == 256 { return false }
            let name = seen_string_view_bytes(this.host as *const UInt8, length as Int64)
            if name == "NVIDIA GeForce RTX 4090" { this.selected = device; matches = matches + 1 }
            i = i + 1
        }
        if matches != 1 { println("expected exactly one NVIDIA GeForce RTX 4090; no fallback"); return false }
        if not nativeOkay(cuDeviceGetUuid_v2(this.address(256), this.selected), "cuDeviceGetUuid_v2") or
            not nativeOkay(cuDeviceGetAttribute(&this.major, 75 as Int32, this.selected), "cuDeviceGetAttribute.major") or
            not nativeOkay(cuDeviceGetAttribute(&this.minor, 76 as Int32, this.selected), "cuDeviceGetAttribute.minor") { return false }
        if this.major != (8 as Int32) or this.minor != (9 as Int32) { return false }
        if not nativeOkay(cuCtxCreate_v2(&this.context, 0 as UInt32, this.selected), "cuCtxCreate_v2") or this.context == (null as *Void) { return false }
        if not nativeOkay(cuModuleLoad(&this.module, filename), "cuModuleLoad") or this.module == (null as *Void) { return false }
        if not nativeOkay(cuModuleGetFunction(&this.function, this.module, entry), "cuModuleGetFunction") or this.function == (null as *Void) { return false }
        // The cubin's native parameter layout must agree with admitted reflection.
        i = 0
        while i < 6 {
            var offset = 0 as UInt64; var bytes = 0 as UInt64
            if not nativeOkay(cuFuncGetParamInfo(this.function, i as UInt64, &offset, &bytes), "cuFuncGetParamInfo") or
                offset != (parameterOffset(i) as UInt64) or bytes != (parameterBytes(i) as UInt64) { return false }; i = i + 1
        }
        var extraOffset = 0 as UInt64; var extraBytes = 0 as UInt64
        let end = cuFuncGetParamInfo(this.function, 6 as UInt64, &extraOffset, &extraBytes)
        if end != (1 as Int32) { println("cuFuncGetParamInfo must reject a seventh parameter"); println(end); return false }
        if not nativeOkay(cuMemAlloc_v2(&this.input, 148 as UInt64), "cuMemAlloc_v2.input") or this.input == (0 as UInt64) { return false }
        if not nativeOkay(cuMemAlloc_v2(&this.output, 148 as UInt64), "cuMemAlloc_v2.output") or this.output == (0 as UInt64) { return false }
        if not nativeOkay(cuMemAlloc_v2(&this.fault, 4 as UInt64), "cuMemAlloc_v2.fault") or this.fault == (0 as UInt64) { return false }
        if not nativeOkay(cuStreamCreate(&this.stream, 1 as UInt32), "cuStreamCreate") or this.stream == (null as *Void) { return false }
        if not nativeOkay(cuEventCreate(&this.start, 0 as UInt32), "cuEventCreate.start") or this.start == (null as *Void) { return false }
        if not nativeOkay(cuEventCreate(&this.stop, 0 as UInt32), "cuEventCreate.stop") or this.stop == (null as *Void) { return false }
        let input = this.words(288); let output = this.words(448); let uniform = this.words(768)
        i = 0; while i < 37 { input[i] = (i + 1) as UInt32; output[i] = 4294967295 as UInt32; i = i + 1 }
        uniform[0] = 7 as UInt32 // Entire aligned 16-byte value block was zeroed above.
        if not nativeOkay(cuMemcpyHtoD_v2(this.input, input as *const Void, 148 as UInt64), "cuMemcpyHtoD_v2.input") { return false }; this.uploaded = this.uploaded + 148
        if not nativeOkay(cuMemcpyHtoD_v2(this.output, output as *const Void, 148 as UInt64), "cuMemcpyHtoD_v2.output") { return false }; this.uploaded = this.uploaded + 148
        if not nativeOkay(cuMemcpyHtoD_v2(this.fault, this.address(784) as *const Void, 4 as UInt64), "cuMemcpyHtoD_v2.fault") { return false }; this.uploaded = this.uploaded + 4
        let parameters = this.address(800) as **Void
        parameters[0] = (&this.input) as *Void; parameters[1] = (&this.inputCount) as *Void
        parameters[2] = (&this.output) as *Void; parameters[3] = (&this.outputCount) as *Void
        parameters[4] = uniform as *Void; parameters[5] = (&this.fault) as *Void
        return true
    }
    fun poll(useEvent: Bool) r: Bool {
        let started = seen_time_monotonic_nanos(); if started < (0 as Int64) { return false }
        var fuel = 0
        while fuel < 1000000 {
            var status = 0 as Int32
            if useEvent { status = cuEventQuery(this.stop) } else { status = cuStreamQuery(this.stream) }
            this.queries = this.queries + 1
            if status == (0 as Int32) { this.pending = false; return true }
            if status != (600 as Int32) { return nativeOkay(status, "CUDA completion query") }
            fuel = fuel + 1
            if fuel % 64 == 0 {
                let now = seen_time_monotonic_nanos()
                if now < started or now - started >= (2000000000 as Int64) { println("CUDA completion deadline"); return false }
            }
        }; println("CUDA completion fuel exhausted"); return false
    }
    fun launch() r: Bool {
        if this.pending { return false }; this.recorded = false
        if not nativeOkay(cuEventRecord(this.start, this.stream), "cuEventRecord.start") { return false }
        this.pending = true
        if not nativeOkay(cuLaunchKernel(this.function, 5 as UInt32, 1 as UInt32, 1 as UInt32,
            8 as UInt32, 1 as UInt32, 1 as UInt32, 0 as UInt32, this.stream, this.address(800) as **Void, null as **Void), "cuLaunchKernel") { return false }
        if not nativeOkay(cuEventRecord(this.stop, this.stream), "cuEventRecord.stop") { return false }
        this.recorded = true
        if not this.poll(true) { return false }
        if not nativeOkay(cuEventElapsedTime(&this.milliseconds, this.start, this.stop), "cuEventElapsedTime") { return false }
        if not (this.milliseconds >= (0.0 as Float32) and this.milliseconds <= (2000.0 as Float32)) { return false }
        this.cycles = this.cycles + 1; return true
    }
    fun readback() r: Bool {
        if this.pending or not this.recorded { return false }
        if not nativeOkay(cuMemcpyDtoH_v2(this.address(448) as *Void, this.output, 148 as UInt64), "cuMemcpyDtoH_v2.output") { return false }; this.downloaded = this.downloaded + 148
        if not nativeOkay(cuMemcpyDtoH_v2(this.address(784) as *Void, this.fault, 4 as UInt64), "cuMemcpyDtoH_v2.fault") { return false }; this.downloaded = this.downloaded + 4
        let output = this.words(448); var i = 0
        while i < 37 { if output[i] != ((8 * i + 7) as UInt32) { println("CUDA output element mismatch"); println(i); return false }; i = i + 1 }
        return this.words(784)[0] == (0 as UInt32)
    }
    fun close() r: Bool {
        var drained = true
        if this.pending { drained = this.poll(this.recorded) }
        // On a failed retirement proof, do not free potentially borrowed backing.
        // Context teardown is still attempted and its status reported, but it is
        // not relabelled as successful per-resource drain or hardware evidence.
        if not drained {
            if this.context != (null as *Void) {
                if nativeOkay(cuCtxDestroy_v2(this.context), "cuCtxDestroy_v2.after_failed_retirement") { this.context = null as *Void }
            }; return false
        }
        if this.stop != (null as *Void) { if nativeOkay(cuEventDestroy_v2(this.stop), "cuEventDestroy_v2.stop") { this.stop = null as *Void } else { drained = false } }
        if this.start != (null as *Void) { if nativeOkay(cuEventDestroy_v2(this.start), "cuEventDestroy_v2.start") { this.start = null as *Void } else { drained = false } }
        if this.stream != (null as *Void) { if nativeOkay(cuStreamDestroy_v2(this.stream), "cuStreamDestroy_v2") { this.stream = null as *Void } else { drained = false } }
        if this.fault != (0 as UInt64) { if nativeOkay(cuMemFree_v2(this.fault), "cuMemFree_v2.fault") { this.fault = 0 as UInt64 } else { drained = false } }
        if this.output != (0 as UInt64) { if nativeOkay(cuMemFree_v2(this.output), "cuMemFree_v2.output") { this.output = 0 as UInt64 } else { drained = false } }
        if this.input != (0 as UInt64) { if nativeOkay(cuMemFree_v2(this.input), "cuMemFree_v2.input") { this.input = 0 as UInt64 } else { drained = false } }
        if this.module != (null as *Void) { if nativeOkay(cuModuleUnload(this.module), "cuModuleUnload") { this.module = null as *Void; this.function = null as *Void } else { drained = false } }
        if this.context != (null as *Void) { if nativeOkay(cuCtxDestroy_v2(this.context), "cuCtxDestroy_v2") { this.context = null as *Void } else { drained = false } }
        return drained
    }
    fun releaseHost() r: Void {
        if this.host != (null as *UInt8) {
            seen_aligned_buffer_free(this.host as *Void, 2048 as Int64, 16 as Int64); this.host = null as *UInt8
        }; this.free()
    }
}
