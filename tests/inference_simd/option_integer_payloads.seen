import core.option.{Some}
extern "C" fun seen_memory_used_bytes() r: Int64
fun requireOptionWord(value: Bool) r: Void {
    if not value { abort("fixed-width Option payload lost its concrete integer type") }
}
fun optionalByte(value: UInt8) r: UInt8? { return value }
fun main() r: Int {
    let initial = seen_memory_used_bytes(); var iteration = 0
    while iteration < 100 {
        let byte = optionalByte(255 as UInt8); let signedByte = Some(-7 as Int8)
        let half = Some(65001 as UInt16); let signedHalf = Some(-30001 as Int16)
        let word = Some(4000000001 as UInt32); let signedWord = Some(-2000000001 as Int32)
        let byteValue = byte.unwrap(); let halfValue = half.unwrap(); let wordValue = word.unwrap()
        requireOptionWord(byteValue == (255 as UInt8) and signedByte.unwrap() == (-7 as Int8))
        requireOptionWord(halfValue == (65001 as UInt16) and signedHalf.unwrap() == (-30001 as Int16))
        requireOptionWord(wordValue == (4000000001 as UInt32) and signedWord.unwrap() == (-2000000001 as Int32))
        byte.free(); signedByte.free(); half.free(); signedHalf.free(); word.free(); signedWord.free()
        requireOptionWord(seen_memory_used_bytes() == initial); iteration = iteration + 1
    }
    println("PASS: fixed-width Option integer unwrap preserves signedness payload bits and allocation baseline")
    return 0
}
