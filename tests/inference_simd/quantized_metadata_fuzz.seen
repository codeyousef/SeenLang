import inference.quantized_formats.{QuantizedFormat, quantizedBlockElements}
import simd.quantized_decode.{decodeQuantizedBlock}
import simd.memory_operations.{SimdMemoryProgress}
import memory.aligned_buffer.{OwnedBuffer}
import dot_fixture_support.{must, errorIs, context}
import quantized_fixture_support.{prepareQuantizedCorpus, corpusExpected, corpusFormat}
extern "C" fun seen_time_monotonic_nanos() r: Int64
extern "C" fun seen_memory_used_bytes() r: Int64
fun main() r: Int {
    let source: OwnedBuffer<UInt8> = must(OwnedBuffer<UInt8>.allocate(4096 as UInt64, 1 as UInt64, 64 as UInt64))
    let output: OwnedBuffer<UInt8> = must(OwnedBuffer<UInt8>.allocate(4096 as UInt64, 1 as UInt64, 64 as UInt64))
    let ctx = context(); let progress = SimdMemoryProgress.create()
    prepareQuantizedCorpus(source.data, QuantizedFormat.Q8_0, 0)
    must(decodeQuantizedBlock(source, 0 as UInt64, output, 0 as UInt64, QuantizedFormat.Q8_0, 1, 128, ctx, progress))
    let baseline = seen_memory_used_bytes(); let start = seen_time_monotonic_nanos()
    if start < (0 as Int64) or start > (9223371976854775807 as Int64) { return 1 }
    let deadline = start + (60000000000 as Int64)
    var now = start; var seed = 1101; var iterations = 0
    while now < deadline {
        seed = (seed * 1103515245 + 12345) % 2147483647
        let format = corpusFormat(seed % 7); let offset = seed % 64
        let input = ((source.data as UInt64) + (offset as UInt64)) as *UInt8
        prepareQuantizedCorpus(input, format, 0)
        let count = (seed / 64) % (quantizedBlockElements(format) + 1)
        var width = 128; if seed % 3 == 1 { width = 256 }; if seed % 3 == 2 { width = 512 }
        let mode = seed % 10; var expected = ""
        var requested = count; var sourceOffset = offset as UInt64
        if mode == 0 { requested = -1; expected = "simd.invalid_quantization" }
        if mode == 1 { requested = quantizedBlockElements(format) + 1; expected = "simd.invalid_quantization" }
        if mode == 2 { width = 64; expected = "simd.invalid_policy" }
        if mode == 3 { sourceOffset = 4096 as UInt64; expected = "simd.invalid_shape" }
        if mode == 8 { ctx.cancellation = true; expected = "simd.cancelled" }
        if mode == 9 { ctx.monotonicDeadline = 0 as Int64; expected = "simd.timeout" }
        if mode == 4 {
            if not errorIs(decodeQuantizedBlock(source, sourceOffset, source, sourceOffset,
                format, 1, width, ctx, progress), "simd.invalid_alias") { return 2 }
        } else if mode == 5 {
            prepareQuantizedCorpus(input, QuantizedFormat.Q8_0, 0); input[1] = 124 as UInt8
            if not errorIs(decodeQuantizedBlock(source, sourceOffset, output, 0 as UInt64,
                QuantizedFormat.Q8_0, 32, width, ctx, progress), "simd.invalid_quantization") { return 3 }
        } else if mode == 6 {
            prepareQuantizedCorpus(input, QuantizedFormat.MXFP4, 0); input[0] = 254 as UInt8; input[1] = 4 as UInt8
            if not errorIs(decodeQuantizedBlock(source, sourceOffset, output, 0 as UInt64,
                QuantizedFormat.MXFP4, 1, width, ctx, progress), "simd.invalid_quantization") { return 4 }
        } else {
            let result = decodeQuantizedBlock(source, sourceOffset, output, 0 as UInt64, format, requested, width, ctx, progress)
            if expected != "" { if not errorIs(result, expected) { return 5 } }
            else {
                must(result)
                if progress.completed != (count as UInt64) { return 6 }
                let values = output.data as *Float32
                if count > 0 and values[count - 1] != corpusExpected(format, count - 1, 0) { return 7 }
            }
        }
        ctx.cancellation = false; ctx.monotonicDeadline = 9223372036854775807 as Int64
        iterations = iterations + 1
        if iterations % 256 == 0 {
            if seen_memory_used_bytes() != baseline { return 8 }
            let next = seen_time_monotonic_nanos(); if next < now { return 9 }; now = next
        }
    }
    if iterations < 256 or seen_memory_used_bytes() != baseline { return 10 }
    source.close(); source.free(); output.close(); output.free(); progress.free()
    ctx.limits.free(); ctx.traceId.free(); ctx.free()
    println("PASS: quantized metadata fuzz 60s seed=1101 live-allocation-stable")
    return 0
}
