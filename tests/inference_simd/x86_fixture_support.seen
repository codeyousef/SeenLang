import core.result.{Result}
import core.error.{AsciiString}
import core.operation_context.{OperationContext, OperationLimits}
import simd.ir_types.{SimdIrError}
fun must<T, E>(value: Result<T, E>) r: T {
    if value.isErr() { abort("x86 SIMD fixture failed") }
    let result = value.unwrap(); value.releaseContainer(); return result
}

fun errorIs<T>(value: Result<T, SimdIrError>, expected: String) r: Bool {
    if value.isOkay() { value.releaseContainer(); return false }
    let error = value.unwrapErr(); value.releaseContainer()
    let matches = error.code == expected; error.free(); return matches
}

fun context() r: OperationContext {
    return OperationContext{cancellation: false, monotonicDeadline: 9223372036854775807 as Int64,
        limits: OperationLimits{maxTargets: 8, maxIdentityBytes: 128, maxVersionBytes: 128,
            maxManifestBytes: 4096, maxPathBytes: 4095, maxGraphModules: 8,
            maxGraphEdges: 16, maxGraphDepth: 4}, traceId: AsciiString{value: "simd-b"}}
}
