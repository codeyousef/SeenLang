/// Protocol golden values in decimal axis order, independently encoded from
/// the production ASCII codebook. Attribution: seen_std/THIRD_PARTY_NOTICES.txt.
fun corpusIQ3Magnitude(index: Int, axis: Int) r: Int {
    if index < 0 or index > 255 or axis < 0 or axis > 3 { abort("invalid corpus coordinate") }
    let values = ""
    let position = index * 12 + axis * 3
    return (values.byteAt(position) - 48) * 100 +
        (values.byteAt(position + 1) - 48) * 10 + values.byteAt(position + 2) - 48
}
