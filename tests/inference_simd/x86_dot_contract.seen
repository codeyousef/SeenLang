import simd.dot_contract.{DotBackendHandle}
import simd.dot_clock.{DotClockHandle, NativeDotClock}
import dot_fixture_support.{must, errorIs, context, parity, ProbeDotClock}
import memory.aligned_buffer.{OwnedBuffer}
import simd.x86_dispatch.{X86SimdCapabilities, selectX86Variant}
import simd.dot_contract.{DotOperation, DotProgress}
import simd.x86_kernels.{executeX86Dot, executeX86DotWithClock, X86DotBackend}
extern "C" fun seen_memory_used_bytes() r: Int64
extern "C" fun seen_string_release_owned(value: String) r: Void
fun memoryUnchanged(before: Int64, phase: String) r: Void {
    let after = seen_memory_used_bytes()
    if after != before {
        let beforeText = before.toString(); let afterText = after.toString()
        println("FAIL: x86 allocation baseline changed"); println(phase); println(beforeText); println(afterText)
        seen_string_release_owned(beforeText); seen_string_release_owned(afterText)
        abort("x86 allocation ownership regression")
    }
}
fun clockOwnership() r: Void {
    let baseline = seen_memory_used_bytes(); var i = 0
    while i < 16 {
        let provider = NativeDotClock{reserved: 0}; let clock = DotClockHandle.create(provider)
        clock.release(); provider.free(); memoryUnchanged(baseline, "clock handle and borrowed provider"); i = i + 1
    }
}
fun capabilitiesMatrix() r: Void {
    var bits = 0
    while bits < 32 {
        let caps = X86SimdCapabilities{avx2: (bits & 1) != 0, fma: (bits & 2) != 0,
            avx512: (bits & 4) != 0, vnni: (bits & 8) != 0, bf16: (bits & 16) != 0}
        let selected = selectX86Variant(caps, "dot-f32", "auto", true, false)
        if not caps.valid() {
            if not errorIs(selected, "simd.invalid_capability") { abort("inconsistent capability set accepted") }
        } else {
            var expected = 0
            if caps.avx2 and caps.fma { expected = 1 }
            if caps.avx512 and caps.fma { expected = 2 }
            if must(selected) != expected { abort("non-deterministic x86 selection") }
            if must(selectX86Variant(caps, "dot-f32", "auto", true, true)) != 0 {
                abort("deterministic policy selected native reduction")
            }
            if not errorIs(selectX86Variant(caps, "dot-f32", "auto", false, true), "simd.scalar_required") {
                abort("implicit deterministic fallback accepted")
            }
        }
        caps.free(); bits = bits + 1
    }
}
fun main() r: Int {
    clockOwnership()
    let backendProvider = X86DotBackend{reserved: 0}; let backend = DotBackendHandle.create(backendProvider)
    let ctx = context(); let left: OwnedBuffer<UInt8> = must(OwnedBuffer<UInt8>.allocate(32768 as UInt64, 1 as UInt64, 64 as UInt64))
    let right: OwnedBuffer<UInt8> = must(OwnedBuffer<UInt8>.allocate(32768 as UInt64, 1 as UInt64, 64 as UInt64))
    let reference = DotProgress.create(); let actual = DotProgress.create()
    capabilitiesMatrix()
    parity(backend, DotOperation.Float32, ctx, left, right, reference, actual)
    parity(backend, DotOperation.UnsignedSignedByte, ctx, left, right, reference, actual)
    parity(backend, DotOperation.BFloat16, ctx, left, right, reference, actual)
    let memory = seen_memory_used_bytes()
    capabilitiesMatrix(); memoryUnchanged(memory, "capability selection and result cleanup")
    parity(backend, DotOperation.Float32, ctx, left, right, reference, actual)
    memoryUnchanged(memory, "Float32 scalar and native dispatch")
    parity(backend, DotOperation.UnsignedSignedByte, ctx, left, right, reference, actual)
    memoryUnchanged(memory, "byte scalar and native dispatch")
    parity(backend, DotOperation.BFloat16, ctx, left, right, reference, actual)
    memoryUnchanged(memory, "BF16 scalar and native dispatch")
    println("PASS: SEEN-INF-002B_happy")
    let none = X86SimdCapabilities{avx2: false, fma: false, avx512: false, vnni: false, bf16: false}
    if not errorIs(selectX86Variant(none, "dot-u8s8", "vnni", false, false), "simd.unsupported_capability") { return 2 }
    if not errorIs(selectX86Variant(none, "secret-input", "auto", true, false), "simd.invalid_operation") { return 3 }
    if not errorIs(selectX86Variant(none, "dot-f32", "secret-policy", true, false), "simd.invalid_policy") { return 4 }
    none.free()
    if not errorIs(executeX86Dot(left, 1 as UInt64, right, 0 as UInt64, 8 as UInt64,
        DotOperation.Float32, "auto", true, false, ctx, actual), "simd.invalid_shape") { return 5 }
    let previous = actual.completed
    if not errorIs(executeX86Dot(left, 0 as UInt64, right, 0 as UInt64, 4194305 as UInt64,
        DotOperation.Float32, "auto", true, false, ctx, actual), "simd.limit") or
        actual.completed != previous { return 6 }
    println("PASS: SEEN-INF-002B_invalid")
    println("PASS: SEEN-INF-002B_limit")
    ctx.cancellation = true
    if not errorIs(executeX86Dot(left, 0 as UInt64, right, 0 as UInt64, 64 as UInt64,
        DotOperation.Float32, "scalar", false, false, ctx, actual), "simd.cancelled") or
        actual.completed != (0 as UInt64) { return 7 }
    ctx.cancellation = false; ctx.monotonicDeadline = -1 as Int64
    if not errorIs(executeX86Dot(left, 0 as UInt64, right, 0 as UInt64, 64 as UInt64,
        DotOperation.Float32, "scalar", false, false, ctx, actual), "simd.timeout") { return 8 }
    println("PASS: SEEN-INF-002B_cancel")
    var i = 0
    let ap = left.data as *Float32; let bp = right.data as *Float32
    while i < 8192 { ap[i] = 1.0 as Float32; bp[i] = 2.0 as Float32; i = i + 1 }
    ctx.monotonicDeadline = 200 as Int64
    let clockProvider = ProbeDotClock{reads: 0, reverse: false}; let clock = DotClockHandle.create(clockProvider)
    if not errorIs(executeX86DotWithClock(left, 0 as UInt64, right, 0 as UInt64,
        8192 as UInt64, DotOperation.Float32, "scalar", false, false, ctx,
        actual, clock), "simd.timeout") or actual.completed != (4096 as UInt64) or
        actual.floating != (8192.0 as Float32) { return 9 }
    clockProvider.reads = 0; clockProvider.reverse = true
    if not errorIs(executeX86DotWithClock(left, 0 as UInt64, right, 0 as UInt64,
        8192 as UInt64, DotOperation.Float32, "scalar", false, false, ctx,
        actual, clock), "simd.unavailable") or actual.completed != (4096 as UInt64) { return 10 }
    clock.release(); clockProvider.free()
    println("PASS: SEEN-INF-002B_partial")
    backend.release(); backendProvider.free(); reference.free(); actual.free(); left.close(); left.free(); right.close(); right.free()
    ctx.limits.free(); ctx.traceId.free(); ctx.free()
    println("PASS: SEEN-INF-002B_cleanup")
    return 0
}
