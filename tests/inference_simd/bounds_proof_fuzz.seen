import bounds_fixture_support.{BoundsFixture, proofFixtureNode}
import codegen.ir_bounds_proof.{proveRangeArrayBounds}
import codegen.ir_bounds_proof_state.{enterBoundsProof, leaveBoundsProof, consumeBoundsProof, boundsProofAccessCount}
import codegen.simd_report.{renderBoundsLoopRecord, simdReportDecimalAfter}
import json.builder.{releaseJsonText}
extern "C" fun seen_time_monotonic_nanos() r: Int64
extern "C" fun seen_memory_used_bytes() r: Int64
fun main() r: Int {
    let initialMemory = seen_memory_used_bytes()
    let fixture = BoundsFixture.create()
    let call = proofFixtureNode(fixture.nodes); call.kind = "MethodCall"; call.callee = "pop"; call.literalValue = "data"
    let warm = proveRangeArrayBounds(fixture.rangeStatement, fixture.names, fixture.types, fixture.names.length()); warm.free()
    let report = renderBoundsLoopRecord(202, 1, 1, "canonical-zero-to-stable-length", 1, 1); releaseJsonText(report)
    let memory = seen_memory_used_bytes()
    let start = seen_time_monotonic_nanos()
    if start < (0 as Int64) or start > (9223371976854775807 as Int64) { return 1 }
    let deadline = start + (60000000000 as Int64)
    var seed = 1101; var iterations = 0; var now = start
    while now < deadline {
        seed = (seed * 1103515245 + 12345) % 2147483647
        fixture.zero.literalValue = "0"; fixture.types[0] = "Array<Int>"; fixture.types[3] = "Int"
        fixture.assignment.variableName = "sum"; fixture.body.expression = fixture.assignment
        fixture.add.operands[0] = fixture.sum; fixture.length.literalValue = "data"
        let mode = seed % 8; var expected = "canonical-zero-to-stable-length"
        if mode == 1 { fixture.zero.literalValue = "-1"; expected = "noncanonical-range" }
        if mode == 2 { fixture.types[3] = "UnknownClass"; expected = "effects-or-control" }
        if mode == 3 { fixture.assignment.variableName = "i"; expected = "effects-or-control" }
        if mode == 4 { fixture.add.operands[0] = fixture.add; expected = "analysis-limit" }
        if mode == 5 { fixture.body.expression = call; expected = "effects-or-control" }
        if mode == 6 { fixture.length.literalValue = "other" }
        if mode == 7 { fixture.types[0] = "*Int"; expected = "unproved-owner-type" }
        let plan = proveRangeArrayBounds(fixture.rangeStatement, fixture.names, fixture.types, fixture.names.length())
        if plan.reason != expected { return 2 }
        let scope = enterBoundsProof(plan)
        let matched = consumeBoundsProof(fixture.data, fixture.index)
        if matched != (mode == 0) { return 3 }
        let text = renderBoundsLoopRecord(202, 1, 1, scope.plan.reason, boundsProofAccessCount(), 1)
        releaseJsonText(text); leaveBoundsProof(scope)
        if consumeBoundsProof(fixture.data, fixture.index) { return 4 }
        let value = seed % 999999; let digits = value.toString()
        let diagnostic = "vectorization width: " + digits
        if simdReportDecimalAfter(diagnostic, "vectorization width: ") != value { return 5 }
        releaseJsonText(diagnostic); releaseJsonText(digits)
        iterations = iterations + 1
        if iterations % 256 == 0 {
            if seen_memory_used_bytes() != memory { return 6 }
            let next = seen_time_monotonic_nanos(); if next < now { return 7 }; now = next
        }
    }
    if iterations < 256 or seen_memory_used_bytes() != memory { return 8 }
    fixture.add.operands[0] = fixture.sum; fixture.release()
    if seen_memory_used_bytes() != initialMemory { return 9 }
    println("PASS: bounds proof AST and report metadata fuzz 60s seed=1101")
    return 0
}
