import simd.arm_dispatch.{ArmSimdCapabilities, selectArmVariant}
extern "C" fun seen_time_monotonic_nanos() r: Int64
extern "C" fun seen_memory_used_bytes() r: Int64
fun main() r: Int {
    let start = seen_time_monotonic_nanos()
    if start < (0 as Int64) or start > (9223371976854775807 as Int64) { return 1 }
    let deadline = start + (60000000000 as Int64)
    let memory = seen_memory_used_bytes(); var seed = 1101; var iterations = 0
    var now = start
    while now < deadline {
        seed = (seed * 1103515245 + 12345) % 2147483647
        let bytes = (seed % 1025) as UInt64
        let probed = ArmSimdCapabilities.fromProbe((seed & 1) != 0, (seed & 2) != 0,
            ((seed / 8) % 6) as Int32, bytes)
        if probed.isOkay() {
            let caps = probed.unwrap(); probed.releaseContainer()
            if not caps.valid() { return 2 }
            let planned = selectArmVariant(caps, "auto", true, false)
            if planned.isErr() { return 3 }
            let variant = planned.unwrap(); planned.releaseContainer()
            if variant < 0 or variant > 2 or (variant == 2 and not caps.sve) or
                (variant == 1 and not caps.neon) { return 4 }
            caps.free()
        } else {
            let error = probed.unwrapErr(); probed.releaseContainer()
            if error.code != "simd.invalid_capability" and error.code != "simd.unavailable" { return 5 }
            error.free()
        }
        iterations = iterations + 1
        if iterations % 256 == 0 {
            if seen_memory_used_bytes() != memory { return 6 }
            let next = seen_time_monotonic_nanos()
            if next < now { return 7 }
            now = next
        }
    }
    if iterations < 256 or seen_memory_used_bytes() != memory { return 8 }
    println("PASS: ARM capability metadata fuzz 60s seed=1101 with stable live memory")
    return 0
}
