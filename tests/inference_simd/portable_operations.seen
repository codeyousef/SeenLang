import memory.aligned_buffer.{OwnedBuffer}
import simd.memory_operations.{SimdMemoryProgress, copyMaskedSimd, transformPackedSimdBytes, prefetchSimdBlock}
import simd.operation_types.{simdOperationArity, simdOperationResult}
import tests.inference_simd.dot_fixture_support.{must, errorIs, context}
extern "C" fun seen_memory_used_bytes() r: Int64
fun require(value: Bool) r: Void { if not value { abort("portable SIMD operation mismatch") } }
fun closeBuffer(buffer: OwnedBuffer<UInt8>) r: Void { require(buffer.close()); buffer.free() }
fun raw_f32x4(borrow input: OwnedBuffer<UInt8>, borrow output: OwnedBuffer<UInt8>, offset: Int) r: Void {
    let rounded: f32x4 = simd_fma_f32x4(
        f32x4(1.0000001192092896, 1.0000001192092896, 1.0000001192092896, 1.0000001192092896),
        f32x4(0.9999998807907104, 0.9999998807907104, 0.9999998807907104, 0.9999998807907104),
        f32x4(-1, -1, -1, -1))
    require(rounded.reduce_add() == (-5.684341886080802e-14 as Float32))
    let source = (input.data as Int) + offset
    let destination = (output.data as Int) + offset
    let mask = mask4(true, false, true, false)
    let value: f32x4 = simd_unsafe_masked_load_f32x4(source, mask, f32x4(2, 2, 2, 2))
    require(value.reduce_add() == 6)
    let empty = mask4(false, false, false, false)
    let noRead: f32x4 = simd_unsafe_masked_load_f32x4(0, empty, f32x4(2, 2, 2, 2))
    require(noRead.reduce_add() == 8)
    simd_unsafe_masked_store_f32x4(noRead, 0, empty)
    simd_unsafe_masked_store_f32x4(f32x4(2, 2, 2, 2), destination, mask)
    let fused: f32x4 = simd_fma_f32x4(f32x4(2, 2, 2, 2), f32x4(3, 3, 3, 3), f32x4(4, 4, 4, 4))
    require(fused.reduce_add() == 40)
    let indices = i32x4(-1, 8, 3, 4)
    let permuted: f32x4 = simd_permute_f32x4(f32x4(2, 2, 2, 2), f32x4(5, 5, 5, 5), indices)
    require(permuted.reduce_add() == 7)
}
fun raw_f32x8(borrow input: OwnedBuffer<UInt8>, borrow output: OwnedBuffer<UInt8>, offset: Int) r: Void {
    let source = (input.data as Int) + offset
    let destination = (output.data as Int) + offset
    let mask = mask8(true, false, true, false, true, false, true, false)
    let value: f32x8 = simd_unsafe_masked_load_f32x8(source, mask, f32x8(2, 2, 2, 2, 2, 2, 2, 2))
    require(value.reduce_add() == 12)
