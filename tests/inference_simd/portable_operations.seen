fun checkRaw_i32x4(borrow input: OwnedBuffer<UInt8>, borrow output: OwnedBuffer<UInt8>) r: Void {
    var offset = 0
    while offset < 64 {
        var i = 0
        while i < 192 { input.data[i] = 0 as UInt8; output.data[i] = 165 as UInt8; i = i + 1 }
        var lane = 0
        while lane < 4 {
            input.data[offset + lane * 4 + 0] = 1 as UInt8
            lane = lane + 1
        }
        raw_i32x4(input, output, offset)
        i = 0
        while i < 192 {
            var expected = 165
            if i >= offset and i < offset + 16 and ((i - offset) / 4) % 2 == 0 {
                expected = 0
                if (i - offset) % 4 == 0 { expected = 2 }
            }
            require(output.data[i] == (expected as UInt8)); i = i + 1
        }
        offset = offset + 1
    }
}
