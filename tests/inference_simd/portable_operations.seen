    require(noRead.reduce_add() == 16)
    simd_unsafe_masked_store_f32x8(noRead, 0, empty)
    simd_unsafe_masked_store_f32x8(f32x8(2, 2, 2, 2, 2, 2, 2, 2), destination, mask)
    let fused: f32x8 = simd_fma_f32x8(f32x8(2, 2, 2, 2, 2, 2, 2, 2), f32x8(3, 3, 3, 3, 3, 3, 3, 3), f32x8(4, 4, 4, 4, 4, 4, 4, 4))
    require(fused.reduce_add() == 80)
    let indices = i32x8(-1, 16, 7, 8, 0, 0, 0, 0)
    let permuted: f32x8 = simd_permute_f32x8(f32x8(2, 2, 2, 2, 2, 2, 2, 2), f32x8(5, 5, 5, 5, 5, 5, 5, 5), indices)
    require(permuted.reduce_add() == 15)
}
