import simd.dot_contract.{DotBackendHandle}
import simd.dot_clock.{DotClockHandle}
import simd.arm_kernels.{ArmDotBackend}
import dot_benchmark_support.{runDotBenchmark}
fun main() r: Int {
    let backendProvider = ArmDotBackend{reserved: 0}; let backend = DotBackendHandle.create(backendProvider)
    let result = runDotBenchmark(backend)
    backend.release(); backendProvider.free(); return result
}
