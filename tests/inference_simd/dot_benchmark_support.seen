import benchmark_statistics.{metric, medianRatioPpm}
import dot_fixture_support.{must, context}
import env.env.{args}
import memory.aligned_buffer.{OwnedBuffer}
import simd.dot_contract.{DotOperation, DotProgress}
import simd.dot_contract.{DotBackend, NativeDotClock, executeDotWithBackend}
extern "C" fun seen_time_monotonic_nanos() r: Int64
extern "C" fun seen_memory_used_bytes() r: Int64
extern "C" fun seen_memory_peak_bytes() r: Int64
extern "C" fun seen_string_release_owned(value: String) r: Void
fun sample<B: DotBackend>(borrow backend: B, borrow left: OwnedBuffer<UInt8>, borrow right: OwnedBuffer<UInt8>,
    progress: DotProgress, policy: String) r: Int64 {
    let ctx = context(); let clock = NativeDotClock{reserved: 0}; let before = seen_time_monotonic_nanos(); var i = 0
    while i < 16 {
        must(executeDotWithBackend(left, 0 as UInt64, right, 0 as UInt64, 262144 as UInt64,
            DotOperation.Float32, policy, true, false, ctx, progress, clock, backend))
        if progress.floating != (524288.0 as Float32) or progress.completed != (262144 as UInt64) {
            abort("benchmark correctness failed")
        }
        i = i + 1
    }
    let elapsed = seen_time_monotonic_nanos() - before
    clock.free(); ctx.limits.free(); ctx.traceId.free(); ctx.free()
    if elapsed <= (0 as Int64) or elapsed > (10000000000 as Int64) { abort("benchmark duration invalid") }
    return elapsed
}
fun runDotBenchmark<B: DotBackend>(borrow backend: B) r: Int {
    let argv = args()
    if argv.length() > 2 { return 1 }
    var enforce = false
    if argv.length() == 2 { if argv[1] != "--enforce" { return 1 }; enforce = true }
    argv.free()
    let left = must(OwnedBuffer<UInt8>.allocate(1048576 as UInt64, 1 as UInt64, 64 as UInt64))
    let right = must(OwnedBuffer<UInt8>.allocate(1048576 as UInt64, 1 as UInt64, 64 as UInt64))
    let ap = left.data as *Float32; let bp = right.data as *Float32; var i = 0
    while i < 262144 { ap[i] = 1.0 as Float32; bp[i] = 2.0 as Float32; i = i + 1 }
    let progress = DotProgress.create(); i = 0
    while i < 5 {
        let candidate = sample(backend, left, right, progress, "auto")
        let reference = sample(backend, left, right, progress, "scalar"); i = i + 1
    }
    let ratios = Array<Int64>(); i = 0
    while i < 30 { ratios.push(0 as Int64); i = i + 1 }
    let memory = seen_memory_used_bytes(); i = 0
    while i < 30 {
        var candidate = 0 as Int64; var reference = 0 as Int64
        if i % 2 == 0 {
            reference = sample(backend, left, right, progress, "scalar")
            candidate = sample(backend, left, right, progress, "auto")
        } else {
            candidate = sample(backend, left, right, progress, "auto")
            reference = sample(backend, left, right, progress, "scalar")
        }
        ratios[i] = candidate * (1000000 as Int64) / reference
        if seen_memory_used_bytes() != memory { return 2 }
        i = i + 1
    }
    let ratio = medianRatioPpm(ratios)
    println("BENCH: dot warmups=5 samples=30 control=scalar clock=monotonic paired=true")
    metric("BENCH: median_ratio_ppm=", ratio)
    metric("BENCH: allocator_peak_bytes=", seen_memory_peak_bytes())
    metric("BENCH: selected_variant=", progress.variant as Int64)
    if enforce and (progress.variant == 0 or ratio > (1050000 as Int64)) { return 3 }
    ratios.free(); progress.free(); left.close(); left.free(); right.close(); right.free()
    println("PASS: SIMD observed performance and live-allocation stability")
    if enforce { println("PASS: SIMD designated scalar control five-percent gate") }
    else { println("PENDING: designated-machine performance enforcement; hardware certification is deferred") }
    return 0
}
