import env.env.{args, releaseArgs}
import tools.gpu_command.{gpuReadBoundedText}
import codegen.gpu_source.{lowerGpuSource}
import codegen.gpu_options.{GpuOptions}
import json.builder.{releaseJsonText}
import spirv_contract_support.{require, checkEmission}
extern "C" fun seen_memory_used_bytes() r: Int64

fun main() r: Int {
    let initial = seen_memory_used_bytes(); let arguments = args(); require(arguments.length() == 2)
    let loaded = gpuReadBoundedText(arguments[1], 1048576); require(loaded.isOkay())
    let source = loaded.unwrap(); loaded.releaseContainer()
    let lowered = lowerGpuSource(source, "vector-splat.seen"); releaseJsonText(source); require(lowered.isOkay())
    let module = lowered.unwrap(); lowered.releaseContainer()
    let options = GpuOptions.create(); options.backend = "spirv"
    let targets = ["vulkan1.2", "vulkan1.3"]; let baseline = seen_memory_used_bytes(); var target = 0
    while target < targets.length() {
        options.target = targets[target]; var iteration = 0
        while iteration < 10 {
            checkEmission(module, options, iteration == 0)
            require(seen_memory_used_bytes() == baseline); iteration = iteration + 1
        }; target = target + 1
    }
    targets.free(); options.release(); module.release(); releaseArgs(arguments)
    require(seen_memory_used_bytes() == initial)
    println("PASS: SPIR-V scalar broadcast constructors and deterministic cleanup")
    return 0
}
