import env.env.{args, releaseArgs}
import tools.gpu_command.{gpuReadBoundedText}
import bootstrap.frontend.{runFrontendCompat}
import codegen.gpu_lower_program.{lowerGpuProgram}
import codegen.gpu_options.{GpuOptions}
import spirv_contract_support.{require, checkEmission}
import json.builder.{releaseJsonText}
extern "C" fun seen_memory_used_bytes() r: Int64
fun main() r: Int {
    let argv = args(); require(argv.length() == 2)
    let read = gpuReadBoundedText(argv[1], 1048576); require(read.isOkay()); let text = read.unwrap(); read.releaseContainer()
    let frontend = runFrontendCompat(text, "spirv-packed.seen", "en"); require(frontend.success)
    let lowered = lowerGpuProgram(frontend.program, "spirv-packed.seen"); releaseJsonText(text); require(lowered.isOkay())
    let module = lowered.unwrap(); lowered.releaseContainer(); let options = GpuOptions.create(); options.backend = "spirv"; options.target = "vulkan1.2"
    let baseline = seen_memory_used_bytes(); var i = 0
    while i < 30 { checkEmission(module, options, i == 0); require(seen_memory_used_bytes() == baseline); i = i + 1 }
    options.target = "vulkan1.3"; checkEmission(module, options, true); require(seen_memory_used_bytes() == baseline)
    options.release(); module.release(); releaseArgs(argv)
    println("PASS: GPU-002B all packed formats dynamic lanes scale encoding and cleanup"); return 0
}
