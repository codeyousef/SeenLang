@compute(1)
fun packed_words(word: Uniform<UInt32>, lane: Uniform<UInt32>, value: Uniform<Float32>, scale: Uniform<UInt32>, output: WriteBuffer<UInt32>, signed: WriteBuffer<Int32>, floating: WriteBuffer<Float32>) {
    output[0] = insertFp32(word, lane, value)
    floating[16] = unpackFp32(word, lane)
    output[1] = insertFp16(word, lane, value)
    floating[17] = unpackFp16(word, lane)
    output[2] = insertBf16(word, lane, value)
    floating[18] = unpackBf16(word, lane)
    output[3] = insertInt8(word, lane, -3)
    signed[19] = unpackInt8(word, lane)
    output[4] = insertUInt8(word, lane, 3 as UInt32)
    output[20] = unpackUInt8(word, lane)
    output[5] = insertInt4(word, lane, -3)
    signed[21] = unpackInt4(word, lane)
    output[6] = insertUInt4(word, lane, 3 as UInt32)
    output[22] = unpackUInt4(word, lane)
    output[7] = insertInt2(word, lane, -1)
    signed[23] = unpackInt2(word, lane)
    output[8] = insertUInt2(word, lane, 3 as UInt32)
    output[24] = unpackUInt2(word, lane)
    output[9] = insertFp8E4M3FN(word, lane, value)
    floating[25] = unpackFp8E4M3FN(word, lane)
    output[10] = insertMxfp4(word, lane, value, scale)
    floating[26] = unpackMxfp4(word, lane, scale)
    output[11] = insertInt32(word, lane, -3)
    signed[27] = unpackInt32(word, lane)
    output[12] = insertUInt32(word, lane, 3 as UInt32)
    output[28] = unpackUInt32(word, lane)
}
fun main() r: Int { return 0 }
