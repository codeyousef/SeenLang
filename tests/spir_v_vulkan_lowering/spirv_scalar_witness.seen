/// A bounded, independent scalar SPIR-V witness for packed-format instructions.
/// It consumes emitted numeric words, not the emitter's conversion plans.
import codegen.gpu.spirv_types.{GpuSpirvContext}
import codegen.gpu.spirv_function.{GpuSpirvFunction}
import codegen.gpu.spirv_words.{SPV_DECLARATIONS, SPV_FUNCTIONS}

fun witnessRequire(value: Bool) r: Void { if not value { abort("SPIR-V scalar witness rejected its instruction stream") } }
fun witnessFloat(bits: Int) r: Float32 {
    var word: UInt32 = bits as UInt32; return *((&word) as *Float32)
}
fun witnessBits(value: Float32) r: Int {
    var number: Float32 = value; return (*((&number) as *UInt32)) as Int
}
fun witnessSigned(value: Int) r: Int { if value >= 2147483648 { return value - 4294967296 }; return value }
class SpirvScalarWitness {
    var values: Array<Int>
    var types: Array<Int>
    var glsl: Int
    fun release() r: Void { this.values.free(); this.types.free(); this.free() }
    fun value(identity: Int) r: Int {
        witnessRequire(identity > 0 and identity < this.values.length()); return this.values[identity]
    }
    fun binary(opcode: Int, left: Int, right: Int) r: Int {
        if opcode == 128 { return (left + right) & 4294967295 }
        if opcode == 130 { return (left - right) & 4294967295 }
        if opcode == 132 { return (((left as UInt64) * (right as UInt64)) & (4294967295 as UInt64)) as Int }
        if opcode == 133 { return witnessBits(witnessFloat(left) * witnessFloat(right)) }
        if opcode == 194 or opcode == 196 {
            witnessRequire(right >= 0 and right < 32)
            if opcode == 194 { return left >> right }; return (left << right) & 4294967295
        }
        if opcode == 197 { return left | right }; if opcode == 198 { return left ^ right }; if opcode == 199 { return left & right }
        var result = false
        if opcode == 166 { result = left != 0 or right != 0 }
        else if opcode == 167 { result = left != 0 and right != 0 }
        else if opcode == 170 or opcode == 164 { result = left == right }
        else if opcode == 171 or opcode == 165 { result = left != right }
        else if opcode == 172 { result = left > right }
        else if opcode == 174 { result = left >= right }
        else if opcode == 176 { result = left < right }
        else if opcode == 178 { result = left <= right }
        else if opcode == 175 { result = witnessSigned(left) >= witnessSigned(right) }
        else if opcode == 177 { result = witnessSigned(left) < witnessSigned(right) }
        else if opcode == 179 { result = witnessSigned(left) <= witnessSigned(right) }
        else { abort("unsupported scalar witness binary instruction") }
        if result { return 1 }; return 0
    }
    fun declarations(words: Array<Int>) r: Void {
        var cursor = 0
        while cursor < words.length() {
            let count = words[cursor] >> 16; let opcode = words[cursor] & 65535
            witnessRequire(count > 0 and count <= words.length() - cursor)
            if opcode == 20 { this.types[words[cursor + 1]] = 1 }
            if opcode == 21 { this.types[words[cursor + 1]] = 3 - words[cursor + 3] }
            if opcode == 22 { witnessRequire(words[cursor + 2] == 32); this.types[words[cursor + 1]] = 4 }
            if opcode == 43 { this.values[words[cursor + 2]] = words[cursor + 3] }
            if opcode == 41 { this.values[words[cursor + 2]] = 1 }
            if opcode == 42 or opcode == 46 { this.values[words[cursor + 2]] = 0 }
            cursor = cursor + count
        }
    }
    fun execute(words: Array<Int>) r: Void {
        var cursor = 0; var instructions = 0
        while cursor < words.length() {
            let count = words[cursor] >> 16; let opcode = words[cursor] & 65535
            witnessRequire(count >= 4 and count <= words.length() - cursor and instructions < 65536)
            let resultType = this.types[words[cursor + 1]]; let result = words[cursor + 2]; var value = 0
            witnessRequire(resultType >= 1 and resultType <= 4 and result > 0 and result < this.values.length())
            if opcode == 124 { value = this.value(words[cursor + 3]) }
            else if opcode == 168 { if this.value(words[cursor + 3]) == 0 { value = 1 } }
            else if opcode == 169 {
                witnessRequire(count == 6)
                if this.value(words[cursor + 3]) != 0 { value = this.value(words[cursor + 4]) }
                else { value = this.value(words[cursor + 5]) }
            } else if opcode == 109 {
                let bits = this.value(words[cursor + 3]); witnessRequire(bits <= 1090519040)
                value = (witnessFloat(bits) as UInt32) as Int
            } else if opcode == 112 { value = witnessBits((this.value(words[cursor + 3]) as UInt32) as Float32) }
            else if opcode == 12 {
                witnessRequire(count == 6 and words[cursor + 3] == this.glsl and words[cursor + 4] == 2)
                let bits = this.value(words[cursor + 5]); witnessRequire(bits <= 1090519040)
                let number = witnessFloat(bits); var rounded = number as UInt32
                let remainder: Float32 = number - (rounded as Float32)
                if remainder > (0.5 as Float32) or (remainder == (0.5 as Float32) and (rounded & (1 as UInt32)) != (0 as UInt32)) { rounded = rounded + (1 as UInt32) }
                value = witnessBits(rounded as Float32)
            } else if opcode == 202 or opcode == 203 {
                witnessRequire(count == 6); let base = this.value(words[cursor + 3]); let offset = this.value(words[cursor + 4]); let bits = this.value(words[cursor + 5])
                witnessRequire(offset >= 0 and bits > 0 and bits <= 32 and offset <= 32 - bits)
                let mask = (1 << bits) - 1; value = (base >> offset) & mask
                if opcode == 202 and (value & (1 << (bits - 1))) != 0 { value = (value - (1 << bits)) & 4294967295 }
            } else {
                witnessRequire(count == 5); value = this.binary(opcode, this.value(words[cursor + 3]), this.value(words[cursor + 4]))
            }
            this.values[result] = value; cursor = cursor + count; instructions = instructions + 1
        }
    }
}
fun witnessSpirvScalar(context: GpuSpirvContext, function: GpuSpirvFunction, result: Int) r: Int {
    witnessRequire(context.validation.valid and context.words.nextId <= 32768)
    let values = Array<Int>(); let types = Array<Int>(); var i = 0
    while i < context.words.nextId { values.push(0); types.push(0); i = i + 1 }
    let witness = SpirvScalarWitness{values: values, types: types, glsl: context.glslSet}
    witness.declarations(context.words.sections[SPV_DECLARATIONS]); witness.execute(function.code.sections[SPV_FUNCTIONS])
    let value = witness.value(result); witness.release(); return value
}
