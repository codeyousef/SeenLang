import bootstrap.frontend.{runFrontendCompat}
import codegen.gpu_lower_program.{lowerGpuProgram}
import codegen.gpu.spirv_emitter.{emitGpuSpirv}
import codegen.gpu_options.{GpuOptions}
import spirv_contract_support.{require, checkEmission}
extern "C" fun seen_memory_used_bytes() r: Int64

fun main() r: Int {
    let source = "@device fun choose(value: Int32) r: Int32 { if value < 0 { return -value }; var i = 0; while i < 4 { if i == value { return i }; i = i + 1 }; return value + 7 } @device fun read_value(input: ReadBuffer<Int32>, index: UInt32) r: Int32 { return input[index] } @compute(64) fun copy_arbitrary(input: ReadBuffer<Int32>, output: WriteBuffer<Int32>, count: Uniform<UInt32>) { let id = globalInvocationId.x; if id < count { output[id] = choose(read_value(input, id)) } } @compute(8) fun structured(output: WriteBuffer<Int32>) { let scratch: SharedBuffer<Int32> = sharedBuffer(9); var total = 0; for i in 0..8 { if i == 2 { continue }; if i == 7 { break }; scratch[i] = i; total = total + scratch[i] }; var j = 0; while j < 4 { total = total + j; j = j + 1 }; let lazy = false and output.length > (0 as UInt32); if lazy { output[0] = total }; output[1] = total / 0; output[2] = total << 32 } @compute(1) fun vector_math(input: ReadBuffer<f32x4>, output: WriteBuffer<f32x4>, factor: Uniform<Float32>, enabled: Uniform<Bool>) { let value = input[0]; let scale = f32x4(factor, factor, factor, factor); if enabled { output[0] = sqrt(abs(value)) + scale }; output[1] = min(value, scale); output[2] = clamp(value, scale, scale) } @compute(1) fun conversions(input: ReadBuffer<Float32>, output: WriteBuffer<Int32>, unsigned_output: WriteBuffer<UInt32>) { output[0] = input[0] as Int32; unsigned_output[0] = input[1] as UInt32 }"
    let frontend = runFrontendCompat(source, "spirv-contract.seen", "en"); require(frontend.success)
    let lowered = lowerGpuProgram(frontend.program, "spirv-contract.seen"); require(lowered.isOkay())
    let module = lowered.unwrap(); lowered.releaseContainer(); let options = GpuOptions.create(); options.backend = "spirv"; options.target = "vulkan1.2"
    let baseline = seen_memory_used_bytes(); var round = 0
    while round < 50 {
        checkEmission(module, options, round == 0); require(seen_memory_used_bytes() == baseline); round = round + 1
    }
    options.target = "vulkan1.3"; checkEmission(module, options, true); require(seen_memory_used_bytes() == baseline)
    options.backend = "cuda"; options.target = "sm_80"
    let rejected = emitGpuSpirv(module, options); require(rejected.isErr())
    let validation = rejected.unwrapErr(); rejected.releaseContainer(); require(validation.diagnostics[0].code == "E_GPU_SPIRV_TARGET"); validation.release()
    require(seen_memory_used_bytes() == baseline); options.release(); module.release()
    println("PASS: GPU-002A resource helper control flow deterministic reflection and partial cleanup")
    return 0
}
