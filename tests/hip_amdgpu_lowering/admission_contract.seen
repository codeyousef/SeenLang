import codegen.gpu_source.{lowerGpuSource}
import codegen.gpu_artifact.{buildGpuArtifact}
import codegen.gpu_options.{GpuOptions, gpuSetOption}
import codegen.gpu_ir_model.{GpuIrValidation}
import codegen.gpu.amdgpu_context.{createGpuAmdFunction}
import codegen.gpu.amdgpu_builtins.{amdImplicitWord}
import tools.gpu_command.{gpuPrintValidation}
extern "C" fun seen_memory_used_bytes() r: Int64
fun require(value: Bool) r: Void { if not value { abort("AMDGPU admission or ownership contract failed") } }
fun checkSource(source: String, expected: String, selection: String) r: Void {
    let lowered = lowerGpuSource(source, "amdgpu-admission.seen")
    if lowered.isErr() { gpuPrintValidation(lowered.unwrapErr()) }
    require(lowered.isOkay()); let module = lowered.unwrap(); lowered.releaseContainer()
    let options = GpuOptions.create(); options.backend = "hip"; options.target = "gfx90a"; options.fallback = "cpu"
    if selection != "" { let selected = gpuSetOption(options, "entry", selection, 0); require(selected.code == ""); selected.free() }
    let baseline = seen_memory_used_bytes(); var round = 0
    while round < 30 {
        let result = buildGpuArtifact(module, options)
        if expected == "" {
            if result.isErr() { gpuPrintValidation(result.unwrapErr()) }; require(result.isOkay())
            let artifact = result.unwrap(); result.releaseContainer()
            require(artifact.binary.contains("@plain(") and not artifact.binary.contains("@unavailable(")); artifact.release()
        } else {
            require(result.isErr()); let error = result.unwrapErr(); result.releaseContainer()
            require(error.diagnostics.length() > 0 and error.diagnostics[0].code == expected)
            require(error.diagnostics[0].functionIndex >= 0); error.release()
        }
        require(seen_memory_used_bytes() == baseline); round = round + 1
    }; options.release(); module.release()
}
fun checkLimits(mode: Int) r: Void {
    let validation = GpuIrValidation.create(); let function = createGpuAmdFunction(validation, "gfx90a", 0, 1, 1, 1, true)
    if mode == 0 { require(function.allocate(65536) == 0) }
    if mode == 1 { function.nextValue = 1048576; require(function.value() == 0) }
    if mode == 2 { function.nextLabel = 1048576; require(function.label() == 0) }
    if mode == 3 { require(amdImplicitWord(function, 255, false) == 0) }
    if mode == 4 { require(amdImplicitWord(function, -1, true) == 0) }
    require(not validation.valid and validation.diagnostics.length() == 1)
    if mode < 3 { require(validation.diagnostics[0].code == "E_GPU_AMDGPU_LIMIT") }
    else { require(validation.diagnostics[0].code == "E_GPU_AMDGPU_LAYOUT") }
    function.release(); validation.release()
}
fun main() r: Int {
    let initial = seen_memory_used_bytes()
    checkSource("@compute(64) fun unsupported(input: ReadBuffer<UInt32>) { let matrix = coopLoadA(input, 0 as UInt32, 16 as UInt32, FP32, Tile16x16x16, RowMajor) }", "E_GPU_AMDGPU_CAPABILITY", "")
    checkSource("@compute(64) fun unsupported(input: ReadBuffer<UInt32>) { let matrix = coopLoadA(input, 0 as UInt32, 1 as UInt32, INT2, Tile8x8x8, RowMajor) }", "E_GPU_AMDGPU_CAPABILITY", "")
    checkSource("@compute(1) fun too_large(output: WriteBuffer<Int32>) { let a: SharedBuffer<Int32> = sharedBuffer(16383); let b: SharedBuffer<Int32> = sharedBuffer(1); output[0] = a[0] + b[0] }", "E_GPU_AMDGPU_LAYOUT", "")
    checkSource("@compute(64) fun unavailable(input: ReadBuffer<UInt32>) { let matrix = coopLoadA(input, 0 as UInt32, 1 as UInt32, INT2, Tile8x8x8, RowMajor) } @compute(1) fun plain(output: WriteBuffer<UInt32>) { output[0] = 7 as UInt32 }", "", "plain")
    var mode = 0; while mode < 5 { checkLimits(mode); require(seen_memory_used_bytes() == initial); mode = mode + 1 }
    println("PASS: AMDGPU selected-entry capabilities padded shared limits implicit geometry and bounded identities restore ownership"); return 0
}
