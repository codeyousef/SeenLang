import codegen.gpu_source.{lowerGpuSource}
import codegen.gpu_artifact.{buildGpuArtifact}
import codegen.gpu_options.{GpuOptions}
import tools.gpu_command.{gpuPrintValidation}
extern "C" fun seen_memory_used_bytes() r: Int64
fun requireCapability(value: Bool) r: Void { if not value { abort("AMDGPU capability or ownership contract failed") } }
fun rejectCapability(source: String, target: String) r: Void {
    let lowered = lowerGpuSource(source, "amdgpu-capability-rejection.seen")
    if lowered.isErr() { gpuPrintValidation(lowered.unwrapErr()) }
    requireCapability(lowered.isOkay()); let module = lowered.unwrap(); lowered.releaseContainer()
    let options = GpuOptions.create(); options.backend = "hip"; options.target = target; options.fallback = "cpu"
    let baseline = seen_memory_used_bytes(); var iteration = 0
    while iteration < 30 {
        let built = buildGpuArtifact(module, options); requireCapability(built.isErr())
        let error = built.unwrapErr(); built.releaseContainer()
        requireCapability(error.diagnostics.length() > 0 and error.diagnostics[0].code == "E_GPU_AMDGPU_CAPABILITY")
        requireCapability(error.diagnostics[0].functionIndex >= 0); error.release()
        requireCapability(seen_memory_used_bytes() == baseline); iteration = iteration + 1
    }; options.release(); module.release()
}
fun main() r: Int {
    let baseline = seen_memory_used_bytes()
    let half = "@compute(64) fun unsupported(a: ReadBuffer<UInt32>) { let matrix = coopLoadA(a, 0 as UInt32, 8 as UInt32, FP16, Tile16x16x16, RowMajor) }"
    rejectCapability(half, "gfx1100"); rejectCapability(half, "gfx1101"); rejectCapability(half, "gfx1200")
    rejectCapability("@compute(48) fun unsupported(a: ReadBuffer<UInt32>) { let matrix = coopLoadA(a, 0 as UInt32, 8 as UInt32, FP16, Tile16x16x16, RowMajor) }", "gfx90a")
    rejectCapability("@compute(32) fun unsupported(a: ReadBuffer<UInt32>) { let matrix = coopLoadA(a, 0 as UInt32, 8 as UInt32, BF16, Tile16x16x16, RowMajor) }", "gfx942")
    rejectCapability("@compute(64) fun unsupported(a: ReadBuffer<UInt32>) { let matrix = coopLoadA(a, 0 as UInt32, 16 as UInt32, FP32, Tile16x16x16, RowMajor) }", "gfx90a")
    rejectCapability("@compute(64) fun unsupported(a: ReadBuffer<UInt32>) { let matrix = coopLoadA(a, 0 as UInt32, 1 as UInt32, INT2, Tile8x8x8, RowMajor) }", "gfx942")
    rejectCapability("@compute(64) fun unsupported(a: ReadBuffer<UInt32>) { let matrix = coopLoadA(a, 0 as UInt32, 8 as UInt32, FP16, Tile16x8x16, RowMajor) }", "gfx90a")
    rejectCapability("@compute(64) fun unsupported(a: ReadBuffer<UInt32>) { let matrix = coopLoadA(a, 0 as UInt32, 8 as UInt32, FP16, Tile16x16x16, ColumnMajor) }", "gfx90a")
    rejectCapability("@compute(64) fun unsupported(b: ReadBuffer<UInt32>) { let matrix = coopLoadB(b, 0 as UInt32, 8 as UInt32, BF16, Tile16x16x16, RowMajor) }", "gfx942")
    let mutable = lowerGpuSource("@compute(64) fun unsupported(output: WriteBuffer<Float32>) { var matrix = coopFillFp32(0.0, Tile16x16x16); coopStore(matrix, output, 0 as UInt32, 16 as UInt32, RowMajor) }", "immutable-fragments.seen")
    requireCapability(mutable.isErr()); let error = mutable.unwrapErr(); mutable.releaseContainer()
    requireCapability(error.diagnostics.length() > 0 and error.diagnostics[0].code == "E_GPU_TYPE"); error.release()
    requireCapability(seen_memory_used_bytes() == baseline)
    println("PASS: AMDGPU native CDNA precision shape layout full-wave and immutable-fragment rejection restore ownership")
    return 0
}
