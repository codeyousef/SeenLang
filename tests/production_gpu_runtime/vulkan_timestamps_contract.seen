fun timestampTake<T>(result: Result<T, GpuError>) r: T {
    if result.isErr() { println(result.unwrapErr().code); println(result.unwrapErr().message); abort("native timestamp fixture operation failed") }
    let value = result.unwrap(); result.releaseContainer(); return value
}
fun timestampReject<T>(result: Result<T, GpuError>, code: String, progress: UInt64) r: Void {
    if result.isOkay() { abort("invalid timestamp operation succeeded") }
    let error = result.unwrapErr(); result.releaseContainer()
    if error.code != code or error.progress != progress { println(error.code); abort("timestamp failure lost diagnostic or submitted progress") }; error.release()
}
fun timestampNative(status: Int32) r: Void { if status != (0 as Int32) { abort("timestamp fixture SDK command setup failed") } }
fun timestampFinish(borrow pool: GpuVulkanTimestampPool, borrow sample: GpuVulkanTimestampSample) r: Void {
    var fuel = 1000000
    while fuel > 0 { let ready = timestampTake<Bool>(pool.poll(sample)); if ready { return }; fuel = fuel - 1 }
    abort("bounded native timestamp poll fuel exhausted")
}
fun timestampUnchanged(borrow sample: GpuVulkanTimestampSample) r: Void {
