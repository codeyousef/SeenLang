    let abi = VulkanTimestampPoolInfo{sType: 11 as UInt32, pNext: null as *Void, flags: 0 as UInt32, queryType: 2 as UInt32, queryCount: 2 as UInt32, pipelineStatistics: 0 as UInt32}
