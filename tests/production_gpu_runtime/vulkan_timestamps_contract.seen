}
fun timestampSentinel(borrow sample: GpuVulkanTimestampSample) r: Void {
    sample.startTicks = 17 as UInt64; sample.endTicks = 23 as UInt64; sample.elapsedTicks = 6 as UInt64; sample.elapsedNanoseconds = 12.0; sample.ready = true
}
