                    if observed.isErr() { let error = observed.unwrapErr(); observed.releaseContainer(); if error.code != arguments[5] or error.progress != sequence { abort("native graph poll lost typed failure/progress") }; error.release(); observedFault = true } else { if observed.unwrap() { abort("injected native poll fault became success") }; observed.releaseContainer() }; fuel = fuel + 1
                }
                if not observedFault { abort("native poll failure was not observed") }
