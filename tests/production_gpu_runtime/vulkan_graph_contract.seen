                if graph.pending { graphFRejected<Bool>(graph.close(), "gpu.busy"); graphFDrain(graph) }
            } else {
                // Cancellation after admission must not prevent native retirement.
                op.cancellation = true; op.monotonicDeadline = -1 as Int64; graphFDrain(graph); op.cancellation = false; op.monotonicDeadline = 9223372036854775807 as Int64
                completed(graph.poll(), true)
                if mode == "timed" { if not graph.sample.ready or graph.sample.elapsedNanoseconds < 0.0 { abort("native graph timestamp was not published") } }
                let next = graphFTake<UInt64>(graph.submit(op)); if next <= sequence { abort("graph reuse did not advance native timeline") }; graphFDrain(graph)
                if graph.command != command or graph.commandPool != commandPool or graph.descriptorPool != descriptorPool { abort("graph reuse replaced persistent native setup") }
                if mode == "timed" {
                    let last = graphFTake<UInt64>(graph.submit(op)); var fuel = 0; var retired = false
                    while not retired and fuel < 1000000 { retired = graphFTake<Bool>(stream.poll(last)); fuel = fuel + 1 }
                    if not retired { abort("timed graph did not retire native batch") }
                    set("SEEN_VULKAN_FIXTURE_FAULT", "timestamp-unavailable")
                    completed(graph.poll(), false)
                    if graph.sample.ready or graph.timing.unwrap().pending { abort("unavailable profiling validated output or retained retired query use") }
                    // Unavailable profiling must permit reusing the same native
                    // batch and query owner, not merely permit their release.
                    let clock = graph.timing.unwrap(); let queryPool = clock.pool
                    let reused = graphFTake<UInt64>(graph.submit(op))
                    if reused <= last or not graph.pending or not clock.pending or graph.sample.ready { abort("unavailable profiling blocked fresh native graph ownership") }
                    graphFRejected<UInt64>(graph.submit(op), "gpu.busy"); graphFRejected<Bool>(graph.close(), "gpu.busy")
                    fuel = 0; retired = false
                    while not retired and fuel < 1000000 { retired = graphFTake<Bool>(stream.poll(reused)); fuel = fuel + 1 }
                    if not retired { abort("reused timed graph did not retire native batch") }
                    completed(graph.poll(), false)
                    if graph.pending or clock.pending or graph.sample.ready or stream.core.inFlight != 0 { abort("unavailable profiling retained reused native work or validated a sample") }
                    if graph.command != command or graph.commandPool != commandPool or graph.descriptorPool != descriptorPool or clock.pool != queryPool { abort("unavailable-profile reuse replaced persistent native setup") }
                    set("SEEN_VULKAN_FIXTURE_FAULT", "")
                    graphFDrain(graph)
                    if not graph.sample.ready or graph.sample.elapsedNanoseconds < 0.0 { abort("reused native graph timestamp was not published after availability recovered") }
                }
            }
        }
        // Keep the borrowed timestamp payload separately before graph consumes
        // its Option wrapper, then release it only after dropGraph.
        if mode == "timed" { let pool = graph.timing.unwrap(); completed(graph.close(), true); completed(graph.close(), false); graphFRejected<UInt64>(graph.submit(op), "gpu.invalid"); completed(graph.release(), true); completed(pool.release(), true) }
        else { completed(graph.close(), true); completed(graph.close(), false); graphFRejected<UInt64>(graph.submit(op), "gpu.invalid"); completed(graph.release(), true) }
        if mode == "plain" or mode == "timed" { graphFOracle(output, intermediate, fault, op) }
    }
    if producer.borrowers != 0 or consumer.borrowers != 0 or stream.core.inFlight != 0 { abort("graph shutdown retained node or timeline owners") }
    completed(producer.release(), true); completed(consumer.release(), true)
    completed(input.release(), true); completed(intermediate.release(), true); completed(output.release(), true); completed(scale.release(), true); completed(fault.release(), true)
    completed(stream.release(), true); completed(allocator.release(), true); completed(context.release(), true); completed(device.release(), true)
    physical.release(); limits.release(); releaseOperation(op); seen_string_release_owned(binary); seen_string_release_owned(reflection); releaseArgs(arguments)
    if seen_memory_used_bytes() != baseline or seen_sync_live_atomics() != atomics { abort("native graph contract retained Seen owners") }
    println("PASS: native persistent graph ownership, producer-consumer execution and bounded lifecycle contract"); return 0
}
