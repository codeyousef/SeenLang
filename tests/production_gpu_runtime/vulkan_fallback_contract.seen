fun recoveryTake<T>(result: Result<T, GpuError>) r: T {
    if result.isErr() { let error = result.unwrapErr(); println(error.code); println(error.operation); println(error.message); abort("native GPU recovery operation failed") }
    let value = result.unwrap(); result.releaseContainer(); return value
}
fun recoveryReject<T>(result: Result<T, GpuError>, code: String) r: Void {
    if result.isOkay() { abort("invalid GPU recovery operation succeeded") }
    let error = result.unwrapErr(); result.releaseContainer(); if error.code != code { println(error.code); abort("GPU recovery rejection differs") }; error.release()
}
fun recoveryCpuStorage() r: OwnedBuffer<UInt32> {
    let allocated = OwnedBuffer<UInt32>.allocate(37 as UInt64, 4 as UInt64, 64 as UInt64)
    if allocated.isErr() { abort("CPU fallback oracle storage unavailable") }
    let buffer = allocated.unwrap(); allocated.releaseContainer(); return buffer
}
fun recoveryPut(borrow map: GpuVulkanMappedRegion, index: Int, word: UInt32) r: Void {
    var b = 0; while b < 4 { completed(map.writeByte((index * 4 + b) as UInt64, ((word >> ((b * 8) as UInt32)) & (255 as UInt32)) as UInt8), true); b = b + 1 }
}
fun recoveryWord(borrow map: GpuVulkanMappedRegion, index: Int) r: UInt32 {
    var value = 0 as UInt32; var b = 0
    while b < 4 { value = value | ((recoveryTake<UInt8>(map.readByte((index * 4 + b) as UInt64)) as UInt32) << ((b * 8) as UInt32)); b = b + 1 }; return value
}
// Independent closed-form reference: the chosen input sequence makes the
// modular output an arithmetic progression, crossing UInt32 at index31.
fun recoveryExpected(index: Int) r: UInt32 {
    var expected = index * 22 - 672; if expected < 0 { expected = expected + 4294967296 }; return expected as UInt32
}
// ACTUAL CPU fallback of the same reflected foundation task, using retained CPU
// inputs, never GPU data read after loss. Shift/subtract differs from shader's
// multiply and the independent arithmetic-progression consumer oracle.
fun recoveryCpuFoundation(borrow input: OwnedBuffer<UInt32>, borrow output: OwnedBuffer<UInt32>, op: OperationContext) r: Result<Bool, GpuError> {
    let checked = gpuCheckOperation(op, "gpu.fixture.cpu_foundation"); if checked.isErr() { return checked }; checked.releaseContainer()
    var i = 0
    while i < 37 { let value = input.data[i] as UInt64; output.data[i] = (((value << (3 as UInt32)) - value + (i as UInt64)) & (4294967295 as UInt64)) as UInt32; i = i + 1 }
    return Ok<Bool, GpuError>(true)
}
fun recoveryError(borrow error: GpuError, lost: Bool, progress: UInt64) r: Void {
    var code = "gpu.out_of_memory"; var native = -1 as Int64
    if lost { code = "gpu.device_lost"; native = -4 as Int64 }
    if error.code != code or error.progress != progress or error.nativeCode.isNone() or error.nativeCode.unwrap() != native { abort("GPU recovery lost original SDK code or accepted progress") }
}
