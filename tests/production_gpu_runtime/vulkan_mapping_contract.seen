import compute.vulkan_mapping.{gpuVkMapBuffer, GpuVulkanMappedRegion}
import compute.buffer.{GpuBuffer}
import compute.memory_kind.{GpuMemoryKind}
import compute.error.{GpuError}
import core.result.{Result}
import device_fixture_support.{gpuFixtureRejected}
import provider_fixture_support.{completed}
import vulkan_mapping_fixture_support.{mappingWorld}
extern "C" fun seen_memory_used_bytes() r: Int64
extern "C" fun seen_sync_live_atomics() r: UInt64

fun mapped(result: Result<GpuVulkanMappedRegion, GpuError>) r: GpuVulkanMappedRegion {
    if result.isErr() { abort("Vulkan coherent mapping was rejected") }
    let value = result.unwrap(); result.releaseContainer(); return value
}
fun rejected(result: Result<GpuVulkanMappedRegion, GpuError>, code: String) r: Void {
    if result.isOkay() { abort("invalid Vulkan mapping accepted") }
    let error = result.unwrapErr(); result.releaseContainer()
    if error.code != code { println(error.code); abort("Vulkan mapping rejection code differs") }
    error.release()
}
fun main() r: Int {
    let baseline = seen_memory_used_bytes(); let atomics = seen_sync_live_atomics()
    let world = mappingWorld(GpuMemoryKind.HostCoherent)
    let op = world.operation; let allocator = world.allocator
    let retired = Array<GpuVulkanMappedRegion>(); var cycle = 0
    while cycle < 10 {
        let a = GpuBuffer<UInt8>.allocate(allocator, 32 as UInt64, 1 as UInt64, 256 as UInt64, op)
        let b = GpuBuffer<UInt8>.allocate(allocator, 32 as UInt64, 1 as UInt64, 256 as UInt64, op)
        if a.isErr() or b.isErr() { abort("Vulkan staging buffers unavailable") }
        let first = a.unwrap(); let second = b.unwrap(); a.releaseContainer(); b.releaseContainer()
        let writeA = mapped(gpuVkMapBuffer(first, 0 as UInt64, 32 as UInt64, true, op))
        let writeB = mapped(gpuVkMapBuffer(second, 0 as UInt64, 32 as UInt64, true, op))
        var i = 0 as UInt64
        while i < (32 as UInt64) {
            let wa = writeA.writeByte(i, (i + (128 as UInt64)) as UInt8)
            let wb = writeB.writeByte(i, (255 as UInt64 - i) as UInt8)
            if wa.isErr() or wb.isErr() { abort("Vulkan mapped write failed") }
            wa.releaseContainer(); wb.releaseContainer(); i = i + (1 as UInt64)
        }
        gpuFixtureRejected(first.close(), "gpu.busy")
        rejected(gpuVkMapBuffer(first, 0 as UInt64, 1 as UInt64, false, op), "gpu.busy")
        completed(writeA.close(), true); completed(writeA.close(), false); completed(writeA.release(), true)
        completed(writeB.release(), true)
        let readA = mapped(gpuVkMapBuffer(first, 0 as UInt64, 32 as UInt64, false, op))
        let readB = mapped(gpuVkMapBuffer(first, 5 as UInt64, 7 as UInt64, false, op))
        let readSecond = mapped(gpuVkMapBuffer(second, 0 as UInt64, 32 as UInt64, false, op))
        i = 0 as UInt64
        while i < (32 as UInt64) {
            let byte = readA.readByte(i)
            if byte.isErr() or byte.unwrap() != (i + (128 as UInt64)) as UInt8 { abort("Vulkan mapped bytes changed") }
            byte.releaseContainer(); i = i + (1 as UInt64)
        }
        let tail = readB.readByte(6 as UInt64)
        if tail.isErr() or tail.unwrap() != (139 as UInt8) { abort("mapped partial-view offset changed") }
        tail.releaseContainer()
        i = 0 as UInt64
        while i < (32 as UInt64) {
            let byte = readSecond.readByte(i)
            if byte.isErr() or byte.unwrap() != ((255 as UInt64) - i) as UInt8 { abort("pooled neighboring bytes changed") }
            byte.releaseContainer(); i = i + (1 as UInt64)
        }
        gpuFixtureRejected(readA.writeByte(0 as UInt64, 0 as UInt8), "gpu.invalid")
        let outside = readA.readByte(32 as UInt64)
        if outside.isOkay() { abort("mapped read escaped payload") }
        let error = outside.unwrapErr(); outside.releaseContainer(); error.release()
        completed(readA.close(), true); retired.push(readA)
        completed(readB.release(), true); completed(readSecond.release(), true)
        rejected(gpuVkMapBuffer(first, 32 as UInt64, 1 as UInt64, false, op), "gpu.invalid")
        op.cancellation = true
        rejected(gpuVkMapBuffer(first, 0 as UInt64, 1 as UInt64, false, op), "gpu.cancelled")
        op.cancellation = false
        completed(first.close(), true)
        rejected(gpuVkMapBuffer(first, 0 as UInt64, 1 as UInt64, false, op), "gpu.invalid")
        completed(first.release(), true); completed(second.release(), true)
        cycle = cycle + 1
    }
    world.release()
    cycle = 0
    while cycle < retired.length() {
        completed(retired[cycle].close(), false)
        let stale = retired[cycle].readByte(0 as UInt64)
        if stale.isOkay() { abort("closed mapped view remained readable") }
        let error = stale.unwrapErr(); stale.releaseContainer()
        if error.code != "gpu.invalid" { abort("closed mapped view diagnostic changed") }
        error.release()
        completed(retired[cycle].release(), true); cycle = cycle + 1
    }
    retired.free()
    if seen_memory_used_bytes() != baseline or seen_sync_live_atomics() != atomics {
        abort("Vulkan mapping lifecycle retained Seen ownership")
    }
    println("PASS: GPU-006C native pooled mappings preserve bytes borrows bounds and cold cleanup")
    return 0
}
