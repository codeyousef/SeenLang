import compute.vulkan_pipeline_cache_file.{gpuVkAtomicCacheWrite}
import core.error.{AsciiString}
import core.operation_context.{OperationContext, OperationLimits}
import fs.types.{Path}
import fs.file.{seen_fs_open, seen_cstr_free}
import io.file.{writeText, readText, exists, deleteFile}
import env.env.{args, releaseArgs}
import json.builder.{seen_string_release_owned}
extern "C" fun seen_memory_used_bytes() r: Int64
extern "C" fun seen_memory_reserved_bytes() r: Int64
extern "C" fun seen_memory_limit_bytes() r: Int64
extern "C" fun seen_memory_set_limit_bytes(bytes: Int64) r: Void
extern "C" fun seen_memory_allocation_failures() r: Int64
extern "C" fun seen_time_monotonic_nanos() r: Int64

fun rejectWrapperAllocation(path: String, flags: Int32) r: Void {
    let nativePath = path.toCString()
    var handle = 0 as UInt64; var alignment = 0 as UInt64
    var active = 0 as Int32; var fallbacks = 0 as UInt64
    let previousLimit = seen_memory_limit_bytes()
    let failures = seen_memory_allocation_failures()
    // No Seen allocation is permitted between capping and the native open.
    seen_memory_set_limit_bytes(seen_memory_used_bytes() + seen_memory_reserved_bytes())
    let status = seen_fs_open(path.length() as Int64, nativePath as *const Char,
        flags, 0 as Int32, &handle, &alignment, &active, &fallbacks)
    seen_memory_set_limit_bytes(previousLimit)
    seen_cstr_free(nativePath as *Void)
    if status != (3 as Int32) or handle != (0 as UInt64) or
        seen_memory_allocation_failures() != failures + (1 as Int64) {
        abort("post-open wrapper allocation failure did not preserve native status and ownership")
    }
}

fun postCreateRegressions(path: Path, staging: String, bytes: Array<Int>,
    operation: OperationContext) r: Void {
    // Successful exclusive creation owns cleanup even if its wrapper cannot allocate.
    rejectWrapperAllocation(staging, 38 as Int32)
    if exists(staging) { abort("wrapper allocation failure orphaned exclusive staging") }
    if not writeText(staging, "FOREIGN") { abort("could not establish competing staging") }
    // Ordinary successful opens do not own the pre-existing path on later failure.
    rejectWrapperAllocation(staging, 2 as Int32)
    let existing = readText(staging)
    if existing != "FOREIGN" { abort("ordinary open allocation failure removed a foreign file") }
    seen_string_release_owned(existing)
    let collision = gpuVkAtomicCacheWrite(path, bytes, operation)
    if collision.isOkay() { abort("competing exclusive staging was reused") }
    let error = collision.unwrapErr(); collision.releaseContainer()
    if error.code != "gpu.busy" or error.nativeCode.isNone() or
        error.nativeCode.unwrap() != (6 as Int64) or error.progress != (0 as UInt64) {
        abort("competing staging lost its typed exclusive-open failure")
    }
    error.release()
    let competing = readText(staging)
    if competing != "FOREIGN" { abort("failed exclusive creation removed competing staging") }
    seen_string_release_owned(competing)
    if not deleteFile(staging) { abort("could not release fixture-owned competing staging") }
}

fun main() r: Int {
    let baseline = seen_memory_used_bytes(); let arguments = args()
    if arguments.length() != 3 { abort("requires cache destination and native fault mode") }
    let destinationText = arguments[1]; let mode = arguments[2]
    if mode != "expire" and mode != "sync-error" and mode != "close-error" and mode != "directory-error" and mode != "fstat-error" { abort("unknown native cache fault mode") }
    if not writeText(destinationText, "OLD") { abort("could not establish previous cache visibility") }
    let pathResult = Path.fromString(destinationText)
    if pathResult.isErr() { abort("cache fault destination invalid") }
    let path = pathResult.unwrap(); pathResult.releaseContainer()
    let operation = OperationContext{
        cancellation: false, monotonicDeadline: seen_time_monotonic_nanos() + (30000000000 as Int64),
        limits: OperationLimits{maxTargets: 8, maxIdentityBytes: 128, maxVersionBytes: 128,
            maxManifestBytes: 4096, maxPathBytes: 4095, maxGraphModules: 8,
            maxGraphEdges: 16, maxGraphDepth: 4},
        traceId: AsciiString{value: "cache-fault"}}
    let bytes = Array<Int>(); var i = 0
    while i < 64 { bytes.push((i * 17) % 256); i = i + 1 }
    let result = gpuVkAtomicCacheWrite(path, bytes, operation)
    if result.isOkay() { abort("designated native cache publication fault was hidden") }
    let error = result.unwrapErr(); result.releaseContainer()
    if mode == "expire" {
        if error.code != "gpu.timeout" or error.progress != (0 as UInt64) { abort("expiry after staging sync was not a precommit timeout") }
    } else {
        if error.code != "gpu.unavailable" or error.nativeCode.isNone() { abort("native cache I/O failure lost its classification") }
        if error.nativeCode.unwrap() != (4 as Int64) { abort("native filesystem I/O status was discarded") }
        var expectedProgress = 0 as UInt64; if mode == "directory-error" { expectedProgress = 1 as UInt64 }
        if error.progress != expectedProgress { abort("cache failure confused visibility with durability") }
    }
    error.release()
    let actual = readText(destinationText)
    if mode == "directory-error" {
        if actual.length() != bytes.length() { abort("committed cache was not visible after directory sync failure") }
        i = 0; while i < bytes.length() { if actual.byteAt(i) != bytes[i] { abort("committed cache bytes changed after directory sync failure") }; i = i + 1 }
    } else if actual != "OLD" { abort("precommit failure replaced the previous cache") }
    let staging = destinationText + ".pending"
    if exists(staging) { abort("owned staging survived failed publication") }
    if mode == "fstat-error" {
        postCreateRegressions(path, staging, bytes, operation)
        let previous = readText(destinationText)
        if previous != "OLD" { abort("post-create failure regressions replaced the previous cache") }
        seen_string_release_owned(previous)
    }
    seen_string_release_owned(staging); seen_string_release_owned(actual); bytes.free()
    path.raw.free(); path.free(); operation.traceId.free(); operation.limits.free(); operation.free(); releaseArgs(arguments)
    if seen_memory_used_bytes() != baseline { abort("native cache failure retained Seen ownership") }
    return 0
}
