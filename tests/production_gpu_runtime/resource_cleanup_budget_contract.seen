import compute.buffer.{GpuBuffer}
import compute.resource_ranges.{GpuRangeSet}
import device_fixture_support.{gpuFixtureRejected}
import resource_fixture_support.{resourceWorld}
import resource_assertions.{allocated}
import provider_fixture_support.{completed}
extern "C" fun seen_memory_used_bytes() r: Int64
extern "C" fun seen_memory_reserved_bytes() r: Int64
extern "C" fun seen_memory_limit_bytes() r: Int64
extern "C" fun seen_memory_set_limit_bytes(bytes: Int64) r: Void

fun main() r: Int {
    let initial = seen_memory_used_bytes(); let world = resourceWorld(512 as UInt64, 32, 2)
    let first = allocated(GpuBuffer<UInt32>.allocate(world.allocator, 4 as UInt64, 4 as UInt64, 16 as UInt64, world.operation))
    let middle = allocated(GpuBuffer<UInt32>.allocate(world.allocator, 4 as UInt64, 4 as UInt64, 16 as UInt64, world.operation))
    let last = allocated(GpuBuffer<UInt32>.allocate(world.allocator, 4 as UInt64, 4 as UInt64, 16 as UInt64, world.operation))
    // Free a middle span with neither adjacent span free. Returning it needs
    // another free-range record, which must already have been admitted.
    let previous = seen_memory_limit_bytes()
    let committed = seen_memory_used_bytes() + seen_memory_reserved_bytes()
    let records = world.allocator.core.blocks[0].ranges.ranges.length()
    // Result uses two bounded array envelopes. Leave only their return-value
    // headroom, below the 4 KiB admission for a new free-range record.
    seen_memory_set_limit_bytes(committed + (512 as Int64))
    let closed = middle.close()
    seen_memory_set_limit_bytes(previous); completed(closed, true)
    if world.allocator.core.blocks[0].ranges.ranges.length() != records or world.allocator.core.allocatedBytes != (32 as UInt64) or world.counts.creates != 1 or world.counts.destroys != 0 {
        abort("GPU buffer cleanup allocated native storage or changed another owner's range")
    }
    completed(first.release(), true); completed(last.release(), true); completed(middle.release(), true)
    world.release()
    let created = GpuRangeSet.create(64 as UInt64, 8)
    if created.isErr() { abort("range metadata fixture construction failed") }
    let ranges = created.unwrap(); created.releaseContainer()
    gpuFixtureRejected(ranges.prepare(0), "gpu.limit")
    gpuFixtureRejected(ranges.prepare(9), "gpu.limit")
    completed(ranges.prepare(1), false)
    let limit = seen_memory_limit_bytes()
    seen_memory_set_limit_bytes(seen_memory_used_bytes() + seen_memory_reserved_bytes() + (4096 as Int64))
    let rejected = ranges.prepare(8)
    seen_memory_set_limit_bytes(limit); gpuFixtureRejected(rejected, "gpu.limit")
    if ranges.ranges.length() != 1 or ranges.freeBytes != (64 as UInt64) {
        abort("rejected GPU range metadata admission mutated free storage")
    }
    completed(ranges.prepare(8), true); completed(ranges.prepare(8), false)
    if ranges.ranges.length() != 8 or ranges.freeBytes != (64 as UInt64) {
        abort("GPU range metadata admission changed the byte partition")
    }
    completed(ranges.close(), true)
    gpuFixtureRejected(ranges.prepare(1), "gpu.invalid")
    completed(ranges.release(), true)
    if seen_memory_used_bytes() != initial { abort("GPU cleanup under an exhausted metadata budget leaked ownership") }
    println("PASS: GPU-006B middle-range destruction uses admitted range metadata with only bounded Result return headroom")
    return 0
}
