import compute.vulkan_stream.{GpuVulkanStream, GpuVulkanEvent}
import compute.memory_kind.{GpuMemoryKind}
import compute.error.{GpuError}
import core.result.{Result}
import vulkan_mapping_fixture_support.{mappingWorldSelected}
import env.env.{args, releaseArgs}
import device_fixture_support.{gpuFixtureRejected}
import provider_fixture_support.{completed}
extern "C" fun seen_memory_used_bytes() r: Int64
extern "C" fun seen_sync_live_atomics() r: UInt64

fun stream(result: Result<GpuVulkanStream, GpuError>) r: GpuVulkanStream {
    if result.isErr() { abort("native timeline stream creation rejected") }
    let owner = result.unwrap(); result.releaseContainer(); return owner
}
fun signal(result: Result<UInt64, GpuError>) r: UInt64 {
    if result.isErr() { abort("native timeline submission rejected") }
    let value = result.unwrap(); result.releaseContainer(); return value
}
fun event(result: Result<GpuVulkanEvent, GpuError>) r: GpuVulkanEvent {
    if result.isErr() { abort("submitted native event creation rejected") }
    let value = result.unwrap(); result.releaseContainer(); return value
}
fun finish(borrow owner: GpuVulkanStream, sequence: UInt64) r: Void {
    var fuel = 100000
    while fuel > 0 {
        let observed = owner.poll(sequence)
        if observed.isErr() { abort("native timeline completion failed") }
        let done = observed.unwrap(); observed.releaseContainer()
        if done { return }
        fuel = fuel - 1
    }
    abort("bounded native timeline poll fuel exhausted")
}
fun main() r: Int {
    let baseline = seen_memory_used_bytes(); let atomics = seen_sync_live_atomics()
    let arguments = args(); var hardware = false
    if arguments.length() == 2 and arguments[1] == "--hardware" { hardware = true }
    else if arguments.length() != 1 { abort("stream fixture accepts only explicit --hardware") }
    let world = mappingWorldSelected(GpuMemoryKind.HostCoherent, hardware); let op = world.operation
    let a = stream(GpuVulkanStream.open(world.allocator, 2, op))
    let b = stream(GpuVulkanStream.open(world.allocator, 2, op))
    let steady = seen_memory_used_bytes(); var cycle = 0
    while cycle < 100 {
        let sequence = signal(a.signal(op))
        if sequence != ((cycle + 1) as UInt64) { abort("native stream signal is not monotone") }
        let dependency = event(a.event(sequence, op))
        let after = signal(b.wait(dependency, op))
        if after != sequence or a.core.waitBorrowers != 1 or a.core.eventBorrowers != 1 { abort("native dependency admission lost timeline ownership") }
        completed(dependency.close(), true); completed(dependency.close(), false)
        completed(dependency.release(), true)
        // Even a completed source cannot destroy the semaphore borrowed by b.
        finish(a, sequence)
        gpuFixtureRejected(a.close(), "gpu.busy"); gpuFixtureRejected(b.close(), "gpu.busy")
        op.cancellation = true; finish(b, after); op.cancellation = false
        if a.core.waitBorrowers != 0 or a.core.eventBorrowers != 0 or a.core.inFlight != 0 or b.core.inFlight != 0 {
            abort("native completion did not retire cross-stream timeline borrowers")
        }
        completed(a.poll(sequence), true); completed(b.poll(after), true)
        if seen_memory_used_bytes() != steady { abort("reused native stream slots allocated persistent submission metadata") }
        cycle = cycle + 1
    }
    // Native destination completion itself implies the source signal completed.
    let sequence = signal(a.signal(op)); let dependency = event(a.event(sequence, op))
    let after = signal(b.wait(dependency, op)); finish(b, after)
    completed(dependency.poll(), true)
    gpuFixtureRejected(a.close(), "gpu.busy")
    completed(dependency.release(), true)
    let selfEvent = event(b.event(after, op)); let own = signal(b.wait(selfEvent, op))
    completed(selfEvent.release(), true); finish(b, own)
    completed(a.core.retain(op), true); gpuFixtureRejected(a.close(), "gpu.busy"); a.core.dropBorrow()
    completed(a.close(), true); completed(a.close(), false); completed(a.release(), true)
    completed(b.close(), true); completed(b.close(), false); completed(b.release(), true)
    world.release(); releaseArgs(arguments)
    if seen_memory_used_bytes() != baseline or seen_sync_live_atomics() != atomics { abort("native timeline lifecycle retained Seen ownership") }
    println("PASS: GPU-006D native timeline ordering cross-stream retention bounded slot reuse cancellation and exact cold cleanup")
    return 0
}
