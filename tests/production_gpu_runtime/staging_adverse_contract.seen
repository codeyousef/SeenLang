import compute.staging_ring.{GpuStagingRing, GpuStagingSlice, GPU_STAGING_MAX_SEQUENCE}
import compute.limits.{GPU_MAX_RESOURCES, GPU_MAX_MEMORY_BYTES}
import compute.error.{GpuError}
import core.result.{Result}
import device_fixture_support.{operation, releaseOperation, gpuFixtureRejected}
import provider_fixture_support.{completed}
import staging_fixture_support.{ring, claimed, rejected}
extern "C" fun seen_memory_used_bytes() r: Int64
extern "C" fun seen_memory_reserved_bytes() r: Int64
extern "C" fun seen_memory_limit_bytes() r: Int64
extern "C" fun seen_memory_set_limit_bytes(bytes: Int64) r: Void

fun rejectedRing(result: Result<GpuStagingRing, GpuError>) r: Void {
    if result.isOkay() { abort("unbounded staging owner admitted") }
    let error = result.unwrapErr(); result.releaseContainer()
    if error.code != "gpu.limit" or error.retryable { abort("staging creation limit diagnostic changed") }
    error.release()
}
fun rejectedSignal(result: Result<UInt64, GpuError>, code: String) r: Void {
    if result.isOkay() { abort("invalid staging submission signal admitted") }
    let error = result.unwrapErr(); result.releaseContainer()
    if error.code != code or error.retryable { abort("staging signal diagnostic changed") }
    error.release()
}
fun main() r: Int {
    let baseline = seen_memory_used_bytes()
    rejectedRing(GpuStagingRing.create(64 as UInt64, 0))
    rejectedRing(GpuStagingRing.create(64 as UInt64, GPU_MAX_RESOURCES + 1))
    rejectedRing(GpuStagingRing.create(0 as UInt64, 1))
    rejectedRing(GpuStagingRing.create(GPU_MAX_MEMORY_BYTES + (1 as UInt64), 1))
    let limit = seen_memory_limit_bytes()
    seen_memory_set_limit_bytes(seen_memory_used_bytes() + seen_memory_reserved_bytes() + (8192 as Int64))
    let exhausted = GpuStagingRing.create(64 as UInt64, 1)
    seen_memory_set_limit_bytes(limit); rejectedRing(exhausted)

    let op = operation(); let owner = ring(64 as UInt64, 2)
    op.cancellation = true; rejected(owner.reserve(1 as UInt64, 1 as UInt64, op), "gpu.cancelled")
    op.cancellation = false; op.monotonicDeadline = -1 as Int64
    rejected(owner.reserve(1 as UInt64, 1 as UInt64, op), "gpu.timeout")
    op.monotonicDeadline = 9223372036854775807 as Int64
    rejected(owner.reserve(0 as UInt64, 1 as UInt64, op), "gpu.invalid")
    rejected(owner.reserve(1 as UInt64, 3 as UInt64, op), "gpu.invalid")
    rejected(owner.reserve(65 as UInt64, 1 as UInt64, op), "gpu.limit")
    seen_memory_set_limit_bytes(seen_memory_used_bytes() + seen_memory_reserved_bytes() + (4095 as Int64))
    let noMetadata = owner.reserve(1 as UInt64, 1 as UInt64, op)
    seen_memory_set_limit_bytes(limit); rejected(noMetadata, "gpu.limit")
    let full = claimed(owner.reserve(64 as UInt64, 1 as UInt64, op))
    rejected(owner.reserve(1 as UInt64, 1 as UInt64, op), "gpu.limit")
    if owner.core.borrowers != 1 or owner.core.inFlight != 0 or owner.core.occupiedBytes != (64 as UInt64) { abort("failed staging admission mutated live storage") }
    completed(full.submitted(1 as UInt64), true)
    rejectedSignal(full.nextSignal(), "gpu.invalid")
    let generation = full.generation; full.generation = generation + (1 as UInt64)
    if full.isComplete() { abort("stale staging ticket reported completion") }
    rejectedSignal(full.nextSignal(), "gpu.invalid"); gpuFixtureRejected(full.close(), "gpu.invalid")
    full.generation = generation
    gpuFixtureRejected(owner.core.closeSlot(-1, generation), "gpu.invalid")
    // Cancellation cannot reclaim bytes that a native submission may use.
    op.cancellation = true; gpuFixtureRejected(full.close(), "gpu.busy")
    if owner.core.occupiedBytes != (64 as UInt64) or owner.core.inFlight != 1 { abort("cancelled staging work released pending native storage") }
    completed(owner.complete(1 as UInt64), true); completed(full.close(), true)
    if full.isComplete() { abort("inactive staging ticket consulted its old slot") }
    rejectedSignal(full.nextSignal(), "gpu.invalid"); completed(full.release(), true)
    op.cancellation = false
    let retired = claimed(owner.reserve(1 as UInt64, 1 as UInt64, op))
    owner.core.lastSubmitted = GPU_STAGING_MAX_SEQUENCE; owner.core.lastCompleted = GPU_STAGING_MAX_SEQUENCE
    rejectedSignal(retired.nextSignal(), "gpu.limit")
    gpuFixtureRejected(retired.submitted(GPU_STAGING_MAX_SEQUENCE), "gpu.limit")
    completed(retired.release(), true)
    // Retired generation slots must never wrap into a previously issued ticket.
    owner.core.slots[0].generation = GPU_STAGING_MAX_SEQUENCE
    owner.core.slots[1].generation = GPU_STAGING_MAX_SEQUENCE
    rejected(owner.reserve(1 as UInt64, 1 as UInt64, op), "gpu.limit")
    completed(owner.release(), true); releaseOperation(op)
    if seen_memory_used_bytes() != baseline { abort("staging cancellation limits or retired counters leaked ownership") }
    println("PASS: GPU-006C staging cancellation pending ownership budgets stale handles and counter retirement")
    return 0
}
