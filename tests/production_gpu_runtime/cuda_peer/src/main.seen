import compute.cuda_peer.{GpuCudaPeerCapability, GpuCudaPeerLink}
import compute.cuda_device_transfer.{GpuCudaDeviceTransfer}
import compute.cuda_staging.{GpuCudaStagingRing, GpuCudaStagingTicket, gpuCudaStagingUpload, gpuCudaStagingDownload}
import compute.error.{GpuError}
import core.result.{Result}
import core.option.{Option, Some, None}
import core.operation_context.{OperationContext, OperationLimits}
import core.error.{AsciiString}
import inference.span.{Span, MutableSpan}
import memory.aligned_buffer.{OwnedBuffer}
import env.env.{args, releaseArgs}
extern "C" fun seen_memory_used_bytes() r: Int64
extern "C" fun seen_sync_live_atomics() r: UInt64

fun peerTake<T>(result: Result<T, GpuError>) r: T {
    if result.isErr() { let error = result.unwrapErr(); println(error.code); println(error.operation); println(error.message); abort("CUDA peer transport failed") }
    let value = result.unwrap(); result.releaseContainer(); return value
}
fun peerDone(result: Result<Bool, GpuError>, expected: Bool) r: Void {
    if peerTake<Bool>(result) != expected { abort("CUDA peer completion state differs") }
}
fun peerReject<T>(result: Result<T, GpuError>, code: String) r: Void {
    if result.isOkay() { abort("invalid CUDA peer operation succeeded") }
    let error = result.unwrapErr(); result.releaseContainer()
    if error.code != code { println(error.code); abort("CUDA peer error classification differs") }; error.release()
}
fun peerReady(borrow ticket: GpuCudaStagingTicket) r: Void {
    var fuel = 0
    while fuel < 1000000 { let ready = peerTake<Bool>(ticket.poll()); if ready { return }; fuel = fuel + 1 }
    abort("CUDA native ticket did not retire within bounded observations")
}
fun peerCopy(sourceDevice: Int32, destinationDevice: Int32, link: Option<GpuCudaPeerLink>, op: OperationContext, fault: Bool) r: Void {
    let source = peerTake<GpuCudaStagingRing>(GpuCudaStagingRing.prepare(64 as UInt64, 2, 4096 as UInt64))
    let destination = peerTake<GpuCudaStagingRing>(GpuCudaStagingRing.prepare(64 as UInt64, 2, 4096 as UInt64))
    peerDone(source.open(sourceDevice, op), true); peerDone(destination.open(destinationDevice, op), true)
    let allocated = OwnedBuffer<UInt8>.allocate(128 as UInt64, 1 as UInt64, 64 as UInt64)
    if allocated.isErr() { abort("CUDA transfer host oracle storage unavailable") }
    let host = allocated.unwrap(); allocated.releaseContainer()
    var cycle = 0
    while cycle < 40 {
        let upload = peerTake<GpuCudaStagingTicket>(source.reserve(64 as UInt64, op))
        let received = peerTake<GpuCudaStagingTicket>(destination.reserve(29 as UInt64, op))
        var i = 0; while i < 64 { host.data[i] = ((i * 7 + 193 + cycle * 11) % 256) as UInt8; i = i + 1 }
        peerDone(upload.write(Span<UInt8>{data: host.data as *const UInt8, length: 64 as UInt64}, 0 as UInt64, op), true)
        peerDone(gpuCudaStagingUpload(upload, op), true); peerReady(upload)
        var access: Option<GpuCudaPeerLink> = None<GpuCudaPeerLink>()
        if link.isSome() { access.free(); access = Some<GpuCudaPeerLink>(link.unwrap()) }
        let transfer = peerTake<GpuCudaDeviceTransfer>(GpuCudaDeviceTransfer.prepare(received, upload, 11 as UInt64, access, op))
        peerReject<Bool>(upload.close(), "gpu.busy"); peerReject<Bool>(received.close(), "gpu.busy")
        if link.isSome() { peerReject<Bool>(link.unwrap().close(), "gpu.busy") }
        op.cancellation = true; peerReject<Bool>(transfer.start(op), "gpu.cancelled"); op.cancellation = false
        op.monotonicDeadline = -1 as Int64; peerReject<Bool>(transfer.start(op), "gpu.timeout"); op.monotonicDeadline = 9223372036854775807 as Int64
        let started = transfer.start(op)
        if fault {
            if started.isOkay() { abort("native second-copy fault did not reach transfer admission") }
            let error = started.unwrapErr(); started.releaseContainer()
            if error.code != "gpu.unavailable" or error.progress == (0 as UInt64) or not transfer.pending { abort("uncertain CUDA copy lost typed error or retained progress") }; error.release()
            peerReject<Bool>(transfer.close(), "gpu.busy")
            var fuel = 0
            while transfer.pending and fuel < 1000000 { peerReject<Bool>(transfer.poll(), "gpu.unavailable"); fuel = fuel + 1 }
            if transfer.pending or source.core.poisoned { abort("failed destination transfer detached work or poisoned independent source") }
        } else {
            peerDone(started, true); peerReject<Bool>(transfer.close(), "gpu.busy")
            op.cancellation = true; op.monotonicDeadline = -1 as Int64
            var complete = false; var fuel = 0
            while not complete and fuel < 1000000 { complete = peerTake<Bool>(transfer.poll()); fuel = fuel + 1 }
            op.cancellation = false; op.monotonicDeadline = 9223372036854775807 as Int64
            if not complete { abort("CUDA device transfer did not retire within bounded fuel") }
            peerReject<Bool>(transfer.start(op), "gpu.invalid")
        }
        peerReject<Bool>(upload.close(), "gpu.busy"); peerReject<Bool>(received.close(), "gpu.busy")
        peerDone(transfer.close(), true); peerDone(transfer.close(), false); peerDone(transfer.release(), true)
        // A destination failure must leave source bytes and its own stream usable.
        var download: GpuCudaStagingTicket = received
        if fault { download = peerTake<GpuCudaStagingTicket>(source.reserve(29 as UInt64, op)); peerDone(gpuCudaStagingDownload(download, upload, 11 as UInt64, op), true) }
        else { download = peerTake<GpuCudaStagingTicket>(destination.reserve(29 as UInt64, op)); peerDone(gpuCudaStagingDownload(download, received, 0 as UInt64, op), true) }
        peerReady(download)
        i = 64; while i < 128 { host.data[i] = 173 as UInt8; i = i + 1 }
        peerDone(download.read(MutableSpan<UInt8>{data: ((host.data as UInt64) + (67 as UInt64)) as *UInt8, length: 29 as UInt64}, 0 as UInt64, op), true)
        i = 64; while i < 128 { var expected = 173; if i >= 67 and i < 96 { expected = ((i - 67 + 11) * 7 + 193 + cycle * 11) % 256 }; if host.data[i] != (expected as UInt8) { abort("CUDA device transport byte oracle or canary differs") }; i = i + 1 }
        peerDone(download.release(), true); peerDone(received.release(), true); peerDone(upload.release(), true)
        if fault { break }; cycle = cycle + 1
    }
    host.close(); host.free(); peerDone(source.release(), true); peerDone(destination.release(), true); link.free()
}
fun peerInvalidActivation(count: Int32, op: OperationContext) r: Void {
    // Synthetic NEGATIVE owner metadata bypasses capability admission solely to
    // exercise the actual SDK's invalid-ordinal enable failure on one GPU.
    // This is not native capability data or positive physical peer-route proof.
    let malformed = GpuCudaPeerCapability{sourceDevice: count, destinationDevice: 0 as Int32,
        nativeDeviceCount: count, sameDevice: false, canAccessPeer: true}
    let peer = peerTake<GpuCudaPeerLink>(GpuCudaPeerLink.prepare(malformed)); malformed.free()
    let opened = peer.open(op)
    if opened.isOkay() { abort("invalid native peer ordinal unexpectedly enabled access") }
    let error = opened.unwrapErr(); opened.releaseContainer()
    if error.code != "gpu.invalid" or error.operation != "gpu.cuda.peer.open" or error.progress != (0 as UInt64) or
        error.nativeCode.isNone() or error.nativeCode.unwrap() != (101 as Int64) {
        abort("failed peer activation lost original native invalid-device status")
    }
    error.release()
    // enabled is the real admission predicate used by transfer prepare/start.
    // Failed acquisition must retain a cleanup owner without authorizing copies.
    if not peer.started or peer.enabled or peer.closed or peer.borrowers != 0 {
        abort("failed peer activation was exposed as a confirmed active route")
    }
    peerReject<Bool>(peer.open(op), "gpu.invalid")
    // The isolated interposer forwards the native disable, then injects 705.
    // This checks cleanup-state handling, not actual physical peer cleanup.
    peerDone(peer.close(), true); peerDone(peer.close(), false)
    if peer.enabled or not peer.closed { abort("705 cleanup retained peer admission") }
    peerDone(peer.release(), true)
}
fun main() r: Int {
    let baseline = seen_memory_used_bytes(); let atomics = seen_sync_live_atomics(); let arguments = args()
    if arguments.length() < 2 or arguments.length() > 3 { abort("CUDA peer fixture requires a mode and optional expected capability error") }
    let fault = arguments[1] == "copy-second-error"; let capabilityFault = arguments.length() == 3
    let activationFault = arguments[1] == "peer-enable-invalid"
    if capabilityFault { if not arguments[1].startsWith("peer-") { abort("unknown CUDA capability fault mode") } }
    else if not fault and not activationFault and arguments[1] != "reference" { abort("unknown CUDA peer mode") }
    let op = OperationContext{cancellation: false, monotonicDeadline: 9223372036854775807 as Int64,
        limits: OperationLimits{maxTargets: 8, maxIdentityBytes: 128, maxVersionBytes: 128, maxManifestBytes: 4096, maxPathBytes: 4095, maxGraphModules: 8, maxGraphEdges: 16, maxGraphDepth: 4}, traceId: AsciiString{value: "cuda-peer-fixture"}}
    peerReject<GpuCudaPeerCapability>(GpuCudaPeerCapability.query(-1 as Int32, 0 as Int32, op), "gpu.invalid")
    op.cancellation = true; peerReject<GpuCudaPeerCapability>(GpuCudaPeerCapability.query(0 as Int32, 0 as Int32, op), "gpu.cancelled"); op.cancellation = false
    if capabilityFault {
        let queried = GpuCudaPeerCapability.query(0 as Int32, 0 as Int32, op)
        if queried.isOkay() { abort("malformed native capability was accepted") }
        let error = queried.unwrapErr(); queried.releaseContainer()
        if error.code != arguments[2] or error.progress != (0 as UInt64) { println(error.code); abort("native CUDA capability failure classification differs") }
        if arguments[1] == "peer-query-error" { if error.nativeCode.isNone() or error.nativeCode.unwrap() != (999 as Int64) { abort("CUDA capability error lost original native status") } }
        if arguments[1] == "peer-query-oom" { if error.nativeCode.isNone() or error.nativeCode.unwrap() != (2 as Int64) { abort("CUDA capability OOM lost original native status") } }
        error.release(); op.traceId.free(); op.limits.free(); op.free(); releaseArgs(arguments)
        if seen_memory_used_bytes() != baseline or seen_sync_live_atomics() != atomics { abort("capability rejection retained Seen owners") }
        println("PASS: actual SDK capability adverse reply rejected with typed error and exact owner drain")
        return 0
    }
    let local = peerTake<GpuCudaPeerCapability>(GpuCudaPeerCapability.query(0 as Int32, 0 as Int32, op))
    if not local.sameDevice or local.canAccessPeer or local.nativeDeviceCount < (1 as Int32) { abort("same-device memory was misrepresented as native peer capability") }
    let count = local.nativeDeviceCount
    peerReject<GpuCudaPeerLink>(GpuCudaPeerLink.prepare(local), "gpu.unsupported_capability"); local.free()
    peerReject<GpuCudaPeerCapability>(GpuCudaPeerCapability.query(0 as Int32, count, op), "gpu.invalid")
    if activationFault { peerInvalidActivation(count, op) }
    else { peerCopy(0 as Int32, 0 as Int32, None<GpuCudaPeerLink>(), op, fault) }
    if not fault and not activationFault and count > (1 as Int32) {
        let capability = peerTake<GpuCudaPeerCapability>(GpuCudaPeerCapability.query(0 as Int32, 1 as Int32, op))
        if capability.canAccessPeer {
            let peer = peerTake<GpuCudaPeerLink>(GpuCudaPeerLink.prepare(capability)); peerDone(peer.open(op), true)
            peerCopy(0 as Int32, 1 as Int32, Some<GpuCudaPeerLink>(peer), op, false); peerDone(peer.release(), true)
            println("CLASSIFICATION: distinct-device native CUDA peer transfer executed")
        } else { println("CLASSIFICATION: SDK reports distinct-device peer access unsupported; no peer copy or fallback scheduled") }
        capability.free()
    } else if not fault and not activationFault { println("CLASSIFICATION: one physical CUDA device; distinct-device peer-positive path not executed") }
    op.traceId.free(); op.limits.free(); op.free(); releaseArgs(arguments)
    if seen_memory_used_bytes() != baseline or seen_sync_live_atomics() != atomics { abort("CUDA peer transport retained Seen owners") }
    if activationFault { println("PASS: actual SDK invalid-ordinal enable remains inadmissible; cleanup 705 is injected, not physical peer evidence") }
    else { println("PASS: actual CUDA cross-ring byte transfer, capability classification, cancellation, retained owners and failure isolation") }
    return 0
}
