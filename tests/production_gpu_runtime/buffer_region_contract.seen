import compute.buffer.{GpuBuffer}
import buffer_region_fixture_support.{region, rejectedRegion}
import resource_fixture_support.{resourceWorld}
import resource_assertions.{allocated}
import provider_fixture_support.{completed}
import device_fixture_support.{gpuFixtureRejected}
extern "C" fun seen_memory_used_bytes() r: Int64
fun main() r: Int {
    let baseline = seen_memory_used_bytes(); let world = resourceWorld(512 as UInt64, 32, 2)
    let buffer = allocated(GpuBuffer<UInt32>.allocate(world.allocator, 8 as UInt64, 4 as UInt64, 16 as UInt64, world.operation))
    let before = world.device.core.resourceBorrowers
    let first = region(buffer.region(0 as UInt64, 16 as UInt64, false, world.operation))
    let second = region(buffer.region(16 as UInt64, 16 as UInt64, false, world.operation))
    gpuFixtureRejected(buffer.close(), "gpu.busy")
    rejectedRegion(buffer.region(0 as UInt64, 1 as UInt64, true, world.operation), "gpu.busy")
    completed(first.release(), true); completed(second.release(), true)
    let writer = region(buffer.region(1 as UInt64, 31 as UInt64, true, world.operation))
    rejectedRegion(buffer.region(0 as UInt64, 1 as UInt64, false, world.operation), "gpu.busy")
    rejectedRegion(buffer.region(0 as UInt64, 1 as UInt64, true, world.operation), "gpu.busy")
    if writer.offset != (1 as UInt64) or writer.bytes != (31 as UInt64) or not writer.valid() { abort("GPU byte region geometry or owning lease changed") }
    completed(writer.close(), true); completed(writer.close(), false)
    rejectedRegion(buffer.region(33 as UInt64, 1 as UInt64, false, world.operation), "gpu.invalid")
    rejectedRegion(buffer.region(0 as UInt64, 0 as UInt64, false, world.operation), "gpu.invalid")
    rejectedRegion(buffer.region(31 as UInt64, 2 as UInt64, false, world.operation), "gpu.invalid")
    world.operation.cancellation = true
    rejectedRegion(buffer.region(0 as UInt64, 1 as UInt64, false, world.operation), "gpu.cancelled")
    world.operation.cancellation = false
    if world.device.core.resourceBorrowers != before { abort("GPU region rejection leaked a resource lease") }
    completed(buffer.release(), true); world.release()
    completed(writer.close(), false); completed(writer.release(), true)
    if seen_memory_used_bytes() != baseline { abort("GPU region lifecycle leaked Seen ownership") }
    println("PASS: GPU-006C byte regions enforce geometry aliasing global leases and buffer shutdown order")
    return 0
}
