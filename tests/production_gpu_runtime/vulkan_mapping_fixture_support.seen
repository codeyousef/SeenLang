import compute.vulkan_provider.{GpuVulkanProvider, openVulkanDevice}
import compute.device.{GpuDevice, GpuContext}
import compute.allocator.{GpuAllocator}
import compute.memory_kind.{GpuMemoryKind}
import compute.limits.{GpuLimits}
import compute.device_info.{GpuDeviceKind}
import core.operation_context.{OperationContext}
import device_fixture_support.{operation, releaseOperation}
import provider_fixture_support.{completed}

class VulkanMappingWorld {
    var operation: OperationContext
    var limits: GpuLimits
    var device: GpuDevice
    var context: GpuContext
    var allocator: GpuAllocator
    fun release() r: Void {
        completed(this.allocator.release(), true)
        completed(this.context.release(), true); completed(this.device.release(), true)
        this.limits.release(); releaseOperation(this.operation); this.free()
    }
}
fun mappingWorld(kind: GpuMemoryKind) r: VulkanMappingWorld {
    return mappingWorldSelected(kind, false)
}
fun mappingHardwareWorld(kind: GpuMemoryKind) r: VulkanMappingWorld {
    return mappingWorldSelected(kind, true)
}
fun mappingWorldSelected(kind: GpuMemoryKind, hardware: Bool) r: VulkanMappingWorld {
    let op = operation(); let limits = GpuLimits.bounded(4, 2, 64, 1048576 as UInt64)
    let discovered = GpuVulkanProvider.discover(op, limits, not hardware)
    if discovered.isErr() { abort("explicit Vulkan reference unavailable") }
    let provider = discovered.unwrap(); discovered.releaseContainer()
    var selected = 0
    if hardware {
        selected = -1; var index = 0
        while index < provider.catalog.devices.length() {
            let info = provider.catalog.devices[index]
            if info.kind == GpuDeviceKind.Discrete and info.name.contains("RTX 4090") { selected = index }
            index = index + 1
        }
        if selected < 0 { abort("designated RTX 4090 hardware is unavailable; no fallback permitted") }
    }
    let opened = openVulkanDevice(provider, selected, op)
    if opened.isErr() { abort("explicit Vulkan reference open failed") }
    let device = opened.unwrap(); opened.releaseContainer()
    if hardware { println(device.core.info.name); println(device.core.info.identity.uuid) }
    let created = device.createContext(op)
    if created.isErr() { abort("Vulkan mapping context failed") }
    let context = created.unwrap(); created.releaseContainer()
    let pooled = GpuAllocator.create(context, kind, 1024 as UInt64, 2, op)
    if pooled.isErr() { abort("Vulkan staging allocator unavailable") }
    let allocator = pooled.unwrap(); pooled.releaseContainer()
    return VulkanMappingWorld{operation: op, limits: limits, device: device, context: context, allocator: allocator}
}
