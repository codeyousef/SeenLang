import env.env.{args, releaseArgs}
import fs.types.{OpenOptions}
import io.completion_types.{IoQueueLimits, IoOperation, IoRegistration, IoCompletion}
import io.macos_positional.{MacPositionalQueue}
import io.macos_file.{MacCachePolicy, macosOpenHandle}
import async.structured.{AsyncOperationContext}
import async.executor_core.{executorReleaseContext}
import memory.aligned_buffer.{OwnedBuffer}
import fixture_support.{ioMust, ioRequire, ioContext}
import sync.contracts.{seen_time_monotonic_nanos}
extern "C" fun seen_memory_used_bytes() r: Int64
fun macosAwait(borrow queue: MacPositionalQueue) r: Void {
    let start = seen_time_monotonic_nanos(); ioRequire(start >= (0 as Int64) and start <= (9223372031854775807 as Int64))
    let deadline = start + (5000000000 as Int64); var now = start
    while queue.worker.core.nativeActive != 0 {
        ioMust(queue.publishCancellation()); ioMust(queue.reap(queue.worker.core.capacity))
        let next = seen_time_monotonic_nanos(); ioRequire(next >= now and next < deadline); now = next
    }
}
fun macosTake(borrow queue: MacPositionalQueue) r: IoCompletion {
    let ready = queue.poll(); ioRequire(ready.isSome()); let completion = ready.unwrap(); ready.free(); return completion
}
fun macosNativeReserve(borrow queue: MacPositionalQueue, path: String, borrow options: OpenOptions,
    context: AsyncOperationContext, block: Int, write: Bool, policy: MacCachePolicy) r: IoRegistration {
    let buffer: OwnedBuffer<UInt8> = ioMust(OwnedBuffer<UInt8>.allocate(64 as UInt64, 1 as UInt64, 16 as UInt64))
    var i = 0; while i < 64 { buffer.data[i] = 0 as UInt8; if write { buffer.data[i] = ((i + block * 17) % 256) as UInt8 }; i = i + 1 }
    var operation = IoOperation.Read; if write { operation = IoOperation.Write }
    return ioMust(queue.reserveFile(path, options, buffer, operation, (block * 16) as Int64, 16 as UInt64, context, policy))
}
fun macosNativeRound(borrow queue: MacPositionalQueue, path: String, borrow options: OpenOptions,
    context: AsyncOperationContext, write: Bool, cancel: Bool, policy: MacCachePolicy) r: Void {
    let first = macosNativeReserve(queue, path, options, context, 0, write, policy)
    let second = macosNativeReserve(queue, path, options, context, 1, write, policy)
    ioMust(queue.submit(first.token)); ioMust(queue.submit(second.token)); ioRequire(queue.worker.core.nativeActive == 2)
    if cancel { ioMust(queue.cancel(first.token)); ioMust(queue.cancel(second.token)) }
    macosAwait(queue); var delivered = 0
    while delivered < 2 {
        let completion = macosTake(queue); let outcome = completion.outcome()
        ioRequire(completion.token == first.token or completion.token == second.token)
        if cancel { ioRequire(outcome.isErr() and outcome.unwrapErr().code == "async.cancelled"); outcome.unwrapErr().free() }
        else {
            ioRequire(outcome.isOkay() and outcome.unwrap() == (16 as UInt64))
            if not write {
                let block = (completion.request.fileOffset / (16 as Int64)) as Int; var i = 0
                while i < 16 { ioRequire(completion.request.resources.buffer.data[i] == (((i + block * 17) % 256) as UInt8)); i = i + 1 }
            }
        }
        outcome.releaseContainer(); ioMust(completion.release()); delivered = delivered + 1
    }
    first.free(); second.free()
}
fun main() r: Int {
    let arguments = args(); if arguments.length() != 2 { releaseArgs(arguments); return 2 }
    let context = ioContext(); let limits = IoQueueLimits{depth: 2, maxTransferBytes: 64 as UInt64, maxOwnedBytes: 128 as UInt64, maxMetadataBytes: 8192 as UInt64}
    let baseline = seen_memory_used_bytes(); let created = MacPositionalQueue.create(limits, 2, 262144 as UInt64, context)
    if created.isErr() {
        let error = created.unwrapErr(); created.releaseContainer(); ioRequire(error.code == "async.unsupported_platform"); error.free()
        ioRequire(seen_memory_used_bytes() == baseline); limits.free(); executorReleaseContext(context); releaseArgs(arguments)
        println("{\"schema\":\"seen-io-macos-v1\",\"backend\":\"macos-positional-workers\",\"classification\":\"unsupported\",\"fallback_count\":0}")
        return 0
    }
    let queue: MacPositionalQueue = created.unwrap(); created.releaseContainer(); limits.free()
    let options = OpenOptions.createNew(); let file = ioMust(macosOpenHandle(arguments[1], options, IoOperation.Write, MacCachePolicy.Cached))
    ioMust(file.close()); file.free(); options.create = false; options.exclusive = false
    macosNativeRound(queue, arguments[1], options, context, true, false, MacCachePolicy.Cached)
    macosNativeRound(queue, arguments[1], options, context, false, false, MacCachePolicy.UncachedRequired)
    macosNativeRound(queue, arguments[1], options, context, false, true, MacCachePolicy.Cached)
    let live = seen_memory_used_bytes(); var index = 0
    while index < 100 {
        var policy = MacCachePolicy.Cached; if index % 2 == 1 { policy = MacCachePolicy.UncachedRequired }
        macosNativeRound(queue, arguments[1], options, context, false, index % 3 == 0, policy)
        ioRequire(seen_memory_used_bytes() == live); index = index + 1
    }
    ioMust(queue.close()); ioMust(queue.close()); ioMust(queue.release()); options.free(); executorReleaseContext(context); releaseArgs(arguments)
    println("PASS: IO-002D native positional cached F_NOCACHE cancellation and cleanup")
    println("{\"schema\":\"seen-io-macos-v1\",\"backend\":\"macos-positional-workers\",\"classification\":\"verified\",\"workers\":2,\"nocache_required\":true,\"native_overlap_verified\":false,\"fallback_count\":0}")
    return 0
}
