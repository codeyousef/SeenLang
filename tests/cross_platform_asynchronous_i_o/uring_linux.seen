    let queue: LinuxUringQueue = created.unwrap(); created.releaseContainer(); limits.free()
    let context = ioContext(); let path: Path = ioMust(Path.fromString(arguments[1])); let options = OpenOptions.createNew()
    let file: File = ioMust(File.open(context.operation, path, options, DirectIoPolicy.Off)); options.free()
    uringNativeRound(queue, file, context, true, false); uringNativeRound(queue, file, context, false, false)
    uringNativeRound(queue, file, context, false, true)
    let live = seen_memory_used_bytes(); var i = 0
    while i < 100 {
        uringNativeRound(queue, file, context, false, i % 2 == 1)
        ioRequire(seen_memory_used_bytes() == live); i = i + 1
    }
    let independent: IoRegistration = ioMust(queue.reserve(uringNativeRequest(file, context, 0, false)))
    ioMust(file.close()); ioRequire(ioErrorIs(uringFileHandle(file), "async.invalid"))
    ioMust(queue.submit(independent.token)); uringAwait(queue)
    let independentResult = ioTake(queue.core)
    ioRequire(ioMust(independentResult.outcome()) == (4096 as UInt64)); ioMust(independentResult.release()); independent.free()
    let notification = ioMust(queue.notificationLease()); ioMust(queue.drainNotification())
    ioRequire(ioErrorIs(queue.close(), "async.limit")); ioRequire(notification.release())
    ioMust(queue.close()); ioMust(queue.close()); ioMust(queue.release())
    file.directIo.free(); file.path.raw.free(); file.path.free(); file.free()
    executorReleaseContext(context); uringReleaseArguments(arguments)
    println("PASS: IO-002B native positional writes reads cancellation notification and repeated cleanup")
    println("{\"schema\":\"seen-io-uring-v1\",\"backend\":\"io_uring\",\"classification\":\"verified\",\"scope\":\"linux-file-contract\",\"submission_overlap\":2,\"native_overlap_verified\":false,\"fallback_count\":0}")
    return 0
}
