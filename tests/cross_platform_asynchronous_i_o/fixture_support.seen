import core.result.{Result}
import core.error.{AsciiString}
import core.operation_context.{OperationContext, OperationLimits}
import async.structured.{AsyncError, AsyncLimits, AsyncOperationContext}
import async.process_native.{seen_async_process_pipe}
import reactor.reactor.{OwnedHandle}
import memory.aligned_buffer.{OwnedBuffer}
import io.completion_types.{IoRequest, IoOperation, IoCompletion, IoRegistration, IoRejectedSubmission}
import io.completion_queue.{IoQueue}
fun ioRequire(value: Bool) r: Void { if not value { abort("completion I/O contract failed") } }
fun ioMust<T,E>(result: Result<T,E>) r: T {
    if result.isErr() { abort("completion I/O fixture failed") }
    let value = result.unwrap(); result.releaseContainer(); return value
}
fun ioErrorIs<T>(result: Result<T,AsyncError>, expected: String) r: Bool {
    if result.isOkay() { result.releaseContainer(); return false }
    let error = result.unwrapErr(); result.releaseContainer()
    let matches = error.code == expected; error.free(); return matches
}
fun ioContext() r: AsyncOperationContext {
    return AsyncOperationContext{operation: OperationContext{cancellation: false,
        monotonicDeadline: 9223372036854775807 as Int64,
        limits: OperationLimits{maxTargets: 8, maxIdentityBytes: 128, maxVersionBytes: 128,
            maxManifestBytes: 4096, maxPathBytes: 4095, maxGraphModules: 8, maxGraphEdges: 16, maxGraphDepth: 4},
        traceId: AsciiString{value: "completion-contract"}}, resourceId: "io-contract",
        fallbackPolicy: 0, limits: AsyncLimits.bounded(16, 16, 8, 8, 128)}
}
// The contract harness uses real owned Linux pipe descriptors, but simulates
// native submission/acknowledgement. It does not claim file I/O or OS overlap.
fun ioFixtureRequest(context: AsyncOperationContext) r: IoRequest {
    var input = -1 as Int64; var output = -1 as Int64
    ioRequire(seen_async_process_pipe(0 as Int32, &input, &output) == (0 as Int32))
    let writer = OwnedHandle{native: output, owned: true, valid: true}
    ioMust(writer.close()); writer.free()
    let buffer: OwnedBuffer<UInt8> = ioMust(OwnedBuffer<UInt8>.allocate(64 as UInt64, 1 as UInt64, 16 as UInt64))
    return IoRequest.create(OwnedHandle{native: input, owned: true, valid: true}, buffer,
        IoOperation.Read, 0 as Int64, 16 as UInt64, context)
}

fun ioTake(borrow queue: IoQueue) r: IoCompletion {
    let ready = queue.poll(); ioRequire(ready.isSome())
    let completion = ready.unwrap(); ready.free(); return completion
}

fun ioRejectAndRelease(result: Result<IoRegistration, IoRejectedSubmission>, expected: String) r: Void {
    ioRequire(result.isErr())
    let returned: IoRejectedSubmission = result.unwrapErr(); result.releaseContainer()
    ioRequire(returned.error.code == expected); ioMust(returned.release())
}
