import io.completion_bytes.{completionWrite32}
import io.uring_layout.{UringLayout}
import fixture_support.{ioRequire}
import uring_fixture_support.{uringFixtureParameters}
extern "C" fun seen_time_monotonic_nanos() r: Int64
extern "C" fun seen_memory_used_bytes() r: Int64
fun main() r: Int {
    let parameters = uringFixtureParameters(); let baseline = seen_memory_used_bytes()
    let start = seen_time_monotonic_nanos()
    if start < (0 as Int64) or start > (9223371976854775807 as Int64) { return 1 }
    let deadline = start + (60000000000 as Int64); var now = start; var seed = 1102; var iterations = 0
    while now < deadline {
        seed = (seed * 1103515245 + 12345) % 2147483647
        let offset = (seed % 30) * 4; let previous = Array<UInt8>(); var i = 0
        while i < 4 { previous.push(parameters.data[offset + i]); i = i + 1 }
        completionWrite32(parameters.data, offset, seed as UInt64)
        let parsed = UringLayout.read(parameters.data, 120 as UInt64, 2, 8192 as UInt64, 4096 as UInt64)
        if parsed.isOkay() {
            let layout: UringLayout = parsed.unwrap()
            ioRequire(layout.sqBytes + layout.sqeBytes <= (8192 as UInt64))
            ioRequire(layout.sqEntries >= (2 as UInt64) and layout.cqEntries >= layout.sqEntries * (2 as UInt64))
            layout.release()
        } else { parsed.unwrapErr().free() }
        parsed.releaseContainer(); i = 0
        while i < 4 { parameters.data[offset + i] = previous[i]; i = i + 1 }; previous.free()
        ioRequire(seen_memory_used_bytes() == baseline); iterations = iterations + 1
        if iterations % 256 == 0 { let next = seen_time_monotonic_nanos(); if next < now { return 2 }; now = next }
    }
    ioRequire(iterations >= 256); parameters.close(); parameters.free()
    println("PASS: IO-002B layout fuzz 60s seed=1102 bounded maps and allocation baseline")
    return 0
}
