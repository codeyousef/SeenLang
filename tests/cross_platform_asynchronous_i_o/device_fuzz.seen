import io.completion_types.{IoQueueLimits, IoRegistration, IoRejectedSubmission, IoSubmissionView}
import io.completion_queue.{IoQueue}
import async.executor_core.{executorReleaseContext}
import fixture_support.{ioMust, ioRequire, ioErrorIs, ioContext, ioFixtureRequest, ioTake}
import queue_invariants.{checkIoQueueInvariants}
import sync.contracts.{seen_time_monotonic_nanos}
extern "C" fun seen_memory_used_bytes() r: Int64
fun deviceRound(seed: Int) r: Void {
    let context = ioContext(); let limits = IoQueueLimits{depth: 4, maxTransferBytes: 64 as UInt64, maxOwnedBytes: 256 as UInt64, maxMetadataBytes: 8192 as UInt64}
    let queue: IoQueue = ioMust(IoQueue.create(limits)); limits.free()
    let expected = Array<Int>(); let tokens = Array<UInt64>(); var i = 0; var random = seed
    while i < 4 {
        random = (random * 1103515245 + 12345) % 2147483647
        let registration: IoRegistration = ioMust(queue.reserve(ioFixtureRequest(context))); tokens.push(registration.token)
        let mode = random % 3
        if mode != 0 { let view: IoSubmissionView = ioMust(queue.submission(registration.token)); view.free() }
        if mode == 2 { ioMust(queue.submitted(registration.token)) }
        if random % 5 == 0 { ioMust(queue.cancel(registration.token)); expected.push(9) } else { expected.push(10) }
        registration.free(); i = i + 1
    }
    checkIoQueueInvariants(queue); queue.deviceRemoved(-19 as Int64); checkIoQueueInvariants(queue)
    let rejected = queue.reserve(ioFixtureRequest(context)); ioRequire(rejected.isErr())
    let returned: IoRejectedSubmission = rejected.unwrapErr(); rejected.releaseContainer()
    ioRequire(returned.error.code == "io.device_removed"); ioMust(returned.release()); i = 0
    while i < 4 {
        let token = tokens[i]; let slot = queue.slot(token)
        if queue.states[slot] == 2 { ioMust(queue.complete(token, (random % 17) as UInt64, 0 as Int32, 0 as Int64)) }
        if queue.states[slot] == 4 {
            if random % 2 == 0 { ioMust(queue.rejectSubmission(token, 3 as Int32, -5 as Int64)) }
            else { let result = queue.submitted(token); ioRequire(result.isErr()); result.unwrapErr().free(); result.releaseContainer() }
        }
        checkIoQueueInvariants(queue); i = i + 1
    }
    let seen = [false, false, false, false]; i = 0
    while i < 4 {
        let completion = ioTake(queue); let index = ((completion.token % (4294967296 as UInt64)) as Int) - 1
        ioRequire(not seen[index]); seen[index] = true
        let outcome = completion.outcome(); ioRequire(outcome.isErr())
        if expected[index] == 9 { ioRequire(outcome.unwrapErr().code == "async.cancelled") }
        else { ioRequire(outcome.unwrapErr().code == "io.device_removed" and completion.request.nativeEvent.isSome() and completion.request.nativeEvent.unwrap() == (-19 as Int64)) }
        ioRequire(outcome.unwrapErr().progress <= (16 as UInt64)); outcome.unwrapErr().free(); outcome.releaseContainer()
        ioMust(completion.release()); ioRequire(ioErrorIs(queue.complete(tokens[index], 0 as UInt64, 0 as Int32, 0 as Int64), "async.invalid"))
        checkIoQueueInvariants(queue); i = i + 1
    }
    expected.free(); tokens.free(); seen.free(); ioMust(queue.close()); ioMust(queue.close()); ioMust(queue.release()); executorReleaseContext(context)
}
fun main() r: Int {
    deviceRound(1105); let baseline = seen_memory_used_bytes(); let start = seen_time_monotonic_nanos()
    ioRequire(start >= (0 as Int64) and start <= (9223371976854775807 as Int64))
    let deadline = start + (60000000000 as Int64); var now = start; var seed = 1105; var iterations = 0
    while now < deadline {
        seed = (seed * 1103515245 + 12345) % 2147483647; deviceRound(seed)
        ioRequire(seen_memory_used_bytes() == baseline); iterations = iterations + 1
        if iterations % 64 == 0 { let next = seen_time_monotonic_nanos(); ioRequire(next >= now); now = next }
    }
    ioRequire(iterations >= 64)
    println("PASS: IO-002E device-loss fuzz 60s seed=1105 mixed phases first reason and ownership")
    return 0
}
