import env.env.{args, releaseArgs}
import io.completion_types.{IoQueueLimits, IoOperation, IoRegistration, IoRejectedSubmission}
import io.windows_iocp.{WindowsIocpQueue, IocpCreateFailure}
import io.iocp_file.{iocpOpenHandle}
import fs.types.{OpenOptions}
import memory.aligned_buffer.{OwnedBuffer}
import async.structured.{AsyncOperationContext}
import async.executor_core.{executorReleaseContext}
import fixture_support.{ioMust, ioRequire, ioContext, ioTake}
extern "C" fun seen_time_monotonic_nanos() r: Int64
extern "C" fun seen_memory_used_bytes() r: Int64
fun iocpAwait(borrow queue: WindowsIocpQueue) r: Void {
    let start = seen_time_monotonic_nanos()
    ioRequire(start >= (0 as Int64) and start <= (9223372031854775807 as Int64))
    let deadline = start + (5000000000 as Int64); var now = start
    while queue.core.nativeActive != 0 {
        ioMust(queue.publishCancellation()); ioMust(queue.reap(queue.core.capacity))
        let next = seen_time_monotonic_nanos(); ioRequire(next >= now and next < deadline); now = next
    }
}
fun iocpNativeReserve(borrow queue: WindowsIocpQueue, path: String, borrow options: OpenOptions,
    context: AsyncOperationContext, block: Int, write: Bool) r: IoRegistration {
    let buffer: OwnedBuffer<UInt8> = ioMust(OwnedBuffer<UInt8>.allocate(64 as UInt64, 1 as UInt64, 16 as UInt64))
    var i = 0; while i < 64 { buffer.data[i] = 0 as UInt8; if write { buffer.data[i] = ((i + block * 17) % 256) as UInt8 }; i = i + 1 }
    var operation = IoOperation.Read; if write { operation = IoOperation.Write }
    return ioMust(queue.reserveFile(path, options, buffer, operation, (block * 16) as Int64, 16 as UInt64, context))
}
fun iocpNativeRound(borrow queue: WindowsIocpQueue, path: String, borrow options: OpenOptions,
    context: AsyncOperationContext, write: Bool, cancel: Bool) r: Void {
    let first = iocpNativeReserve(queue, path, options, context, 0, write)
    let second = iocpNativeReserve(queue, path, options, context, 1, write)
    ioMust(queue.submit(first.token)); ioMust(queue.submit(second.token))
    ioRequire(queue.core.nativeActive == 2)
    if cancel { ioMust(queue.cancel(first.token)); ioMust(queue.cancel(second.token)) }
    iocpAwait(queue); var delivered = 0
    while delivered < 2 {
        let completion = ioTake(queue.core); let outcome = completion.outcome()
        ioRequire(completion.token == first.token or completion.token == second.token)
        if cancel { ioRequire(outcome.isErr() and outcome.unwrapErr().code == "async.cancelled"); outcome.unwrapErr().free() }
        else {
            ioRequire(outcome.isOkay() and outcome.unwrap() == (16 as UInt64))
            if not write {
                let block = (completion.request.fileOffset / (16 as Int64)) as Int; var i = 0
                while i < 16 { ioRequire(completion.request.resources.buffer.data[i] == (((i + block * 17) % 256) as UInt8)); i = i + 1 }
            }
        }
        outcome.releaseContainer(); ioMust(completion.release()); delivered = delivered + 1
    }
    first.free(); second.free()
}
fun main() r: Int {
    let arguments = args(); if arguments.length() != 2 { releaseArgs(arguments); return 2 }
    let limits = IoQueueLimits{depth: 2, maxTransferBytes: 64 as UInt64, maxOwnedBytes: 128 as UInt64, maxMetadataBytes: 8192 as UInt64}
    let baseline = seen_memory_used_bytes(); let created = WindowsIocpQueue.create(limits, 64 as UInt64)
    if created.isErr() {
        let failure: IocpCreateFailure = created.unwrapErr(); created.releaseContainer()
        ioRequire(failure.error.code == "async.unsupported_platform" and failure.nativeResult == (50 as UInt32))
        failure.release(); ioRequire(seen_memory_used_bytes() == baseline); limits.free(); releaseArgs(arguments)
        println("{\"schema\":\"seen-io-iocp-v1\",\"backend\":\"iocp\",\"classification\":\"unsupported\",\"fallback_count\":0}")
        return 0
    }
    let queue: WindowsIocpQueue = created.unwrap(); created.releaseContainer(); limits.free()
    let context = ioContext(); let options = OpenOptions.createNew()
    let file = ioMust(iocpOpenHandle(arguments[1], options, IoOperation.Write)); ioMust(file.close()); file.free()
    // Opening/creating the fixture is separate from queued request admission.
    options.create = false; options.exclusive = false
    iocpNativeRound(queue, arguments[1], options, context, true, false)
    iocpNativeRound(queue, arguments[1], options, context, false, false)
    iocpNativeRound(queue, arguments[1], options, context, false, true)
    let eof = iocpNativeReserve(queue, arguments[1], options, context, 4096, false)
    ioMust(queue.submit(eof.token)); iocpAwait(queue)
    let ended = ioTake(queue.core); ioRequire(ended.partial() and ioMust(ended.outcome()) == (0 as UInt64)); ioMust(ended.release()); eof.free()
    let live = seen_memory_used_bytes(); var i = 0
    while i < 100 {
        iocpNativeRound(queue, arguments[1], options, context, false, i % 2 == 1)
        ioRequire(seen_memory_used_bytes() == live); i = i + 1
    }
    ioMust(queue.close()); ioMust(queue.close()); ioMust(queue.release()); options.free()
    executorReleaseContext(context); releaseArgs(arguments)
    println("PASS: IO-002C native overlapped writes reads EOF cancellation and repeated cleanup")
    println("{\"schema\":\"seen-io-iocp-v1\",\"backend\":\"iocp\",\"classification\":\"verified\",\"scope\":\"windows-file-contract\",\"submission_overlap\":2,\"native_overlap_verified\":false,\"fallback_count\":0}")
    return 0
}
