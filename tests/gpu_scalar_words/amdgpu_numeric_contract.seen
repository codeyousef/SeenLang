/// Export actual emitted LLVM and the same fixed goldens used by PTX/SPIR-V.
/// Python only executes that LLVM and compares words; it owns no conversion.
import codegen.gpu_ir_model.{GpuIrValidation}
import codegen.gpu.amdgpu_context.{GpuAmdFunction, createGpuAmdFunction, amdValue, amdSlot}
import codegen.gpu.scalar_plan.{GpuScalarValues}
import codegen.gpu.scalar_packed.{scalarPayloadPlan, scalarPackedPlan}
import codegen.gpu.amdgpu_scalar_plan.{emitAmdScalarPlan}
import packed_numeric_goldens.{PackedNumericGolden, PackedWordGolden, packedNumericGoldens, packedWordGoldens}
import json.builder.{JsonBuilder_new, destroyJsonBuilder, releaseJsonText}
extern "C" fun seen_memory_used_bytes() r: Int64
fun requireNumeric(value: Bool) r: Void { if not value { abort("AMDGPU scalar numeric export failed") } }
fun argument(function: GpuAmdFunction, index: Int) r: Int {
    let result = function.allocate(1); let text = function.initializers
    text.literal("  store i32 %input"); text.number(index); text.literal(", ptr addrspace(5) ")
    amdSlot(text, result); text.literal(", align 4\n"); return result
}
fun printNumeric(function: GpuAmdFunction, output: GpuScalarValues, inputs: Array<Int>, expected: Int, laneValid: Int, scaleValid: Int) r: Void {
    var lane = output.laneValid; var scale = output.scaleValid
    if lane == 0 { lane = function.word(1) }; if scale == 0 { scale = function.word(1) }
    let valueId = function.read(output.value); let laneId = function.read(lane); let scaleId = function.read(scale)
    requireNumeric(function.validation.valid)
    let allocations = function.allocations.finish(); let initializers = function.initializers.finish(); let body = function.body.finish()
    let builder = JsonBuilder_new(); builder.startObject(); builder.stringProp("schema", "seen-amdgpu-numeric-case-v1")
    builder.stringProp("allocations", allocations); builder.stringProp("initializers", initializers); builder.stringProp("body", body)
    builder.intProp("value_id", valueId); builder.intProp("lane_id", laneId); builder.intProp("scale_id", scaleId)
    builder.key("inputs"); builder.startArray(); var index = 0
    while index < inputs.length() { builder.number(inputs[index] & 4294967295); index = index + 1 }; builder.endArray()
    builder.key("expected"); builder.startArray(); builder.number(expected & 4294967295); builder.number(laneValid); builder.number(scaleValid); builder.endArray()
    builder.endObject(); let record = builder.build(); destroyJsonBuilder(builder); println(record)
    releaseJsonText(record); releaseJsonText(allocations); releaseJsonText(initializers); releaseJsonText(body)
}
fun main() r: Int {
    let initial = seen_memory_used_bytes(); let records = packedNumericGoldens(); var index = 0
    while index < records.length() {
        let baseline = seen_memory_used_bytes(); let record: PackedNumericGolden = records[index]
        let validation = GpuIrValidation.create(); let function = createGpuAmdFunction(validation, "gfx90a", 0, 1, 1, 1, false)
        let slots = [argument(function, 0), argument(function, 1), argument(function, 2), argument(function, 3)]
        let plan = scalarPayloadPlan(record.format, slots[0], slots[3], record.insert); let output = emitAmdScalarPlan(function, plan)
        let inputs = [record.word, 0, 0, record.scale]; printNumeric(function, output, inputs, record.expected, 1, 1)
        inputs.free(); slots.free(); output.free(); function.release(); validation.release()
        requireNumeric(seen_memory_used_bytes() == baseline); record.free(); index = index + 1
    }; records.free(); let words = packedWordGoldens(); index = 0
    while index < words.length() {
        let baseline = seen_memory_used_bytes(); let record: PackedWordGolden = words[index]
        let validation = GpuIrValidation.create(); let function = createGpuAmdFunction(validation, "gfx90a", 0, 1, 1, 1, false)
        let slots = [argument(function, 0), argument(function, 1), argument(function, 2), argument(function, 3)]
        let plan = scalarPackedPlan(record.format, record.insert, slots[0], slots[1], slots[2], slots[3]); let output = emitAmdScalarPlan(function, plan)
        let inputs = [record.word, record.lane, record.value, record.scale]
        printNumeric(function, output, inputs, record.expected, record.laneValid, record.scaleValid)
        inputs.free(); slots.free(); output.free(); function.release(); validation.release()
        requireNumeric(seen_memory_used_bytes() == baseline); record.free(); index = index + 1
    }; words.free(); requireNumeric(seen_memory_used_bytes() == initial)
    println("PASS: emitted AMDGPU scalar cases share fixed IEEE packed goldens and restore allocation baseline"); return 0
}
