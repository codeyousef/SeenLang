/// Fixed IEEE and integer words, shared by independent backend witnesses.
class PackedNumericGolden {
    var format: Int
    var word: Int
    var scale: Int
    var insert: Bool
    var expected: Int
}
class PackedWordGolden {
    var format: Int
    var insert: Bool
    var word: Int
    var lane: Int
    var value: Int
    var scale: Int
    var expected: Int
    var laneValid: Int
    var scaleValid: Int
}
fun packedWordGoldens() r: Array<PackedWordGolden> {
    let records = Array<PackedWordGolden>()
    records.push(PackedWordGolden{format: 6, insert: true, word: 0xa5a5a5a5, lane: 7, value: 0xfffffffd, scale: 127, expected: 0xd5a5a5a5, laneValid: 1, scaleValid: 1})
    records.push(PackedWordGolden{format: 6, insert: true, word: 0xa5a5a5a5, lane: 8, value: 3, scale: 127, expected: 0xa5a5a5a5, laneValid: 0, scaleValid: 1})
    records.push(PackedWordGolden{format: 6, insert: false, word: 0xa5a5a5a5, lane: 7, value: 0, scale: 127, expected: 0xfffffffa, laneValid: 1, scaleValid: 1})
    records.push(PackedWordGolden{format: 9, insert: true, word: 0xa5a5a5a5, lane: 15, value: 3, scale: 127, expected: 0xe5a5a5a5, laneValid: 1, scaleValid: 1})
    records.push(PackedWordGolden{format: 2, insert: true, word: 0xa5a5a5a5, lane: 2, value: 0x3f800000, scale: 127, expected: 0xa5a5a5a5, laneValid: 0, scaleValid: 1})
    records.push(PackedWordGolden{format: 10, insert: true, word: 0xffffffff, lane: 0, value: 0x7fa12345, scale: 127, expected: 0xffffff7f, laneValid: 1, scaleValid: 1})
    records.push(PackedWordGolden{format: 11, insert: true, word: 0xa5a5a5a5, lane: 0, value: 0x3f800000, scale: 255, expected: 0xa5a5a5a5, laneValid: 1, scaleValid: 0})
    records.push(PackedWordGolden{format: 11, insert: false, word: 0xa5a5a5a5, lane: 8, value: 0, scale: 255, expected: 0, laneValid: 0, scaleValid: 0})
    records.push(PackedWordGolden{format: 1, insert: false, word: 0x7fa12345, lane: 1, value: 0, scale: 127, expected: 0, laneValid: 0, scaleValid: 1})
    records.push(PackedWordGolden{format: 12, insert: true, word: 0xa5a5a5a5, lane: 0, value: 0xffffffff, scale: 127, expected: 0xffffffff, laneValid: 1, scaleValid: 1})
    records.push(PackedWordGolden{format: 13, insert: false, word: 0xffffffff, lane: 0, value: 0, scale: 127, expected: 0xffffffff, laneValid: 1, scaleValid: 1})
    return records
}
fun appendPackedGolden(records: Array<PackedNumericGolden>, format: Int, word: Int, scale: Int, insert: Bool, expected: Int) r: Void {
    records.push(PackedNumericGolden{format: format, word: word, scale: scale, insert: insert, expected: expected})
}
