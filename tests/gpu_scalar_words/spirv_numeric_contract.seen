import codegen.gpu_ir_model.{GpuIrValidation}
import codegen.gpu.spirv_types.{createGpuSpirvContext}
import codegen.gpu.spirv_function.{createGpuSpirvFunction}
import codegen.gpu.spirv_packed.{spirvPackedPayload}
import codegen.gpu_precision_formats.{gpuPrecisionValueType}
import spirv_scalar_witness.{witnessSpirvScalar, witnessRequire}
import packed_numeric_goldens.{packedNumericGoldens, PackedWordGolden, packedWordGoldens}
import codegen.gpu.scalar_packed.{scalarPackedPlan}
import codegen.gpu.spirv_scalar_plan.{emitSpirvScalarPlan}
import json.builder.{releaseJsonText}
extern "C" fun seen_memory_used_bytes() r: Int64
fun wordGolden(record: PackedWordGolden) r: Void {
    let baseline = seen_memory_used_bytes(); let validation = GpuIrValidation.create(); let context = createGpuSpirvContext(validation)
    let function = createGpuSpirvFunction(context, 1, 1, 1); var valueType = 3
    if record.insert { valueType = gpuPrecisionValueType(record.format) }
    let plan = scalarPackedPlan(record.format, record.insert, context.constant(3, record.word), context.constant(3, record.lane), context.constant(valueType, record.value), context.constant(3, record.scale))
    let output = emitSpirvScalarPlan(function, plan); witnessRequire(validation.valid)
    witnessRequire(witnessSpirvScalar(context, function, output.value) == record.expected)
    witnessRequire(witnessSpirvScalar(context, function, output.laneValid) == record.laneValid)
    witnessRequire(witnessSpirvScalar(context, function, output.scaleValid) == record.scaleValid)
    output.free(); function.release(); context.release(); validation.release(); witnessRequire(seen_memory_used_bytes() == baseline)
}

fun printNumericGoldenValue(value: Int) r: Void { let text = value.toString(); println(text); releaseJsonText(text) }

fun golden(format: Int, word: Int, scale: Int, insert: Bool, expected: Int) r: Void {
    let baseline = seen_memory_used_bytes(); let validation = GpuIrValidation.create(); let context = createGpuSpirvContext(validation)
    let function = createGpuSpirvFunction(context, 1, 1, 1); var typeCode = 3
    if insert { typeCode = gpuPrecisionValueType(format) }
    let value = context.constant(typeCode, word); let scaleId = context.constant(3, scale)
    let result = spirvPackedPayload(function, format, value, scaleId, insert)
    witnessRequire(validation.valid); let actual = witnessSpirvScalar(context, function, result)
    if actual != expected {
        println("FAIL: packed SPIR-V numeric golden"); printNumericGoldenValue(format); printNumericGoldenValue(word); printNumericGoldenValue(scale); printNumericGoldenValue(expected); printNumericGoldenValue(actual)
        abort("packed SPIR-V conversion differs from fixed format golden")
    }
    function.release(); context.release(); validation.release(); witnessRequire(seen_memory_used_bytes() == baseline)
}
fun main() r: Int {
    let baseline = seen_memory_used_bytes(); let records = packedNumericGoldens(); var index = 0
    while index < records.length() {
        let record = records[index]; golden(record.format, record.word, record.scale, record.insert, record.expected)
        record.free(); index = index + 1
    }
    records.free(); let words = packedWordGoldens(); index = 0
    while index < words.length() { wordGolden(words[index]); words[index].free(); index = index + 1 }
    words.free(); witnessRequire(seen_memory_used_bytes() == baseline)
    println("PASS: GPU-002B emitted scalar SPIR-V matches fixed IEEE packed goldens and allocation baseline")
    return 0
}
