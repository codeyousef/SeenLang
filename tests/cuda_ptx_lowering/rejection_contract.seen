import codegen.gpu_source.{lowerGpuSource}
import codegen.gpu.ptx_emitter.{emitGpuPtx}
import codegen.gpu_options.{GpuOptions}
import json.builder.{releaseJsonText}
extern "C" fun seen_memory_used_bytes() r: Int64
extern "C" fun seen_time_monotonic_nanos() r: Int64

fun require(value: Bool, message: String) r: Void { if not value { abort(message) } }

fun rejectSource(source: String, expected: String) r: Void {
    let lowered = lowerGpuSource(source, "ptx-rejected.seen")
    if lowered.isErr() {
        let error = lowered.unwrapErr(); var index = 0
        while index < error.diagnostics.length() {
            println(error.diagnostics[index].code); println(error.diagnostics[index].message); index = index + 1
        }
        abort("PTX rejection fixture source did not lower")
    }
    let module = lowered.unwrap(); lowered.releaseContainer()
    let options = GpuOptions.create(); options.backend = "cuda"; options.target = "sm_80"
    let rejected = emitGpuPtx(module, options); require(rejected.isErr(), "PTX unsupported source was accepted")
    let validation = rejected.unwrapErr(); rejected.releaseContainer()
    require(validation.diagnostics.length() > 0, "PTX rejection omitted diagnostics")
    if validation.diagnostics[0].code != expected {
        println(validation.diagnostics[0].code); println(expected)
        abort("PTX rejection diagnostic differs")
    }
    validation.release(); options.release(); module.release()
}

fun main() r: Int {
    let initial = seen_memory_used_bytes()
    rejectSource("@compute(1) fun too_large(output: WriteBuffer<Int32>) { let scratch: SharedBuffer<Int32> = sharedBuffer(16384); output[0] = scratch[0] }", "E_GPU_PTX_LAYOUT")
    rejectSource("@compute(1) fun unsupported(output: Buffer<Int32>) { let old = atomicAdd(output, 0, 1, Relaxed, DeviceScope) }", "E_GPU_PTX_CAPABILITY")
    if seen_memory_used_bytes() != initial { abort("PTX source rejection allocation baseline differs") }
    let lowered = lowerGpuSource("@compute(1) fun arbitrary(output: WriteBuffer<Int32>) { output[0] = 7 }", "ptx-mutation.seen")
    require(lowered.isOkay(), "PTX mutation source did not lower"); let module = lowered.unwrap(); lowered.releaseContainer()
    let function = module.functions[0]; let block = function.blocks[0]
    let store = block.instructions[block.instructions.length() - 1]
    let options = GpuOptions.create(); options.backend = "cuda"; options.target = "sm_80"
    let originalOpcode = store.opcode; let originalOperand = store.operands[0]
    let baseline = seen_memory_used_bytes(); let start = seen_time_monotonic_nanos()
    require(start >= (0 as Int64) and start <= (9223371976854775807 as Int64), "PTX fuzz clock domain")
    let deadline = start + (60000000000 as Int64); var now = start; var iterations = 0; var seed = 1091
    while now < deadline and iterations < 1000000000 {
        seed = (seed * 48271) % 2147483647; let mode = seed % 5
        if mode == 0 { store.opcode = 48 + seed % 10000 }
        if mode == 1 { store.operands[0] = function.registerCount + 1 + seed % 1000 }
        if mode == 2 { options.backend = "spirv"; options.target = "vulkan1.2" }
        if mode == 3 { options.target = "sm_999" }
        let emitted = emitGpuPtx(module, options)
        if mode == 4 { require(emitted.isOkay(), "PTX valid mutation control was rejected"); releaseJsonText(emitted.unwrap()) }
        else {
            require(emitted.isErr(), "PTX malformed IR or target was accepted"); let validation = emitted.unwrapErr()
            require(not validation.valid and validation.diagnostics.length() > 0 and validation.diagnostics.length() <= 64, "PTX mutation diagnostic bounds")
            if mode == 2 { require(validation.diagnostics[0].code == "E_GPU_PTX_TARGET", "PTX wrong-backend diagnostic") }
            validation.release()
        }
        emitted.releaseContainer(); store.opcode = originalOpcode; store.operands[0] = originalOperand
        options.backend = "cuda"; options.target = "sm_80"
        require(seen_memory_used_bytes() == baseline, "PTX mutation allocation baseline"); iterations = iterations + 1
        if iterations % 32 == 0 { let next = seen_time_monotonic_nanos(); require(next >= now, "PTX fuzz clock moved backwards"); now = next }
    }
    if now < deadline or iterations < 32 {
        println(iterations.toString()); println(((now - start) as Int).toString())
        abort("PTX fuzz duration or progress")
    }
    options.release(); module.release()
    require(seen_memory_used_bytes() == initial, "PTX mutation final cleanup")
    println("PASS: PTX 60s seed=1091 malformed IR target capability and shared limits restore allocation baseline")
    return 0
}
