{
  "components": {
    "compiler": {
      "layout_abi": "seen-layout-abi-v2",
      "object_cache_abi": "seen-object-cache-abi-v3",
      "package_interface_schema": "seen-package-interface-v2",
      "package_object_manifest_schema": "seen-package-object-manifest-v2",
      "prebuilt_package_schema": "seen-prebuilt-package-v2",
      "version": "0.10.1"
    },
    "llvm": {
      "minimum_major": 18
    },
    "package_client": {
      "protocol": "SEENPKG1",
      "version": "0.10.1"
    },
    "runtime": {
      "abi": "runtime-v2"
    },
    "standard_library": {
      "module_manifest_version": 1,
      "version": "0.2.0"
    }
  },
  "determinism": {
    "certification": {
      "artifact_comparison": "raw-bytes",
      "builder_count": 2,
      "complete_corpus_required": true,
      "distinct_builder_identities": true,
      "distinct_root_identities": true,
      "installed_archive_required": true,
      "signed_evidence_required": true
    },
    "context_schema": "seen-deterministic-context-v1",
    "object_cache_record_schema": "seen-object-cache-record-v1",
    "program_artifacts_schema": "seen-program-artifacts-v1",
    "program_build_input_schema": "seen-program-build-input-v1",
    "program_reproducibility_schema": "seen-program-reproducibility-v1",
    "release_lto_cache_record_schema": "seen-release-lto-cache-record-v1",
    "required_provenance": [
      "artifact-hash",
      "artifact-size",
      "build-input-digest",
      "builder-identity",
      "cancellation-state",
      "command",
      "compiler-identity",
      "containment-readback",
      "epoch",
      "lock-digest",
      "mode",
      "root-identity",
      "source-digest",
      "target-identity",
      "toolchain-identity"
    ]
  },
  "platforms": {
    "linux-arm64": "declared-toolchain-dependent",
    "linux-x86_64": "required",
    "macos": "declared-toolchain-dependent",
    "windows": "declared-toolchain-dependent"
  },
  "release_version": "0.10.1",
  "schema": "seen-compatibility-manifest-v1",
  "schema_version": 1,
  "targets": [
    {
      "name": "linux-x86_64",
      "support": "required",
      "triple": "x86_64-unknown-linux-gnu"
    }
  ]
}
