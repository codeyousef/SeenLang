import abi_records.value.{GenericAbiRecord, PrebuiltRecordProbe}
extern "C" fun seen_memory_used_bytes() r: Int64

fun main() r: Int {
    let baseline = seen_memory_used_bytes()
    let probe = PrebuiltRecordProbe{bias: 0}
    let record = GenericAbiRecord<UInt8>{address: null as *const UInt8, length: 9 as UInt64}
    let marker = probe.markerAfterRecord(record, 73)
    probe.free()
    if marker != 73 { abort("prebuilt generic record changed the following scalar argument") }
    if seen_memory_used_bytes() != baseline { abort("prebuilt record owner did not clean up") }
    println("PASS: prebuilt generic record method ABI and cleanup")
    return 0
}
