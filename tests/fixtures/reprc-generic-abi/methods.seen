import inference.span.{Span, MutableSpan}
import memory.aligned_buffer.{OwnedBuffer}
import span_probe.{GenericSpanProbe, directSpanLength}
extern "C" fun seen_memory_used_bytes() r: Int64

fun sameModuleSpan(value: Span<UInt8>) r: UInt64 { return value.length }

fun acceptsNullPointer(value: Ptr) r: Bool { return (value as Int) == 0 }
fun acceptsEmptyArray(value: Array<Int>) r: Bool { return value.length() == 0 }

class NullDefaultProbe {
    fun acceptsPointer(value: Ptr) r: Bool { return (value as Int) == 0 }
    fun acceptsArray(value: Array<Int>) r: Bool { return value.length() == 0 }
}
fun main() r: Int {
    let baseline = seen_memory_used_bytes()
    // Null defaults cross both source signature paths; release optimization
    // must not erase the null branch through an unjustified nonnull attribute.
    let nullProbe = NullDefaultProbe{}
    let emptyArray = __default<Array<Int>>()
    if not acceptsNullPointer(__default<Ptr>()) or
        not nullProbe.acceptsPointer(__default<Ptr>()) {
        abort("null default pointer rejected at source parameter boundary")
    }
    if not acceptsEmptyArray(emptyArray) or not nullProbe.acceptsArray(emptyArray) {
        abort("null default Array rejected at source parameter boundary")
    }
    if acceptsNullPointer(37 as Ptr) or nullProbe.acceptsPointer(37 as Ptr) {
        abort("non-null pointer control confused with null default")
    }
    let populatedArray = Array<Int>()
    populatedArray.push(41)
    if acceptsEmptyArray(populatedArray) or nullProbe.acceptsArray(populatedArray) {
        abort("non-empty Array control confused with null default")
    }
    populatedArray.free()
    emptyArray.free()
    nullProbe.free()
    let result = OwnedBuffer<UInt8>.allocate(64 as UInt64, 1 as UInt64, 64 as UInt64)
    if result.isErr() { abort("generic span method backing unavailable") }
    let storage = result.unwrap(); result.releaseContainer(); var i = 0 as UInt64
    while i < storage.byteLength { storage.data[i] = 0 as UInt8; i = i + (1 as UInt64) }
    let immutable = Span<UInt8>{data: storage.data as *const UInt8, length: 29 as UInt64}
    let mutable = MutableSpan<UInt8>{data: storage.data, length: 31 as UInt64}
    let probe = GenericSpanProbe{bias: 7 as UInt64}
    if sameModuleSpan(immutable) != (29 as UInt64) or directSpanLength(immutable) != (29 as UInt64) {
        abort("generic repr(C) function parameter ABI changed")
    }
    if probe.lengthOf(immutable) != (36 as UInt64) or probe.mutableLengthOf(mutable) != (38 as UInt64) {
        abort("generic repr(C) method parameter ABI differs from caller")
    }
    probe.free(); storage.close(); storage.free()
    if seen_memory_used_bytes() != baseline { abort("generic repr(C) method payload leaked") }
    println("PASS: generic repr(C) span method and function ABI")
    return 0
}
