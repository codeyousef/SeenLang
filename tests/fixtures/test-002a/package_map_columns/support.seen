import imports.package_map.{PackageMapColumns, decodePackageMapColumns}

fun packageMapReferenceValid(line: String) r: Bool {
    var field = 0
    var bytes = 0
    var index = 0
    while index < line.length() {
        let byte = line.byteAt(index)
        if byte == 13 or byte == 10 { return false }
        if byte == 9 {
            if field >= 3 or bytes == 0 { return false }
            field = field + 1
            bytes = 0
        } else {
            bytes = bytes + 1
        }
        index = index + 1
    }
    return field == 3
}

fun requirePackageMapRow(parsed: PackageMapColumns, line: String, expected: Bool,
    first: Int, second: Int, third: Int) r: Void {

    decodePackageMapColumns(line, parsed)
    if parsed.valid != expected or packageMapReferenceValid(line) != expected {
        abort("package-map row framing disagrees with expected grammar")
    }
    if expected and (parsed.firstTab != first or parsed.secondTab != second or
        parsed.thirdTab != third) {
        abort("package-map byte column offsets are incorrect")
    }
}

fun checkPackageMapRows() r: Void {
    let parsed = PackageMapColumns{firstTab: 7, secondTab: 9,
        thirdTab: 11, valid: true}
    decodePackageMapColumns("", parsed)
    if parsed.valid or parsed.firstTab != -1 or parsed.secondTab != -1 or
        parsed.thirdTab != -1 {
        abort("invalid package-map row retained previous state")
    }
    requirePackageMapRow(parsed, "r\ta\td\t", true, 1, 3, 5)
    requirePackageMapRow(parsed, "root\talias\tdep\tprefix", true, 4, 10, 14)
    requirePackageMapRow(parsed, "r\ta\td\té", true, 1, 3, 5)
    requirePackageMapRow(parsed, "", false, 0, 0, 0)
    requirePackageMapRow(parsed, "\t", false, 0, 0, 0)
    requirePackageMapRow(parsed, "\ta\td\t", false, 0, 0, 0)
    requirePackageMapRow(parsed, "r\t\td\t", false, 0, 0, 0)
    requirePackageMapRow(parsed, "r\ta\t\t", false, 0, 0, 0)
    requirePackageMapRow(parsed, "r\ta\td", false, 0, 0, 0)
    requirePackageMapRow(parsed, "r\ta\td\t\t", false, 0, 0, 0)
    requirePackageMapRow(parsed, "r\ta\td\tprefix\textra", false, 0, 0, 0)
    requirePackageMapRow(parsed, "r\ta\td\tprefix\r", false, 0, 0, 0)
    requirePackageMapRow(parsed, "r\ra\ta\td\t", false, 0, 0, 0)
    requirePackageMapRow(parsed, "r\ta\nd\td\t", false, 0, 0, 0)
    requirePackageMapRow(parsed, "r\ta\td\tprefix\n", false, 0, 0, 0)
    requirePackageMapRow(parsed, "é\ta\td\t", true, 2, 4, 6)
    parsed.free()
}
