import support.{checkPackageMapRows, packageMapReferenceValid}
import imports.package_map.{PackageMapColumns, decodePackageMapColumns}
import str.string.{StringBuilder}
import json.builder.{seen_string_builder_flatten_owned, seen_string_release_owned}
import time.time.{seen_time_monotonic_nanos}

fun main() r: Int {
    checkPackageMapRows()
    let alphabet = ["a", "b", "/", "_", "0", "1", ".", "\t", "\r", "\n", " ", "x", "é"]
    let builder = StringBuilder{parts: Array<String>(), totalLength: 0}
    let parsed = PackageMapColumns{firstTab: -1, secondTab: -1,
        thirdTab: -1, valid: false}
    let start = seen_time_monotonic_nanos()
    if start <= (0 as Int64) { abort("monotonic clock unavailable") }
    let deadline = start + (60000000000 as Int64)
    var seed = 1101
    var cases = 0
    while seen_time_monotonic_nanos() < deadline {
        var batch = 0
        while batch < 1024 {
            builder.parts.clear()
            builder.totalLength = 0
            seed = (seed * 48271) % 2147483647
            let length = seed % 64
            var index = 0
            while index < length {
                seed = (seed * 48271) % 2147483647
                builder.append(alphabet[seed % alphabet.length()])
                index = index + 1
            }
            let line = seen_string_builder_flatten_owned(builder.parts,
                builder.totalLength)
            decodePackageMapColumns(line, parsed)
            if parsed.valid != packageMapReferenceValid(line) {
                abort("package-map decoder disagrees with independent byte FSM")
            }
            if parsed.valid {
                if line.byteAt(parsed.firstTab) != 9 or
                    line.byteAt(parsed.secondTab) != 9 or
                    line.byteAt(parsed.thirdTab) != 9 {
                    abort("package-map decoder returned non-delimiter positions")
                }
            }
            seen_string_release_owned(line)
            cases = cases + 1
            batch = batch + 1
        }
    }
    parsed.free()
    builder.parts.free()
    builder.free()
    alphabet.free()
    println("PASS: TEST-002A package-map byte fuzz seed=1101 cases=" + cases.toString())
    return 0
}
