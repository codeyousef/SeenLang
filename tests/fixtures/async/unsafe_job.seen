import async.multithread.{MultithreadExecutor, ExecutorJob, ExecutorTaskContext}

class UnsafeJob { var borrowed: *Int }

impl ExecutorJob for UnsafeJob {
    fun run(this: UnsafeJob, context: ExecutorTaskContext) r: Bool { return true }
    fun release(this: UnsafeJob) r: Bool { this.free(); return true }
}

// A borrowed raw pointer must not satisfy the public Send admission bound.
fun reject(pool: MultithreadExecutor<UnsafeJob>) r: Int { return 0 }
fun main() r: Int { return 0 }
