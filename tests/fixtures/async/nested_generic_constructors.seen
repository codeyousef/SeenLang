import core.option.{Option, Some}
extern "C" fun seen_memory_used_bytes() r: Int64
fun nestedConstructors() r: Int {
    let values = Array<Option<Array<Int>>>()
    let inner = Array<Int>(); inner.push(42)
    values.push(Some<Array<Int>>(inner))
    if values[0].unwrap()[0] != 42 { return 1 }
    let implicit: Array<Int>? = inner
    if implicit.unwrap()[0] != 42 { return 7 }
    let outer = Array<Array<Option<Array<Int>>>>()
    outer.push(values)
    if outer[0][0].unwrap()[0] != 42 { return 2 }
    let spaced = Array<Option<Array<Int> > >()
    if spaced.length() != 0 { return 3 }
    if (32 >> 2) != 8 or 3 >= 8 or 8 <= 3 { return 4 }
    if not (3 < 8) or not (8 > 3) { return 5 }
    implicit.free(); spaced.free(); outer.free(); values[0].free(); inner.free(); values.free()
    return 0
}

fun main() r: Int {
    let first = nestedConstructors()
    if first != 0 { return first }
    let baseline = seen_memory_used_bytes()
    var round = 0
    while round < 1000 {
        let status = nestedConstructors()
        if status != 0 { return status }
        if seen_memory_used_bytes() != baseline { return 6 }
        round = round + 1
    }
    println("PASS: nested generic Option and Array constructors preserve values and cleanup")
    return 0
}
