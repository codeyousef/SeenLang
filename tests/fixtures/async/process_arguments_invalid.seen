import async.process_arguments.{ProcessArguments, validProcessProgram, validProcessEnvironment}
import core.result.{Result}
import async.structured.{AsyncError}
fun matches<T>(result: Result<T, AsyncError>, code: String) r: Bool {
    if result.isOkay() { result.releaseContainer(); return false }
    let error = result.unwrapErr(); result.releaseContainer()
    let okay = error.code == code and error.progress == (0 as UInt64)
    error.free(); return okay
}
fun main() r: Int {
    let values = Array<String>(); let nul = String.fromCharCode(0); values.push(nul)
    if not matches(ProcessArguments.pack(values), "async.invalid") { return 1 }
    values.free(); nul.free()
    let tooMany = Array<String>(); var i = 0
    while i < 257 { tooMany.push("x"); i = i + 1 }
    if not matches(ProcessArguments.pack(tooMany), "async.limit") { return 2 }
    tooMany.free()
    if validProcessProgram("/bin/../cat") or validProcessProgram("cat") or
        not validProcessProgram("/bin/cat") { return 3 }
    let environment = Array<String>(); environment.push("BAD-NAME=value")
    if validProcessEnvironment(environment) { return 4 }
    environment[0] = "EMPTY="
    if not validProcessEnvironment(environment) { return 5 }
    environment.free()
    let arguments = Array<String>(); arguments.push("hello"); arguments.push("world")
    let packed = ProcessArguments.pack(arguments)
    if packed.isErr() { return 6 }
    let owner = packed.unwrap(); packed.releaseContainer()
    arguments[0] = "changed"; arguments.free()
    if (ptr_deref_i8(owner.strings.data as Int) as Int) != 104 or
        ptr_deref_i64((owner.pointers.data as Int) + 16) != 0 { return 7 }
    owner.release(); return 0
}
