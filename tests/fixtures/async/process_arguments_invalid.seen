import memory.aligned_buffer.{OwnedBuffer}
extern "C" fun seen_string_view_bytes(data: *const UInt8, length: Int64) r: String
import async.process_arguments.{validProcessProgram, validProcessEnvironment}
import async.owned_strings.{OwnedCStringVector}
import async.executor_native.{seen_string_release_owned}
import core.result.{Result}
import async.structured.{AsyncError}
fun matches<T>(result: Result<T, AsyncError>, code: String) r: Bool {
    if result.isOkay() { result.releaseContainer(); return false }
    let error = result.unwrapErr(); result.releaseContainer()
    let okay = error.code == code and error.progress == (0 as UInt64)
    error.free(); return okay
}
fun main() r: Int {
    let allocated = OwnedBuffer<UInt8>.allocate(1 as UInt64, 1 as UInt64, 16 as UInt64)
    if allocated.isErr() { return 10 }
    let storage = allocated.unwrap(); allocated.releaseContainer()
    ptr_store_i8(storage.data as Int, 0 as Int8)
    let nul = seen_string_view_bytes(storage.data as *const UInt8, 1 as Int64)
    let values = Array<String>(); values.push(nul)
    if not matches(OwnedCStringVector.pack(values), "async.invalid") { return 1 }
    values.free(); storage.close(); storage.free()
    let tooMany = Array<String>(); var i = 0
    while i < 257 { tooMany.push("x"); i = i + 1 }
    if not matches(OwnedCStringVector.pack(tooMany), "async.limit") { return 2 }
    tooMany.free()
    if validProcessProgram("/bin/../cat") or validProcessProgram("cat") or
        not validProcessProgram("/bin/cat") { return 3 }
    let environment = Array<String>(); environment.push("BAD-NAME=value")
    if validProcessEnvironment(environment) { return 4 }
    environment[0] = "EMPTY="
    if not validProcessEnvironment(environment) { return 5 }
    environment.free()
    let arguments = Array<String>(); arguments.push("hello"); arguments.push("world")
    let packed = OwnedCStringVector.pack(arguments)
    if packed.isErr() { return 6 }
    let owner = packed.unwrap(); packed.releaseContainer()
    arguments[0] = "changed"; arguments.free()
    if (ptr_deref_i8(owner.strings.data as Int) as Int) != 104 or
        ptr_deref_i64((owner.pointers.data as Int) + 16) != 0 { return 7 }
    let first = owner.get(0)
    if first.isErr() { return 8 }
    let owned = first.unwrap(); first.releaseContainer()
    owner.release()
    if owned != "hello" { return 9 }
    seen_string_release_owned(owned); return 0
}
