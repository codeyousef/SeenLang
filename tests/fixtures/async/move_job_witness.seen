import move_job_witness_support.{MoveJob}
import async.executor_core.{ExecutorOwnedJob, executorCaptureWitness, executorDropWitness}
extern "C" fun seen_memory_used_bytes() r: Int64
fun main() r: Int {
    let memory = seen_memory_used_bytes()
    let job = MoveJob{number: 7}
    let discarded = executorCaptureWitness(job); executorDropWitness(discarded)
    if job.number != 7 { return 1 }
    let witness = executorCaptureWitness(job)
    let bound = ExecutorOwnedJob<MoveJob>.bind(job, witness)
    if bound.isErr() { abort("move-only job witness failed to bind") }
    let owner = bound.unwrap(); bound.releaseContainer()
    let value = owner.take()
    if value.number != 7 { return 2 }; value.release()
    if seen_memory_used_bytes() != memory { abort("move-only job witness leaked allocations") }
    println("PASS: borrowed witness capture preserves a move-only job until owner binding")
    return 0
}
