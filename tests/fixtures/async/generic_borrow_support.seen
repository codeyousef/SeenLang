@move
class BorrowToken { var value: Int }
class BorrowFactory<T> {
    var reserved: Int
    fun observeInstance(borrow value: BorrowToken) r: Int { return value.value }
    static fun observe(borrow value: BorrowToken) r: Int { return value.value }
    static fun consume(value: BorrowToken) r: Void { value.free() }
}
