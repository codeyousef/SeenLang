import env.env.{args, releaseArgs}
import json.builder.{JsonBuilder_new, destroyJsonBuilder, jsonToString,
    toJsonPretty, releaseJsonText}
import json.parser.{parseJsonWithStrictLimits, destroyJsonParseResult}
import json.value.{JsonValue, JsonValue_numberFloat, JsonValue_emptyArray,
    JsonValue_emptyObject, JsonValue_destroy}
import math.math.{copysign, NAN, INFINITY, NEG_INFINITY}

extern "C" fun seen_memory_used_bytes() r: Int64

fun floatRequire(condition: Bool, message: String) r: Void {
    if not condition { abort(message) }
}

fun sameFloat(actual: Float, expected: Float) r: Bool {
    if actual != expected { return false }
    if expected == 0.0 {
        return copysign(1.0, actual) == copysign(1.0, expected)
    }
    return true
}

fun strictNumber(text: String, expected: Float) r: Void {
    let parsed = parseJsonWithStrictLimits(text, 8192, 16, 128, 4096)
    floatRequire(parsed.success == 1, "serialized Float is not strict JSON")
    let value = parsed.value.unwrap()
    floatRequire(value.isNumber(), "serialized Float changed JSON kind")
    floatRequire(sameFloat(value.getNumber(), expected),
        "serialized Float did not roundtrip exactly")
    destroyJsonParseResult(parsed, true)
}

fun builderNumber(expected: Float) r: Void {
    let baseline = seen_memory_used_bytes()
    let builder = JsonBuilder_new()
    builder.numberFloat(expected)
    let text = builder.build()
    let second = builder.build()
    builder.reset()
    builder.numberFloat(expected)
    let resetText = builder.build()
    destroyJsonBuilder(builder)
    strictNumber(text, expected)
    releaseJsonText(text)
    strictNumber(second, expected)
    releaseJsonText(second)
    strictNumber(resetText, expected)
    releaseJsonText(resetText)
    floatRequire(seen_memory_used_bytes() == baseline,
        "Float builder retained allocations")
}

fun valueNumber(expected: Float) r: Void {
    let baseline = seen_memory_used_bytes()
    let value = JsonValue_numberFloat(expected)
    let ownerBaseline = seen_memory_used_bytes()
    let text = jsonToString(value)
    strictNumber(text, expected)
    releaseJsonText(text)
    floatRequire(sameFloat(value.getNumber(), expected),
        "serialization consumed borrowed numeric JsonValue")
    floatRequire(seen_memory_used_bytes() == ownerBaseline,
        "numeric JsonValue serialization retained allocations")
    let pretty = toJsonPretty(value, 2)
    strictNumber(pretty, expected)
    releaseJsonText(pretty)
    JsonValue_destroy(value)
    floatRequire(seen_memory_used_bytes() == baseline,
        "numeric JsonValue owner did not release exactly once")
}

fun nestedNumber(expected: Float) r: Void {
    let baseline = seen_memory_used_bytes()
    let root = JsonValue_emptyObject()
    let values = JsonValue_emptyArray()
    let number = JsonValue_numberFloat(expected)
    values.push(number)
    root.set("numbers", values)
    let ownerBaseline = seen_memory_used_bytes()
    var iteration = 0
    while iteration < 2 {
        var text = jsonToString(root)
        if iteration == 1 { releaseJsonText(text); text = toJsonPretty(root, 2) }
        let parsed = parseJsonWithStrictLimits(text, 8192, 16, 128, 4096)
        floatRequire(parsed.success == 1, "nested Float is not strict JSON")
        let parsedRoot = parsed.value.unwrap()
        floatRequire(parsedRoot.isObject() and parsedRoot.length() == 1,
            "nested Float object changed")
        let arrayOption = parsedRoot.get("numbers")
        floatRequire(arrayOption != null, "nested Float array missing")
        let parsedArray = arrayOption.unwrap()
        floatRequire(parsedArray.isArray() and parsedArray.length() == 1,
            "nested Float array changed")
        let parsedNumber = parsedArray.getArray()[0]
        floatRequire(parsedNumber.isNumber() and
            sameFloat(parsedNumber.getNumber(), expected),
            "nested Float did not roundtrip exactly")
        arrayOption.free()
        destroyJsonParseResult(parsed, true)
        releaseJsonText(text)
        floatRequire(root.length() == 1 and values.length() == 1 and
            sameFloat(number.getNumber(), expected),
            "serialization consumed borrowed nested JsonValue")
        floatRequire(seen_memory_used_bytes() == ownerBaseline,
            "nested Float serialization retained allocations")
        iteration = iteration + 1
    }
    JsonValue_destroy(root)
    floatRequire(seen_memory_used_bytes() == baseline,
        "nested Float tree did not release exactly once")
}

fun integerContract() r: Void {
    let baseline = seen_memory_used_bytes()
    let builder = JsonBuilder_new()
    builder.startArray()
    builder.number(-9223372036854775807 - 1)
    builder.number(9223372036854775807)
    builder.number(0)
    builder.endArray()
    let text = builder.build()
    destroyJsonBuilder(builder)
    floatRequire(text == "[-9223372036854775808,9223372036854775807,0]",
        "integer JSON formatting changed")
    releaseJsonText(text)
    floatRequire(seen_memory_used_bytes() == baseline,
        "integer builder retained allocations")
}

fun rejectNonfinite(mode: String, kind: String) r: Bool {
    // Native constants, not exceptional arithmetic under the compiler's
    // existing fast-math lowering. Invalid factory and acceptance are distinct.
    var value = INFINITY
    if kind == "nan" { value = NAN }
    else if kind == "-inf" { value = NEG_INFINITY }
    else if kind != "inf" { return false }
    if kind == "nan" { if not value.isNaN() { return false } }
    else if not value.isInfinite() { return false }
    if mode == "reject-builder" {
        let builder = JsonBuilder_new()
        builder.numberFloat(value)
        destroyJsonBuilder(builder)
    } else {
        let number = JsonValue_numberFloat(value)
        var text = ""
        if mode == "reject-pretty" { text = toJsonPretty(number, 2) }
        else { text = jsonToString(number) }
        releaseJsonText(text)
        JsonValue_destroy(number)
    }
    return true
}

fun main() r: Int {
    let initial = seen_memory_used_bytes()
    let arguments = args()
    var mode = "all"
    if arguments.length() > 1 { mode = arguments[1] }
    if mode == "reject-builder" or mode == "reject-value" or
        mode == "reject-pretty" {
        floatRequire(arguments.length() == 3, "missing nonfinite Float kind")
        let accepted = rejectNonfinite(mode, arguments[2])
        releaseArgs(arguments)
        if accepted { return 73 }; return 72
    }
    floatRequire(mode == "all" or mode == "builder" or mode == "value" or
        mode == "nested" or mode == "integer" or mode == "references",
        "unknown Float fixture mode")
    // Establish the narrow defect before reference-corpus parsing can fail.
    if mode == "all" or mode == "builder" { builderNumber(1.25) }
    if mode == "all" or mode == "value" { valueNumber(1.25) }
    if mode == "all" or mode == "nested" { nestedNumber(1.25) }
    let cases = parseJsonWithStrictLimits(
        "[1.25,-2.75,0.1,1.0000000000000002,1.2345678901234567,9.999999999999998,1e100,-1e100,1e-100,1e308,1.7976931348623157e308,2.2250738585072014e-308,2.225073858507201e-308,5e-324,9007199254740991,9007199254740992,9007199254740994,9223372036854775808,-9223372036854775808,0,-0.0]",
        8192, 16, 128, 4096)
    if cases.success != 1 {
        println(cases.error)
        println(cases.errorPosition)
        abort("reference Float cases did not parse")
    }
    let values = cases.value.unwrap().getArray()
    let baseline = seen_memory_used_bytes()
    var index = 0
    while index < values.length() {
        let expected = values[index].getNumber()
        if mode == "all" or mode == "builder" { builderNumber(expected) }
        if mode == "all" or mode == "value" { valueNumber(expected) }
        if mode == "all" or mode == "nested" { nestedNumber(expected) }
        floatRequire(seen_memory_used_bytes() == baseline,
            "Float case changed exact live allocation baseline")
        index = index + 1
    }
    if mode == "all" or mode == "integer" { integerContract() }
    destroyJsonParseResult(cases, true)
    releaseArgs(arguments)
    floatRequire(seen_memory_used_bytes() == initial,
        "Float serialization fixture retained owners")
    return 0
}

main()
