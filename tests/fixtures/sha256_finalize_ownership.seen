    byteDigest(63, 17, "29af2686fd53374a36b0846694cc342177e428d1647515f078784d69cdb9e488");
    byteDigest(63, 64, "29af2686fd53374a36b0846694cc342177e428d1647515f078784d69cdb9e488");
    byteDigest(64, 1, "fdeab9acf3710362bd2658cdc9a29e8f9c757fcf9811603a8c447cd1d9151108");
