    byteDigest(513, 17, "2ac6d9e2b50bdd65511fb4dc0f24b7f6a0c1b2e92d1cf6901df565802e380234");
    byteDigest(513, 64, "2ac6d9e2b50bdd65511fb4dc0f24b7f6a0c1b2e92d1cf6901df565802e380234");
}
fun main() r: Int {
    knownVectors()
    var warm = 0
    while warm < 10 {
        digestOnce()
        oneShotOnce()
        warm = warm + 1
    }
    let baseline = memoryStats().usedBytes
    var cycle = 0
    while cycle < 10 {
        digestOnce()
        cycle = cycle + 1
    }
    let afterDirect = memoryStats().usedBytes
    cycle = 0
    while cycle < 10 {
        oneShotOnce()
        cycle = cycle + 1
    }
    let after = memoryStats().usedBytes
    if after != baseline {
        println("SHA-256 allocator baseline: " + baseline.toString() +
            "/" + afterDirect.toString() + "/" + after.toString())
        return 1
    }
    println("PASS: SHA-256 allocator baseline")
    return 0
}

main()
