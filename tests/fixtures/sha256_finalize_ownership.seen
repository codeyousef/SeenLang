import crypto.sha256.{Sha256, sha256, releaseSha256DigestResult}
import memory.allocation.{memoryStats}

fun digestOnce() r: Void {
    let state = Sha256.new()
    let bytes = Array<Int>()
    bytes.push(65)
    let updated = state.updateBytes(bytes)
    bytes.free()
    if updated.isErr() { abort("SHA-256 update failed") }
    updated.releaseContainer()
    let digest = state.finalizeHex()
    if digest.isErr() { abort("SHA-256 finalization failed") }
    if digest.unwrap() !=
        "559aead08264d5795d3909718cdd05abd49572e84fe55590eef31a88a08fdffd" {
        abort("SHA-256 digest changed")
    }
    releaseSha256DigestResult(digest)
    state.free()
}

fun oneShotOnce() r: Void {
    let digest = sha256("A")
    if digest.isErr() { abort("one-shot SHA-256 failed") }
    if digest.unwrap() !=
        "559aead08264d5795d3909718cdd05abd49572e84fe55590eef31a88a08fdffd" {
        abort("one-shot SHA-256 digest changed")
    }
    releaseSha256DigestResult(digest)
}

fun knownDigest(text: String, expected: String) r: Void {
    let result = sha256(text)
    if result.isErr() or result.unwrap() != expected { abort("SHA-256 known vector changed") }
    releaseSha256DigestResult(result)
}
fun byteDigest(count: Int, chunkSize: Int, expected: String) r: Void {
    let state = Sha256.new(); let bytes = Array<Int>(); var index = 0
    while index < count {
        bytes.push(index & 255); index = index + 1
        if bytes.length() == chunkSize or index == count {
            let updated = state.updateBytes(bytes)
            if updated.isErr() { abort("SHA-256 split update failed") }
            updated.releaseContainer(); bytes.clear()
        }
    }
    bytes.free(); let digest = state.finalizeHex()
    if digest.isErr() or digest.unwrap() != expected { abort("SHA-256 byte vector changed") }
    releaseSha256DigestResult(digest); state.free()
}
