@device fun nested() r: Int32 {
    var total = 0
    for outer in 0..4 {
        var inner = 0
        while inner < 4 {
            inner = inner + 1
            if inner == 2 { continue }
            if outer == 2 { break }
            if outer == 3 and inner == 3 { return total }
            total = total + outer * 10 + inner
        }
    }
    return total
}
@compute(1) fun repeated_helper(output: WriteBuffer<Int32>) {
    for index in 0..2 { output[index] = nested() }
}
@compute(1) fun signed_index(input: ReadBuffer<Int32>, output: WriteBuffer<Int32>) {
    output[0] = input[-2]
    output[1] = input[-2147483648]
}
@compute(1) fun signed_store(output: WriteBuffer<Int32>) {
    output[-2] = 99
    output[-2147483648] = 101
    output[0] = 23
}
@compute(1) fun threadgroup(output: WriteBuffer<Int32>) { output[0] = 37 }
@compute(1) fun boolean_uniform(output: WriteBuffer<UInt32>, enabled: Uniform<Bool>) {
    if enabled { output[0] = 1 as UInt32 }
    if not enabled { output[1] = 1 as UInt32 }
}
