import dyn_method_modules.free_names.{anchor}
import dyn_method_modules.protocol.{ImportedMethodJob}
extern "C" fun seen_pool_free(value: *Void, bytes: Int64) r: Void
class ImportedMethodBridge {
    static fun execute(job: dyn ImportedMethodJob, expected: Int) r: Bool {
        let matched = job.run(1) == expected and anchor() == 41
        let released = job.release()
        seen_pool_free(job as *Void, 16 as Int64)
        return matched and released
    }
}
