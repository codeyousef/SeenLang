class ImportedGenericProvider<T> {
    var identity: T
    var number: Int
    fun run(delta: Int) r: Int { return this.number + delta }
    fun release() r: Bool { this.free(); return true }
}

class ImportedReceiverProvider { var number: Int }
impl ImportedReceiverProvider {
    fun run(this: ImportedReceiverProvider, delta: Int) r: Int { return this.number + delta }
    fun release(this: ImportedReceiverProvider) r: Bool { this.free(); return true }
}
