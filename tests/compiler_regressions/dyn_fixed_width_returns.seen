extern "C" fun seen_pool_free(value: *Void, bytes: Int64) r: Void
extern "C" fun seen_memory_used_bytes() r: Int64
trait ScalarProvider {
    fun narrow(this: ScalarProvider) r: Int8
    fun medium(this: ScalarProvider) r: UInt16
    fun wide(this: ScalarProvider) r: UInt32
    fun single(this: ScalarProvider) r: Float32
    fun double(this: ScalarProvider) r: Float64
}
class ScalarProbe {
    var reserved: Int
    fun double() r: Float64 { return -2.5 as Float64 }
    fun single() r: Float32 { return 1.25 as Float32 }
    fun wide() r: UInt32 { return 4000000001 as UInt32 }
    fun narrow() r: Int8 { return -7 as Int8 }
    fun medium() r: UInt16 { return 65001 as UInt16 }
}
fun verifyScalars(provider: dyn ScalarProvider) r: Bool {
    let valid = provider.narrow() == (-7 as Int8) and provider.medium() == (65001 as UInt16) and
        provider.wide() == (4000000001 as UInt32) and provider.single() == (1.25 as Float32) and
        provider.double() == (-2.5 as Float64)
    seen_pool_free(provider as *Void, 16 as Int64)
    return valid
}
fun main() r: Int {
    let baseline = seen_memory_used_bytes(); var i = 0
    while i < 1000 {
        let provider = ScalarProbe{reserved: i}
        if not verifyScalars(provider) { abort("trait dispatch changed fixed-width result ABI") }
        provider.free()
        if seen_memory_used_bytes() != baseline { abort("trait box ownership did not return to baseline") }
        i = i + 1
    }
    println("PASS: trait dispatch fixed-width result ABI and box cleanup")
    return 0
}
