extern "C" fun seen_memory_used_bytes() r: Int64
import env.env.{args}
fun filledArrays(count: Int) r: Void {
    let bytes = Array<UInt8>.withLength(count)
    let shorts = Array<Int16>.withLength(count)
    let words = Array<UInt32>.withLength(count)
    let wide = Array<UInt64>.withLength(count)
    let floats = Array<Float32>.withLength(count)
    var index = 0
    while index < count {
        if bytes[index] != (0 as UInt8) or shorts[index] != (0 as Int16) or
            words[index] != (0 as UInt32) or wide[index] != (0 as UInt64) or
            floats[index] != (0 as Float32) { abort("fixed-width array was not zero-filled") }
        bytes[index] = ((index * 17 + 128) & 255) as UInt8
        shorts[index] = ((index % 256) - 128) as Int16
        words[index] = (2147483648 + index * 65537) as UInt32
        wide[index] = ((1 as UInt64) << 63) | (index as UInt64)
        floats[index] = index as Float32
        index = index + 1
    }
    let byteData = bytes.data(); let shortData = shorts.data()
    let wordData = words.data(); let wideData = wide.data(); let floatData = floats.data()
    index = 0
    while index < count {
        if byteData[index] != (((index * 17 + 128) & 255) as UInt8) or
            shortData[index] != (((index % 256) - 128) as Int16) or
            wordData[index] != ((2147483648 + index * 65537) as UInt32) or
            wideData[index] != (((1 as UInt64) << 63) | (index as UInt64)) or
            floatData[index] != (index as Float32) {
            abort("filled array header and typed pointer strides disagree")
        }
        index = index + 1
    }
    bytes.free(); shorts.free(); words.free(); wide.free(); floats.free()
}
fun main() r: Int {
    let argv = args()
    if argv.length() > 1 {
        if argv[1] == "negative" {
            let invalid = Array<UInt8>.withLength(-1); invalid.free()
        } else if argv[1] == "overflow" {
            let invalid = Array<UInt32>.withLength(4611686018427387904); invalid.free()
