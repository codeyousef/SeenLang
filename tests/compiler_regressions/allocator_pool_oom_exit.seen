// An unavailable first slab must report checked OOM, never return a null
// object address that generated field stores would dereference.
extern "C" fun seen_memory_set_limit_bytes(bytes: Int64) r: Void
extern "C" fun write(fd: Int32, data: *const UInt8, bytes: UInt64) r: Int64
class FreshPoolObject {
    var first: Int
    var second: Int
    var third: Int
    var fourth: Int
    var fifth: Int
}
@noinline
fun keep(value: FreshPoolObject) r: FreshPoolObject { return value }
fun main() r: Int {
    seen_memory_set_limit_bytes(1 as Int64)
    let value = keep(FreshPoolObject{first: 1, second: 2, third: 3, fourth: 4, fifth: 5})
    // An external pointer use keeps LLVM from removing the failed allocation.
    write(2 as Int32, value as *const UInt8, 40 as UInt64)
    return 0
}
