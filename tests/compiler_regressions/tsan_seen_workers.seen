import core.result.{Result}
import core.error.{AsciiString}
import core.operation_context.{OperationContext, OperationLimits}
import env.env.{args, releaseArgs}
import memory.aligned_buffer.{OwnedBuffer}
import async.structured.{AsyncLimits, AsyncOperationContext}
import async.executor_core.{ExecutorLimits, ExecutorJob, ExecutorTaskContext, executorReleaseContext}
import async.multithread.{MultithreadExecutor}
import async.barrier.{AsyncBarrier}
import sync.atomic.{AtomicInt, MemoryOrder}

extern "C" fun __ThreadYield() r: Void
extern "C" fun seen_executor_live_threads() r: UInt64
extern "C" fun seen_sync_live_mutexes() r: UInt64
extern "C" fun seen_sync_live_conditions() r: UInt64
extern "C" fun fflush(stream: *Void) r: Int32
extern "C" fun seen_tsan_workers_phase(phase: UInt32) r: Int32

fun tsanTake<T, E>(result: Result<T, E>) r: T {
    if result.isErr() { abort("Seen TSan worker operation failed") }
    let value = result.unwrap()
    result.releaseContainer()
    return value
}

fun tsanContext() r: AsyncOperationContext {
    return AsyncOperationContext{operation: OperationContext{
        cancellation: false, monotonicDeadline: 9223372036854775807 as Int64,
        limits: OperationLimits{maxTargets: 8, maxIdentityBytes: 128,
            maxVersionBytes: 128, maxManifestBytes: 4096, maxPathBytes: 4095,
            maxGraphModules: 8, maxGraphEdges: 16, maxGraphDepth: 4},
        traceId: AsciiString{value: "tsan-seen-workers"}}, resourceId: "tsan-control",
        fallbackPolicy: 0, limits: AsyncLimits.bounded(4, 4, 4, 4, 128)}
}

// The main owner keeps all shared resources alive until both jobs are joined.
// Raw pointer sharing is deliberate: race mode must exercise a real Seen store,
// not an unsynchronized foreign accessor or an uninstrumented reference program.
@send
class TsanSeenJob {
    var address: UInt64
    var race: Bool
    var phase: AsyncBarrier
    var started: AtomicInt
    var finished: AtomicInt
}

impl ExecutorJob for TsanSeenJob {
    fun run(this: TsanSeenJob, task: ExecutorTaskContext) r: Bool {
        tsanTake(this.started.fetchAdd(1 as Int64, MemoryOrder.SeqCst))
        tsanTake(this.phase.arrive(task.operation))
        if seen_tsan_workers_phase(0 as UInt32) != (0 as Int32) {
            abort("Seen TSan workers did not reach their write phase")
        }
        if not this.race {
            if task.core.lock(task.operation.operation.monotonicDeadline) != (0 as Int32) {
                abort("Seen TSan clean control could not acquire its mutex")
            }
        }
        let shared = this.address as *Int64
        shared[0] = shared[0] + (1 as Int64)
        if not this.race { task.core.unlock() }
        // Use a lock-free, nonallocating rendezvous before any Result allocation
        // or handle-registry access can accidentally order the conflicting
        // stores. The foreign control never reads or writes the counter.
        if seen_tsan_workers_phase(1 as UInt32) != (0 as Int32) {
            abort("Seen TSan workers did not finish their write phase")
        }
        tsanTake(this.finished.fetchAdd(1 as Int64, MemoryOrder.SeqCst))
        return true
    }
    fun release(this: TsanSeenJob) r: Bool { this.free(); return true }
}

fun main() r: Int {
    let arguments = args()
    var race = false
    var valid = arguments.length() == 1
    if arguments.length() == 2 {
        race = arguments[1] == "race"
        valid = race or arguments[1] == "clean"
    }
    releaseArgs(arguments)
    if not valid { return 64 }
    let initialThreads = seen_executor_live_threads()
    let initialMutexes = seen_sync_live_mutexes()
    let initialConditions = seen_sync_live_conditions()
    let context = tsanContext()
    let limits = ExecutorLimits{workers: 2, tasks: 4, queued: 4,
        helpDepth: 2, stackBytes: 1048576 as UInt64}
    let pool = tsanTake(MultithreadExecutor<TsanSeenJob>.create(limits))
    limits.free()
    if seen_executor_live_threads() != initialThreads + (2 as UInt64) {
        abort("Seen TSan control did not start two native workers")
    }
    let phase = tsanTake(AsyncBarrier.create(pool.core, 2))
    let started = tsanTake(AtomicInt.create(0 as Int64))
    let finished = tsanTake(AtomicInt.create(0 as Int64))
    let storage: OwnedBuffer<Int64> = tsanTake(OwnedBuffer<Int64>.allocate(
        1 as UInt64, 8 as UInt64, 64 as UInt64))
    storage.data[0] = 0 as Int64
    let address = storage.data as UInt64
    println("TSAN_SEEN_COUNTER_ADDRESS=" + address.toString())
    if fflush(null as *Void) != (0 as Int32) { abort("Seen TSan address output failed") }
    let first = TsanSeenJob{address: address, race: race, phase: phase,
        started: started, finished: finished}
    let second = TsanSeenJob{address: address, race: race, phase: phase,
        started: started, finished: finished}
    let firstHandle = tsanTake(pool.spawn(first, first, context))
    let secondHandle = tsanTake(pool.spawn(second, second, context))
    // Wait without joining/helping so both job bodies are native worker calls.
    var spins = 0
    while tsanTake(started.load(MemoryOrder.SeqCst)) != (2 as Int64) {
        if spins >= 10000000 { abort("Seen TSan native workers did not enter") }
        __ThreadYield()
        spins = spins + 1
    }
    let firstOwned = tsanTake(firstHandle.join(context))
    let secondOwned = tsanTake(secondHandle.join(context))
    firstOwned.release(); secondOwned.release()
    firstHandle.free(); secondHandle.free()
    let entered = tsanTake(started.load(MemoryOrder.SeqCst))
    let completed = tsanTake(finished.load(MemoryOrder.SeqCst))
    let value = storage.data[0]
    if race { abort("Seen TSan failed to diagnose the deliberately racy stores") }
    if entered != (2 as Int64) or completed != (2 as Int64) or value != (2 as Int64) {
        abort("Seen TSan clean worker result differs")
    }
    tsanTake(phase.close()); tsanTake(phase.release())
    tsanTake(started.close()); started.free()
    tsanTake(finished.close()); finished.free()
    tsanTake(pool.release())
    if not storage.close() { abort("Seen TSan counter ownership was lost") }
    storage.free()
    executorReleaseContext(context)
    if seen_executor_live_threads() != initialThreads or
        seen_sync_live_mutexes() != initialMutexes or
        seen_sync_live_conditions() != initialConditions {
        abort("Seen TSan control retained native resources")
    }
    println("TSAN_SEEN_WORKERS=" + entered.toString())
    println("TSAN_SEEN_COUNTER=" + value.toString())
    println("TSAN_SEEN_DRAINED=1")
    return 0
}
