extern "C" fun seen_pool_free(value: *Void, bytes: Int64) r: Void
extern "C" fun seen_memory_used_bytes() r: Int64
import dyn_method_modules.consumer.{ImportedMethodBridge}
import dyn_method_modules.provider.{ImportedGenericProvider}
trait MethodValue { fun value(this: MethodValue) r: Int }
class MethodProvider {
    var number: Int
    fun value() r: Int { return this.number }
}
class MethodValueHandle {
    var provider: dyn MethodValue
    static fun create(provider: dyn MethodValue) r: MethodValueHandle {
        return MethodValueHandle{provider: provider}
    }
    static fun forward(provider: dyn MethodValue) r: MethodValueHandle {
        return MethodValueHandle.create(provider)
    }
    fun value() r: Int { return this.provider.value() }
    fun release() r: Void { seen_pool_free(this.provider as *Void, 16 as Int64); this.free() }
}
fun ownedMethodValue(provider: dyn MethodValue) r: Int {
    let value = provider.value(); seen_pool_free(provider as *Void, 16 as Int64); return value
}
fun genericMethodValue<T>(identity: T, provider: dyn MethodValue) r: Int { return ownedMethodValue(provider) }
class MethodValueReader {
    var reserved: Int
    fun consume(provider: dyn MethodValue, expected: Int) r: Bool {
        return ownedMethodValue(provider) == expected
    }
}
// Similar names must not inherit another function's dynamic parameter slot.
fun prefixedreadMethodValue(provider: dyn MethodValue) r: Int { return ownedMethodValue(provider) }
fun readMethodValue(provider: MethodProvider) r: Int { return provider.number }
fun main() r: Int {
    let initial = seen_memory_used_bytes(); let reader = MethodValueReader{reserved: 0}
    let baseline = seen_memory_used_bytes(); var i = 0
    while i < 100 {
        let provider = MethodProvider{number: i + 41}
        let direct = MethodValueHandle.create(provider)
        if direct.value() != i + 41 { abort("static trait argument was not boxed") }; direct.release()
        let forwarded = MethodValueHandle.forward(provider)
        if forwarded.value() != i + 41 { abort("forwarded trait argument changed identity") }; forwarded.release()
        if not reader.consume(provider, i + 41) { abort("instance trait argument was not boxed") }
        if prefixedreadMethodValue(provider) != i + 41 or readMethodValue(provider) != i + 41 { abort("trait parameter name boundary changed argument ABI") }
        if genericMethodValue<Int>(i, provider) != i + 41 { abort("generic trait argument changed identity") }
        let imported = ImportedGenericProvider<Int>{identity: i, number: i + 41}
        if not ImportedMethodBridge.execute(imported, i + 42) { abort("imported generic witness lost method slots or ownership") }
        provider.free()
        if seen_memory_used_bytes() != baseline { abort("method trait box did not return to allocation baseline") }; i = i + 1
    }
    reader.free(); if seen_memory_used_bytes() != initial { abort("method trait fixture owner leaked") }
    println("PASS: static instance and forwarded trait arguments preserve identity and box ownership"); return 0
}
