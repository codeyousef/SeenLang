import core.result.{Result}
import memory.aligned_buffer.{OwnedBuffer}
fun take<T, E>(result: Result<T, E>) r: T {
    if result.isErr() { abort("typed pointer fixture allocation failed") }
    let value = result.unwrap(); result.releaseContainer(); return value
}
fun requirePointer(value: Bool) r: Void { if not value { abort("typed pointer index mismatch") } }
fun checkUInt8(borrow storage: OwnedBuffer<UInt8>) r: Void {
    var offset = 0
    while offset < 16 {
        var i = 0
        while i < 128 { storage.data[i] = 165 as UInt8; i = i + 1 }
        let pointer = ((storage.data as UInt64) + (offset as UInt64)) as *UInt8
        i = 0; while i < 4 { pointer[i] = 249 as UInt8; i = i + 1 }
        i = 0; while i < 4 { requirePointer(pointer[i] == (249 as UInt8)); i = i + 1 }
        i = 0
        while i < 128 {
            var expected = 165
            if i >= offset and i < offset + 4 {
                expected = 0
                if (i - offset) % 1 == 0 { expected = 249 }
            }
            requirePointer(storage.data[i] == (expected as UInt8)); i = i + 1
        }
        offset = offset + 1
    }
}
