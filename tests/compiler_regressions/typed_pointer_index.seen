fun main() r: Int {
    let storage: OwnedBuffer<UInt8> = take(OwnedBuffer<UInt8>.allocate(128 as UInt64, 1 as UInt64, 64 as UInt64))
    let other: OwnedBuffer<UInt8> = take(OwnedBuffer<UInt8>.allocate(128 as UInt64, 1 as UInt64, 64 as UInt64))
    // Copy through a generic pointer field, then restore the allocation owner.
    // This exercises both the emitted pointer value and field-store coercion.
    let original = other.data
    other.data = storage.data
    other.data[3] = 73 as UInt8
    requirePointer(storage.data[3] == (73 as UInt8))
    requirePointer((other.data as UInt64) == (storage.data as UInt64))
    other.data = original
    requirePointer(other.close()); other.free()
    storage.data[0] = 81 as UInt8
    let readonly = ReadonlyPointerFixture{data: storage.data as *const UInt8}
    let view = seen_string_view_bytes(readonly.data, 4 as Int64)
    requirePointer(view.byteAt(0) == 81 and readonly.data[0] == (81 as UInt8))
    readonly.free()
    println("POINTER CASE: UInt8")
    checkUInt8(storage)
    println("POINTER CASE: Int8")
    checkInt8(storage)
    println("POINTER CASE: UInt16")
    checkUInt16(storage)
    println("POINTER CASE: Int16")
    checkInt16(storage)
    println("POINTER CASE: UInt32")
    checkUInt32(storage)
    println("POINTER CASE: Int32")
    checkInt32(storage)
    println("POINTER CASE: UInt64")
    checkUInt64(storage)
    println("POINTER CASE: Int64")
    checkInt64(storage)
    println("POINTER CASE: Int")
    checkInt(storage)
    println("POINTER CASE: Float32")
    checkFloat32(storage)
    println("POINTER CASE: Float64")
    checkFloat64(storage)
    println("POINTER CASE: Float")
    checkFloat(storage)
    requirePointer(storage.close()); storage.free()
    println("PASS: typed pointer indices use pointee widths and preserve sentinels")
    return 0
}
