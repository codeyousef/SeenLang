fun checkInt16(borrow storage: OwnedBuffer<UInt8>) r: Void {
    var offset = 0
    while offset < 16 {
        var i = 0
        while i < 128 { storage.data[i] = 165 as UInt8; i = i + 1 }
        let pointer = ((storage.data as UInt64) + (offset as UInt64)) as *Int16
        i = 0; while i < 4 { pointer[i] = -7 as Int16; i = i + 1 }
        i = 0; while i < 4 { requirePointer(pointer[i] == (-7 as Int16)); i = i + 1 }
        i = 0
        while i < 128 {
            var expected = 165
            if i >= offset and i < offset + 8 {
                expected = 0
                if (i - offset) % 2 == 0 { expected = 249 }
