fun checkFloat32(borrow storage: OwnedBuffer<UInt8>) r: Void {
    var offset = 0
    while offset < 16 {
        var i = 0
        while i < 128 { storage.data[i] = 165 as UInt8; i = i + 1 }
        let pointer = ((storage.data as UInt64) + (offset as UInt64)) as *Float32
        i = 0; while i < 4 { pointer[i] = 1.25 as Float32; i = i + 1 }
        i = 0; while i < 4 { requirePointer(pointer[i] == (1.25 as Float32)); i = i + 1 }
        i = 0
        while i < 128 {
            var expected = 165
            if i >= offset and i < offset + 16 {
                expected = 0
                if (i - offset) % 4 == 2 { expected = 160 }
                if (i - offset) % 4 == 3 { expected = 63 }
            }
            requirePointer(storage.data[i] == (expected as UInt8)); i = i + 1
        }
        offset = offset + 1
    }
}
