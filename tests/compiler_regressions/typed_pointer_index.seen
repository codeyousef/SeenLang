fun main() r: Int {
    let storage: OwnedBuffer<UInt8> = take(OwnedBuffer<UInt8>.allocate(128 as UInt64, 1 as UInt64, 64 as UInt64))
    checkUInt8(storage)
    checkInt8(storage)
    checkUInt16(storage)
    checkInt16(storage)
    checkUInt32(storage)
    checkInt32(storage)
    checkUInt64(storage)
    checkInt64(storage)
    checkInt(storage)
    checkFloat32(storage)
    checkFloat64(storage)
    checkFloat(storage)
    requirePointer(storage.close()); storage.free()
    println("PASS: typed pointer indices use pointee widths and preserve sentinels")
    return 0
}
