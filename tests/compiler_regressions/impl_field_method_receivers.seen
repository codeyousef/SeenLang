extern "C" fun seen_pool_free(value: *Void, bytes: Int64) r: Void
extern "C" fun seen_memory_used_bytes() r: Int64
trait FieldAction { fun run(this: FieldAction) r: Int }
class FieldCounter {
    var value: Int
    fun advance() r: Int { this.value = this.value + 1; return this.value }
}
class FieldTask { var counter: FieldCounter }
impl FieldAction for FieldTask {
    fun run(this: FieldTask) r: Int { return this.counter.advance() }
}
fun evaluateFieldAction(action: dyn FieldAction) r: Int {
    let value = action.run()
    seen_pool_free(action as *Void, 16 as Int64)
    return value
}
fun main() r: Int {
    let baseline = seen_memory_used_bytes()
    var round = 0
    while round < 100 {
        let counter = FieldCounter{value: round}
        let task = FieldTask{counter: counter}
        if evaluateFieldAction(task) != round + 1 or
            evaluateFieldAction(task) != round + 2 or counter.value != round + 2 { return 1 }
        task.free(); counter.free()
        if seen_memory_used_bytes() != baseline { return 2 }
        round = round + 1
    }
    println("PASS: trait implementation field methods preserve typed receiver and storage")
    return 0
}
