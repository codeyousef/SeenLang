/// Explicit clock erasure. The handle owns only its compiler-created trait box;
/// the concrete provider must outlive the handle and remains caller-owned.
extern "C" fun seen_time_monotonic_nanos() r: Int64
extern "C" fun seen_pool_free(value: *Void, bytes: Int64) r: Void

trait DotClock { fun now(this: DotClock) r: Int64 }
class NativeDotClock {
    var reserved: Int
    fun now() r: Int64 { return seen_time_monotonic_nanos() }
}
@move
class DotClockHandle {
    var provider: dyn DotClock
    // Entry consumes the compiler-created box, while borrowing its provider.
    static fun create(provider: dyn DotClock) r: DotClockHandle {
        return DotClockHandle{provider: provider}
    }
    fun now() r: Int64 { return this.provider.now() }
    fun release() r: Void {
        seen_pool_free(this.provider as *Void, 16 as Int64); this.free()
    }
}
