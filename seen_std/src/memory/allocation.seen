///
Allocation failure contract for Seen 0.22.0.

usedBytes measures live allocations, including checked-out pool slots, but
excludes recyclable pool capacity. memoryReservedBytes() reports the retained
pool capacity (including slab headers) not currently checked out. The memory
limit and remainingBytes conservatively apply to committed bytes, including
that reserve; peakBytes is the peak committed byte count. Releasing a slot
restores the live baseline without pretending its slab has returned to the OS.
///

import core.result.{Result, Ok, Err}
import core.unit.{Unit}

extern fun seen_memory_set_limit_bytes(bytes: Int) r: Void
extern fun seen_memory_limit_bytes() r: Int
extern fun seen_memory_used_bytes() r: Int
extern fun seen_memory_reserved_bytes() r: Int
extern fun seen_memory_peak_bytes() r: Int
extern fun seen_memory_remaining_bytes() r: Int
extern fun seen_memory_allocation_failures() r: Int
extern "C" fun seen_memory_snapshot() r: MemoryStats
extern "C" fun seen_arr_release_i64(values: Array<Int>) r: Void
extern "C" fun seen_arr_release_f64(values: Array<Float>) r: Void
extern "C" fun seen_arr_release_str(values: Array<String>) r: Void

class AllocError {
    var requestedBytes: Int
    var limitBytes: Int
    var usedBytes: Int
    var message: String

    static fun outOfMemory(requestedBytes: Int) r: AllocError {
        return AllocError {
            requestedBytes: requestedBytes,
            limitBytes: seen_memory_limit_bytes(),
            usedBytes: seen_memory_used_bytes(),
            message: "Seen allocation budget exceeded"
        }
    }
}

@repr(C)
@trivially_copyable
class MemoryStats {
    var limitBytes: Int
    var usedBytes: Int
    var peakBytes: Int
    var remainingBytes: Int
    var allocationFailures: Int

    static fun current() r: MemoryStats {
        return seen_memory_snapshot()
    }
}

fun setMemoryLimitBytes(bytes: Int) r: Void {
    seen_memory_set_limit_bytes(bytes)
}

fun memoryStats() r: MemoryStats {
    return MemoryStats.current()
}

fun memoryRemainingBytes() r: Int {
    return seen_memory_remaining_bytes()
}

fun memoryReservedBytes() r: Int {
    return seen_memory_reserved_bytes()
}

fun ensureAllocationBudget(bytes: Int) r: Result<Unit, AllocError> {
    if bytes <= 0 {
        return Ok<Unit, AllocError>(Unit{})
    }
    if seen_memory_limit_bytes() <= 0 {
        return Ok<Unit, AllocError>(Unit{})
    }
    if bytes <= seen_memory_remaining_bytes() {
        return Ok<Unit, AllocError>(Unit{})
    }
    return Err<Unit, AllocError>(AllocError.outOfMemory(bytes))
}

fun releaseIntArrayStorage(values: Array<Int>) r: Void {
    seen_arr_release_i64(values)
}

fun releaseFloatArrayStorage(values: Array<Float>) r: Void {
    seen_arr_release_f64(values)
}

fun releaseStringArrayStorage(values: Array<String>) r: Void {
    seen_arr_release_str(values)
}
