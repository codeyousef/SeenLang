/// Device owners are confined to their creator. Contexts borrow the core;
/// closing the device rejects outstanding borrowers. Failed native destruction
/// retains ownership so callers can explicitly retry without detaching work.
import compute.provider.{GpuDeviceProvider, gpuReleaseProvider}
import compute.device_info.{GpuDeviceInfo}
import compute.error.{GpuError, gpuFailure}
import compute.limits.{GpuLimits}
import compute.operation.{gpuCheckOperation}
import core.operation_context.{OperationContext}
import core.result.{Result, Ok, Err}
import memory.allocation.{ensureAllocationBudget}

let GPU_CONTEXT_MAX_GENERATION: UInt64 = 9223372036854775807 as UInt64

class GpuContextSlot {
    var native: UInt64
    var generation: UInt64
    var borrowed: Bool
}

class GpuDeviceCore {
    var provider: dyn GpuDeviceProvider
    var info: GpuDeviceInfo
    var limits: GpuLimits
    var slots: Array<GpuContextSlot>
    var borrowers: Int
    var closed: Bool

    fun reserve() r: Result<Int, GpuError> {
        var index = 0
        while index < this.slots.length() {
            let slot = this.slots[index]
            if slot.native == (0 as UInt64) and slot.generation < GPU_CONTEXT_MAX_GENERATION {
                return Ok<Int, GpuError>(index)
            }
            index = index + 1
        }
        if this.slots.length() >= this.limits.maxContexts {
            return Err<Int, GpuError>(gpuFailure("gpu.limit", "gpu.context", "GPU context ceiling reached"))
        }
        this.slots.push(GpuContextSlot{native: 0 as UInt64, generation: 1 as UInt64, borrowed: false})
        return Ok<Int, GpuError>(index)
    }

    fun destroy(slot: GpuContextSlot) r: Result<Bool, GpuError> {
        let result = this.provider.destroyContext(slot.native)
        if result.isErr() { return result }
        let destroyed = result.unwrap(); result.releaseContainer()
        if not destroyed { return Err<Bool, GpuError>(gpuFailure("gpu.invalid", "gpu.context.close", "provider did not destroy its open context")) }
        slot.native = 0 as UInt64
        if slot.generation < GPU_CONTEXT_MAX_GENERATION { slot.generation = slot.generation + (1 as UInt64) }
        return Ok<Bool, GpuError>(true)
    }

    fun close() r: Result<Bool, GpuError> {
        if this.closed { return Ok<Bool, GpuError>(false) }
        if this.borrowers != 0 { return Err<Bool, GpuError>(gpuFailure("gpu.busy", "gpu.device.close", "GPU device still has context borrowers")) }
        var index = 0; var progress = 0 as UInt64
        while index < this.slots.length() {
            let slot = this.slots[index]
            if slot.native != (0 as UInt64) {
                let closed = this.destroy(slot)
                if closed.isErr() {
                    let error = closed.unwrapErr(); closed.releaseContainer(); error.progress = progress
                    return Err<Bool, GpuError>(error)
                }
                closed.releaseContainer(); progress = progress + (1 as UInt64)
            }
            index = index + 1
        }
        gpuReleaseProvider(this.provider); this.info.release(); this.limits.release()
        index = 0
        while index < this.slots.length() { this.slots[index].free(); index = index + 1 }
        this.slots.free(); this.closed = true
        return Ok<Bool, GpuError>(true)
    }
}

@move
class GpuContext {
    var core: GpuDeviceCore
    var slot: Int
    var generation: UInt64
    var active: Bool

    fun close() r: Result<Bool, GpuError> {
        if not this.active { return Ok<Bool, GpuError>(false) }
        if this.core.closed or this.slot < 0 or this.slot >= this.core.slots.length() {
            return Err<Bool, GpuError>(gpuFailure("gpu.invalid", "gpu.context.close", "GPU context owner is invalid"))
        }
        let slot = this.core.slots[this.slot]
        if not slot.borrowed or slot.generation != this.generation or slot.native == (0 as UInt64) {
            return Err<Bool, GpuError>(gpuFailure("gpu.invalid", "gpu.context.close", "GPU context identity is stale"))
        }
        let closed = this.core.destroy(slot)
        if closed.isErr() { return closed }
        closed.releaseContainer(); slot.borrowed = false
        this.core.borrowers = this.core.borrowers - 1; this.active = false
        return Ok<Bool, GpuError>(true)
    }
    fun release() r: Result<Bool, GpuError> {
        let closed = this.close()
        if closed.isErr() { return closed }
        closed.releaseContainer(); this.free()
        return Ok<Bool, GpuError>(true)
    }
}

@move
class GpuDevice {
    var core: GpuDeviceCore

    /// Consumes provider and report on every outcome; borrows the limit input.
    static fun open(provider: dyn GpuDeviceProvider, report: GpuDeviceInfo, borrow limits: GpuLimits) r: Result<GpuDevice, GpuError> {
        let valid = report.validate(limits)
        if valid.isErr() {
            let error = valid.unwrapErr(); valid.releaseContainer(); gpuReleaseProvider(provider); report.release()
            return Err<GpuDevice, GpuError>(error)
        }
        valid.releaseContainer()
        if provider.backend() != report.identity.backend or provider.identity() != report.identity.providerId {
            gpuReleaseProvider(provider); report.release()
            return Err<GpuDevice, GpuError>(gpuFailure("gpu.invalid", "gpu.device", "device report belongs to another provider"))
        }
        let copied = limits.snapshot()
        if copied.isErr() {
            let error = copied.unwrapErr(); copied.releaseContainer(); gpuReleaseProvider(provider); report.release()
            return Err<GpuDevice, GpuError>(error)
        }
        let owned = copied.unwrap(); copied.releaseContainer()
        return Ok<GpuDevice, GpuError>(GpuDevice{core: GpuDeviceCore{provider: provider,
            info: report, limits: owned, slots: Array<GpuContextSlot>(), borrowers: 0, closed: false}})
    }

    fun createContext(context: OperationContext) r: Result<GpuContext, GpuError> {
        if this.core.closed { return Err<GpuContext, GpuError>(gpuFailure("gpu.invalid", "gpu.context", "GPU device is closed")) }
        let valid = gpuCheckOperation(context, "gpu.context")
        if valid.isErr() { let error = valid.unwrapErr(); valid.releaseContainer(); return Err<GpuContext, GpuError>(error) }
        valid.releaseContainer()
        // Admit a finite metadata budget before the driver creates a resource.
        // This owner performs no concurrent allocations.
        let budget = ensureAllocationBudget(4096)
        if budget.isErr() {
            budget.unwrapErr().free(); budget.releaseContainer()
            return Err<GpuContext, GpuError>(gpuFailure("gpu.limit", "gpu.context", "GPU context metadata allocation budget exhausted"))
        }
        budget.unwrap().free(); budget.releaseContainer()
        let reserved = this.core.reserve()
        if reserved.isErr() { let error = reserved.unwrapErr(); reserved.releaseContainer(); return Err<GpuContext, GpuError>(error) }
        let index = reserved.unwrap(); reserved.releaseContainer()
        let created = this.core.provider.createContext(this.core.info.identity.ordinal)
        if created.isErr() { let error = created.unwrapErr(); created.releaseContainer(); return Err<GpuContext, GpuError>(error) }
        let native = created.unwrap(); created.releaseContainer()
        if native == (0 as UInt64) { return Err<GpuContext, GpuError>(gpuFailure("gpu.invalid", "gpu.context", "provider returned an empty context identity")) }
        var other = 0
        while other < this.core.slots.length() {
            if this.core.slots[other].native == native {
                return Err<GpuContext, GpuError>(gpuFailure("gpu.invalid", "gpu.context", "provider returned an aliased context identity"))
            }
            other = other + 1
        }
        let slot = this.core.slots[index]; slot.native = native
        let observed = gpuCheckOperation(context, "gpu.context")
        if observed.isErr() {
            let error = observed.unwrapErr(); observed.releaseContainer()
            let cleanup = this.core.destroy(slot)
            if cleanup.isErr() { error.causes.push(cleanup.unwrapErr()) }
            cleanup.releaseContainer()
            return Err<GpuContext, GpuError>(error)
        }
        observed.releaseContainer(); slot.borrowed = true
        this.core.borrowers = this.core.borrowers + 1
        return Ok<GpuContext, GpuError>(GpuContext{core: this.core,
            slot: index, generation: slot.generation, active: true})
    }
    fun close() r: Result<Bool, GpuError> { return this.core.close() }
    fun release() r: Result<Bool, GpuError> {
        let closed = this.close()
        if closed.isErr() { return closed }
        closed.releaseContainer(); this.core.free(); this.free()
        return Ok<Bool, GpuError>(true)
    }
}
