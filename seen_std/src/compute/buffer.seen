/// A move-only typed range in an allocator-owned native block. Closing returns
/// its range to the pool; only explicit trim or allocator shutdown frees blocks.
import compute.resource_arena_core.{GpuArenaCore}
import compute.allocator.{GpuAllocator}
import compute.buffer_region.{GpuBufferRegion}
import compute.resource_geometry.{GpuBufferGeometry, gpuResourceAlignmentValid}
import core.operation_context.{OperationContext}
import compute.error.{GpuError, gpuFailure}
import core.result.{Result, Ok, Err}

@move
class GpuBuffer<T> {
    var core: GpuArenaCore
    var slot: Int
    var generation: UInt64
    var elementCount: UInt64
    var elementBytes: UInt64
    var byteLength: UInt64
    var active: Bool

    /// Element stride is explicit, as with OwnedBuffer<T>. Binding validation
    /// must compare it with reflected kernel layout before a native launch.
    static fun allocate(borrow allocator: GpuAllocator, count: UInt64, elementBytes: UInt64, alignment: UInt64,
        operation: OperationContext) r: Result<GpuBuffer<T>, GpuError> {
        if allocator.core.closed {
            return Err<GpuBuffer<T>, GpuError>(gpuFailure("gpu.invalid", "gpu.buffer.allocate", "GPU allocator is closed"))
        }
        let required = allocator.core.provider.value.bindingAlignment()
        var effective = alignment
        if required > effective { effective = required }
        if not gpuResourceAlignmentValid(alignment) {
            return Err<GpuBuffer<T>, GpuError>(gpuFailure("gpu.invalid", "gpu.buffer.allocate", "GPU buffer alignment is invalid"))
        }
        let checked = GpuBufferGeometry.checked(count, elementBytes, effective)
        if checked.isErr() { let error = checked.unwrapErr(); checked.releaseContainer(); return Err<GpuBuffer<T>, GpuError>(error) }
        let geometry = checked.unwrap(); checked.releaseContainer()
        let allocated = allocator.core.allocate(geometry, operation)
        geometry.release()
        if allocated.isErr() { let error = allocated.unwrapErr(); allocated.releaseContainer(); return Err<GpuBuffer<T>, GpuError>(error) }
        let slot = allocated.unwrap(); allocated.releaseContainer()
        let buffer = GpuBuffer<T>{core: allocator.core, slot: slot.index, generation: slot.generation,
            elementCount: count, elementBytes: elementBytes, byteLength: count * elementBytes, active: true}
        slot.free(); return Ok<GpuBuffer<T>, GpuError>(buffer)
    }
    fun isOpen() r: Bool {
        if not this.active { return false }
        return this.core.validSlot(this.slot, this.generation)
    }
    fun byteOffset() r: Result<UInt64, GpuError> {
        if not this.isOpen() {
            return Err<UInt64, GpuError>(gpuFailure("gpu.invalid", "gpu.buffer.offset", "GPU buffer owner or generation is inactive"))
        }
        return Ok<UInt64, GpuError>(this.core.slots[this.slot].range.offset)
    }
    fun region(offset: UInt64, bytes: UInt64, write: Bool, operation: OperationContext) r: Result<GpuBufferRegion, GpuError> {
        if not this.active {
            return Err<GpuBufferRegion, GpuError>(gpuFailure("gpu.invalid", "gpu.buffer.region", "GPU byte region requires an active buffer owner"))
        }
        return GpuBufferRegion.acquire(this.core, this.slot, this.generation, offset, bytes, write, operation)
    }
    fun close() r: Result<Bool, GpuError> {
        if not this.active { return Ok<Bool, GpuError>(false) }
        let closed = this.core.releaseSlot(this.slot, this.generation)
        if closed.isErr() { return closed }
        closed.releaseContainer(); this.active = false
        return Ok<Bool, GpuError>(true)
    }
    fun release() r: Result<Bool, GpuError> {
        let closed = this.close()
        if closed.isErr() { return closed }
        closed.releaseContainer(); this.free(); return Ok<Bool, GpuError>(true)
    }
}
