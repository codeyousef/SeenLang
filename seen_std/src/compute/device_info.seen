/// Independent owning snapshots outlive discovery buffers and driver calls.
import core.result.{Result, Ok, Err}
import core.error.{errorIdentityValid}
import compute.backend.{GpuBackend, gpuBackendKnown}
import compute.capabilities.{GpuCapabilities}
import compute.error.{GpuError, gpuFailure}
import compute.limits.{GpuLimits, GPU_MAX_DEVICES}
import json.builder.{seen_string_clone_owned, seen_string_release_owned}

fun gpuDeviceTextValid(value: String, maximum: Int) r: Bool {
    if value.length() == 0 or value.length() > maximum { return false }
    var index = 0
    while index < value.length() {
        let byte = value.byteAt(index)
        if byte < 32 or byte > 126 { return false }
        index = index + 1
    }
    return true
}

@move
class GpuDeviceIdentity {
    var backend: GpuBackend
    var ordinal: Int
    var providerId: UInt64
    var uuid: String

    fun valid(maximum: Int) r: Bool {
        return gpuBackendKnown(this.backend) and this.backend != GpuBackend.CpuOnly and
            this.ordinal >= 0 and this.ordinal < GPU_MAX_DEVICES and this.providerId != (0 as UInt64) and
            this.uuid.length() <= maximum and errorIdentityValid(this.uuid)
    }
    fun release() r: Void { seen_string_release_owned(this.uuid); this.free() }
}

@move
class GpuDeviceInfo {
    var identity: GpuDeviceIdentity
    var name: String
    var driverVersion: String
    var capabilities: GpuCapabilities
    var freeBytes: UInt64

    fun validate(limits: GpuLimits) r: Result<Bool, GpuError> {
        let valid = limits.validate()
        if valid.isErr() { return valid }
        valid.releaseContainer()
        if not this.identity.valid(limits.maxIdentityBytes) or
            not gpuDeviceTextValid(this.name, limits.maxNameBytes) or
            not gpuDeviceTextValid(this.driverVersion, limits.maxVersionBytes) or
            not this.capabilities.valid() or this.freeBytes > this.capabilities.totalBytes {
            return Err<Bool, GpuError>(gpuFailure("gpu.invalid", "gpu.device", "GPU device identity or capability report is invalid"))
        }
        return Ok<Bool, GpuError>(true)
    }
    fun snapshot(limits: GpuLimits) r: Result<GpuDeviceInfo, GpuError> {
        let valid = this.validate(limits)
        if valid.isErr() { let error = valid.unwrapErr(); valid.releaseContainer(); return Err<GpuDeviceInfo, GpuError>(error) }
        valid.releaseContainer()
        let copied = this.capabilities.snapshot()
        if copied.isErr() { let error = copied.unwrapErr(); copied.releaseContainer(); return Err<GpuDeviceInfo, GpuError>(error) }
        let capabilities = copied.unwrap(); copied.releaseContainer()
        return Ok<GpuDeviceInfo, GpuError>(GpuDeviceInfo{
            identity: GpuDeviceIdentity{backend: this.identity.backend, ordinal: this.identity.ordinal,
                providerId: this.identity.providerId, uuid: seen_string_clone_owned(this.identity.uuid)},
            name: seen_string_clone_owned(this.name), driverVersion: seen_string_clone_owned(this.driverVersion),
            capabilities: capabilities, freeBytes: this.freeBytes})
    }
    fun release() r: Void {
        this.identity.release(); this.capabilities.release()
        seen_string_release_owned(this.name); seen_string_release_owned(this.driverVersion); this.free()
    }
}
