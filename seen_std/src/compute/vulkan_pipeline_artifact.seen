        // Only fixed, one-dimensional compiler arrays with ordinary 32-bit
        // scalar/vector elements are supported. Mixed alignments are rejected:
        // implicit Workgroup packing permits implementation-dependent padding
        // in arbitrary variable order, which the v1 raw-byte reflection omits.
        var shared = 0; var sharedAlignment = 0; i = 1
        while i < bound and valid {
            if interfaces[i] == 1 and storage[i] == 4 {
                let pointer = types[i]
                if pointer < 1 or pointer >= bound { valid = false }
                else if types[pointer] != 32 or storage[pointer] != 4 { valid = false }
                else {
                    let array = pointees[pointer]
                    if array < 1 or array >= bound { valid = false }
                    else if types[array] != 28 or blocks[array] != 0 { valid = false }
                    else {
                        let element = members[array]; let extent = pointees[array]
                        if element < 1 or element >= bound or extent < 1 or extent >= bound { valid = false }
                        else if values[element] < 1 or types[extent] != 43 { valid = false }
                        else {
                            let extentType = members[extent]; let length = pointees[extent]
                            let lanes = (values[element] - 1) / 16 + 1; let scalar = (values[element] - 1) % 16 + 1
                            var stride = lanes * 4; if lanes == 3 { stride = 16 }
                            if extentType < 1 or extentType >= bound { valid = false }
                            else if values[extentType] != 3 or length < 1 or lanes > 4 or scalar < 1 or scalar > 4 or strides[array] != 0 { valid = false }
                            else if sharedAlignment != 0 and sharedAlignment != stride { valid = false }
                            else if length > (4294967295 - shared) / stride { valid = false }
                            else { sharedAlignment = stride; shared = shared + length * stride }
                        }
                    }
                }
            }
            i = i + 1
        }
        if shared != this.sharedBytes { valid = false }
        var b = 0
        while b < this.bindings.length() and valid {
            let expected = this.bindings[b]; var matches = 0; i = 1
            while i < bound {
                if interfaces[i] == 1 and groups[i] == expected.group and bindings[i] == expected.binding {
                    matches = matches + 1; let pointer = types[i]
                    if pointer < 1 or pointer >= bound { valid = false }
                    else { let block = pointees[pointer]
                        if block < 1 or block >= bound { valid = false }
                        else if types[pointer] != 32 or types[block] != 30 or blocks[block] != 1 or members[block] == 0 or offsets[block] != 0 { valid = false }
                        else {
                            var value = members[block]; var expectedValue = expected.valueType
                            if expected.descriptorType == 6 { if storage[i] != 2 { valid = false }; if expectedValue == 1 { expectedValue = 3 } }
                            else if storage[i] != 12 { valid = false }
                            else if not expected.fault {
                                let array = value
                                if array < 1 or array >= bound { valid = false; value = 0 }
                                else { if types[array] != 29 or strides[array] != expected.stride { valid = false }; value = members[array] }
                                var expectedAccess = 0; if expected.typeCode / 1000 == 1 { expectedAccess = 1 }; if expected.typeCode / 1000 == 2 { expectedAccess = 2 }
                                if access[i] != expectedAccess { valid = false }
                            }
                            if value < 1 or value >= bound { valid = false } else if values[value] != expectedValue { valid = false }
                        }
                    }
                }; i = i + 1
            }
            if matches != 1 { valid = false }; b = b + 1
        }
        offsets.free(); access.free(); values.free(); interfaces.free(); groups.free(); bindings.free(); storage.free(); types.free(); pointees.free(); blocks.free(); members.free(); strides.free(); return valid
    }
}
