                if (opcode == 71 or opcode == 72 or opcode == 59 or opcode == 32 or opcode == 30 or opcode == 29 or opcode == 28 or opcode == 43 or opcode == 20 or opcode == 21 or opcode == 22 or opcode == 23) and count >= 2 {
                    var id = this.word(offset + 1); if opcode == 59 or opcode == 43 { if count < 4 { valid = false } else { id = this.word(offset + 2) } }
                    if id < 1 or id >= bound { valid = false }
                    else {
                        if opcode == 71 and count >= 3 {
                            let decoration = this.word(offset + 2)
                            if decoration == 2 { blocks[id] = 1 }
                            if decoration == 24 { access[id] = access[id] | 1 }; if decoration == 25 { access[id] = access[id] | 2 }
                            if decoration == 33 or decoration == 34 or decoration == 6 {
                                if count != 4 { valid = false }
                                else { let value = this.word(offset + 3); if decoration == 33 { bindings[id] = value }; if decoration == 34 { groups[id] = value }; if decoration == 6 { strides[id] = value } }
                            }
                        }
                        if opcode == 72 and count == 5 and this.word(offset + 2) == 0 and this.word(offset + 3) == 35 { offsets[id] = this.word(offset + 4) }
                        if opcode == 20 and count == 2 { values[id] = 1 }
                        if opcode == 21 and count == 4 and this.word(offset + 2) == 32 { if this.word(offset + 3) == 0 { values[id] = 3 } else if this.word(offset + 3) == 1 { values[id] = 2 } }
                        if opcode == 22 and count == 3 and this.word(offset + 2) == 32 { values[id] = 4 }
                        if opcode == 23 and count == 4 { types[id] = 23; members[id] = this.word(offset + 2); pointees[id] = this.word(offset + 3) }
                        if opcode == 32 { if count != 4 { valid = false } else { storage[id] = this.word(offset + 2); pointees[id] = this.word(offset + 3); types[id] = 32 } }
                        if opcode == 59 and count >= 4 { types[id] = this.word(offset + 1); storage[id] = this.word(offset + 3); if storage[id] == 4 and count != 4 { valid = false } }
                        if opcode == 30 { if count == 3 { members[id] = this.word(offset + 2) }; types[id] = 30 }
                        if opcode == 29 { if count != 3 { valid = false } else { types[id] = 29; members[id] = this.word(offset + 2) } }
                        if opcode == 28 { if count != 4 { valid = false } else { types[id] = 28; members[id] = this.word(offset + 2); pointees[id] = this.word(offset + 3) } }
                        if opcode == 43 and count == 4 { types[id] = 43; members[id] = this.word(offset + 1); pointees[id] = this.word(offset + 3) }
                    }
                }
            }
            offset = offset + count
        }
        if selected == 0 or not geometry { valid = false }
        i = 1
        while i < bound {
            if types[i] == 23 { let component = members[i]; let lanes = pointees[i]; if component > 0 and component < bound and lanes >= 2 and lanes <= 4 and values[component] >= 2 { values[i] = values[component] + 16 * (lanes - 1) } }
            if interfaces[i] == 1 and (storage[i] == 2 or storage[i] == 12) {
                var represented = false; var j = 0
                while j < this.bindings.length() { if groups[i] == this.bindings[j].group and bindings[i] == this.bindings[j].binding { represented = true }; j = j + 1 }
                if not represented { valid = false }
