/// Resource owners borrow a live context through an explicit, bounded lease.
/// The context cannot close while leased. These owners are creator-confined.
import compute.device.{GpuContext, GpuDeviceCore}
import compute.error.{GpuError, gpuFailure}
import compute.operation.{gpuCheckOperation}
import core.operation_context.{OperationContext}
import core.result.{Result, Ok, Err}
import memory.allocation.{allocationBudgetAvailable}
import core.option.{Some}

@move
class GpuContextLease {
    var core: GpuDeviceCore
    var slot: Int
    var generation: UInt64
    var active: Bool

    static fun acquire(borrow context: GpuContext, operation: OperationContext)
        r: Result<GpuContextLease, GpuError> {
        return GpuContextLease.createChecked(context.core, context.slot, context.generation, context.active, operation)
    }
    fun borrow(operation: OperationContext) r: Result<GpuContextLease, GpuError> {
        return GpuContextLease.createChecked(this.core, this.slot, this.generation, this.active, operation)
    }
    /// Shared admission for root resource owners and explicit descendant leases.
    static fun createChecked(core: GpuDeviceCore, index: Int, generation: UInt64,
        active: Bool, operation: OperationContext) r: Result<GpuContextLease, GpuError> {
        let checked = gpuCheckOperation(operation, "gpu.context.lease")
        if checked.isErr() { let error = checked.unwrapErr(); checked.releaseContainer(); return Err<GpuContextLease, GpuError>(error) }
        checked.releaseContainer()
        if not active or not core.validSlot(index, generation) {
            return Err<GpuContextLease, GpuError>(gpuFailure("gpu.invalid", "gpu.context.lease", "resource lease requires a live context"))
        }
        let slot = core.slots[index]
        if slot.lost {
            let error = gpuFailure("gpu.device_lost", "gpu.context.lease", "GPU context is lost")
            error.nativeCode.free(); error.nativeCode = Some<Int64>(slot.lostNativeCode as Int64)
            return Err<GpuContextLease, GpuError>(error)
        }
        if core.resourceBorrowers >= core.limits.maxResources or not allocationBudgetAvailable(4096) {
            return Err<GpuContextLease, GpuError>(gpuFailure("gpu.limit", "gpu.context.lease", "GPU resource lease ceiling or metadata budget reached"))
        }
        let lease = GpuContextLease{core: core, slot: index, generation: generation, active: true}
        slot.resourceBorrowers = slot.resourceBorrowers + 1
        core.resourceBorrowers = core.resourceBorrowers + 1
        return Ok<GpuContextLease, GpuError>(lease)
    }
    fun valid() r: Bool {
        if not this.active { return false }
        if not this.core.validSlot(this.slot, this.generation) { return false }
        return this.core.slots[this.slot].resourceBorrowers > 0 and this.core.resourceBorrowers > 0
    }
    /// Ownership remains valid after loss; ready is strictly an admission check.
    fun ready() r: Bool { return this.valid() and not this.core.slots[this.slot].lost }
    fun lostFailure(operation: String) r: GpuError {
        let error = gpuFailure("gpu.device_lost", operation, "GPU context is lost")
        error.nativeCode.free(); error.nativeCode = Some<Int64>(this.core.slots[this.slot].lostNativeCode as Int64)
        return error
    }
    fun admission(operation: String) r: Result<Bool, GpuError> {
        if not this.valid() { return Err<Bool, GpuError>(gpuFailure("gpu.invalid", operation, "GPU context lease is stale")) }
        if not this.ready() { return Err<Bool, GpuError>(this.lostFailure(operation)) }
        return Ok<Bool, GpuError>(true)
    }
    /// Only an actual native loss report changes the slot; OOM never poisons it.
    fun observeFailure(borrow error: GpuError) r: Void {
        if this.valid() and error.code == "gpu.device_lost" and error.nativeCode.isSome() and error.nativeCode.unwrap() == (-4 as Int64) {
            let slot = this.core.slots[this.slot]
            if not slot.lost { slot.lost = true; slot.lostNativeCode = -4 as Int32 }
        }
    }
    fun native() r: Result<UInt64, GpuError> {
        if not this.valid() {
            return Err<UInt64, GpuError>(gpuFailure("gpu.invalid", "gpu.context.lease", "GPU resource context lease is inactive or stale"))
        }
        return Ok<UInt64, GpuError>(this.core.slots[this.slot].native)
    }
    fun close() r: Result<Bool, GpuError> {
        if not this.active { return Ok<Bool, GpuError>(false) }
        if not this.valid() {
            return Err<Bool, GpuError>(gpuFailure("gpu.invalid", "gpu.context.lease", "GPU resource context lease is stale"))
        }
        let slot = this.core.slots[this.slot]
        slot.resourceBorrowers = slot.resourceBorrowers - 1
        this.core.resourceBorrowers = this.core.resourceBorrowers - 1; this.active = false
        return Ok<Bool, GpuError>(true)
    }
    fun release() r: Result<Bool, GpuError> {
        let closed = this.close()
        if closed.isErr() { return closed }
        closed.releaseContainer(); this.free()
        return Ok<Bool, GpuError>(true)
    }
}
