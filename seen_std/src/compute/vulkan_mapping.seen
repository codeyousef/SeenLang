/// Explicit Vulkan host mapping. The pool owns each native mapping; bounded
/// byte-region leases own its views. No queue wait or allocation-kind fallback.
import compute.backend.{GpuBackend}
import compute.buffer.{GpuBuffer}
import compute.buffer_region.{GpuBufferRegion}
import compute.error.{GpuError, gpuFailure}
import compute.vulkan_error.{gpuVkFailure}
import compute.operation.{gpuCheckOperation}
import core.operation_context.{OperationContext}
import core.result.{Result, Ok, Err}
import memory.allocation.{allocationBudgetAvailable}

@repr(C)
class VulkanMappedMemoryRange {
    var sType: UInt32
    var pNext: *Void
    var memory: UInt64
    var offset: UInt64
    var size: UInt64
}
extern "C" fun vkMapMemory(device: UInt64, memory: UInt64, offset: UInt64,
    size: UInt64, flags: UInt32, data: **Void) r: Int32
extern "C" fun vkUnmapMemory(device: UInt64, memory: UInt64) r: Void
extern "C" fun vkFlushMappedMemoryRanges(device: UInt64, count: UInt32,
    ranges: *const VulkanMappedMemoryRange) r: Int32
extern "C" fun vkInvalidateMappedMemoryRanges(device: UInt64, count: UInt32,
    ranges: *const VulkanMappedMemoryRange) r: Int32

fun gpuVkWholeMappedRange(memory: UInt64) r: VulkanMappedMemoryRange {
    return VulkanMappedMemoryRange{sType: 6 as UInt32, pNext: null as *Void,
        memory: memory, offset: 0 as UInt64, size: 18446744073709551615 as UInt64}
}
fun gpuVkDropMappingRegion(region: GpuBufferRegion) r: Void {
    let closed = region.release()
    if closed.isErr() { abort("confined mapping lost its byte-region lease") }
    closed.releaseContainer()
}

@move
class GpuVulkanMappedRegion {
    var region: GpuBufferRegion
    var block: Int
    var address: UInt64
    var active: Bool

    fun valid() r: Bool {
        if not this.active or not this.region.valid() { return false }
        let arena = this.region.core.blocks[this.block]
        return arena.active and arena.mappedBorrowers > 0 and
            arena.mappedAddress != (0 as UInt64) and
            this.address == arena.mappedAddress + this.region.offset
    }
    fun readByte(offset: UInt64) r: Result<UInt8, GpuError> {
        if not this.valid() or offset >= this.region.bytes {
            return Err<UInt8, GpuError>(gpuFailure("gpu.invalid", "gpu.vulkan.map.read", "mapped read escapes its active byte region"))
        }
        let data = this.address as *UInt8
        return Ok<UInt8, GpuError>(data[offset])
    }
    fun writeByte(offset: UInt64, value: UInt8) r: Result<Bool, GpuError> {
        if not this.valid() or not this.region.write or offset >= this.region.bytes {
            return Err<Bool, GpuError>(gpuFailure("gpu.invalid", "gpu.vulkan.map.write", "mapped write requires an active exclusive byte region"))
        }
        let data = this.address as *UInt8; data[offset] = value
        return Ok<Bool, GpuError>(true)
    }
    fun close() r: Result<Bool, GpuError> {
        if not this.active { return Ok<Bool, GpuError>(false) }
        if not this.valid() {
            return Err<Bool, GpuError>(gpuFailure("gpu.invalid", "gpu.vulkan.map.close", "mapped region lifetime is invalid"))
        }
        let arena = this.region.core.blocks[this.block]
        let device = this.region.core.provider.value.contextIdentity()
        if this.region.write and not arena.native.hostCoherent {
            let range = gpuVkWholeMappedRange(arena.native.memory)
            let flushed = vkFlushMappedMemoryRanges(device, 1 as UInt32, (&range) as *const VulkanMappedMemoryRange)
            if flushed != (0 as Int32) {
                // A failed flush preserves both mapping and lease for retry.
                return Err<Bool, GpuError>(gpuVkFailure(flushed, "gpu.vulkan.map.flush"))
            }
        }
        if arena.mappedBorrowers == 1 {
            vkUnmapMemory(device, arena.native.memory); arena.mappedAddress = 0 as UInt64
        }
        arena.mappedBorrowers = arena.mappedBorrowers - 1
        gpuVkDropMappingRegion(this.region); this.active = false; this.address = 0 as UInt64
        return Ok<Bool, GpuError>(true)
    }
    fun release() r: Result<Bool, GpuError> {
        let closed = this.close()
        if closed.isErr() { return closed }
        closed.releaseContainer(); this.free(); return Ok<Bool, GpuError>(true)
    }
}

fun gpuVkMapBuffer<T>(borrow buffer: GpuBuffer<T>, offset: UInt64, bytes: UInt64,
    write: Bool, operation: OperationContext) r: Result<GpuVulkanMappedRegion, GpuError> {
    if not buffer.isOpen() or buffer.core.provider.value.backend() != GpuBackend.Vulkan {
        return Err<GpuVulkanMappedRegion, GpuError>(gpuFailure("gpu.invalid", "gpu.vulkan.map", "mapping requires an active explicit Vulkan buffer"))
    }
    if not allocationBudgetAvailable(4096) {
        return Err<GpuVulkanMappedRegion, GpuError>(gpuFailure("gpu.out_of_memory", "gpu.vulkan.map", "mapping metadata budget is unavailable"))
    }
    let acquired = buffer.region(offset, bytes, write, operation)
    if acquired.isErr() { let error = acquired.unwrapErr(); acquired.releaseContainer(); return Err<GpuVulkanMappedRegion, GpuError>(error) }
    let region = acquired.unwrap(); acquired.releaseContainer()
    let block = buffer.core.slots[buffer.slot].block; let arena = buffer.core.blocks[block]
    if not arena.native.hostVisible {
        gpuVkDropMappingRegion(region)
        return Err<GpuVulkanMappedRegion, GpuError>(gpuFailure("gpu.unsupported_capability", "gpu.vulkan.map", "selected native memory is not host-visible"))
    }
    // Whole-allocation flush/invalidate is atom-aligned. Noncoherent mappings
    // are block-exclusive so invalidation cannot discard another view's writes.
    if not arena.native.hostCoherent and (arena.mappedBorrowers != 0 or arena.regionBorrowers != 1) {
        gpuVkDropMappingRegion(region)
        return Err<GpuVulkanMappedRegion, GpuError>(gpuFailure("gpu.busy", "gpu.vulkan.map", "noncoherent native block already has a host mapping"))
    }
    let device = buffer.core.provider.value.contextIdentity()
    if arena.mappedBorrowers == 0 {
        var pointer = null as *Void
        let status = vkMapMemory(device, arena.native.memory, 0 as UInt64,
            18446744073709551615 as UInt64, 0 as UInt32, &pointer)
        if status != (0 as Int32) {
            gpuVkDropMappingRegion(region)
            return Err<GpuVulkanMappedRegion, GpuError>(gpuVkFailure(status, "gpu.vulkan.map"))
        }
        if pointer == (null as *Void) {
            vkUnmapMemory(device, arena.native.memory); gpuVkDropMappingRegion(region)
            return Err<GpuVulkanMappedRegion, GpuError>(gpuFailure("gpu.invalid", "gpu.vulkan.map", "Vulkan returned an empty mapping"))
        }
        arena.mappedAddress = pointer as UInt64
    }
    if arena.mappedAddress > (18446744073709551615 as UInt64) - region.offset or
        arena.mappedAddress + region.offset > (18446744073709551615 as UInt64) - (region.bytes - (1 as UInt64)) {
        if arena.mappedBorrowers == 0 {
            vkUnmapMemory(device, arena.native.memory); arena.mappedAddress = 0 as UInt64
        }
        gpuVkDropMappingRegion(region)
        return Err<GpuVulkanMappedRegion, GpuError>(gpuFailure("gpu.invalid", "gpu.vulkan.map", "native mapped address overflows its byte span"))
    }
    if not write and not arena.native.hostCoherent {
        let range = gpuVkWholeMappedRange(arena.native.memory)
        let invalidated = vkInvalidateMappedMemoryRanges(device, 1 as UInt32, (&range) as *const VulkanMappedMemoryRange)
        if invalidated != (0 as Int32) {
            vkUnmapMemory(device, arena.native.memory); arena.mappedAddress = 0 as UInt64
            gpuVkDropMappingRegion(region)
            return Err<GpuVulkanMappedRegion, GpuError>(gpuVkFailure(invalidated, "gpu.vulkan.map.invalidate"))
        }
    }
    let observed = gpuCheckOperation(operation, "gpu.vulkan.map")
    if observed.isErr() {
        let error = observed.unwrapErr(); observed.releaseContainer()
        if arena.mappedBorrowers == 0 {
            vkUnmapMemory(device, arena.native.memory); arena.mappedAddress = 0 as UInt64
        }
        gpuVkDropMappingRegion(region)
        return Err<GpuVulkanMappedRegion, GpuError>(error)
    }
    observed.releaseContainer()
    arena.mappedBorrowers = arena.mappedBorrowers + 1
    let mapped = GpuVulkanMappedRegion{region: region, block: block,
        address: arena.mappedAddress + region.offset, active: true}
    return Ok<GpuVulkanMappedRegion, GpuError>(mapped)
}
