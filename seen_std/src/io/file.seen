// File I/O operations
import core.option.{Option, Some, None}
import core.result.{Result, Ok, Err}
import core.unit.{Unit}
import core.error.{SeenError, SeenErrorKind, RetryClass, RedactionClass,
    seenFailure}

fun fileFailure<T>(operation: String, message: String,
    nativeCode: Option<Int64>) r: Result<T, SeenError> {
    return seenFailure<T>(SeenErrorKind.Io, operation, message,
        nativeCode, RetryClass.Never, RedactionClass.Sensitive)
}

extern fun __FileExists(path: String) r: Bool
extern fun __DeleteFile(path: String) r: Bool
extern fun seen_replace_file(source: String, destination: String) r: Bool
extern fun seen_write_text_atomic(destination: String, content: String) r: Bool
extern fun __CreateDirectory(path: String) r: Bool
extern fun __OpenFile(path: String, mode: String) r: Int
extern fun __ReadFile(fd: Int) r: String
extern fun __ReadFileBytes(fd: Int, size: Int) r: Array<Int>
extern fun __WriteFile(fd: Int, content: String) r: Int
extern fun __WriteFileBytes(fd: Int, bytes: Array<Int>) r: Int
extern fun seen_file_seek(fd: Int, offset: Int) r: Bool
extern fun __CloseFile(fd: Int) r: Int
extern fun __FileSize(fd: Int) r: Int
extern fun __FileError(fd: Int) r: String
extern fun stdoutLine(s: String) r: Void

class FsFile {
    var fd: Int
    var path: String
    
    static fun open(path: String) r: Result<FsFile, SeenError> {
        let file_desc = __OpenFile(path, "r")
        if file_desc < 0 {
            return fileFailure<FsFile>("open", "failed to open file",
                Some<Int64>(file_desc as Int64))
        }
        return Ok(FsFile { fd: file_desc, path: path })
    }
    
    static fun create(path: String) r: Result<FsFile, SeenError> {
        let file_desc = __OpenFile(path, "w")
        if file_desc < 0 {
            return fileFailure<FsFile>("create", "failed to create file",
                Some<Int64>(file_desc as Int64))
        }
        return Ok(FsFile { fd: file_desc, path: path })
    }
    
    fun readContent() r: Result<String, SeenError> {
        let content: String = __ReadFile(this.fd)
        let errMsg: String = __FileError(this.fd)
        if content == "" and errMsg != "" {
            return fileFailure<String>("read", "failed to read file", None<Int64>())
        }
        return Ok<String, SeenError>(content)
    }
    
    fun read_bytes(size: Int) r: Result<Array<Int>, SeenError> {
        let bytes: Array<Int> = __ReadFileBytes(this.fd, size)
        let errMsg: String = __FileError(this.fd)
        if bytes.len() == 0 and errMsg != "" {
            let failed = fileFailure<Int>("read", "failed to read file", None<Int64>())
            return Err<Array<Int>, SeenError>(failed.unwrapErr())
        }
        return Ok(bytes)
    }
    
    fun writeContent(content: String) r: Result<Int, SeenError> {
        let written: Int = __WriteFile(this.fd, content)
        if written < 0 {
            return fileFailure<Int>("write", "failed to write file",
                Some<Int64>(written as Int64))
        }
        return Ok(written)
    }
    
    fun write_bytes(bytes: Array<Int>) r: Result<Int, SeenError> {
        let written: Int = __WriteFileBytes(this.fd, bytes)
        if written < 0 {
            return fileFailure<Int>("write", "failed to write file bytes",
                Some<Int64>(written as Int64))
        }
        return Ok(written)
    }
    
    fun closeFile() r: Result<Unit, SeenError> {
        let result: Int = __CloseFile(this.fd)
        if result < 0 {
            return fileFailure<Unit>("close", "failed to close file",
                Some<Int64>(result as Int64))
        }
        return Ok(Unit{})
    }
    
    fun size() r: Result<Int, SeenError> {
        let fileSize: Int = __FileSize(this.fd)
        if fileSize < 0 {
            return fileFailure<Int>("size", "failed to get file size",
                Some<Int64>(fileSize as Int64))
        }
        return Ok(fileSize)
    }
}

///
/// Bootstrap-safe checked text read. Unlike readText, this distinguishes a
/// valid empty file from an open/read/close failure. It deliberately avoids a
/// generic Result return so bootstrap compilers do not need to synthesize
/// cross-module Result method specializations merely to discover data files.
///
class CheckedTextRead {
    var success: Bool
    var content: String
    var error: Option<SeenError>

    static fun ok(content: String) r: CheckedTextRead {
        return CheckedTextRead{
            success: true, content: content, error: None<SeenError>()
        }
    }

    static fun err(operation: String, message: String) r: CheckedTextRead {
        let failed = fileFailure<SeenError>(operation, message, None<Int64>())
        return CheckedTextRead{
            success: false, content: "", error: Some<SeenError>(failed.unwrapErr())
        }
    }
}

fun readTextChecked(path: String) r: CheckedTextRead {
    let fd: Int = __OpenFile(path, "rb")
    if fd < 0 {
        return CheckedTextRead.err("open", "failed to open file")
    }

    let expectedSize: Int = __FileSize(fd)
    if expectedSize < 0 {
        let _ = __CloseFile(fd)
        return CheckedTextRead.err("size", "failed to determine file size")
    }
    let content: String = __ReadFile(fd)
    let readError: String = __FileError(fd)
    let closeResult: Int = __CloseFile(fd)
    if readError != "" or content.length() != expectedSize {
        return CheckedTextRead.err("read", "failed to read file")
    }
    if closeResult < 0 {
        return CheckedTextRead.err("close", "failed to close file")
    }
    return CheckedTextRead.ok(content)
}

/// Frozen bootstrap-only scalar ABI. New fallible code uses FsFile or
/// readTextChecked; the ERR-001C audit pins this exception inventory.
fun readText(path: String) r: String {
    let fd: Int = __OpenFile(path, "r")
    if fd < 0 {
        return ""
    }

    let content: String = __ReadFile(fd)
    let err: String = __FileError(fd)
    let closeResult: Int = __CloseFile(fd)

    let contentLen: Int = content.len()
    let errLen: Int = err.len()
    if contentLen == 0 and errLen > 0 {
         return ""
    }
    return content
}

fun writeText(path: String, content: String) r: Bool {
    let fd: Int = __OpenFile(path, "w")
    if fd < 0 {
        return false
    }
    let written: Int = __WriteFile(fd, content)
    let closeResult: Int = __CloseFile(fd)
    return written == content.length() and closeResult >= 0
}

///
/// Bootstrap-safe transactional text output. The runtime creates an exclusive
/// temporary file beside path, validates every write/sync/close operation, and
/// commits with one atomic replacement. A failure before commit preserves an
/// existing destination and removes only the temporary file owned by this call.
/// Existing symlink destinations are rejected rather than followed.
///
fun writeTextAtomically(path: String, content: String) r: Bool {
    return seen_write_text_atomic(path, content)
}

fun appendText(path: String, content: String) r: Bool {
    let fd: Int = __OpenFile(path, "a")
    if fd < 0 {
        return false
    }
    let written: Int = __WriteFile(fd, content)
    let closeResult: Int = __CloseFile(fd)
    return written >= 0
}

fun exists(path: String) r: Bool {
    return __FileExists(path)
}

fun deleteFile(path: String) r: Bool {
    return __DeleteFile(path)
}

fun replaceFile(source: String, destination: String) r: Bool {
    return seen_replace_file(source, destination)
}

fun createDirectory(path: String) r: Bool {
    return __CreateDirectory(path)
}

fun size(path: String) r: Int {
    let fd: Int = __OpenFile(path, "rb")
    if fd < 0 {
        return -1
    }
    let fileSize: Int = __FileSize(fd)
    let _ = __CloseFile(fd)
    return fileSize
}

fun readBytes(path: String) r: Array<Int> {
    let fd: Int = __OpenFile(path, "rb")
    if fd < 0 {
        return Array<Int>()
    }
    let fileSize: Int = __FileSize(fd)
    if fileSize < 0 {
        let _ = __CloseFile(fd)
        return Array<Int>()
    }
    let bytes: Array<Int> = __ReadFileBytes(fd, fileSize)
    let _ = __CloseFile(fd)
    return bytes
}

fun readBytesPrefix(path: String, maxBytes: Int) r: Array<Int> {
    return readBytesRange(path, 0, maxBytes)
}

fun readBytesRange(path: String, offset: Int, byteCount: Int) r: Array<Int> {
    if offset < 0 or byteCount <= 0 {
        return Array<Int>()
    }
    let fd: Int = __OpenFile(path, "rb")
    if fd < 0 {
        return Array<Int>()
    }
    if not seen_file_seek(fd, offset) {
        let _ = __CloseFile(fd)
        return Array<Int>()
    }
    let bytes: Array<Int> = __ReadFileBytes(fd, byteCount)
    let _ = __CloseFile(fd)
    return bytes
}

fun writeBytes(path: String, bytes: Array<Int>) r: Bool {
    ensureParentDirectories(path)
    let fd: Int = __OpenFile(path, "wb")
    if fd < 0 {
        return false
    }
    let written: Int = __WriteFileBytes(fd, bytes)
    let _ = __CloseFile(fd)
    return written >= 0
}

fun writeBytesAt(path: String, offset: Int, bytes: Array<Int>) r: Bool {
    if offset < 0 {
        return false
    }
    let fd: Int = __OpenFile(path, "r+b")
    if fd < 0 {
        return false
    }
    if not seen_file_seek(fd, offset) {
        let _ = __CloseFile(fd)
        return false
    }
    let written: Int = __WriteFileBytes(fd, bytes)
    let _ = __CloseFile(fd)
    return written == bytes.length()
}

fun copyFileBytes(src: String, dst: String) r: Bool {
    if not exists(src) {
        return false
    }
    ensureParentDirectories(dst)
    let inFd: Int = __OpenFile(src, "rb")
    if inFd < 0 {
        return false
    }
    let outFd: Int = __OpenFile(dst, "wb")
    if outFd < 0 {
        let _ = __CloseFile(inFd)
        return false
    }
    let chunkSize = 65536
    var total = 0
    var ok = true
    var done = false
    while not done {
        let chunk: Array<Int> = __ReadFileBytes(inFd, chunkSize)
        if chunk.length() == 0 {
            done = true
        } else {
            let written: Int = __WriteFileBytes(outFd, chunk)
            if written != chunk.length() {
                ok = false
                done = true
            } else {
                total = total + written
                if chunk.length() < chunkSize {
                    done = true
                }
            }
        }
    }
    let _ = __CloseFile(inFd)
    let _ = __CloseFile(outFd)
    let expected = size(src)
    if expected >= 0 and total != expected {
        return false
    }
    return ok
}

fun writeLines(path: String, lines: Array<String>) r: Bool {
    var content = ""
    var i = 0
    while i < lines.length() {
        if i > 0 {
            content = content + "\n"
        }
        content = content + lines[i]
        i = i + 1
    }
    return writeText(path, content)
}

fun hash(path: String) r: String {
    let content = readText(path)
    var value = 1469598103934665603
    var i = 0
    while i < content.length() {
        value = value ^ content.charAt(i)
        value = value * 1099511628211
        i = i + 1
    }
    return value.toString()
}

fun ensureParentDirectories(path: String) r: Bool {
    var i = 0
    while i < path.length() {
        if path.substring(i, i + 1) == "/" {
            let parent = path.substring(0, i)
            if parent.length() > 0 {
                createDirectory(parent)
            }
        }
        i = i + 1
    }
    return true
}
