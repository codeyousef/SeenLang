// Checked byte ownership and borrowed-view primitives.
//
// Byte counts use nonnegative 64-bit Int values. Views retain their owner,
// record its generation, and must be closed explicitly. A mutable view is
// exclusive; releasing its owner invalidates every outstanding view.

import core.result.{Result, Ok, Err}
import core.error.{AsciiString}
import core.operation_context.{OperationContext}

class IoError {
    var code: AsciiString
    var operation: AsciiString
    var message: String
    var retryable: Bool
}

let BYTE_MAX_COUNT: Int = 9223372036854775807
let BYTE_MAX_CAPACITY: Int = 1073741824
let BYTE_DEFAULT_ALIGNMENT: Int = 32
let BYTE_MAX_ALIGNMENT: Int = 32
let BYTE_ERROR_INVALID: String = "byte.invalid"
let BYTE_ERROR_LIMIT: String = "byte.limit"
let BYTE_ERROR_CANCELLED: String = "byte.cancelled"
let BYTE_ERROR_TIMEOUT: String = "byte.timeout"
let BYTE_ERROR_UNAVAILABLE: String = "byte.unavailable"
let BYTE_ERROR_UNSUPPORTED_PLATFORM: String = "byte.unsupported_platform"

fun byteFailure(code: String, operation: String, message: String,
    retryable: Bool = false) r: IoError {

    return IoError{
        code: AsciiString{ value: code },
        operation: AsciiString{ value: operation },
        message: message, retryable: retryable
    }
}

fun validateByteRange(totalLength: Int, offset: Int, count: Int)
    r: Result<Bool, IoError> {

    if totalLength < 0 or offset < 0 or count < 0 {
        return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "slice",
            "byte range values must be nonnegative"))
    }
    if totalLength > BYTE_MAX_COUNT or offset > totalLength or
        count > totalLength - offset {

        return Err<Bool, IoError>(byteFailure(BYTE_ERROR_LIMIT, "slice",
            "byte range exceeds its owner bound"))
    }
    return Ok<Bool, IoError>(true)
}

fun validateByteRangeInContext(context: OperationContext, totalLength: Int,
    offset: Int, count: Int) r: Result<Bool, IoError> {

    if context.cancellation {
        return Err<Bool, IoError>(byteFailure(BYTE_ERROR_CANCELLED, "slice",
            "byte slice acquisition is cancelled"))
    }
    return validateByteRange(totalLength, offset, count)
}

fun isValidByteAlignment(alignment: Int) r: Bool {
    if alignment <= 0 or alignment > BYTE_MAX_ALIGNMENT { return false }
    return (alignment & (alignment - 1)) == 0
}

fun validateByteCapacity(capacity: Int, alignment: Int)
    r: Result<Bool, IoError> {

    if capacity < 0 or not isValidByteAlignment(alignment) {
        return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "allocate",
            "byte capacity must be nonnegative and alignment must be a power of two through 32"))
    }
    if capacity > BYTE_MAX_CAPACITY {
        return Err<Bool, IoError>(byteFailure(BYTE_ERROR_LIMIT, "allocate",
            "byte capacity exceeds the bounded allocation limit"))
    }
    return Ok<Bool, IoError>(true)
}

class ByteOwner {
    var data: Array<Int>
    var capacity: Int
    var alignment: Int
    var generation: Int
    var active: Bool
    var sharedBorrows: Int
    var mutableBorrowed: Bool
}

@move
class ByteBuffer {
    var owner: ByteOwner

    static fun fromArray(source: Array<Int>) r: ByteBuffer {
        let copied = Array<Int>()
        var index = 0
        while index < source.length() {
            copied.push(source[index] & 255)
            index = index + 1
        }
        return ByteBuffer{
            owner: ByteOwner{
                data: copied, capacity: copied.length(),
                alignment: BYTE_DEFAULT_ALIGNMENT, generation: 1, active: true,
                sharedBorrows: 0, mutableBorrowed: false
            }
        }
    }

    static fun empty() r: ByteBuffer {
        return ByteBuffer.fromArray(Array<Int>())
    }

    fun length() r: Int {
        if not this.owner.active { return 0 }
        return this.owner.data.length()
    }

    fun capacity() r: Int {
        if not this.owner.active { return 0 }
        return this.owner.capacity
    }

    fun alignment() r: Int {
        if not this.owner.active { return 0 }
        return this.owner.alignment
    }

    fun reserve(requiredCapacity: Int) r: Result<Bool, IoError> {
        if not this.owner.active {
            return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "reserve",
                "byte owner has been released"))
        }
        if this.owner.mutableBorrowed or this.owner.sharedBorrows > 0 {
            return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "reserve",
                "byte owner cannot grow while a view is borrowed"))
        }
        let checked = validateByteCapacity(requiredCapacity, this.owner.alignment)
        if checked.isErr() {
            return Err<Bool, IoError>(checked.unwrapErr())
        }
        if requiredCapacity <= this.owner.capacity {
            return Ok<Bool, IoError>(false)
        }
        let replacement = Array<Int>()
        var index = 0
        while index < this.owner.data.length() {
            replacement.push(this.owner.data[index])
            index = index + 1
        }
        this.owner.data = replacement
        this.owner.capacity = requiredCapacity
        this.owner.generation = this.owner.generation + 1
        return Ok<Bool, IoError>(true)
    }

    fun push(value: Int) r: Result<Bool, IoError> {
        if value < 0 or value > 255 {
            return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "push",
                "byte value is outside 0 through 255"))
        }
        if not this.owner.active or this.owner.mutableBorrowed or
            this.owner.sharedBorrows > 0 {

            return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "push",
                "byte owner is released or borrowed"))
        }
        if this.owner.data.length() >= this.owner.capacity {
            var nextCapacity = this.owner.capacity * 2
            if nextCapacity < 1 { nextCapacity = 1 }
            if nextCapacity < this.owner.data.length() + 1 {
                nextCapacity = this.owner.data.length() + 1
            }
            let grown = this.reserve(nextCapacity)
            if grown.isErr() { return Err<Bool, IoError>(grown.unwrapErr()) }
        }
        this.owner.data.push(value)
        return Ok<Bool, IoError>(true)
    }

    fun append(source: ByteSlice) r: Result<Int, IoError> {
        if not source.active or not source.owner.active or
            source.generation != source.owner.generation {

            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "append",
                "source byte slice is stale or closed"))
        }
        if not this.owner.active or this.owner.mutableBorrowed or
            this.owner.sharedBorrows > 0 {

            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "append",
                "destination byte owner is released or borrowed"))
        }
        if source.count > BYTE_MAX_CAPACITY - this.owner.data.length() {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_LIMIT, "append",
                "appended bytes exceed the bounded allocation limit"))
        }
        let required = this.owner.data.length() + source.count
        if required > this.owner.capacity {
            let grown = this.reserve(required)
            if grown.isErr() { return Err<Int, IoError>(grown.unwrapErr()) }
        }
        var index = 0
        while index < source.count {
            this.owner.data.push(source.owner.data[source.offset + index])
            index = index + 1
        }
        return Ok<Int, IoError>(source.count)
    }

    fun toArray() r: Result<Array<Int>, IoError> {
        if not this.owner.active {
            return Err<Array<Int>, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "copy", "byte owner has been released"))
        }
        let copied = Array<Int>()
        var index = 0
        while index < this.owner.data.length() {
            copied.push(this.owner.data[index])
            index = index + 1
        }
        return Ok<Array<Int>, IoError>(copied)
    }

    fun slice(offset: Int, count: Int) r: Result<ByteSlice, IoError> {
        if not this.owner.active {
            return Err<ByteSlice, IoError>(byteFailure(BYTE_ERROR_INVALID, "slice",
                "byte owner has been released"))
        }
        if this.owner.mutableBorrowed {
            return Err<ByteSlice, IoError>(byteFailure(BYTE_ERROR_INVALID, "slice",
                "byte owner has an active mutable borrow"))
        }
        let checked = validateByteRange(this.owner.data.length(), offset, count)
        if checked.isErr() {
            return Err<ByteSlice, IoError>(checked.unwrapErr())
        }
        this.owner.sharedBorrows = this.owner.sharedBorrows + 1
        return Ok<ByteSlice, IoError>(ByteSlice{
            owner: this.owner, offset: offset, count: count,
            generation: this.owner.generation, active: true
        })
    }

    fun sliceInContext(context: OperationContext, offset: Int, count: Int)
        r: Result<ByteSlice, IoError> {

        let checked = validateByteRangeInContext(context,
            this.owner.data.length(), offset, count)
        if checked.isErr() {
            return Err<ByteSlice, IoError>(checked.unwrapErr())
        }
        return this.slice(offset, count)
    }

    fun mutableSlice(offset: Int, count: Int)
        r: Result<MutableByteSlice, IoError> {

        if not this.owner.active {
            return Err<MutableByteSlice, IoError>(byteFailure(
                BYTE_ERROR_INVALID, "mutable-slice", "byte owner has been released"))
        }
        if this.owner.mutableBorrowed or this.owner.sharedBorrows > 0 {
            return Err<MutableByteSlice, IoError>(byteFailure(
                BYTE_ERROR_INVALID, "mutable-slice",
                "byte owner already has an active borrow"))
        }
        let checked = validateByteRange(this.owner.data.length(), offset, count)
        if checked.isErr() {
            return Err<MutableByteSlice, IoError>(checked.unwrapErr())
        }
        this.owner.mutableBorrowed = true
        return Ok<MutableByteSlice, IoError>(MutableByteSlice{
            owner: this.owner, offset: offset, count: count,
            generation: this.owner.generation, active: true
        })
    }

    fun mutableSliceInContext(context: OperationContext, offset: Int,
        count: Int) r: Result<MutableByteSlice, IoError> {

        let checked = validateByteRangeInContext(context,
            this.owner.data.length(), offset, count)
        if checked.isErr() {
            return Err<MutableByteSlice, IoError>(checked.unwrapErr())
        }
        return this.mutableSlice(offset, count)
    }

    fun release() r: Result<Bool, IoError> {
        if not this.owner.active { return Ok<Bool, IoError>(false) }
        this.owner.active = false
        this.owner.generation = this.owner.generation + 1
        this.owner.sharedBorrows = 0
        this.owner.mutableBorrowed = false
        this.owner.data = Array<Int>()
        this.owner.capacity = 0
        return Ok<Bool, IoError>(true)
    }
}

fun tryByteBufferWithCapacity(capacity: Int,
    alignment: Int = BYTE_DEFAULT_ALIGNMENT) r: Result<ByteBuffer, IoError> {

    let checked = validateByteCapacity(capacity, alignment)
    if checked.isErr() {
        return Err<ByteBuffer, IoError>(checked.unwrapErr())
    }
    return Ok<ByteBuffer, IoError>(ByteBuffer{
        owner: ByteOwner{
            data: Array<Int>(), capacity: capacity,
            alignment: alignment, generation: 1, active: true,
            sharedBorrows: 0, mutableBorrowed: false
        }
    })
}

fun tryZeroedByteBuffer(length: Int,
    alignment: Int = BYTE_DEFAULT_ALIGNMENT) r: Result<ByteBuffer, IoError> {

    let allocated = tryByteBufferWithCapacity(length, alignment)
    if allocated.isErr() {
        return Err<ByteBuffer, IoError>(allocated.unwrapErr())
    }
    let buffer = allocated.unwrap()
    var index = 0
    while index < length {
        buffer.owner.data.push(0)
        index = index + 1
    }
    return Ok<ByteBuffer, IoError>(buffer)
}

class ByteSlice {
    var owner: ByteOwner
    var offset: Int
    var count: Int
    var generation: Int
    var active: Bool

    fun length() r: Int { return this.count }

    fun get(index: Int) r: Result<Int, IoError> {
        if not this.active or not this.owner.active or
            this.generation != this.owner.generation {

            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "read",
                "byte slice is stale or closed"))
        }
        let checked = validateByteRange(this.count, index, 1)
        if checked.isErr() {
            return Err<Int, IoError>(checked.unwrapErr())
        }
        return Ok<Int, IoError>(this.owner.data[this.offset + index])
    }

    fun close() r: Result<Bool, IoError> {
        if not this.active { return Ok<Bool, IoError>(false) }
        this.active = false
        if this.owner.active and this.generation == this.owner.generation and
            this.owner.sharedBorrows > 0 {

            this.owner.sharedBorrows = this.owner.sharedBorrows - 1
        }
        return Ok<Bool, IoError>(true)
    }
}

@move
class MutableByteSlice {
    var owner: ByteOwner
    var offset: Int
    var count: Int
    var generation: Int
    var active: Bool

    fun length() r: Int { return this.count }

    fun get(index: Int) r: Result<Int, IoError> {
        if not this.active or not this.owner.active or
            this.generation != this.owner.generation {

            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "read",
                "mutable byte slice is stale or closed"))
        }
        let checked = validateByteRange(this.count, index, 1)
        if checked.isErr() {
            return Err<Int, IoError>(checked.unwrapErr())
        }
        return Ok<Int, IoError>(this.owner.data[this.offset + index])
    }

    fun set(index: Int, value: Int) r: Result<Bool, IoError> {
        if value < 0 or value > 255 {
            return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "write",
                "byte value is outside 0 through 255"))
        }
        if not this.active or not this.owner.active or
            this.generation != this.owner.generation {

            return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "write",
                "mutable byte slice is stale or closed"))
        }
        let checked = validateByteRange(this.count, index, 1)
        if checked.isErr() {
            return Err<Bool, IoError>(checked.unwrapErr())
        }
        this.owner.data[this.offset + index] = value
        return Ok<Bool, IoError>(true)
    }

    fun close() r: Result<Bool, IoError> {
        if not this.active { return Ok<Bool, IoError>(false) }
        this.active = false
        if this.owner.active and this.generation == this.owner.generation {
            this.owner.mutableBorrowed = false
        }
        return Ok<Bool, IoError>(true)
    }
}

let BYTE_SEEK_START: Int = 0
let BYTE_SEEK_CURRENT: Int = 1
let BYTE_SEEK_END: Int = 2

fun validateByteOperation(context: OperationContext, operation: String)
    r: Result<Bool, IoError> {

    if context.cancellation {
        return Err<Bool, IoError>(byteFailure(BYTE_ERROR_CANCELLED, operation,
            "byte operation is cancelled"))
    }
    if context.monotonicDeadline < 0 {
        return Err<Bool, IoError>(byteFailure(BYTE_ERROR_TIMEOUT, operation,
            "byte operation deadline has expired"))
    }
    return Ok<Bool, IoError>(true)
}

trait Reader {
    fun read(this: Reader, context: OperationContext,
        destination: MutableByteSlice) r: Result<Int, IoError>
}

trait Writer {
    fun write(this: Writer, context: OperationContext,
        source: ByteSlice) r: Result<Int, IoError>
}

trait Seeker {
    fun seek(this: Seeker, context: OperationContext, offset: Int,
        origin: Int) r: Result<Int, IoError>
}

trait BufRead {
    fun fillBuf(this: BufRead, context: OperationContext)
        r: Result<ByteSlice, IoError>
    fun consume(this: BufRead, context: OperationContext, count: Int)
        r: Result<Int, IoError>
}

trait Flush {
    fun flush(this: Flush, context: OperationContext) r: Result<Bool, IoError>
}

@move
class ByteReader {
    var storage: ByteBuffer
    var position: Int
    var active: Bool

    static fun fromArray(source: Array<Int>) r: ByteReader {
        return ByteReader{
            storage: ByteBuffer.fromArray(source), position: 0, active: true
        }
    }

    fun remaining() r: Int {
        if not this.active { return 0 }
        return this.storage.length() - this.position
    }

    fun read(context: OperationContext,
        destination: MutableByteSlice) r: Result<Int, IoError> {

        let allowed = validateByteOperation(context, "read")
        if allowed.isErr() { return Err<Int, IoError>(allowed.unwrapErr()) }
        if not this.active or not destination.active or
            not destination.owner.active or
            destination.generation != destination.owner.generation {

            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "read",
                "reader or destination byte slice is closed or stale"))
        }
        var count = destination.count
        let available = this.storage.length() - this.position
        if count > available { count = available }
        var index = 0
        while index < count {
            destination.owner.data[destination.offset + index] =
                this.storage.owner.data[this.position + index]
            index = index + 1
        }
        this.position = this.position + count
        return Ok<Int, IoError>(count)
    }

    fun seek(context: OperationContext, offset: Int,
        origin: Int) r: Result<Int, IoError> {

        let allowed = validateByteOperation(context, "seek")
        if allowed.isErr() { return Err<Int, IoError>(allowed.unwrapErr()) }
        if not this.active {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "seek",
                "reader is closed"))
        }
        var base = 0
        if origin == BYTE_SEEK_CURRENT {
            base = this.position
        } else if origin == BYTE_SEEK_END {
            base = this.storage.length()
        } else if origin != BYTE_SEEK_START {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "seek",
                "seek origin is invalid"))
        }
        if offset > 0 and base > BYTE_MAX_COUNT - offset {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_LIMIT, "seek",
                "seek position overflows checked byte geometry"))
        }
        let target = base + offset
        if target < 0 or target > this.storage.length() {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_LIMIT, "seek",
                "seek position is outside the reader"))
        }
        this.position = target
        return Ok<Int, IoError>(target)
    }

    fun fillBuf(context: OperationContext)
        r: Result<ByteSlice, IoError> {

        let allowed = validateByteOperation(context, "fill-buffer")
        if allowed.isErr() {
            return Err<ByteSlice, IoError>(allowed.unwrapErr())
        }
        if not this.active {
            return Err<ByteSlice, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "fill-buffer", "reader is closed"))
        }
        return this.storage.slice(this.position,
            this.storage.length() - this.position)
    }

    fun consume(context: OperationContext, count: Int)
        r: Result<Int, IoError> {

        let allowed = validateByteOperation(context, "consume")
        if allowed.isErr() { return Err<Int, IoError>(allowed.unwrapErr()) }
        if not this.active or count < 0 {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "consume",
                "reader is closed or count is negative"))
        }
        if count > this.storage.length() - this.position {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_LIMIT, "consume",
                "consume count exceeds buffered bytes"))
        }
        this.position = this.position + count
        return Ok<Int, IoError>(count)
    }

    fun close() r: Result<Bool, IoError> {
        if not this.active { return Ok<Bool, IoError>(false) }
        this.active = false
        let released = this.storage.release()
        if released.isErr() { return Err<Bool, IoError>(released.unwrapErr()) }
        return Ok<Bool, IoError>(true)
    }
}

@move
class ByteWriter {
    var storage: ByteBuffer
    var maxBytes: Int
    var active: Bool

    fun length() r: Int {
        if not this.active { return 0 }
        return this.storage.length()
    }

    fun toArray() r: Result<Array<Int>, IoError> {
        if not this.active {
            return Err<Array<Int>, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "copy", "writer is closed"))
        }
        return this.storage.toArray()
    }

    fun write(context: OperationContext, source: ByteSlice)
        r: Result<Int, IoError> {

        let allowed = validateByteOperation(context, "write")
        if allowed.isErr() { return Err<Int, IoError>(allowed.unwrapErr()) }
        if not this.active or not source.active or not source.owner.active or
            source.generation != source.owner.generation {

            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "write",
                "writer or source byte slice is closed or stale"))
        }
        let available = this.maxBytes - this.storage.length()
        if available <= 0 and source.count > 0 {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_LIMIT, "write",
                "writer byte limit is exhausted"))
        }
        var count = source.count
        if count > available { count = available }
        var index = 0
        while index < count {
            let pushed = this.storage.push(
                source.owner.data[source.offset + index])
            if pushed.isErr() { return Err<Int, IoError>(pushed.unwrapErr()) }
            index = index + 1
        }
        return Ok<Int, IoError>(count)
    }

    fun flush(context: OperationContext) r: Result<Bool, IoError> {
        let allowed = validateByteOperation(context, "flush")
        if allowed.isErr() { return Err<Bool, IoError>(allowed.unwrapErr()) }
        if not this.active {
            return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "flush",
                "writer is closed"))
        }
        return Ok<Bool, IoError>(true)
    }

    fun close() r: Result<Bool, IoError> {
        if not this.active { return Ok<Bool, IoError>(false) }
        this.active = false
        let released = this.storage.release()
        if released.isErr() { return Err<Bool, IoError>(released.unwrapErr()) }
        return Ok<Bool, IoError>(true)
    }
}

fun tryByteWriterWithLimit(maxBytes: Int) r: Result<ByteWriter, IoError> {
    if maxBytes < 0 {
        return Err<ByteWriter, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "writer", "writer limit must be nonnegative"))
    }
    if maxBytes > BYTE_MAX_CAPACITY {
        return Err<ByteWriter, IoError>(byteFailure(BYTE_ERROR_LIMIT,
            "writer", "writer limit exceeds bounded capacity"))
    }
    let allocated = tryByteBufferWithCapacity(0, 32)
    if allocated.isErr() {
        return Err<ByteWriter, IoError>(allocated.unwrapErr())
    }
    return Ok<ByteWriter, IoError>(ByteWriter{
        storage: allocated.unwrap(), maxBytes: maxBytes, active: true
    })
}

class CopyResult {
    var readBytes: Int
    var writtenBytes: Int
    var limitReached: Bool
    var complete: Bool
}

@move
class LimitedReader {
    var reader: ByteReader
    var remainingLimit: Int
    var active: Bool

    static fun fromArray(source: Array<Int>, limit: Int) r: LimitedReader {
        var bounded = limit
        if bounded < 0 { bounded = 0 }
        return LimitedReader{
            reader: ByteReader.fromArray(source), remainingLimit: bounded,
            active: true
        }
    }

    fun read(context: OperationContext, destination: MutableByteSlice)
        r: Result<Int, IoError> {

        let allowed = validateByteOperation(context, "limited-read")
        if allowed.isErr() { return Err<Int, IoError>(allowed.unwrapErr()) }
        if not this.active or not destination.active or
            not destination.owner.active or
            destination.generation != destination.owner.generation {

            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "limited-read", "limited reader or destination is closed"))
        }
        var count = destination.count
        if count > this.remainingLimit { count = this.remainingLimit }
        let available = this.reader.remaining()
        if count > available { count = available }
        var index = 0
        while index < count {
            destination.owner.data[destination.offset + index] =
                this.reader.storage.owner.data[this.reader.position + index]
            index = index + 1
        }
        this.reader.position = this.reader.position + count
        this.remainingLimit = this.remainingLimit - count
        return Ok<Int, IoError>(count)
    }

    fun close() r: Result<Bool, IoError> {
        if not this.active { return Ok<Bool, IoError>(false) }
        this.active = false
        return this.reader.close()
    }
}

@move
class CountingReader {
    var reader: ByteReader
    var bytesRead: Int
    var active: Bool

    static fun fromArray(source: Array<Int>) r: CountingReader {
        return CountingReader{
            reader: ByteReader.fromArray(source), bytesRead: 0, active: true
        }
    }

    fun read(context: OperationContext, destination: MutableByteSlice)
        r: Result<Int, IoError> {

        if not this.active {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "counting-read", "counting reader is closed"))
        }
        let progress = this.reader.read(context, destination)
        if progress.isErr() { return Err<Int, IoError>(progress.unwrapErr()) }
        this.bytesRead = this.bytesRead + progress.unwrap()
        return progress
    }

    fun count() r: Int { return this.bytesRead }

    fun close() r: Result<Bool, IoError> {
        if not this.active { return Ok<Bool, IoError>(false) }
        this.active = false
        return this.reader.close()
    }
}

@move
class TeeReader {
    var reader: ByteReader
    var sink: ByteWriter
    var bytesRead: Int
    var bytesTeeWritten: Int
    var active: Bool

    fun read(context: OperationContext, destination: MutableByteSlice)
        r: Result<Int, IoError> {

        let allowed = validateByteOperation(context, "tee-read")
        if allowed.isErr() { return Err<Int, IoError>(allowed.unwrapErr()) }
        if not this.active or not destination.active or
            not destination.owner.active or
            destination.generation != destination.owner.generation {

            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "tee-read", "tee reader or destination is closed"))
        }
        var count = destination.count
        let available = this.reader.remaining()
        if count > available { count = available }
        let sinkAvailable = this.sink.maxBytes - this.sink.storage.length()
        if count > sinkAvailable { count = sinkAvailable }
        if count == 0 and available > 0 and destination.count > 0 {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_LIMIT, "tee-read",
                "tee sink byte limit is exhausted"))
        }
        var index = 0
        while index < count {
            let value = this.reader.storage.owner.data[
                this.reader.position + index]
            destination.owner.data[destination.offset + index] = value
            let pushed = this.sink.storage.push(value)
            if pushed.isErr() { return Err<Int, IoError>(pushed.unwrapErr()) }
            index = index + 1
        }
        this.reader.position = this.reader.position + count
        this.bytesRead = this.bytesRead + count
        this.bytesTeeWritten = this.bytesTeeWritten + count
        return Ok<Int, IoError>(count)
    }

    fun close() r: Result<Bool, IoError> {
        if not this.active { return Ok<Bool, IoError>(false) }
        this.active = false
        let readerClosed = this.reader.close()
        let sinkClosed = this.sink.close()
        if readerClosed.isErr() { return Err<Bool, IoError>(readerClosed.unwrapErr()) }
        if sinkClosed.isErr() { return Err<Bool, IoError>(sinkClosed.unwrapErr()) }
        return Ok<Bool, IoError>(true)
    }
}

fun tryTeeReader(source: Array<Int>, sinkLimit: Int)
    r: Result<TeeReader, IoError> {

    let sink = tryByteWriterWithLimit(sinkLimit)
    if sink.isErr() { return Err<TeeReader, IoError>(sink.unwrapErr()) }
    return Ok<TeeReader, IoError>(TeeReader{
        reader: ByteReader.fromArray(source), sink: sink.unwrap(),
        bytesRead: 0, bytesTeeWritten: 0, active: true
    })
}

@move
class HashingWriter {
    var writer: ByteWriter
    var hashValue: Int
    var bytesWritten: Int
    var active: Bool

    fun write(context: OperationContext, source: ByteSlice)
        r: Result<Int, IoError> {

        if not this.active {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "hash-write", "hashing writer is closed"))
        }
        let progress = this.writer.write(context, source)
        if progress.isErr() { return Err<Int, IoError>(progress.unwrapErr()) }
        let count = progress.unwrap()
        var index = 0
        while index < count {
            this.hashValue = ((this.hashValue * 257) +
                source.owner.data[source.offset + index]) & 2147483647
            index = index + 1
        }
        this.bytesWritten = this.bytesWritten + count
        return Ok<Int, IoError>(count)
    }

    fun digest() r: Int { return this.hashValue }

    fun close() r: Result<Bool, IoError> {
        if not this.active { return Ok<Bool, IoError>(false) }
        this.active = false
        return this.writer.close()
    }
}

fun tryHashingWriter(limit: Int) r: Result<HashingWriter, IoError> {
    let writer = tryByteWriterWithLimit(limit)
    if writer.isErr() {
        return Err<HashingWriter, IoError>(writer.unwrapErr())
    }
    return Ok<HashingWriter, IoError>(HashingWriter{
        writer: writer.unwrap(), hashValue: 0, bytesWritten: 0, active: true
    })
}

@move
class BufferedReader {
    var reader: ByteReader
    var chunkLimit: Int
    var active: Bool

    static fun fromArray(source: Array<Int>, chunkLimit: Int)
        r: BufferedReader {

        var bounded = chunkLimit
        if bounded < 1 { bounded = 1 }
        return BufferedReader{
            reader: ByteReader.fromArray(source), chunkLimit: bounded,
            active: true
        }
    }

    fun read(context: OperationContext, destination: MutableByteSlice)
        r: Result<Int, IoError> {

        let allowed = validateByteOperation(context, "buffered-read")
        if allowed.isErr() { return Err<Int, IoError>(allowed.unwrapErr()) }
        if not this.active or not destination.active or
            not destination.owner.active {

            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "buffered-read", "buffered reader or destination is closed"))
        }
        var count = destination.count
        if count > this.chunkLimit { count = this.chunkLimit }
        let available = this.reader.remaining()
        if count > available { count = available }
        var index = 0
        while index < count {
            destination.owner.data[destination.offset + index] =
                this.reader.storage.owner.data[this.reader.position + index]
            index = index + 1
        }
        this.reader.position = this.reader.position + count
        return Ok<Int, IoError>(count)
    }

    fun close() r: Result<Bool, IoError> {
        if not this.active { return Ok<Bool, IoError>(false) }
        this.active = false
        return this.reader.close()
    }
}

@move
class BufferedWriter {
    var writer: ByteWriter
    var chunkLimit: Int
    var active: Bool

    fun write(context: OperationContext, source: ByteSlice)
        r: Result<Int, IoError> {

        let allowed = validateByteOperation(context, "buffered-write")
        if allowed.isErr() { return Err<Int, IoError>(allowed.unwrapErr()) }
        if not this.active or not source.active or not source.owner.active {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "buffered-write", "buffered writer or source is closed"))
        }
        var count = source.count
        if count > this.chunkLimit { count = this.chunkLimit }
        let available = this.writer.maxBytes - this.writer.storage.length()
        if count > available { count = available }
        if count == 0 and source.count > 0 {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_LIMIT,
                "buffered-write", "buffered writer limit is exhausted"))
        }
        var index = 0
        while index < count {
            let pushed = this.writer.storage.push(
                source.owner.data[source.offset + index])
            if pushed.isErr() { return Err<Int, IoError>(pushed.unwrapErr()) }
            index = index + 1
        }
        return Ok<Int, IoError>(count)
    }

    fun flush(context: OperationContext) r: Result<Bool, IoError> {
        if not this.active {
            return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "buffered-flush", "buffered writer is closed"))
        }
        return this.writer.flush(context)
    }

    fun close() r: Result<Bool, IoError> {
        if not this.active { return Ok<Bool, IoError>(false) }
        this.active = false
        return this.writer.close()
    }
}

fun tryBufferedWriter(limit: Int, chunkLimit: Int)
    r: Result<BufferedWriter, IoError> {

    if chunkLimit <= 0 or chunkLimit > BYTE_MAX_CAPACITY {
        return Err<BufferedWriter, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "buffered-writer", "buffer chunk limit is invalid"))
    }
    let writer = tryByteWriterWithLimit(limit)
    if writer.isErr() {
        return Err<BufferedWriter, IoError>(writer.unwrapErr())
    }
    return Ok<BufferedWriter, IoError>(BufferedWriter{
        writer: writer.unwrap(), chunkLimit: chunkLimit, active: true
    })
}

fun copyLimited(context: OperationContext, source: ByteReader,
    destination: ByteWriter, limit: Int, scratchCapacity: Int)
    r: Result<CopyResult, IoError> {

    let allowed = validateByteOperation(context, "copy-limited")
    if allowed.isErr() {
        return Err<CopyResult, IoError>(allowed.unwrapErr())
    }
    if limit < 0 or scratchCapacity <= 0 or
        scratchCapacity > BYTE_MAX_CAPACITY {

        return Err<CopyResult, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "copy-limited", "copy limit or scratch capacity is invalid"))
    }
    var readTotal = 0
    var writtenTotal = 0
    var stopped = false
    while readTotal < limit and source.remaining() > 0 and not stopped {
        var chunk = limit - readTotal
        if chunk > scratchCapacity { chunk = scratchCapacity }
        if chunk > source.remaining() { chunk = source.remaining() }
        let scratchResult = tryZeroedByteBuffer(chunk, 32)
        if scratchResult.isErr() {
            return Err<CopyResult, IoError>(scratchResult.unwrapErr())
        }
        let scratch = scratchResult.unwrap()
        let mutableResult = scratch.mutableSlice(0, chunk)
        if mutableResult.isErr() {
            let ignoredRelease = scratch.release()
            return Err<CopyResult, IoError>(mutableResult.unwrapErr())
        }
        let mutable = mutableResult.unwrap()
        let readProgress = source.read(context, mutable)
        let mutableClosed = mutable.close()
        if mutableClosed.isErr() {
            let ignoredRelease = scratch.release()
            return Err<CopyResult, IoError>(mutableClosed.unwrapErr())
        }
        if readProgress.isErr() {
            let ignoredRelease = scratch.release()
            return Err<CopyResult, IoError>(readProgress.unwrapErr())
        }
        let readCount = readProgress.unwrap()
        readTotal = readTotal + readCount
        let immutableResult = scratch.slice(0, readCount)
        if immutableResult.isErr() {
            let ignoredRelease = scratch.release()
            return Err<CopyResult, IoError>(immutableResult.unwrapErr())
        }
        let immutable = immutableResult.unwrap()
        let writeProgress = destination.write(context, immutable)
        let immutableClosed = immutable.close()
        let scratchReleased = scratch.release()
        if immutableClosed.isErr() or scratchReleased.isErr() {
            return Err<CopyResult, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "copy-limited", "scratch cleanup failed"))
        }
        if writeProgress.isErr() {
            if writeProgress.unwrapErr().code.value == BYTE_ERROR_LIMIT {
                stopped = true
            } else {
                return Err<CopyResult, IoError>(writeProgress.unwrapErr())
            }
        } else {
            let wrote = writeProgress.unwrap()
            writtenTotal = writtenTotal + wrote
            if wrote < readCount { stopped = true }
        }
        if readCount == 0 { stopped = true }
    }
    return Ok<CopyResult, IoError>(CopyResult{
        readBytes: readTotal, writtenBytes: writtenTotal,
        limitReached: readTotal >= limit or stopped,
        complete: source.remaining() == 0 and readTotal == writtenTotal
    })
}

fun utf8Continuation(byte: Int) r: Bool {
    return byte >= 128 and byte <= 191
}

fun decodeUtf8Strict(context: OperationContext, source: ByteSlice,
    maxOutputBytes: Int) r: Result<String, IoError> {

    let allowed = validateByteOperation(context, "utf8-decode")
    if allowed.isErr() { return Err<String, IoError>(allowed.unwrapErr()) }
    if not source.active or not source.owner.active or
        source.generation != source.owner.generation or maxOutputBytes < 0 {

        return Err<String, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "utf8-decode", "UTF-8 source is stale or output bound is invalid"))
    }
    if source.count > maxOutputBytes {
        return Err<String, IoError>(byteFailure(BYTE_ERROR_LIMIT,
            "utf8-decode", "UTF-8 output exceeds the caller bound"))
    }
    var output = ""
    var index = 0
    while index < source.count {
        let first = source.owner.data[source.offset + index]
        var width = 0
        var codepoint = 0
        if first <= 127 {
            width = 1
            codepoint = first
        } else if first >= 194 and first <= 223 {
            width = 2
        } else if first >= 224 and first <= 239 {
            width = 3
        } else if first >= 240 and first <= 244 {
            width = 4
        } else {
            return Err<String, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "utf8-decode", "UTF-8 leading byte is invalid"))
        }
        if index + width > source.count {
            return Err<String, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "utf8-decode", "UTF-8 sequence is truncated"))
        }
        if width >= 2 {
            let second = source.owner.data[source.offset + index + 1]
            if not utf8Continuation(second) or
                (first == 224 and second < 160) or
                (first == 237 and second > 159) or
                (first == 240 and second < 144) or
                (first == 244 and second > 143) {

                return Err<String, IoError>(byteFailure(BYTE_ERROR_INVALID,
                    "utf8-decode", "UTF-8 continuation or scalar range is invalid"))
            }
            if width == 2 {
                codepoint = ((first & 31) << 6) | (second & 63)
            }
        }
        if width >= 3 {
            let third = source.owner.data[source.offset + index + 2]
            if not utf8Continuation(third) {
                return Err<String, IoError>(byteFailure(BYTE_ERROR_INVALID,
                    "utf8-decode", "UTF-8 continuation byte is invalid"))
            }
            if width == 3 {
                let second = source.owner.data[source.offset + index + 1]
                codepoint = ((first & 15) << 12) |
                    ((second & 63) << 6) | (third & 63)
            }
        }
        if width == 4 {
            let fourth = source.owner.data[source.offset + index + 3]
            if not utf8Continuation(fourth) {
                return Err<String, IoError>(byteFailure(BYTE_ERROR_INVALID,
                    "utf8-decode", "UTF-8 continuation byte is invalid"))
            }
            let second = source.owner.data[source.offset + index + 1]
            let third = source.owner.data[source.offset + index + 2]
            codepoint = ((first & 7) << 18) | ((second & 63) << 12) |
                ((third & 63) << 6) | (fourth & 63)
        }
        output = output + String.fromCharCode(codepoint)
        index = index + width
    }
    return Ok<String, IoError>(output)
}

fun decodeUtf8Lossy(context: OperationContext, source: ByteSlice,
    maxOutputBytes: Int) r: Result<String, IoError> {

    let allowed = validateByteOperation(context, "utf8-decode-lossy")
    if allowed.isErr() { return Err<String, IoError>(allowed.unwrapErr()) }
    if not source.active or not source.owner.active or
        source.generation != source.owner.generation or maxOutputBytes < 0 {

        return Err<String, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "utf8-decode-lossy", "UTF-8 source or output bound is invalid"))
    }
    var output = ""
    var producedBytes = 0
    var index = 0
    while index < source.count {
        let first = source.owner.data[source.offset + index]
        var width = 0
        if first <= 127 { width = 1 }
        else if first >= 194 and first <= 223 { width = 2 }
        else if first >= 224 and first <= 239 { width = 3 }
        else if first >= 240 and first <= 244 { width = 4 }
        var valid = width > 0 and index + width <= source.count
        if valid and width >= 2 {
            let second = source.owner.data[source.offset + index + 1]
            valid = utf8Continuation(second) and
                not (first == 224 and second < 160) and
                not (first == 237 and second > 159) and
                not (first == 240 and second < 144) and
                not (first == 244 and second > 143)
        }
        if valid and width >= 3 {
            valid = utf8Continuation(
                source.owner.data[source.offset + index + 2])
        }
        if valid and width == 4 {
            valid = utf8Continuation(
                source.owner.data[source.offset + index + 3])
        }
        if valid {
            var codepoint = first
            if width == 2 {
                codepoint = ((first & 31) << 6) |
                    (source.owner.data[source.offset + index + 1] & 63)
            } else if width == 3 {
                codepoint = ((first & 15) << 12) |
                    ((source.owner.data[source.offset + index + 1] & 63) << 6) |
                    (source.owner.data[source.offset + index + 2] & 63)
            } else if width == 4 {
                codepoint = ((first & 7) << 18) |
                    ((source.owner.data[source.offset + index + 1] & 63) << 12) |
                    ((source.owner.data[source.offset + index + 2] & 63) << 6) |
                    (source.owner.data[source.offset + index + 3] & 63)
            }
            if producedBytes > maxOutputBytes - width {
                return Err<String, IoError>(byteFailure(BYTE_ERROR_LIMIT,
                    "utf8-decode-lossy", "UTF-8 output exceeds the caller bound"))
            }
            output = output + String.fromCharCode(codepoint)
            producedBytes = producedBytes + width
            index = index + width
        } else {
            if producedBytes > maxOutputBytes - 3 {
                return Err<String, IoError>(byteFailure(BYTE_ERROR_LIMIT,
                    "utf8-decode-lossy", "replacement output exceeds the caller bound"))
            }
            output = output + String.fromCharCode(65533)
            producedBytes = producedBytes + 3
            index = index + 1
        }
    }
    return Ok<String, IoError>(output)
}

fun encodeUtf8(context: OperationContext, text: String, maxBytes: Int)
    r: Result<ByteBuffer, IoError> {

    let allowed = validateByteOperation(context, "utf8-encode")
    if allowed.isErr() { return Err<ByteBuffer, IoError>(allowed.unwrapErr()) }
    if maxBytes < 0 {
        return Err<ByteBuffer, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "utf8-encode", "UTF-8 output bound is negative"))
    }
    if text.length() > maxBytes or text.length() > BYTE_MAX_CAPACITY {
        return Err<ByteBuffer, IoError>(byteFailure(BYTE_ERROR_LIMIT,
            "utf8-encode", "UTF-8 bytes exceed the caller bound"))
    }
    let result = tryByteBufferWithCapacity(text.length(), 32)
    if result.isErr() { return Err<ByteBuffer, IoError>(result.unwrapErr()) }
    let output = result.unwrap()
    var index = 0
    while index < text.length() {
        let pushed = output.push(text.byteAt(index))
        if pushed.isErr() {
            let ignoredRelease = output.release()
            return Err<ByteBuffer, IoError>(pushed.unwrapErr())
        }
        index = index + 1
    }
    return Ok<ByteBuffer, IoError>(output)
}

fun readEndianBits(source: ByteSlice, offset: Int, width: Int,
    littleEndian: Bool) r: Result<Int, IoError> {

    if width != 2 and width != 4 and width != 8 {
        return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "decode-endian", "codec width must be 2, 4, or 8 bytes"))
    }
    let checked = validateByteRange(source.count, offset, width)
    if checked.isErr() { return Err<Int, IoError>(checked.unwrapErr()) }
    if not source.active or not source.owner.active or
        source.generation != source.owner.generation {

        return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "decode-endian", "codec source is stale or closed"))
    }
    var value = 0
    var index = 0
    while index < width {
        var shift = index * 8
        if not littleEndian { shift = (width - 1 - index) * 8 }
        value = value | (source.owner.data[source.offset + offset + index] << shift)
        index = index + 1
    }
    return Ok<Int, IoError>(value)
}

fun writeEndianBits(destination: MutableByteSlice, offset: Int, width: Int,
    value: Int, littleEndian: Bool) r: Result<Int, IoError> {

    if width != 2 and width != 4 and width != 8 {
        return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "encode-endian", "codec width must be 2, 4, or 8 bytes"))
    }
    let checked = validateByteRange(destination.count, offset, width)
    if checked.isErr() { return Err<Int, IoError>(checked.unwrapErr()) }
    if not destination.active or not destination.owner.active or
        destination.generation != destination.owner.generation {

        return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "encode-endian", "codec destination is stale or closed"))
    }
    var index = 0
    while index < width {
        var shift = index * 8
        if not littleEndian { shift = (width - 1 - index) * 8 }
        destination.owner.data[destination.offset + offset + index] =
            (value >> shift) & 255
        index = index + 1
    }
    return Ok<Int, IoError>(width)
}

fun readU16LittleEndian(source: ByteSlice, offset: Int = 0)
    r: Result<Int, IoError> { return readEndianBits(source, offset, 2, true) }
fun readU16BigEndian(source: ByteSlice, offset: Int = 0)
    r: Result<Int, IoError> { return readEndianBits(source, offset, 2, false) }
fun readU32LittleEndian(source: ByteSlice, offset: Int = 0)
    r: Result<Int, IoError> { return readEndianBits(source, offset, 4, true) }
fun readU32BigEndian(source: ByteSlice, offset: Int = 0)
    r: Result<Int, IoError> { return readEndianBits(source, offset, 4, false) }
fun readI64LittleEndian(source: ByteSlice, offset: Int = 0)
    r: Result<Int, IoError> { return readEndianBits(source, offset, 8, true) }
fun readI64BigEndian(source: ByteSlice, offset: Int = 0)
    r: Result<Int, IoError> { return readEndianBits(source, offset, 8, false) }

fun writeU16LittleEndian(destination: MutableByteSlice, offset: Int,
    value: Int) r: Result<Int, IoError> {
    if value < 0 or value > 65535 {
        return Err<Int, IoError>(byteFailure(BYTE_ERROR_LIMIT,
            "encode-u16-le", "value exceeds unsigned 16-bit storage"))
    }
    return writeEndianBits(destination, offset, 2, value, true)
}

fun writeU16BigEndian(destination: MutableByteSlice, offset: Int,
    value: Int) r: Result<Int, IoError> {
    if value < 0 or value > 65535 {
        return Err<Int, IoError>(byteFailure(BYTE_ERROR_LIMIT,
            "encode-u16-be", "value exceeds unsigned 16-bit storage"))
    }
    return writeEndianBits(destination, offset, 2, value, false)
}

fun writeU32LittleEndian(destination: MutableByteSlice, offset: Int,
    value: Int) r: Result<Int, IoError> {
    if value < 0 or value > 4294967295 {
        return Err<Int, IoError>(byteFailure(BYTE_ERROR_LIMIT,
            "encode-u32-le", "value exceeds unsigned 32-bit storage"))
    }
    return writeEndianBits(destination, offset, 4, value, true)
}

fun writeU32BigEndian(destination: MutableByteSlice, offset: Int,
    value: Int) r: Result<Int, IoError> {
    if value < 0 or value > 4294967295 {
        return Err<Int, IoError>(byteFailure(BYTE_ERROR_LIMIT,
            "encode-u32-be", "value exceeds unsigned 32-bit storage"))
    }
    return writeEndianBits(destination, offset, 4, value, false)
}

fun writeI64LittleEndian(destination: MutableByteSlice, offset: Int,
    value: Int) r: Result<Int, IoError> {
    return writeEndianBits(destination, offset, 8, value, true)
}

fun writeI64BigEndian(destination: MutableByteSlice, offset: Int,
    value: Int) r: Result<Int, IoError> {
    return writeEndianBits(destination, offset, 8, value, false)
}

fun readFloat16BitsLittleEndian(source: ByteSlice, offset: Int = 0)
    r: Result<Int, IoError> { return readU16LittleEndian(source, offset) }
fun readFloat16BitsBigEndian(source: ByteSlice, offset: Int = 0)
    r: Result<Int, IoError> { return readU16BigEndian(source, offset) }
fun readBFloat16BitsLittleEndian(source: ByteSlice, offset: Int = 0)
    r: Result<Int, IoError> { return readU16LittleEndian(source, offset) }
fun readBFloat16BitsBigEndian(source: ByteSlice, offset: Int = 0)
    r: Result<Int, IoError> { return readU16BigEndian(source, offset) }

fun writeFloat16BitsLittleEndian(destination: MutableByteSlice, offset: Int,
    bits: Int) r: Result<Int, IoError> {
    return writeU16LittleEndian(destination, offset, bits)
}
fun writeFloat16BitsBigEndian(destination: MutableByteSlice, offset: Int,
    bits: Int) r: Result<Int, IoError> {
    return writeU16BigEndian(destination, offset, bits)
}
fun writeBFloat16BitsLittleEndian(destination: MutableByteSlice, offset: Int,
    bits: Int) r: Result<Int, IoError> {
    return writeU16LittleEndian(destination, offset, bits)
}
fun writeBFloat16BitsBigEndian(destination: MutableByteSlice, offset: Int,
    bits: Int) r: Result<Int, IoError> {
    return writeU16BigEndian(destination, offset, bits)
}
fun readFloat64BitsLittleEndian(source: ByteSlice, offset: Int = 0)
    r: Result<Int, IoError> { return readI64LittleEndian(source, offset) }
fun readFloat64BitsBigEndian(source: ByteSlice, offset: Int = 0)
    r: Result<Int, IoError> { return readI64BigEndian(source, offset) }
fun writeFloat64BitsLittleEndian(destination: MutableByteSlice, offset: Int,
    bits: Int) r: Result<Int, IoError> {
    return writeI64LittleEndian(destination, offset, bits)
}
fun writeFloat64BitsBigEndian(destination: MutableByteSlice, offset: Int,
    bits: Int) r: Result<Int, IoError> {
    return writeI64BigEndian(destination, offset, bits)
}

// Asynchronous byte-stream contracts preserve the checked borrowed-view and
// progress semantics of the synchronous traits. Memory-backed operations are
// direct-ready coroutines; readiness-driven backends implement these traits in
// SEEN-IO-002 without changing their ownership or error surface.

trait AsyncReader {
    @async
    fun read(this: AsyncReader, context: OperationContext,
        destination: MutableByteSlice) r: Result<Int, IoError>
}

trait AsyncWriter {
    @async
    fun write(this: AsyncWriter, context: OperationContext,
        source: ByteSlice) r: Result<Int, IoError>
}

trait AsyncSeeker {
    @async
    fun seek(this: AsyncSeeker, context: OperationContext, offset: Int,
        origin: Int) r: Result<Int, IoError>
}

trait AsyncBufRead {
    @async
    fun fillBuf(this: AsyncBufRead, context: OperationContext)
        r: Result<ByteSlice, IoError>
    @async
    fun consume(this: AsyncBufRead, context: OperationContext, count: Int)
        r: Result<Int, IoError>
}

trait AsyncFlush {
    @async
    fun flush(this: AsyncFlush, context: OperationContext)
        r: Result<Bool, IoError>
}

@move
class AsyncByteReader {
    var reader: ByteReader
    var active: Bool

    static fun fromArray(source: Array<Int>) r: AsyncByteReader {
        return AsyncByteReader{
            reader: ByteReader.fromArray(source), active: true
        }
    }

    fun remaining() r: Int {
        if not this.active { return 0 }
        return this.reader.remaining()
    }

    @async
    fun read(context: OperationContext, destination: MutableByteSlice)
        r: Result<Int, IoError> {

        if not this.active {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "async-read", "asynchronous reader is closed"))
        }
        return this.reader.read(context, destination)
    }

    @async
    fun seek(context: OperationContext, offset: Int, origin: Int)
        r: Result<Int, IoError> {

        if not this.active {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "async-seek", "asynchronous reader is closed"))
        }
        return this.reader.seek(context, offset, origin)
    }

    @async
    fun fillBuf(context: OperationContext) r: Result<ByteSlice, IoError> {
        if not this.active {
            return Err<ByteSlice, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "async-fill-buffer", "asynchronous reader is closed"))
        }
        return this.reader.fillBuf(context)
    }

    @async
    fun consume(context: OperationContext, count: Int)
        r: Result<Int, IoError> {

        if not this.active {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "async-consume", "asynchronous reader is closed"))
        }
        return this.reader.consume(context, count)
    }

    fun close() r: Result<Bool, IoError> {
        if not this.active { return Ok<Bool, IoError>(false) }
        this.active = false
        return this.reader.close()
    }
}

@move
class AsyncByteWriter {
    var writer: ByteWriter
    var active: Bool

    fun length() r: Int {
        if not this.active { return 0 }
        return this.writer.length()
    }

    fun toArray() r: Result<Array<Int>, IoError> {
        if not this.active {
            return Err<Array<Int>, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "async-copy", "asynchronous writer is closed"))
        }
        return this.writer.toArray()
    }

    @async
    fun write(context: OperationContext, source: ByteSlice)
        r: Result<Int, IoError> {

        if not this.active {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "async-write", "asynchronous writer is closed"))
        }
        return this.writer.write(context, source)
    }

    @async
    fun flush(context: OperationContext) r: Result<Bool, IoError> {
        if not this.active {
            return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "async-flush", "asynchronous writer is closed"))
        }
        return this.writer.flush(context)
    }

    fun close() r: Result<Bool, IoError> {
        if not this.active { return Ok<Bool, IoError>(false) }
        this.active = false
        return this.writer.close()
    }
}

fun tryAsyncByteWriterWithLimit(maxBytes: Int)
    r: Result<AsyncByteWriter, IoError> {

    let created = tryByteWriterWithLimit(maxBytes)
    if created.isErr() {
        return Err<AsyncByteWriter, IoError>(created.unwrapErr())
    }
    return Ok<AsyncByteWriter, IoError>(AsyncByteWriter{
        writer: created.unwrap(), active: true
    })
}

// Free coroutine entrypoints provide a stable call surface and dispatch to the
// same concrete operations required by the public async traits.
@async
fun asyncRead(reader: AsyncByteReader, context: OperationContext,
    destination: MutableByteSlice) r: Result<Int, IoError> {

    if not reader.active {
        return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "async-read", "asynchronous reader is closed"))
    }
    return reader.reader.read(context, destination)
}

@async
fun asyncSeek(reader: AsyncByteReader, context: OperationContext, offset: Int,
    origin: Int) r: Result<Int, IoError> {

    if not reader.active {
        return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "async-seek", "asynchronous reader is closed"))
    }
    return reader.reader.seek(context, offset, origin)
}

@async
fun asyncFillBuf(reader: AsyncByteReader, context: OperationContext)
    r: Result<ByteSlice, IoError> {

    if not reader.active {
        return Err<ByteSlice, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "async-fill-buffer", "asynchronous reader is closed"))
    }
    return reader.reader.fillBuf(context)
}

@async
fun asyncConsume(reader: AsyncByteReader, context: OperationContext,
    count: Int) r: Result<Int, IoError> {

    if not reader.active {
        return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "async-consume", "asynchronous reader is closed"))
    }
    return reader.reader.consume(context, count)
}

@async
fun asyncWrite(writer: AsyncByteWriter, context: OperationContext,
    source: ByteSlice) r: Result<Int, IoError> {

    if not writer.active {
        return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "async-write", "asynchronous writer is closed"))
    }
    return writer.writer.write(context, source)
}

@async
fun asyncFlush(writer: AsyncByteWriter, context: OperationContext)
    r: Result<Bool, IoError> {

    if not writer.active {
        return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "async-flush", "asynchronous writer is closed"))
    }
    return writer.writer.flush(context)
}
