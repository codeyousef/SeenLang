// Checked byte ownership and borrowed-view primitives.
//
// Byte counts use nonnegative 64-bit Int values. Views retain their owner,
// record its generation, and must be closed explicitly. A mutable view is
// exclusive; releasing its owner invalidates every outstanding view.

import core.result.{Result, Ok, Err}
import core.error.{AsciiString}
import core.operation_context.{OperationContext}

class IoError {
    var code: AsciiString
    var operation: AsciiString
    var message: String
    var retryable: Bool
}

let BYTE_MAX_COUNT: Int = 9223372036854775807
let BYTE_MAX_CAPACITY: Int = 1073741824
let BYTE_DEFAULT_ALIGNMENT: Int = 32
let BYTE_MAX_ALIGNMENT: Int = 32
let BYTE_ERROR_INVALID: String = "byte.invalid"
let BYTE_ERROR_LIMIT: String = "byte.limit"
let BYTE_ERROR_CANCELLED: String = "byte.cancelled"
let BYTE_ERROR_TIMEOUT: String = "byte.timeout"
let BYTE_ERROR_UNAVAILABLE: String = "byte.unavailable"
let BYTE_ERROR_UNSUPPORTED_PLATFORM: String = "byte.unsupported_platform"

fun byteFailure(code: String, operation: String, message: String,
    retryable: Bool = false) r: IoError {

    return IoError{
        code: AsciiString{ value: code },
        operation: AsciiString{ value: operation },
        message: message, retryable: retryable
    }
}

fun validateByteRange(totalLength: Int, offset: Int, count: Int)
    r: Result<Bool, IoError> {

    if totalLength < 0 or offset < 0 or count < 0 {
        return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "slice",
            "byte range values must be nonnegative"))
    }
    if totalLength > BYTE_MAX_COUNT or offset > totalLength or
        count > totalLength - offset {

        return Err<Bool, IoError>(byteFailure(BYTE_ERROR_LIMIT, "slice",
            "byte range exceeds its owner bound"))
    }
    return Ok<Bool, IoError>(true)
}

fun validateByteRangeInContext(context: OperationContext, totalLength: Int,
    offset: Int, count: Int) r: Result<Bool, IoError> {

    if context.cancellation {
        return Err<Bool, IoError>(byteFailure(BYTE_ERROR_CANCELLED, "slice",
            "byte slice acquisition is cancelled"))
    }
    return validateByteRange(totalLength, offset, count)
}

fun isValidByteAlignment(alignment: Int) r: Bool {
    if alignment <= 0 or alignment > BYTE_MAX_ALIGNMENT { return false }
    return (alignment & (alignment - 1)) == 0
}

fun validateByteCapacity(capacity: Int, alignment: Int)
    r: Result<Bool, IoError> {

    if capacity < 0 or not isValidByteAlignment(alignment) {
        return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "allocate",
            "byte capacity must be nonnegative and alignment must be a power of two through 32"))
    }
    if capacity > BYTE_MAX_CAPACITY {
        return Err<Bool, IoError>(byteFailure(BYTE_ERROR_LIMIT, "allocate",
            "byte capacity exceeds the bounded allocation limit"))
    }
    return Ok<Bool, IoError>(true)
}

class ByteOwner {
    var data: Array<Int>
    var capacity: Int
    var alignment: Int
    var generation: Int
    var active: Bool
    var sharedBorrows: Int
    var mutableBorrowed: Bool
}

@move
class ByteBuffer {
    var owner: ByteOwner

    static fun fromArray(source: Array<Int>) r: ByteBuffer {
        let copied = Array<Int>()
        var index = 0
        while index < source.length() {
            copied.push(source[index] & 255)
            index = index + 1
        }
        return ByteBuffer{
            owner: ByteOwner{
                data: copied, capacity: copied.length(),
                alignment: BYTE_DEFAULT_ALIGNMENT, generation: 1, active: true,
                sharedBorrows: 0, mutableBorrowed: false
            }
        }
    }

    static fun empty() r: ByteBuffer {
        return ByteBuffer.fromArray(Array<Int>())
    }

    fun length() r: Int {
        if not this.owner.active { return 0 }
        return this.owner.data.length()
    }

    fun capacity() r: Int {
        if not this.owner.active { return 0 }
        return this.owner.capacity
    }

    fun alignment() r: Int {
        if not this.owner.active { return 0 }
        return this.owner.alignment
    }

    fun reserve(requiredCapacity: Int) r: Result<Bool, IoError> {
        if not this.owner.active {
            return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "reserve",
                "byte owner has been released"))
        }
        if this.owner.mutableBorrowed or this.owner.sharedBorrows > 0 {
            return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "reserve",
                "byte owner cannot grow while a view is borrowed"))
        }
        let checked = validateByteCapacity(requiredCapacity, this.owner.alignment)
        if checked.isErr() {
            return Err<Bool, IoError>(checked.unwrapErr())
        }
        if requiredCapacity <= this.owner.capacity {
            return Ok<Bool, IoError>(false)
        }
        let replacement = Array<Int>()
        var index = 0
        while index < this.owner.data.length() {
            replacement.push(this.owner.data[index])
            index = index + 1
        }
        this.owner.data = replacement
        this.owner.capacity = requiredCapacity
        this.owner.generation = this.owner.generation + 1
        return Ok<Bool, IoError>(true)
    }

    fun push(value: Int) r: Result<Bool, IoError> {
        if value < 0 or value > 255 {
            return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "push",
                "byte value is outside 0 through 255"))
        }
        if not this.owner.active or this.owner.mutableBorrowed or
            this.owner.sharedBorrows > 0 {

            return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "push",
                "byte owner is released or borrowed"))
        }
        if this.owner.data.length() >= this.owner.capacity {
            var nextCapacity = this.owner.capacity * 2
            if nextCapacity < 1 { nextCapacity = 1 }
            if nextCapacity < this.owner.data.length() + 1 {
                nextCapacity = this.owner.data.length() + 1
            }
            let grown = this.reserve(nextCapacity)
            if grown.isErr() { return Err<Bool, IoError>(grown.unwrapErr()) }
        }
        this.owner.data.push(value)
        return Ok<Bool, IoError>(true)
    }

    fun append(source: ByteSlice) r: Result<Int, IoError> {
        if not source.active or not source.owner.active or
            source.generation != source.owner.generation {

            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "append",
                "source byte slice is stale or closed"))
        }
        if not this.owner.active or this.owner.mutableBorrowed or
            this.owner.sharedBorrows > 0 {

            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "append",
                "destination byte owner is released or borrowed"))
        }
        if source.count > BYTE_MAX_CAPACITY - this.owner.data.length() {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_LIMIT, "append",
                "appended bytes exceed the bounded allocation limit"))
        }
        let required = this.owner.data.length() + source.count
        if required > this.owner.capacity {
            let grown = this.reserve(required)
            if grown.isErr() { return Err<Int, IoError>(grown.unwrapErr()) }
        }
        var index = 0
        while index < source.count {
            this.owner.data.push(source.owner.data[source.offset + index])
            index = index + 1
        }
        return Ok<Int, IoError>(source.count)
    }

    fun toArray() r: Result<Array<Int>, IoError> {
        if not this.owner.active {
            return Err<Array<Int>, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "copy", "byte owner has been released"))
        }
        let copied = Array<Int>()
        var index = 0
        while index < this.owner.data.length() {
            copied.push(this.owner.data[index])
            index = index + 1
        }
        return Ok<Array<Int>, IoError>(copied)
    }

    fun slice(offset: Int, count: Int) r: Result<ByteSlice, IoError> {
        if not this.owner.active {
            return Err<ByteSlice, IoError>(byteFailure(BYTE_ERROR_INVALID, "slice",
                "byte owner has been released"))
        }
        if this.owner.mutableBorrowed {
            return Err<ByteSlice, IoError>(byteFailure(BYTE_ERROR_INVALID, "slice",
                "byte owner has an active mutable borrow"))
        }
        let checked = validateByteRange(this.owner.data.length(), offset, count)
        if checked.isErr() {
            return Err<ByteSlice, IoError>(checked.unwrapErr())
        }
        this.owner.sharedBorrows = this.owner.sharedBorrows + 1
        return Ok<ByteSlice, IoError>(ByteSlice{
            owner: this.owner, offset: offset, count: count,
            generation: this.owner.generation, active: true
        })
    }

    fun sliceInContext(context: OperationContext, offset: Int, count: Int)
        r: Result<ByteSlice, IoError> {

        let checked = validateByteRangeInContext(context,
            this.owner.data.length(), offset, count)
        if checked.isErr() {
            return Err<ByteSlice, IoError>(checked.unwrapErr())
        }
        return this.slice(offset, count)
    }

    fun mutableSlice(offset: Int, count: Int)
        r: Result<MutableByteSlice, IoError> {

        if not this.owner.active {
            return Err<MutableByteSlice, IoError>(byteFailure(
                BYTE_ERROR_INVALID, "mutable-slice", "byte owner has been released"))
        }
        if this.owner.mutableBorrowed or this.owner.sharedBorrows > 0 {
            return Err<MutableByteSlice, IoError>(byteFailure(
                BYTE_ERROR_INVALID, "mutable-slice",
                "byte owner already has an active borrow"))
        }
        let checked = validateByteRange(this.owner.data.length(), offset, count)
        if checked.isErr() {
            return Err<MutableByteSlice, IoError>(checked.unwrapErr())
        }
        this.owner.mutableBorrowed = true
        return Ok<MutableByteSlice, IoError>(MutableByteSlice{
            owner: this.owner, offset: offset, count: count,
            generation: this.owner.generation, active: true
        })
    }

    fun mutableSliceInContext(context: OperationContext, offset: Int,
        count: Int) r: Result<MutableByteSlice, IoError> {

        let checked = validateByteRangeInContext(context,
            this.owner.data.length(), offset, count)
        if checked.isErr() {
            return Err<MutableByteSlice, IoError>(checked.unwrapErr())
        }
        return this.mutableSlice(offset, count)
    }

    fun release() r: Result<Bool, IoError> {
        if not this.owner.active { return Ok<Bool, IoError>(false) }
        this.owner.active = false
        this.owner.generation = this.owner.generation + 1
        this.owner.sharedBorrows = 0
        this.owner.mutableBorrowed = false
        this.owner.data = Array<Int>()
        this.owner.capacity = 0
        return Ok<Bool, IoError>(true)
    }
}

fun tryByteBufferWithCapacity(capacity: Int,
    alignment: Int = BYTE_DEFAULT_ALIGNMENT) r: Result<ByteBuffer, IoError> {

    let checked = validateByteCapacity(capacity, alignment)
    if checked.isErr() {
        return Err<ByteBuffer, IoError>(checked.unwrapErr())
    }
    return Ok<ByteBuffer, IoError>(ByteBuffer{
        owner: ByteOwner{
            data: Array<Int>(), capacity: capacity,
            alignment: alignment, generation: 1, active: true,
            sharedBorrows: 0, mutableBorrowed: false
        }
    })
}

fun tryZeroedByteBuffer(length: Int,
    alignment: Int = BYTE_DEFAULT_ALIGNMENT) r: Result<ByteBuffer, IoError> {

    let allocated = tryByteBufferWithCapacity(length, alignment)
    if allocated.isErr() {
        return Err<ByteBuffer, IoError>(allocated.unwrapErr())
    }
    let buffer = allocated.unwrap()
    var index = 0
    while index < length {
        buffer.owner.data.push(0)
        index = index + 1
    }
    return Ok<ByteBuffer, IoError>(buffer)
}

class ByteSlice {
    var owner: ByteOwner
    var offset: Int
    var count: Int
    var generation: Int
    var active: Bool

    fun length() r: Int { return this.count }

    fun get(index: Int) r: Result<Int, IoError> {
        if not this.active or not this.owner.active or
            this.generation != this.owner.generation {

            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "read",
                "byte slice is stale or closed"))
        }
        let checked = validateByteRange(this.count, index, 1)
        if checked.isErr() {
            return Err<Int, IoError>(checked.unwrapErr())
        }
        return Ok<Int, IoError>(this.owner.data[this.offset + index])
    }

    fun close() r: Result<Bool, IoError> {
        if not this.active { return Ok<Bool, IoError>(false) }
        this.active = false
        if this.owner.active and this.generation == this.owner.generation and
            this.owner.sharedBorrows > 0 {

            this.owner.sharedBorrows = this.owner.sharedBorrows - 1
        }
        return Ok<Bool, IoError>(true)
    }
}

@move
class MutableByteSlice {
    var owner: ByteOwner
    var offset: Int
    var count: Int
    var generation: Int
    var active: Bool

    fun length() r: Int { return this.count }

    fun get(index: Int) r: Result<Int, IoError> {
        if not this.active or not this.owner.active or
            this.generation != this.owner.generation {

            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "read",
                "mutable byte slice is stale or closed"))
        }
        let checked = validateByteRange(this.count, index, 1)
        if checked.isErr() {
            return Err<Int, IoError>(checked.unwrapErr())
        }
        return Ok<Int, IoError>(this.owner.data[this.offset + index])
    }

    fun set(index: Int, value: Int) r: Result<Bool, IoError> {
        if value < 0 or value > 255 {
            return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "write",
                "byte value is outside 0 through 255"))
        }
        if not this.active or not this.owner.active or
            this.generation != this.owner.generation {

            return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "write",
                "mutable byte slice is stale or closed"))
        }
        let checked = validateByteRange(this.count, index, 1)
        if checked.isErr() {
            return Err<Bool, IoError>(checked.unwrapErr())
        }
        this.owner.data[this.offset + index] = value
        return Ok<Bool, IoError>(true)
    }

    fun close() r: Result<Bool, IoError> {
        if not this.active { return Ok<Bool, IoError>(false) }
        this.active = false
        if this.owner.active and this.generation == this.owner.generation {
            this.owner.mutableBorrowed = false
        }
        return Ok<Bool, IoError>(true)
    }
}

let BYTE_SEEK_START: Int = 0
let BYTE_SEEK_CURRENT: Int = 1
let BYTE_SEEK_END: Int = 2

fun validateByteOperation(context: OperationContext, operation: String)
    r: Result<Bool, IoError> {

    if context.cancellation {
        return Err<Bool, IoError>(byteFailure(BYTE_ERROR_CANCELLED, operation,
            "byte operation is cancelled"))
    }
    if context.monotonicDeadline < 0 {
        return Err<Bool, IoError>(byteFailure(BYTE_ERROR_TIMEOUT, operation,
            "byte operation deadline has expired"))
    }
    return Ok<Bool, IoError>(true)
}

trait Reader {
    fun read(this: Reader, context: OperationContext,
        destination: MutableByteSlice) r: Result<Int, IoError>
}

trait Writer {
    fun write(this: Writer, context: OperationContext,
        source: ByteSlice) r: Result<Int, IoError>
}

trait Seeker {
    fun seek(this: Seeker, context: OperationContext, offset: Int,
        origin: Int) r: Result<Int, IoError>
}

trait BufRead {
    fun fillBuf(this: BufRead, context: OperationContext)
        r: Result<ByteSlice, IoError>
    fun consume(this: BufRead, context: OperationContext, count: Int)
        r: Result<Int, IoError>
}

trait Flush {
    fun flush(this: Flush, context: OperationContext) r: Result<Bool, IoError>
}

@move
class ByteReader {
    var storage: ByteBuffer
    var position: Int
    var active: Bool

    static fun fromArray(source: Array<Int>) r: ByteReader {
        return ByteReader{
            storage: ByteBuffer.fromArray(source), position: 0, active: true
        }
    }

    fun remaining() r: Int {
        if not this.active { return 0 }
        return this.storage.length() - this.position
    }

    fun read(context: OperationContext,
        destination: MutableByteSlice) r: Result<Int, IoError> {

        let allowed = validateByteOperation(context, "read")
        if allowed.isErr() { return Err<Int, IoError>(allowed.unwrapErr()) }
        if not this.active or not destination.active or
            not destination.owner.active or
            destination.generation != destination.owner.generation {

            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "read",
                "reader or destination byte slice is closed or stale"))
        }
        var count = destination.count
        let available = this.storage.length() - this.position
        if count > available { count = available }
        var index = 0
        while index < count {
            destination.owner.data[destination.offset + index] =
                this.storage.owner.data[this.position + index]
            index = index + 1
        }
        this.position = this.position + count
        return Ok<Int, IoError>(count)
    }

    fun seek(context: OperationContext, offset: Int,
        origin: Int) r: Result<Int, IoError> {

        let allowed = validateByteOperation(context, "seek")
        if allowed.isErr() { return Err<Int, IoError>(allowed.unwrapErr()) }
        if not this.active {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "seek",
                "reader is closed"))
        }
        var base = 0
        if origin == BYTE_SEEK_CURRENT {
            base = this.position
        } else if origin == BYTE_SEEK_END {
            base = this.storage.length()
        } else if origin != BYTE_SEEK_START {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "seek",
                "seek origin is invalid"))
        }
        if offset > 0 and base > BYTE_MAX_COUNT - offset {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_LIMIT, "seek",
                "seek position overflows checked byte geometry"))
        }
        let target = base + offset
        if target < 0 or target > this.storage.length() {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_LIMIT, "seek",
                "seek position is outside the reader"))
        }
        this.position = target
        return Ok<Int, IoError>(target)
    }

    fun fillBuf(context: OperationContext)
        r: Result<ByteSlice, IoError> {

        let allowed = validateByteOperation(context, "fill-buffer")
        if allowed.isErr() {
            return Err<ByteSlice, IoError>(allowed.unwrapErr())
        }
        if not this.active {
            return Err<ByteSlice, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "fill-buffer", "reader is closed"))
        }
        return this.storage.slice(this.position,
            this.storage.length() - this.position)
    }

    fun consume(context: OperationContext, count: Int)
        r: Result<Int, IoError> {

        let allowed = validateByteOperation(context, "consume")
        if allowed.isErr() { return Err<Int, IoError>(allowed.unwrapErr()) }
        if not this.active or count < 0 {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "consume",
                "reader is closed or count is negative"))
        }
        if count > this.storage.length() - this.position {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_LIMIT, "consume",
                "consume count exceeds buffered bytes"))
        }
        this.position = this.position + count
        return Ok<Int, IoError>(count)
    }

    fun close() r: Result<Bool, IoError> {
        if not this.active { return Ok<Bool, IoError>(false) }
        this.active = false
        let released = this.storage.release()
        if released.isErr() { return Err<Bool, IoError>(released.unwrapErr()) }
        return Ok<Bool, IoError>(true)
    }
}

@move
class ByteWriter {
    var storage: ByteBuffer
    var maxBytes: Int
    var active: Bool

    fun length() r: Int {
        if not this.active { return 0 }
        return this.storage.length()
    }

    fun toArray() r: Result<Array<Int>, IoError> {
        if not this.active {
            return Err<Array<Int>, IoError>(byteFailure(BYTE_ERROR_INVALID,
                "copy", "writer is closed"))
        }
        return this.storage.toArray()
    }

    fun write(context: OperationContext, source: ByteSlice)
        r: Result<Int, IoError> {

        let allowed = validateByteOperation(context, "write")
        if allowed.isErr() { return Err<Int, IoError>(allowed.unwrapErr()) }
        if not this.active or not source.active or not source.owner.active or
            source.generation != source.owner.generation {

            return Err<Int, IoError>(byteFailure(BYTE_ERROR_INVALID, "write",
                "writer or source byte slice is closed or stale"))
        }
        let available = this.maxBytes - this.storage.length()
        if available <= 0 and source.count > 0 {
            return Err<Int, IoError>(byteFailure(BYTE_ERROR_LIMIT, "write",
                "writer byte limit is exhausted"))
        }
        var count = source.count
        if count > available { count = available }
        var index = 0
        while index < count {
            let pushed = this.storage.push(
                source.owner.data[source.offset + index])
            if pushed.isErr() { return Err<Int, IoError>(pushed.unwrapErr()) }
            index = index + 1
        }
        return Ok<Int, IoError>(count)
    }

    fun flush(context: OperationContext) r: Result<Bool, IoError> {
        let allowed = validateByteOperation(context, "flush")
        if allowed.isErr() { return Err<Bool, IoError>(allowed.unwrapErr()) }
        if not this.active {
            return Err<Bool, IoError>(byteFailure(BYTE_ERROR_INVALID, "flush",
                "writer is closed"))
        }
        return Ok<Bool, IoError>(true)
    }

    fun close() r: Result<Bool, IoError> {
        if not this.active { return Ok<Bool, IoError>(false) }
        this.active = false
        let released = this.storage.release()
        if released.isErr() { return Err<Bool, IoError>(released.unwrapErr()) }
        return Ok<Bool, IoError>(true)
    }
}

fun tryByteWriterWithLimit(maxBytes: Int) r: Result<ByteWriter, IoError> {
    if maxBytes < 0 {
        return Err<ByteWriter, IoError>(byteFailure(BYTE_ERROR_INVALID,
            "writer", "writer limit must be nonnegative"))
    }
    if maxBytes > BYTE_MAX_CAPACITY {
        return Err<ByteWriter, IoError>(byteFailure(BYTE_ERROR_LIMIT,
            "writer", "writer limit exceeds bounded capacity"))
    }
    let allocated = tryByteBufferWithCapacity(0, 32)
    if allocated.isErr() {
        return Err<ByteWriter, IoError>(allocated.unwrapErr())
    }
    return Ok<ByteWriter, IoError>(ByteWriter{
        storage: allocated.unwrap(), maxBytes: maxBytes, active: true
    })
}
