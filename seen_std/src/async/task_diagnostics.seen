import core.result.{Result, Ok, Err}
import core.error.{RedactionClass, RetryClass}
import async.structured.{AsyncError, asyncFailure, asyncStatusCode}
import async.executor_native.{seen_string_clone_owned}
import async.owned_strings.{OwnedCStringVector}

enum TaskDiagnosticKind { Failure; Panic; Fallback }
enum TaskBackend { Native; Scalar; Cpu; Blocking; Epoll; Aio; Cuda; Vulkan; Metal; DirectMl }
enum TaskPanicPolicy { CooperativeFailure; AbortProcess }
fun runtimeTaskPanicPolicy() r: TaskPanicPolicy { return TaskPanicPolicy.AbortProcess }

fun taskDiagnosticRejected(limit: Bool) r: AsyncError {
    var code = "async.invalid"
    if limit { code = "async.limit" }
    return asyncFailure(code, "task.diagnostic", "task diagnostic violates its bounded contract",
        false, 0 as UInt64, "task")
}
fun taskDiagnosticTextValid(text: String) r: Bool {
    var i = 0
    while i < text.length() {
        let value = text.byteAt(i)
        if (value < 32 and value != 9 and value != 10) or value > 126 { return false }
        i = i + 1
    }
    return true
}

// Every stored string and cause is owned. Capture/copy budgets cover the total
// message plus cause bytes (4 KiB), not just each component independently.
@send
@move
class TaskDiagnostic {
    var kind: TaskDiagnosticKind
    var status: Int32
    var backend: TaskBackend
    var message: String
    var causes: OwnedCStringVector
    var progress: UInt64
    var retryable: Bool

    static fun create(kind: TaskDiagnosticKind, status: Int32, backend: TaskBackend,
        message: String, causes: Array<String>, progress: UInt64,
        retry: RetryClass, redaction: RedactionClass) r: Result<TaskDiagnostic, AsyncError> {
        if causes.length() > 8 or message.length() > 4096 or progress > (9223372036854775807 as UInt64) {
            return Err<TaskDiagnostic, AsyncError>(taskDiagnosticRejected(true))
        }
        if kind == TaskDiagnosticKind.Fallback {
            if status != (0 as Int32) or retry != RetryClass.Never {
                return Err<TaskDiagnostic, AsyncError>(taskDiagnosticRejected(false))
            }
        } else {
            if status != (1 as Int32) and status != (2 as Int32) and status != (3 as Int32) and
                status != (4 as Int32) and status != (7 as Int32) and status != (9 as Int32) {
                return Err<TaskDiagnostic, AsyncError>(taskDiagnosticRejected(false))
            }
            if retry == RetryClass.Transient and (status != (3 as Int32) or kind == TaskDiagnosticKind.Panic) {
                return Err<TaskDiagnostic, AsyncError>(taskDiagnosticRejected(false))
            }
            if kind == TaskDiagnosticKind.Panic and status != (3 as Int32) {
                return Err<TaskDiagnostic, AsyncError>(taskDiagnosticRejected(false))
            }
        }
        var bytes = message.length(); var i = 0
        while i < causes.length() {
            if causes[i].length() > 4096 - bytes {
                return Err<TaskDiagnostic, AsyncError>(taskDiagnosticRejected(true))
            }
            bytes = bytes + causes[i].length(); i = i + 1
        }
        if redaction == RedactionClass.Public {
            if not taskDiagnosticTextValid(message) {
                return Err<TaskDiagnostic, AsyncError>(taskDiagnosticRejected(false))
            }
            i = 0
            while i < causes.length() {
                if not taskDiagnosticTextValid(causes[i]) {
                    return Err<TaskDiagnostic, AsyncError>(taskDiagnosticRejected(false))
                }
                i = i + 1
            }
        }
        var visible = "task details redacted"
        if redaction == RedactionClass.Public { visible = message }
        let visibleCauses = Array<String>(); i = 0
        while i < causes.length() {
            var cause = "redacted"
            if redaction == RedactionClass.Public { cause = causes[i] }
            visibleCauses.push(cause); i = i + 1
        }
        let packed = OwnedCStringVector.pack(visibleCauses); visibleCauses.free()
        if packed.isErr() {
            let error = packed.unwrapErr(); packed.releaseContainer(); return Err<TaskDiagnostic, AsyncError>(error)
        }
        let copied = packed.unwrap(); packed.releaseContainer()
        return Ok<TaskDiagnostic, AsyncError>(TaskDiagnostic{kind: kind, status: status, backend: backend,
            message: seen_string_clone_owned(visible), causes: copied, progress: progress,
            retryable: retry == RetryClass.Transient})
    }
    fun snapshot() r: Result<TaskDiagnostic, AsyncError> {
        if this.causes.length() < 0 { return Err<TaskDiagnostic, AsyncError>(taskDiagnosticRejected(false)) }
        if this.causes.length() > 8 or this.message.length() > 4096 or
            this.causes.strings.byteLength > (4105 as UInt64) {
            return Err<TaskDiagnostic, AsyncError>(taskDiagnosticRejected(true))
        }
        var retry = RetryClass.Never
        if this.retryable { retry = RetryClass.Transient }
        let values = Array<String>(); var i = 0
        while i < this.causes.length() {
            let value = this.causes.get(i)
            if value.isErr() {
                let error = value.unwrapErr(); value.releaseContainer()
                var j = 0
                while j < values.length() { values[j].free(); j = j + 1 }
                values.free(); return Err<TaskDiagnostic, AsyncError>(error)
            }
            values.push(value.unwrap()); value.releaseContainer(); i = i + 1
        }
        let copied = TaskDiagnostic.create(this.kind, this.status, this.backend, this.message,
            values, this.progress, retry, RedactionClass.Public)
        i = 0
        while i < values.length() { values[i].free(); i = i + 1 }
        values.free(); return copied
    }
    fun code() r: String {
        if this.kind == TaskDiagnosticKind.Fallback { return "async.fallback" }
        return asyncStatusCode(this.status)
    }
    fun release() r: Void {
        this.causes.release(); this.message.free(); this.free()
    }
}

// A capture owns metadata only; it is not a cancellation source or a retained
// executor borrow. It can outlive the callback that created it.
@send
@move
class TaskCapture {
    var resourceId: String
    var traceId: String
    var deadline: Int64
    var fallbackPolicy: Int
    var depth: Int
    fun release() r: Void { this.resourceId.free(); this.traceId.free(); this.free() }
}
