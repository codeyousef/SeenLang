// C argv/envp layout is built and owned in Seen, bounded before allocation.
import core.result.{Result, Ok, Err}
import async.structured.{AsyncError}
import async.executor_core.{executorFailure}
import memory.aligned_buffer.{OwnedBuffer}

@send
@move
class ProcessArguments {
    var strings: OwnedBuffer<UInt8>
    var pointers: OwnedBuffer<UInt8>
    var count: Int

    static fun pack(values: Array<String>) r: Result<ProcessArguments, AsyncError> {
        if values.length() > 256 {
            return Err<ProcessArguments, AsyncError>(executorFailure(2 as Int32, "process.arguments", 0 as UInt64))
        }
        var total = 1; var i = 0
        while i < values.length() {
            if values[i].length() > 65536 - total - 1 {
                return Err<ProcessArguments, AsyncError>(executorFailure(2 as Int32, "process.arguments", i as UInt64))
            }
            var j = 0
            while j < values[i].length() {
                if values[i].byteAt(j) == 0 {
                    return Err<ProcessArguments, AsyncError>(executorFailure(1 as Int32, "process.arguments", i as UInt64))
                }
                j = j + 1
            }
            total = total + values[i].length() + 1; i = i + 1
        }
        let allocated = OwnedBuffer<UInt8>.allocate(total as UInt64, 1 as UInt64, 16 as UInt64)
        if allocated.isErr() {
            allocated.unwrapErr().free(); allocated.releaseContainer()
            return Err<ProcessArguments, AsyncError>(executorFailure(2 as Int32, "process.arguments", 0 as UInt64))
        }
        let strings = allocated.unwrap(); allocated.releaseContainer()
        let table = OwnedBuffer<UInt8>.allocate((values.length() + 1) as UInt64, 8 as UInt64, 16 as UInt64)
        if table.isErr() {
            table.unwrapErr().free(); table.releaseContainer(); strings.close(); strings.free()
            return Err<ProcessArguments, AsyncError>(executorFailure(2 as Int32, "process.arguments", 0 as UInt64))
        }
        let pointers = table.unwrap(); table.releaseContainer()
        i = 0; var at = 0
        while i < values.length() {
            ptr_store_i64((pointers.data as Int) + i * 8, (strings.data as Int) + at)
            var j = 0
            while j < values[i].length() {
                ptr_store_i8((strings.data as Int) + at, values[i].byteAt(j) as Int8)
                j = j + 1; at = at + 1
            }
            ptr_store_i8((strings.data as Int) + at, 0 as Int8)
            at = at + 1; i = i + 1
        }
        ptr_store_i64((pointers.data as Int) + i * 8, 0)
        return Ok<ProcessArguments, AsyncError>(ProcessArguments{strings: strings, pointers: pointers,
            count: values.length()})
    }
    fun release() r: Bool {
        this.pointers.close(); this.pointers.free(); this.strings.close(); this.strings.free(); this.free()
        return true
    }
}

fun validProcessProgram(program: String) r: Bool {
    if program.length() <= 1 or program.length() > 4095 or program.byteAt(0) != 47 { return false }
    var start = 1; var i = 1
    while i <= program.length() {
        if i == program.length() or program.byteAt(i) == 47 {
            let count = i - start
            if count == 0 { return false }
            if count == 1 and program.byteAt(start) == 46 { return false }
            if count == 2 and program.byteAt(start) == 46 and program.byteAt(start + 1) == 46 { return false }
            start = i + 1
        } else {
            if program.byteAt(i) == 0 { return false }
        }
        i = i + 1
    }
    return true
}

fun validProcessEnvironment(environment: Array<String>) r: Bool {
    if environment.length() > 256 { return false }
    var i = 0
    while i < environment.length() {
        let value = environment[i]
        if value.length() > 65535 { return false }
        var at = 0
        while at < value.length() and value.byteAt(at) != 61 {
            let code = value.byteAt(at)
            if not ((code >= 65 and code <= 90) or (code >= 97 and code <= 122) or
                code == 95 or (at > 0 and code >= 48 and code <= 57)) { return false }
            at = at + 1
        }
        if at == 0 or at == value.length() { return false }
        i = i + 1
    }
    return true
}
