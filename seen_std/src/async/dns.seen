import core.result.{Result, Ok, Err}
import async.structured.{AsyncError, AsyncOperationContext, validateAsyncContext}
import async.executor_core.{executorFailure, executorCopyContext, executorReleaseSnapshot}
import async.io_lease.{AsyncIoLease, AsyncIoLeaseCounter}
import async.sockets.{SocketAddress, asyncSocketFailure, seen_async_socket_write}
import async.dns_wire.{DnsWire, DnsQuestion, DnsResponse, decodeDnsResponse}
import memory.aligned_buffer.{OwnedBuffer}
import reactor.reactor.{OwnedHandle}

extern "C" fun seen_async_datagram_open(address: *UInt8, length: UInt64,
    port: UInt16, descriptor: *Int64) r: Int32
extern "C" fun seen_async_datagram_receive(descriptor: Int64, buffer: *Void,
    capacity: UInt64, completed: *UInt64) r: Int32
extern "C" fun seen_async_datagram_nonce(value: *UInt16) r: Int32

@move
class AsyncDnsQuery {
    var descriptor: OwnedHandle
    var question: DnsQuestion
    var response: DnsWire
    var context: AsyncOperationContext
    var quota: AsyncIoLease
    var notifications: AsyncIoLeaseCounter
    var maxAnswers: Int
    var sent: Bool
    var finished: Bool
    var closed: Bool

    fun notificationLease() r: Result<AsyncIoLease, AsyncError> {
        if this.finished or this.closed {
            return Err<AsyncIoLease, AsyncError>(executorFailure(1 as Int32, "dns.notification", 0 as UInt64))
        }
        return this.notifications.acquire(this.descriptor.native as UInt64)
    }
    // Call on readiness. Unavailable retains all owners for retry. A terminal
    // result requires removing borrowed registrations before query release.
    fun step() r: Result<DnsResponse, AsyncError> {
        if this.finished or this.closed {
            return Err<DnsResponse, AsyncError>(executorFailure(1 as Int32, "dns.step", 0 as UInt64))
        }
        let valid = validateAsyncContext(this.context, "dns.step", 0 as UInt64)
        if valid.isErr() {
            let error = valid.unwrapErr(); valid.releaseContainer()
            // Errors cannot borrow a trace string owned by a released query.
            error.traceId = "async-dns"; this.finished = true
            return Err<DnsResponse, AsyncError>(error)
        }
        valid.releaseContainer()
        if not this.sent {
            var written = 0 as UInt64
            let status = seen_async_socket_write(this.descriptor.native,
                this.question.wire.storage.data as *Void, this.question.wire.length as UInt64, &written)
            if status != (0 as Int32) {
                if status != (8 as Int32) and status != (5 as Int32) { this.finished = true }
                return Err<DnsResponse, AsyncError>(asyncSocketFailure(status, "dns.send", written))
            }
            if written != (this.question.wire.length as UInt64) {
                this.finished = true
                return Err<DnsResponse, AsyncError>(executorFailure(1 as Int32, "dns.send", written))
            }
            this.sent = true
        }
        var received = 0 as UInt64
        let status = seen_async_datagram_receive(this.descriptor.native, this.response.storage.data as *Void,
            this.response.storage.byteLength, &received)
        if status != (0 as Int32) {
            if status != (8 as Int32) and status != (5 as Int32) { this.finished = true }
            return Err<DnsResponse, AsyncError>(asyncSocketFailure(status, "dns.receive", received))
        }
        this.response.length = received as Int; this.finished = true
        return decodeDnsResponse(this.response, this.question, this.maxAnswers)
    }
    fun close() r: Result<Bool, AsyncError> {
        if this.closed { return Ok<Bool, AsyncError>(true) }
        let idle = this.notifications.idleStatus()
        if idle != (0 as Int32) {
            return Err<Bool, AsyncError>(executorFailure(idle, "dns.close.borrowed", 0 as UInt64))
        }
        let closed = this.descriptor.close()
        if closed.isErr() {
            closed.unwrapErr().free(); closed.releaseContainer()
            this.closed = not this.descriptor.valid
            return Err<Bool, AsyncError>(executorFailure(3 as Int32, "dns.close", 0 as UInt64))
        }
        closed.releaseContainer(); this.closed = true
        return Ok<Bool, AsyncError>(true)
    }
    fun release() r: Result<Bool, AsyncError> {
        let closed = this.close()
        if closed.isErr() { return closed }
        closed.releaseContainer()
        let released = this.notifications.release()
        if released != (0 as Int32) {
            return Err<Bool, AsyncError>(executorFailure(released, "dns.release", 0 as UInt64))
        }
        this.quota.release(); this.question.release(); this.response.release()
        executorReleaseSnapshot(this.context); this.descriptor.free(); this.free()
        return Ok<Bool, AsyncError>(true)
    }
}

@move
class AsyncDnsResolver {
    var server: SocketAddress
    var quota: AsyncIoLeaseCounter
    var maxAnswers: Int
    var maxResponseBytes: Int

    static fun create(server: SocketAddress, maxQueries: Int, maxAnswers: Int,
        maxResponseBytes: Int) r: Result<AsyncDnsResolver, AsyncError> {
        if maxQueries <= 0 or maxQueries > 1024 or maxAnswers <= 0 or maxAnswers > 128 or
            maxResponseBytes < 512 or maxResponseBytes > 4096 {
            return Err<AsyncDnsResolver, AsyncError>(executorFailure(2 as Int32, "dns.create", 0 as UInt64))
        }
        if server.port == (0 as UInt16) or server.packed.data == (null as *UInt8) or
            (server.packed.byteLength != (4 as UInt64) and server.packed.byteLength != (16 as UInt64)) {
            return Err<AsyncDnsResolver, AsyncError>(executorFailure(1 as Int32, "dns.server", 0 as UInt64))
        }
        let bytes = Array<Int>(); var i = 0
        while i < (server.packed.byteLength as Int) {
            bytes.push((ptr_deref_i8((server.packed.data as Int) + i) as Int) & 255); i = i + 1
        }
        let copied = SocketAddress.fromBytes(bytes, server.port as Int); bytes.free()
        if copied.isErr() {
            let error = copied.unwrapErr(); copied.releaseContainer()
            return Err<AsyncDnsResolver, AsyncError>(error)
        }
        let snapshot = copied.unwrap(); copied.releaseContainer()
        let allocated = AsyncIoLeaseCounter.create(maxQueries)
        if allocated.isErr() {
            let error = allocated.unwrapErr(); allocated.releaseContainer(); snapshot.release()
            return Err<AsyncDnsResolver, AsyncError>(error)
        }
        let quota = allocated.unwrap(); allocated.releaseContainer()
        return Ok<AsyncDnsResolver, AsyncError>(AsyncDnsResolver{server: snapshot, quota: quota,
            maxAnswers: maxAnswers, maxResponseBytes: maxResponseBytes})
    }

    fun start(name: String, kind: Int, context: AsyncOperationContext) r: Result<AsyncDnsQuery, AsyncError> {
        let valid = validateAsyncContext(context, "dns.start", 0 as UInt64)
        if valid.isErr() {
            let error = valid.unwrapErr(); valid.releaseContainer(); return Err<AsyncDnsQuery, AsyncError>(error)
        }
        valid.releaseContainer()
        let acquired = this.quota.acquire(0 as UInt64)
        if acquired.isErr() {
            let error = acquired.unwrapErr(); acquired.releaseContainer(); return Err<AsyncDnsQuery, AsyncError>(error)
        }
        let quota = acquired.unwrap(); acquired.releaseContainer()
        let created = DnsQuestion.create(name, kind, 0)
        if created.isErr() {
            let error = created.unwrapErr(); created.releaseContainer(); quota.release()
            return Err<AsyncDnsQuery, AsyncError>(error)
        }
        let question = created.unwrap(); created.releaseContainer()
        var nonce = 0 as UInt16
        var status = seen_async_datagram_nonce(&nonce)
        if status != (0 as Int32) {
            question.release(); quota.release()
            return Err<AsyncDnsQuery, AsyncError>(asyncSocketFailure(status, "dns.nonce", 0 as UInt64))
        }
        question.id = nonce as Int
        question.wire.put(0, (nonce as Int) / 256); question.wire.put(1, (nonce as Int) % 256)
        let allocated = OwnedBuffer<UInt8>.allocate(this.maxResponseBytes as UInt64, 1 as UInt64, 16 as UInt64)
        if allocated.isErr() {
            allocated.unwrapErr().free(); allocated.releaseContainer(); question.release(); quota.release()
            return Err<AsyncDnsQuery, AsyncError>(executorFailure(2 as Int32, "dns.response", 0 as UInt64))
        }
        let buffer = allocated.unwrap(); allocated.releaseContainer()
        let notifications = AsyncIoLeaseCounter.create(1)
        if notifications.isErr() {
            let error = notifications.unwrapErr(); notifications.releaseContainer()
            buffer.close(); buffer.free(); question.release(); quota.release()
            return Err<AsyncDnsQuery, AsyncError>(error)
        }
        let leases = notifications.unwrap(); notifications.releaseContainer()
        let query = AsyncDnsQuery{
            descriptor: OwnedHandle{native: -1 as Int64, valid: false, owned: true}, question: question,
            response: DnsWire{storage: buffer, length: this.maxResponseBytes}, context: executorCopyContext(context),
            quota: quota, notifications: leases, maxAnswers: this.maxAnswers, sent: false, finished: false, closed: false}
        var descriptor = -1 as Int64
        status = seen_async_datagram_open(this.server.packed.data, this.server.packed.byteLength,
            this.server.port, &descriptor)
        if status != (0 as Int32) {
            let released = query.release()
            if released.isErr() { abort("DNS construction rollback failed") }
            released.releaseContainer()
            return Err<AsyncDnsQuery, AsyncError>(asyncSocketFailure(status, "dns.socket", 0 as UInt64))
        }
        query.descriptor.native = descriptor; query.descriptor.valid = true
        return Ok<AsyncDnsQuery, AsyncError>(query)
    }

    fun release() r: Result<Bool, AsyncError> {
        let status = this.quota.release()
        if status != (0 as Int32) {
            return Err<Bool, AsyncError>(executorFailure(status, "dns.release", 0 as UInt64))
        }
        this.server.release(); this.free(); return Ok<Bool, AsyncError>(true)
    }
}
