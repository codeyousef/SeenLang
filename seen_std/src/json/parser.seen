///
JSON Parser
Parses JSON strings into JsonValue objects
///

import json.value.{JsonValue, JSON_NULL, JSON_BOOL, JSON_NUMBER, JSON_STRING, JSON_ARRAY, JSON_OBJECT, JsonValue_nullValue, JsonValue_bool, jsonValue_stringOwned, JsonValue_numberFloat, jsonValue_arrayOwned, jsonValue_objectOwned, JsonValue_destroy}
import str.string.{StringBuilder}

extern "C" fun seen_parse_float_range(text: String, start: Int, end: Int) r: Float
extern "C" fun seen_string_builder_flatten_owned(parts: Array<String>,
    totalLength: Int) r: String
extern "C" fun seen_char_to_owned_string(value: Int) r: String
extern "C" fun seen_string_release_owned(value: String) r: Void

fun destroyJsonParserValues(values: Array<JsonValue>) r: Void {
    var index = 0
    while index < values.length() {
        JsonValue_destroy(values[index])
        index = index + 1
    }
    values.free()
}

fun destroyJsonParserObjectParts(keys: Array<String>,
    values: Array<JsonValue>) r: Void {

    var keyIndex = 0
    while keyIndex < keys.length() {
        seen_string_release_owned(keys[keyIndex])
        keyIndex = keyIndex + 1
    }
    keys.free()
    destroyJsonParserValues(values)
}

fun destroyJsonParserStringBuilder(builder: StringBuilder,
    partOwnership: Array<Bool>) r: Void {

    var partIndex = 0
    while partIndex < builder.parts.length() {
        if partIndex < partOwnership.length() and
            partOwnership[partIndex] {

            seen_string_release_owned(builder.parts[partIndex])
        }
        partIndex = partIndex + 1
    }
    partOwnership.free()
    builder.parts.free()
    builder.free()
}

// JSON Parser result
class JsonParseResult {
    var success: Int
    var value: JsonValue?
    var error: String
    var errorPosition: Int
}

fun destroyJsonParseResult(result: JsonParseResult,
    destroyValue: Bool) r: Void {

    let valueOption = result.value
    if destroyValue and result.success == 1 and not valueOption.isNone() {
        JsonValue_destroy(valueOption.unwrap())
    }
    valueOption.free()
    result.free()
}

// Free functions (formerly static methods on JsonParseResult)

fun JsonParseResult_ok(value: JsonValue) r: JsonParseResult {
    let result = JsonParseResult()
    result.success = 1
    result.value = value
    result.error = ""
    result.errorPosition = -1
    return result
}

fun JsonParseResult_err(message: String, position: Int) r: JsonParseResult {
    let result = JsonParseResult()
    result.success = 0
    result.value = null
    result.error = message
    result.errorPosition = position
    return result
}

// JSON Parser
class JsonParser {
    var input: String
    var pos: Int
    var len: Int
    var maxInputBytes: Int
    var depth: Int
    var maxDepth: Int
    var valueCount: Int
    var maxValues: Int

    // Main parse function
    fun parse() r: JsonParseResult {
        if this.maxInputBytes < 1 or this.maxDepth < 1 or
            this.maxValues < 1 {

            return JsonParseResult_err("JSON limits must be positive", 0)
        }
        if this.len > this.maxInputBytes {
            return JsonParseResult_err("JSON input limit exceeded", 0)
        }
        this.skipWhitespace()
        if this.pos >= this.len {
            return JsonParseResult_err("Unexpected end of input", this.pos)
        }
        let result = this.parseValue()
        if result.success == 1 {
            this.skipWhitespace()
            if this.pos < this.len {
                destroyJsonParseResult(result, true)
                return JsonParseResult_err("Unexpected characters after JSON", this.pos)
            }
        }
        return result
    }

    // Skip whitespace characters
    fun skipWhitespace() r: Void {
        while this.pos < this.len {
            let ch = this.input.charAt(this.pos)
            if ch == 32 or ch == 9 or ch == 10 or ch == 13 {
                this.pos = this.pos + 1
            } else {
                break
            }
        }
    }

    // Parse any JSON value
    fun parseValue() r: JsonParseResult {
        this.skipWhitespace()
        if this.pos >= this.len {
            return JsonParseResult_err("Unexpected end of input", this.pos)
        }

        if this.valueCount >= this.maxValues {
            return JsonParseResult_err("JSON value limit exceeded", this.pos)
        }
        this.valueCount = this.valueCount + 1

        let ch = this.input.charAt(this.pos)

        // null
        if ch == 110 {  // 'n'
            return this.parseNull()
        }

        // true
        if ch == 116 {  // 't'
            return this.parseTrue()
        }

        // false
        if ch == 102 {  // 'f'
            return this.parseFalse()
        }

        // string
        if ch == 34 {  // '"'
            return this.parseString()
        }

        // array
        if ch == 91 {  // '['
            if this.depth >= this.maxDepth {
                return JsonParseResult_err("JSON nesting limit exceeded", this.pos)
            }
            this.depth = this.depth + 1
            let result = this.parseArray()
            this.depth = this.depth - 1
            return result
        }

        // object
        if ch == 123 {  // '{'
            if this.depth >= this.maxDepth {
                return JsonParseResult_err("JSON nesting limit exceeded", this.pos)
            }
            this.depth = this.depth + 1
            let result = this.parseObject()
            this.depth = this.depth - 1
            return result
        }

        // number
        if ch == 45 or (ch >= 48 and ch <= 57) {  // '-' or digit
            return this.parseNumber()
        }

        return JsonParseResult_err("Unexpected character", this.pos)
    }

    // Parse null
    fun parseNull() r: JsonParseResult {
        if this.matchesLiteral("null") {
            this.pos = this.pos + 4
            let nv = JsonValue_nullValue()
            return JsonParseResult_ok(nv)
        }
        return JsonParseResult_err("Expected 'null'", this.pos)
    }

    // Parse true
    fun parseTrue() r: JsonParseResult {
        if this.matchesLiteral("true") {
            this.pos = this.pos + 4
            let bv = JsonValue_bool(true)
            return JsonParseResult_ok(bv)
        }
        return JsonParseResult_err("Expected 'true'", this.pos)
    }

    // Parse false
    fun parseFalse() r: JsonParseResult {
        if this.matchesLiteral("false") {
            this.pos = this.pos + 5
            let bv = JsonValue_bool(false)
            return JsonParseResult_ok(bv)
        }
        return JsonParseResult_err("Expected 'false'", this.pos)
    }

    fun matchesLiteral(literal: String) r: Bool {
        let litLen = literal.length()
        if this.pos + litLen > this.len {
            return false
        }
        var i = 0
        while i < litLen {
            if this.input.byteAt(this.pos + i) != literal.byteAt(i) {
                return false
            }
            i = i + 1
        }
        return true
    }

    // Parse string
    fun parseString() r: JsonParseResult {
        if this.pos >= this.len or this.input.charAt(this.pos) != 34 {
            return JsonParseResult_err("Expected '\"'", this.pos)
        }
        this.pos = this.pos + 1  // Skip opening quote

        let builder = StringBuilder.new()
        let partOwnership = Array<Bool>()
        var segmentStart = this.pos
        while this.pos < this.len {
            let ch = this.input.charAt(this.pos)

            if ch == 34 {  // Closing quote
                if this.pos > segmentStart {
                    builder.append(this.input.substring(segmentStart, this.pos))
                    partOwnership.push(true)
                }
                this.pos = this.pos + 1
                let result = seen_string_builder_flatten_owned(builder.parts,
                    builder.totalLength)
                destroyJsonParserStringBuilder(builder, partOwnership)
                let sv = jsonValue_stringOwned(result)
                return JsonParseResult_ok(sv)
            }

            if ch == 92 {  // Backslash (escape)
                if this.pos > segmentStart {
                    builder.append(this.input.substring(segmentStart, this.pos))
                    partOwnership.push(true)
                }
                this.pos = this.pos + 1
                if this.pos >= this.len {
                    destroyJsonParserStringBuilder(builder, partOwnership)
                    return JsonParseResult_err("Unexpected end of string escape", this.pos)
                }
                let escaped = this.input.charAt(this.pos)
                var escapedChar = ""
                var escapeHandled = 0
                var escapedOwned = false
                if escaped == 34 { escapedChar = "\""; escapeHandled = 1 }
                if escaped == 92 and escapeHandled == 0 { escapedChar = "\\"; escapeHandled = 1 }
                if escaped == 47 and escapeHandled == 0 { escapedChar = "/"; escapeHandled = 1 }
                if escaped == 98 and escapeHandled == 0 { escapedChar = seen_char_to_owned_string(8); escapedOwned = true; escapeHandled = 1 }
                if escaped == 102 and escapeHandled == 0 { escapedChar = seen_char_to_owned_string(12); escapedOwned = true; escapeHandled = 1 }
                if escaped == 110 and escapeHandled == 0 { escapedChar = "\n"; escapeHandled = 1 }
                if escaped == 114 and escapeHandled == 0 { escapedChar = "\r"; escapeHandled = 1 }
                if escaped == 116 and escapeHandled == 0 { escapedChar = "\t"; escapeHandled = 1 }
                if escaped == 117 and escapeHandled == 0 {
                    // Unicode escape - parse 4 hex digits
                    if this.pos + 4 >= this.len {
                        destroyJsonParserStringBuilder(builder, partOwnership)
                        return JsonParseResult_err("Invalid unicode escape", this.pos)
                    }
                    let codepoint = this.parseHexAt(this.pos + 1)
                    if codepoint < 0 {
                        destroyJsonParserStringBuilder(builder, partOwnership)
                        return JsonParseResult_err("Invalid unicode escape", this.pos)
                    }
                    builder.append(seen_char_to_owned_string(codepoint))
                    partOwnership.push(true)
                    this.pos = this.pos + 5
                    segmentStart = this.pos
                    continue
                }
                if escapeHandled == 0 {
                    destroyJsonParserStringBuilder(builder, partOwnership)
                    return JsonParseResult_err("Invalid escape sequence", this.pos)
                }
                builder.append(escapedChar)
                partOwnership.push(escapedOwned)
                this.pos = this.pos + 1
                segmentStart = this.pos
                continue
            } else {
                if ch < 32 {
                    destroyJsonParserStringBuilder(builder, partOwnership)
                    return JsonParseResult_err("Invalid control character in string", this.pos)
                }
            }

            this.pos = this.pos + 1
        }

        destroyJsonParserStringBuilder(builder, partOwnership)
        return JsonParseResult_err("Unterminated string", this.pos)
    }

    fun parseHexAt(start: Int) r: Int {
        var result = 0
        var i = 0
        while i < 4 {
            let ch = this.input.charAt(start + i)
            var digit = 0
            var hexHandled = 0
            if ch >= 48 and ch <= 57 {
                digit = ch - 48
                hexHandled = 1
            }
            if hexHandled == 0 {
                if ch >= 65 and ch <= 70 {
                    digit = ch - 55
                    hexHandled = 1
                }
            }
            if hexHandled == 0 {
                if ch >= 97 and ch <= 102 {
                    digit = ch - 87
                    hexHandled = 1
                }
            }
            if hexHandled == 0 {
                return -1
            }
            result = result * 16 + digit
            i = i + 1
        }
        return result
    }

    // Parse 4 hex digits to integer
    fun parseHex(hex: String) r: Int {
        if hex.length() != 4 {
            return -1
        }
        var result = 0
        var i = 0
        while i < 4 {
            let ch = hex.charAt(i)
            var digit = 0
            var hexHandled = 0
            if ch >= 48 and ch <= 57 {  // 0-9
                digit = ch - 48
                hexHandled = 1
            }
            if hexHandled == 0 {
                if ch >= 65 and ch <= 70 {  // A-F
                    digit = ch - 55
                    hexHandled = 1
                }
            }
            if hexHandled == 0 {
                if ch >= 97 and ch <= 102 {  // a-f
                    digit = ch - 87
                    hexHandled = 1
                }
            }
            if hexHandled == 0 {
                return -1
            }
            result = result * 16 + digit
            i = i + 1
        }
        return result
    }

    // Parse number
    fun parseNumber() r: JsonParseResult {
        let startPos = this.pos
        var hasDecimal = 0
        var hasExponent = 0

        // Optional negative sign
        if this.pos < this.len and this.input.charAt(this.pos) == 45 {
            this.pos = this.pos + 1
        }

        // Integer part
        if this.pos >= this.len {
            return JsonParseResult_err("Expected digit", this.pos)
        }

        let firstDigit = this.input.charAt(this.pos)
        if firstDigit == 48 {  // 0
            this.pos = this.pos + 1
        } else {
            if firstDigit >= 49 and firstDigit <= 57 {  // 1-9
                this.pos = this.pos + 1
                while this.pos < this.len {
                    let ch = this.input.charAt(this.pos)
                    if ch >= 48 and ch <= 57 {
                        this.pos = this.pos + 1
                    } else {
                        break
                    }
                }
            } else {
                return JsonParseResult_err("Expected digit", this.pos)
            }
        }

        // Decimal part
        if this.pos < this.len and this.input.charAt(this.pos) == 46 {
            hasDecimal = 1
            this.pos = this.pos + 1
            if this.pos >= this.len {
                return JsonParseResult_err("Expected digit after decimal point", this.pos)
            }
            let firstFracDigit = this.input.charAt(this.pos)
            if firstFracDigit < 48 or firstFracDigit > 57 {
                return JsonParseResult_err("Expected digit after decimal point", this.pos)
            }
            while this.pos < this.len {
                let ch = this.input.charAt(this.pos)
                if ch >= 48 and ch <= 57 {
                    this.pos = this.pos + 1
                } else {
                    break
                }
            }
        }

        // Exponent part
        if this.pos < this.len {
            let expChar = this.input.charAt(this.pos)
            if expChar == 101 or expChar == 69 {  // e or E
                hasExponent = 1
                this.pos = this.pos + 1
                if this.pos < this.len {
                    let signChar = this.input.charAt(this.pos)
                    if signChar == 43 or signChar == 45 {  // + or -
                        this.pos = this.pos + 1
                    }
                }
                if this.pos >= this.len {
                    return JsonParseResult_err("Expected digit in exponent", this.pos)
                }
                let firstExpDigit = this.input.charAt(this.pos)
                if firstExpDigit < 48 or firstExpDigit > 57 {
                    return JsonParseResult_err("Expected digit in exponent", this.pos)
                }
                while this.pos < this.len {
                    let ch = this.input.charAt(this.pos)
                    if ch >= 48 and ch <= 57 {
                        this.pos = this.pos + 1
                    } else {
                        break
                    }
                }
            }
        }

        let numValue = seen_parse_float_range(this.input, startPos, this.pos)
        if numValue.isNaN() or numValue.isInfinite() {
            return JsonParseResult_err("JSON number out of range", startPos)
        }
        let fv = JsonValue_numberFloat(numValue)
        return JsonParseResult_ok(fv)
    }

    // Parse float from string (simple implementation)
    fun parseFloat(s: String) r: Float {
        let oldInput = this.input
        let oldPos = this.pos
        let oldLen = this.len
        this.input = s
        this.pos = 0
        this.len = s.length()
        let result = seen_parse_float_range(this.input, 0, this.len)
        this.input = oldInput
        this.pos = oldPos
        this.len = oldLen
        return result
    }

    fun parseFloatRange(start: Int, end: Int) r: Float {
        var result = 0.0
        var i = start
        var negativeNum = 0
        var afterDec = 0
        var decimalMultiplier = 0.1
        var hasExp = 0
        var exponent = 0
        var expNeg = 0

        // Handle negative sign
        if i < end and this.input.charAt(i) == 45 {
            negativeNum = 1
            i = i + 1
        }

        while i < end {
            let ch = this.input.charAt(i)

            if ch == 46 {  // Decimal point
                afterDec = 1
                i = i + 1
                continue
            }

            if ch == 101 or ch == 69 {  // Exponent
                hasExp = 1
                i = i + 1
                if i < end {
                    let signCh = this.input.charAt(i)
                    if signCh == 45 {
                        expNeg = 1
                        i = i + 1
                    } else {
                        if signCh == 43 {
                            i = i + 1
                        }
                    }
                }
                // Parse exponent digits
                while i < end {
                    let expCh = this.input.charAt(i)
                    if expCh >= 48 and expCh <= 57 {
                        exponent = exponent * 10 + (expCh - 48)
                    } else {
                        break
                    }
                    i = i + 1
                }
                break
            }

            if ch >= 48 and ch <= 57 {
                let digit = ch - 48
                if afterDec == 1 {
                    result = result + digit.toFloat() * decimalMultiplier
                    decimalMultiplier = decimalMultiplier * 0.1
                } else {
                    result = result * 10.0 + digit.toFloat()
                }
            }

            i = i + 1
        }

        // Apply exponent
        if hasExp == 1 {
            var expMultiplier = 1.0
            var j = 0
            while j < exponent {
                expMultiplier = expMultiplier * 10.0
                j = j + 1
            }
            if expNeg == 1 {
                result = result / expMultiplier
            } else {
                result = result * expMultiplier
            }
        }

        if negativeNum == 1 {
            result = 0.0 - result
        }

        return result
    }

    // Parse array
    fun parseArray() r: JsonParseResult {
        if this.pos >= this.len or this.input.charAt(this.pos) != 91 {
            return JsonParseResult_err("Expected '['", this.pos)
        }
        this.pos = this.pos + 1  // Skip opening bracket

        let elements = Array<JsonValue>()

        this.skipWhitespace()
        if this.pos < this.len and this.input.charAt(this.pos) == 93 {
            // Empty array
            this.pos = this.pos + 1
            let av = jsonValue_arrayOwned(elements)
            return JsonParseResult_ok(av)
        }

        while true {
            this.skipWhitespace()
            let elemResult = this.parseValue()
            if elemResult.success == 1 {
                // ok
            } else {
                destroyJsonParserValues(elements)
                return elemResult
            }
            let elemOptVal = elemResult.value
            let elemVal = elemOptVal.unwrap()
            elements.push(elemVal)
            destroyJsonParseResult(elemResult, false)

            this.skipWhitespace()
            if this.pos >= this.len {
                destroyJsonParserValues(elements)
                return JsonParseResult_err("Unterminated array", this.pos)
            }

            let nextCh = this.input.charAt(this.pos)
            if nextCh == 93 {  // ]
                this.pos = this.pos + 1
                let av = jsonValue_arrayOwned(elements)
                return JsonParseResult_ok(av)
            }

            if nextCh != 44 {  // ,
                destroyJsonParserValues(elements)
                return JsonParseResult_err("Expected ',' or ']'", this.pos)
            }
            this.pos = this.pos + 1  // Skip comma
        }

        // Unreachable but needed for type checker
        destroyJsonParserValues(elements)
        return JsonParseResult_err("Parse error", this.pos)
    }

    // Parse object
    fun parseObject() r: JsonParseResult {
        if this.pos >= this.len or this.input.charAt(this.pos) != 123 {
            return JsonParseResult_err("Expected '{'", this.pos)
        }
        this.pos = this.pos + 1  // Skip opening brace

        let keys = Array<String>()
        let values = Array<JsonValue>()

        this.skipWhitespace()
        if this.pos < this.len and this.input.charAt(this.pos) == 125 {
            // Empty object
            this.pos = this.pos + 1
            let ov = jsonValue_objectOwned(keys, values)
            return JsonParseResult_ok(ov)
        }

        while true {
            this.skipWhitespace()

            // Parse key (must be string)
            if this.pos >= this.len or this.input.charAt(this.pos) != 34 {
                destroyJsonParserObjectParts(keys, values)
                return JsonParseResult_err("Expected string key", this.pos)
            }
            let keyResult = this.parseString()
            if keyResult.success == 1 {
                // ok
            } else {
                destroyJsonParserObjectParts(keys, values)
                return keyResult
            }
            let keyOptVal = keyResult.value
            let keyJsonVal = keyOptVal.unwrap()
            let key = keyJsonVal.getString()

            // Expect colon
            this.skipWhitespace()
            if this.pos >= this.len or this.input.charAt(this.pos) != 58 {
                JsonValue_destroy(keyJsonVal)
                destroyJsonParseResult(keyResult, false)
                destroyJsonParserObjectParts(keys, values)
                return JsonParseResult_err("Expected ':'", this.pos)
            }
            this.pos = this.pos + 1  // Skip colon

            // Move the parsed key into the partial object. From this point the
            // object-parts cleanup path owns it, including value parse errors.
            keys.push(key)
            keyJsonVal.ownsString = false
            JsonValue_destroy(keyJsonVal)
            destroyJsonParseResult(keyResult, false)

            // Parse value
            this.skipWhitespace()
            let valueResult = this.parseValue()
            if valueResult.success == 1 {
                // ok
            } else {
                destroyJsonParserObjectParts(keys, values)
                return valueResult
            }

            let valOptVal = valueResult.value
            let valObj = valOptVal.unwrap()
            values.push(valObj)
            destroyJsonParseResult(valueResult, false)

            this.skipWhitespace()
            if this.pos >= this.len {
                destroyJsonParserObjectParts(keys, values)
                return JsonParseResult_err("Unterminated object", this.pos)
            }

            let nextCh = this.input.charAt(this.pos)
            if nextCh == 125 {  // }
                this.pos = this.pos + 1
                let ov = jsonValue_objectOwned(keys, values)
                return JsonParseResult_ok(ov)
            }

            if nextCh != 44 {  // ,
                destroyJsonParserObjectParts(keys, values)
                return JsonParseResult_err("Expected ',' or '}'", this.pos)
            }
            this.pos = this.pos + 1  // Skip comma
        }

        // Unreachable but needed for type checker
        destroyJsonParserObjectParts(keys, values)
        return JsonParseResult_err("Parse error", this.pos)
    }
}

// Free function (formerly static method on JsonParser)

fun JsonParser_new(input: String) r: JsonParser {
    return jsonParserNewWithLimits(input, 67108864, 256, 1000000)
}

fun jsonParserNewWithLimits(input: String, maxInputBytes: Int,
    maxDepth: Int, maxValues: Int) r: JsonParser {

    let parser = JsonParser()
    parser.input = input
    parser.pos = 0
    parser.len = input.length()
    parser.maxInputBytes = maxInputBytes
    parser.depth = 0
    parser.maxDepth = maxDepth
    parser.valueCount = 0
    parser.maxValues = maxValues
    return parser
}

// Parse under explicit adversarial-input bounds. maxInputBytes limits the
// UTF-8 storage accepted by the parser; maxDepth bounds nested containers and
// maxValues bounds the total number of JSON values visited.
fun parseJsonWithLimits(input: String, maxInputBytes: Int, maxDepth: Int,
    maxValues: Int) r: JsonParseResult {

    if maxInputBytes < 1 or maxDepth < 1 or maxValues < 1 {
        return JsonParseResult_err("JSON limits must be positive", 0)
    }
    if input.length() > maxInputBytes {
        return JsonParseResult_err("JSON input limit exceeded", 0)
    }
    let parser = jsonParserNewWithLimits(input, maxInputBytes, maxDepth,
        maxValues)
    let result = parser.parse()
    parser.free()
    return result
}

// Convenience function with production-safe defaults: 64 MiB of input, 256
// nested containers, and one million total values.
fun parseJson(input: String) r: JsonParseResult {
    return parseJsonWithLimits(input, 67108864, 256, 1000000)
}
