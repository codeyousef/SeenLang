/// Strict manifest-oriented JSON helpers layered on the bounded parser.

import json.parser.{JsonParseResult, parseJsonWithStrictLimits}
import core.result.{Result, Ok, Err}
import json.value.{JsonValue}

let JSON_UNKNOWN_FIELDS_ALLOW: Int = 0
let JSON_UNKNOWN_FIELDS_REJECT: Int = 1

class StrictJsonLimits {
    var maxInputBytes: Int
    var maxDepth: Int
    var maxValues: Int
    var maxStringBytes: Int

    static fun manifests() r: StrictJsonLimits {
        return StrictJsonLimits{ maxInputBytes: 67108864, maxDepth: 128,
            maxValues: 1000000, maxStringBytes: 16777216 }
    }
}

class StrictJsonError {
    var code: String
    var position: Int
    var message: String
}

fun validateJsonUtf8(input: String) r: Result<Bool, StrictJsonError> {
    var index = 0
    while index < input.length() {
        let first = input.byteAt(index)
        var continuation = 0
        if first < 0x80 { continuation = 0 }
        else if first >= 0xC2 and first <= 0xDF { continuation = 1 }
        else if first >= 0xE0 and first <= 0xEF { continuation = 2 }
        else if first >= 0xF0 and first <= 0xF4 { continuation = 3 }
        else {
            return Err<Bool, StrictJsonError>(StrictJsonError{
                code: "json.utf8", position: index,
                message: "invalid UTF-8 leading byte"
            })
        }
        if index + continuation >= input.length() {
            return Err<Bool, StrictJsonError>(StrictJsonError{
                code: "json.utf8", position: index,
                message: "truncated UTF-8 sequence"
            })
        }
        var next = 1
        while next <= continuation {
            let value = input.byteAt(index + next)
            if value < 0x80 or value > 0xBF {
                return Err<Bool, StrictJsonError>(StrictJsonError{
                    code: "json.utf8", position: index + next,
                    message: "invalid UTF-8 continuation byte"
                })
            }
            next = next + 1
        }
        if continuation == 2 {
            let second = input.byteAt(index + 1)
            if (first == 0xE0 and second < 0xA0) or
                (first == 0xED and second >= 0xA0) {
                return Err<Bool, StrictJsonError>(StrictJsonError{
                    code: "json.utf8", position: index,
                    message: "non-scalar UTF-8 sequence"
                })
            }
        }
        if continuation == 3 {
            let second = input.byteAt(index + 1)
            if (first == 0xF0 and second < 0x90) or
                (first == 0xF4 and second > 0x8F) {
                return Err<Bool, StrictJsonError>(StrictJsonError{
                    code: "json.utf8", position: index,
                    message: "out-of-range UTF-8 sequence"
                })
            }
        }
        index = index + continuation + 1
    }
    return Ok<Bool, StrictJsonError>(true)
}

fun parseStrictJson(input: String, limits: StrictJsonLimits)
    r: Result<JsonParseResult, StrictJsonError> {
    if limits.maxInputBytes < 1 or limits.maxDepth < 1 or
        limits.maxValues < 1 or limits.maxStringBytes < 1 {
        return Err<JsonParseResult, StrictJsonError>(StrictJsonError{
            code: "json.limits", position: 0,
            message: "strict JSON limits must be positive"
        })
    }
    let utf8 = validateJsonUtf8(input)
    if utf8.isErr() {
        return Err<JsonParseResult, StrictJsonError>(utf8.unwrapErr())
    }
    let parsed = parseJsonWithStrictLimits(input, limits.maxInputBytes,
        limits.maxDepth, limits.maxValues, limits.maxStringBytes)
    if parsed.success != 1 {
        return Err<JsonParseResult, StrictJsonError>(StrictJsonError{
            code: "json.syntax", position: parsed.errorPosition,
            message: parsed.error
        })
    }
    return Ok<JsonParseResult, StrictJsonError>(parsed)
}

fun enforceStrictJsonUnknownFields(value: JsonValue,
    knownFields: Array<String>, policy: Int)
    r: Result<Bool, StrictJsonError> {
    if policy != JSON_UNKNOWN_FIELDS_ALLOW and
        policy != JSON_UNKNOWN_FIELDS_REJECT {
        return Err<Bool, StrictJsonError>(StrictJsonError{
            code: "json.unknown_policy", position: 0,
            message: "unknown-field policy is invalid"
        })
    }
    if not value.isObject() {
        return Err<Bool, StrictJsonError>(StrictJsonError{
            code: "json.object", position: 0,
            message: "unknown-field validation requires an object"
        })
    }
    if policy == JSON_UNKNOWN_FIELDS_ALLOW {
        return Ok<Bool, StrictJsonError>(true)
    }
    let keys = value.keys()
    var keyIndex = 0
    while keyIndex < keys.length() {
        var known = false
        var knownIndex = 0
        while knownIndex < knownFields.length() {
            if keys[keyIndex] == knownFields[knownIndex] { known = true }
            knownIndex = knownIndex + 1
        }
        if not known {
            return Err<Bool, StrictJsonError>(StrictJsonError{
                code: "json.unknown_field", position: 0,
                message: "object contains an unknown field"
            })
        }
        keyIndex = keyIndex + 1
    }
    return Ok<Bool, StrictJsonError>(true)
}

// Exact signed integer parsing for schema fields. It never converts through
// Float and rejects leading zeroes, fractions, exponents, and overflow.
fun parseStrictInt64(text: String) r: Result<Int64, StrictJsonError> {
    if text.length() == 0 {
        return Err<Int64, StrictJsonError>(StrictJsonError{
            code: "json.integer", position: 0, message: "empty integer"
        })
    }
    var index = 0
    var negative = false
    if text.charAt(0) == 45 { negative = true; index = 1 }
    if index >= text.length() or
        (text.charAt(index) == 48 and index + 1 < text.length()) {
        return Err<Int64, StrictJsonError>(StrictJsonError{
            code: "json.integer", position: index,
            message: "invalid canonical integer"
        })
    }
    var magnitude: UInt64 = 0 as UInt64
    let positiveLimit = 0x7FFFFFFFFFFFFFFF as UInt64
    let negativeLimit = 0x8000000000000000 as UInt64
    let limit = if negative { negativeLimit } else { positiveLimit }
    while index < text.length() {
        let byte = text.charAt(index)
        if byte < 48 or byte > 57 or
            magnitude > (limit - ((byte - 48) as UInt64)) / (10 as UInt64) {
            return Err<Int64, StrictJsonError>(StrictJsonError{
                code: "json.integer", position: index,
                message: "integer syntax or range error"
            })
        }
        magnitude = magnitude * (10 as UInt64) + ((byte - 48) as UInt64)
        index = index + 1
    }
    if negative {
        if magnitude == negativeLimit {
            return Ok<Int64, StrictJsonError>(-9223372036854775807 - 1)
        }
        return Ok<Int64, StrictJsonError>(0 - (magnitude as Int64))
    }
    return Ok<Int64, StrictJsonError>(magnitude as Int64)
}
