///
JSON Builder
Builds JSON strings from JsonValue objects or incrementally
///

import json.value.{JsonValue}
import str.string.{StringBuilder}

extern "C" fun seen_string_builder_flatten_owned(parts: Array<String>,
    totalLength: Int) r: String
extern "C" fun seen_string_clone_owned(value: String) r: String
extern "C" fun seen_string_release_owned(value: String) r: Void

fun jsonAppendBorrowedPart(builder: StringBuilder,
    partOwnership: Array<Bool>, text: String) r: Void {

    if text.length() == 0 {
        return
    }
    builder.append(text)
    partOwnership.push(false)
}

fun jsonAppendOwnedPart(builder: StringBuilder,
    partOwnership: Array<Bool>, text: String) r: Void {

    if text.length() == 0 {
        seen_string_release_owned(text)
        return
    }
    builder.append(text)
    partOwnership.push(true)
}

fun jsonReleaseOwnedParts(builder: StringBuilder,
    partOwnership: Array<Bool>) r: Void {

    if builder.parts.length() != partOwnership.length() {
        abort("JSON builder ownership metadata mismatch")
    }
    var index = 0
    while index < builder.parts.length() {
        if partOwnership[index] {
            seen_string_release_owned(builder.parts[index])
        }
        index = index + 1
    }
}

fun jsonFlattenOwned(builder: StringBuilder,
    partOwnership: Array<Bool>) r: String {

    if builder.parts.length() != partOwnership.length() {
        abort("JSON builder ownership metadata mismatch")
    }
    return seen_string_builder_flatten_owned(builder.parts,
        builder.totalLength)
}

fun jsonFinishOwned(builder: StringBuilder,
    partOwnership: Array<Bool>) r: String {

    let result = jsonFlattenOwned(builder, partOwnership)
    jsonReleaseOwnedParts(builder, partOwnership)
    partOwnership.free()
    builder.parts.free()
    builder.free()
    return result
}

///
Release text returned by escapeJsonString, jsonToString, toJsonPretty, or
JsonBuilder.build. Each of those APIs returns one independent owned string.
///
fun releaseJsonText(value: String) r: Void {
    seen_string_release_owned(value)
}

fun jsonAppendHexDigit(builder: StringBuilder,
    partOwnership: Array<Bool>, value: Int) r: Void {

    if value == 0 { jsonAppendBorrowedPart(builder, partOwnership, "0"); return }
    if value == 1 { jsonAppendBorrowedPart(builder, partOwnership, "1"); return }
    if value == 2 { jsonAppendBorrowedPart(builder, partOwnership, "2"); return }
    if value == 3 { jsonAppendBorrowedPart(builder, partOwnership, "3"); return }
    if value == 4 { jsonAppendBorrowedPart(builder, partOwnership, "4"); return }
    if value == 5 { jsonAppendBorrowedPart(builder, partOwnership, "5"); return }
    if value == 6 { jsonAppendBorrowedPart(builder, partOwnership, "6"); return }
    if value == 7 { jsonAppendBorrowedPart(builder, partOwnership, "7"); return }
    if value == 8 { jsonAppendBorrowedPart(builder, partOwnership, "8"); return }
    if value == 9 { jsonAppendBorrowedPart(builder, partOwnership, "9"); return }
    if value == 10 { jsonAppendBorrowedPart(builder, partOwnership, "a"); return }
    if value == 11 { jsonAppendBorrowedPart(builder, partOwnership, "b"); return }
    if value == 12 { jsonAppendBorrowedPart(builder, partOwnership, "c"); return }
    if value == 13 { jsonAppendBorrowedPart(builder, partOwnership, "d"); return }
    if value == 14 { jsonAppendBorrowedPart(builder, partOwnership, "e"); return }
    jsonAppendBorrowedPart(builder, partOwnership, "f")
}

fun jsonAppendNegativeIntDigits(builder: StringBuilder,
    partOwnership: Array<Bool>, negativeValue: Int) r: Void {

    if negativeValue <= -10 {
        jsonAppendNegativeIntDigits(builder, partOwnership,
            negativeValue / 10)
    }
    let digit = 0 - (negativeValue % 10)
    jsonAppendHexDigit(builder, partOwnership, digit)
}

fun jsonAppendInt(builder: StringBuilder,
    partOwnership: Array<Bool>, value: Int) r: Void {

    var negativeValue = value
    if value < 0 {
        jsonAppendBorrowedPart(builder, partOwnership, "-")
    } else {
        negativeValue = 0 - value
    }
    jsonAppendNegativeIntDigits(builder, partOwnership, negativeValue)
}

fun jsonAppendEscapedString(builder: StringBuilder,
    partOwnership: Array<Bool>, input: String) r: Void {

    jsonAppendBorrowedPart(builder, partOwnership, "\"")
    var index = 0
    var segmentStart = 0
    let length = input.length()

    while index < length {
        // String offsets and byteAt are both UTF-8 byte based. This keeps
        // non-ASCII prefixes from shifting later ASCII escape positions.
        let byte = input.byteAt(index)
        var escaped = ""
        var wasEscaped = false
        if byte == 34 { escaped = "\\\""; wasEscaped = true }
        if byte == 92 and not wasEscaped { escaped = "\\\\"; wasEscaped = true }
        if byte == 10 and not wasEscaped { escaped = "\\n"; wasEscaped = true }
        if byte == 13 and not wasEscaped { escaped = "\\r"; wasEscaped = true }
        if byte == 9 and not wasEscaped { escaped = "\\t"; wasEscaped = true }
        if byte == 8 and not wasEscaped { escaped = "\\b"; wasEscaped = true }
        if byte == 12 and not wasEscaped { escaped = "\\f"; wasEscaped = true }

        if wasEscaped {
            if segmentStart < index {
                jsonAppendOwnedPart(builder, partOwnership,
                    input.substring(segmentStart, index))
            }
            jsonAppendBorrowedPart(builder, partOwnership, escaped)
            segmentStart = index + 1
        } else {
            if byte < 32 {
                if segmentStart < index {
                    jsonAppendOwnedPart(builder, partOwnership,
                        input.substring(segmentStart, index))
                }
                jsonAppendBorrowedPart(builder, partOwnership, "\\u00")
                jsonAppendHexDigit(builder, partOwnership, byte / 16)
                jsonAppendHexDigit(builder, partOwnership, byte % 16)
                segmentStart = index + 1
            }
        }
        index = index + 1
    }

    if segmentStart < length {
        jsonAppendOwnedPart(builder, partOwnership,
            input.substring(segmentStart, length))
    }
    jsonAppendBorrowedPart(builder, partOwnership, "\"")
}

///
Fluent JSON builder for constructing JSON strings incrementally.
build returns an independent owned string; reset and destroyJsonBuilder
release all temporary escaped-string parts retained by the builder.
///
class JsonBuilder {
    var buffer: StringBuilder
    var partOwnership: Array<Bool>
    var needsComma: Int
    var depth: Int

    fun startObject() r: JsonBuilder {
        this.maybeComma()
        jsonAppendBorrowedPart(this.buffer, this.partOwnership, "{")
        this.needsComma = 0
        this.depth = this.depth + 1
        return this
    }

    fun endObject() r: JsonBuilder {
        jsonAppendBorrowedPart(this.buffer, this.partOwnership, "}")
        this.needsComma = 1
        this.depth = this.depth - 1
        return this
    }

    fun startArray() r: JsonBuilder {
        this.maybeComma()
        jsonAppendBorrowedPart(this.buffer, this.partOwnership, "[")
        this.needsComma = 0
        this.depth = this.depth + 1
        return this
    }

    fun endArray() r: JsonBuilder {
        jsonAppendBorrowedPart(this.buffer, this.partOwnership, "]")
        this.needsComma = 1
        this.depth = this.depth - 1
        return this
    }

    fun key(name: String) r: JsonBuilder {
        this.maybeComma()
        jsonAppendEscapedString(this.buffer, this.partOwnership, name)
        jsonAppendBorrowedPart(this.buffer, this.partOwnership, ":")
        this.needsComma = 0
        return this
    }

    fun nullValue() r: JsonBuilder {
        this.maybeComma()
        jsonAppendBorrowedPart(this.buffer, this.partOwnership, "null")
        this.needsComma = 1
        return this
    }

    fun bool(value: Int) r: JsonBuilder {
        this.maybeComma()
        if value == 1 {
            jsonAppendBorrowedPart(this.buffer, this.partOwnership, "true")
        } else {
            jsonAppendBorrowedPart(this.buffer, this.partOwnership, "false")
        }
        this.needsComma = 1
        return this
    }

    fun number(value: Int) r: JsonBuilder {
        this.maybeComma()
        jsonAppendInt(this.buffer, this.partOwnership, value)
        this.needsComma = 1
        return this
    }

    fun numberFloat(value: Float) r: JsonBuilder {
        this.maybeComma()
        jsonAppendInt(this.buffer, this.partOwnership, value.toInt())
        this.needsComma = 1
        return this
    }

    fun string(value: String) r: JsonBuilder {
        this.maybeComma()
        jsonAppendEscapedString(this.buffer, this.partOwnership, value)
        this.needsComma = 1
        return this
    }

    fun raw(json: String) r: JsonBuilder {
        this.maybeComma()
        jsonAppendOwnedPart(this.buffer, this.partOwnership,
            seen_string_clone_owned(json))
        this.needsComma = 1
        return this
    }

    fun stringProp(key: String, value: String) r: JsonBuilder {
        this.key(key)
        return this.string(value)
    }

    fun intProp(key: String, value: Int) r: JsonBuilder {
        this.key(key)
        return this.number(value)
    }

    fun boolProp(key: String, value: Int) r: JsonBuilder {
        this.key(key)
        return this.bool(value)
    }

    fun nullProp(key: String) r: JsonBuilder {
        this.key(key)
        return this.nullValue()
    }

    fun maybeComma() r: Void {
        if this.needsComma == 1 {
            jsonAppendBorrowedPart(this.buffer, this.partOwnership, ",")
        }
    }

    fun build() r: String {
        return jsonFlattenOwned(this.buffer, this.partOwnership)
    }

    fun reset() r: Void {
        jsonReleaseOwnedParts(this.buffer, this.partOwnership)
        this.partOwnership.free()
        this.partOwnership = Array<Bool>()
        this.buffer.clear()
        this.needsComma = 0
        this.depth = 0
    }
}

fun JsonBuilder_new() r: JsonBuilder {
    let builder = JsonBuilder()
    builder.buffer = StringBuilder.new()
    builder.needsComma = 0
    builder.depth = 0
    return builder
}

fun destroyJsonBuilder(builder: JsonBuilder) r: Void {
    jsonReleaseOwnedParts(builder.buffer, builder.partOwnership)
    builder.partOwnership.free()
    let buffer = builder.buffer
    buffer.parts.free()
    buffer.free()
    builder.free()
}

fun escapeJsonString(input: String) r: String {
    let builder = StringBuilder.new()
    let partOwnership = Array<Bool>()
    jsonAppendEscapedString(builder, partOwnership, input)
    return jsonFinishOwned(builder, partOwnership)
}

fun jsonAppendValue(builder: StringBuilder, partOwnership: Array<Bool>,
    value: JsonValue) r: Void {

    if value.isNull() {
        jsonAppendBorrowedPart(builder, partOwnership, "null")
        return
    }
    if value.isBool() {
        if value.boolValue {
            jsonAppendBorrowedPart(builder, partOwnership, "true")
        } else {
            jsonAppendBorrowedPart(builder, partOwnership, "false")
        }
        return
    }
    if value.isNumber() {
        jsonAppendInt(builder, partOwnership, value.getNumber().toInt())
        return
    }
    if value.isString() {
        jsonAppendEscapedString(builder, partOwnership, value.getString())
        return
    }
    if value.isArray() {
        jsonAppendBorrowedPart(builder, partOwnership, "[")
        let values = value.getArray()
        var index = 0
        while index < values.length() {
            if index > 0 {
                jsonAppendBorrowedPart(builder, partOwnership, ",")
            }
            jsonAppendValue(builder, partOwnership, values[index])
            index = index + 1
        }
        jsonAppendBorrowedPart(builder, partOwnership, "]")
        return
    }
    if value.isObject() {
        jsonAppendBorrowedPart(builder, partOwnership, "{")
        let keys = value.keys()
        var index = 0
        while index < keys.length() {
            if index > 0 {
                jsonAppendBorrowedPart(builder, partOwnership, ",")
            }
            jsonAppendEscapedString(builder, partOwnership, keys[index])
            jsonAppendBorrowedPart(builder, partOwnership, ":")
            let memberOption = value.get(keys[index])
            if memberOption != null {
                jsonAppendValue(builder, partOwnership,
                    memberOption.unwrap())
            } else {
                jsonAppendBorrowedPart(builder, partOwnership, "null")
            }
            memberOption.free()
            index = index + 1
        }
        jsonAppendBorrowedPart(builder, partOwnership, "}")
        return
    }
    jsonAppendBorrowedPart(builder, partOwnership, "null")
}

///
Convert a JsonValue to one independent owned JSON string. The caller releases
the result with releaseJsonText.
///
fun jsonToString(value: JsonValue) r: String {
    let builder = StringBuilder.new()
    let partOwnership = Array<Bool>()
    jsonAppendValue(builder, partOwnership, value)
    return jsonFinishOwned(builder, partOwnership)
}

fun jsonAppendIndent(builder: StringBuilder,
    partOwnership: Array<Bool>, size: Int, depth: Int) r: Void {

    var index = 0
    let total = size * depth
    while index < total {
        jsonAppendBorrowedPart(builder, partOwnership, " ")
        index = index + 1
    }
}

fun jsonAppendPrettyValue(builder: StringBuilder,
    partOwnership: Array<Bool>, value: JsonValue, indentSize: Int,
    depth: Int) r: Void {

    if value.isNull() {
        jsonAppendBorrowedPart(builder, partOwnership, "null")
        return
    }
    if value.isBool() {
        if value.boolValue {
            jsonAppendBorrowedPart(builder, partOwnership, "true")
        } else {
            jsonAppendBorrowedPart(builder, partOwnership, "false")
        }
        return
    }
    if value.isNumber() {
        jsonAppendInt(builder, partOwnership, value.getNumber().toInt())
        return
    }
    if value.isString() {
        jsonAppendEscapedString(builder, partOwnership, value.getString())
        return
    }
    if value.isArray() {
        let values = value.getArray()
        if values.length() == 0 {
            jsonAppendBorrowedPart(builder, partOwnership, "[]")
            return
        }
        jsonAppendBorrowedPart(builder, partOwnership, "[\n")
        var index = 0
        while index < values.length() {
            if index > 0 {
                jsonAppendBorrowedPart(builder, partOwnership, ",\n")
            }
            jsonAppendIndent(builder, partOwnership, indentSize, depth + 1)
            jsonAppendPrettyValue(builder, partOwnership, values[index],
                indentSize, depth + 1)
            index = index + 1
        }
        jsonAppendBorrowedPart(builder, partOwnership, "\n")
        jsonAppendIndent(builder, partOwnership, indentSize, depth)
        jsonAppendBorrowedPart(builder, partOwnership, "]")
        return
    }
    if value.isObject() {
        let keys = value.keys()
        if keys.length() == 0 {
            jsonAppendBorrowedPart(builder, partOwnership, "{}")
            return
        }
        jsonAppendBorrowedPart(builder, partOwnership, "{\n")
        var index = 0
        while index < keys.length() {
            if index > 0 {
                jsonAppendBorrowedPart(builder, partOwnership, ",\n")
            }
            jsonAppendIndent(builder, partOwnership, indentSize, depth + 1)
            jsonAppendEscapedString(builder, partOwnership, keys[index])
            jsonAppendBorrowedPart(builder, partOwnership, ": ")
            let memberOption = value.get(keys[index])
            if memberOption != null {
                jsonAppendPrettyValue(builder, partOwnership,
                    memberOption.unwrap(), indentSize, depth + 1)
            } else {
                jsonAppendBorrowedPart(builder, partOwnership, "null")
            }
            memberOption.free()
            index = index + 1
        }
        jsonAppendBorrowedPart(builder, partOwnership, "\n")
        jsonAppendIndent(builder, partOwnership, indentSize, depth)
        jsonAppendBorrowedPart(builder, partOwnership, "}")
        return
    }
    jsonAppendBorrowedPart(builder, partOwnership, "null")
}

fun toJsonPretty(value: JsonValue, indent: Int) r: String {
    return toJsonPrettyHelper(value, indent, 0)
}

fun toJsonPrettyHelper(value: JsonValue, indentSize: Int,
    depth: Int) r: String {

    let builder = StringBuilder.new()
    let partOwnership = Array<Bool>()
    jsonAppendPrettyValue(builder, partOwnership, value, indentSize, depth)
    return jsonFinishOwned(builder, partOwnership)
}
