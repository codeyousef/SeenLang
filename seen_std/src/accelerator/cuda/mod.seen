    descriptor: *const CudaMatmulDescriptor, algorithm: *const CudaAlgorithm,
    a: *const Void, b: *const Void, c: *Void, workspace: *Void,
    stream: UInt64) r: CudaNativeStatus

class CudaDevice {
    var ordinal: Int32
    var runtimeVersion: Int32
    var driverVersion: Int32
    var computeMajor: Int32
    var computeMinor: Int32
    var totalMemoryBytes: UInt64
    var freeMemoryBytes: UInt64

    static fun open(ordinal: Int32) r: Result<CudaDevice, CudaError> {
        var count: Int32 = 0 as Int32
        var runtimeVersion: Int32 = 0 as Int32
        var driverVersion: Int32 = 0 as Int32
        var computeMajor: Int32 = 0 as Int32
        var computeMinor: Int32 = 0 as Int32
        var totalMemoryBytes: UInt64 = 0 as UInt64
        var freeMemoryBytes: UInt64 = 0 as UInt64
        let counted = seen_cuda_device_count(&count)
        if not cudaSucceeded(counted) { return Err<CudaDevice, CudaError>(cudaError(counted)) }
        if ordinal < (0 as Int32) or ordinal >= count {
            return Err<CudaDevice, CudaError>(CudaError{ code: 1 as Int32,
                nativeCode: 0 as Int32, deviceOrdinal: ordinal,
                maturity: 2 as Int32, operation: "device.open",
                message: "CUDA device ordinal is out of range",
                sourceFile: "<cuda-call>", sourceLine: 0, sourceColumn: 0 })
        }
        let runtimeStatus = seen_cuda_runtime_version(&runtimeVersion)
        if not cudaSucceeded(runtimeStatus) { return Err<CudaDevice, CudaError>(cudaError(runtimeStatus)) }
        let driverStatus = seen_cuda_driver_version(&driverVersion)
        if not cudaSucceeded(driverStatus) { return Err<CudaDevice, CudaError>(cudaError(driverStatus)) }
        let capabilityStatus = seen_cuda_device_capability(ordinal,
            &computeMajor, &computeMinor, &totalMemoryBytes, &freeMemoryBytes)
        if not cudaSucceeded(capabilityStatus) {
            return Err<CudaDevice, CudaError>(cudaError(capabilityStatus))
        }
        let selected = seen_cuda_set_device(ordinal)
        if not cudaSucceeded(selected) { return Err<CudaDevice, CudaError>(cudaError(selected)) }
        return Ok<CudaDevice, CudaError>(CudaDevice{ ordinal: ordinal,
            runtimeVersion: runtimeVersion, driverVersion: driverVersion,
            computeMajor: computeMajor, computeMinor: computeMinor,
            totalMemoryBytes: totalMemoryBytes,
            freeMemoryBytes: freeMemoryBytes })
    }
}

@move
class CudaAllocation {
    var handle: UInt64
    var data: *Void
    var byteLength: UInt64
    var device: Int32

    static fun allocate(device: Int32, bytes: UInt64)
        r: Result<CudaAllocation, CudaError> {
        var handle: UInt64 = 0 as UInt64
        let status = seen_cuda_malloc(device, bytes, &handle)
        if not cudaSucceeded(status) {
            return Err<CudaAllocation, CudaError>(cudaError(status))
        }
        var data: *Void = null as *Void
        var actualBytes: UInt64 = 0 as UInt64
        var actualDevice: Int32 = -1 as Int32
        let queried = seen_cuda_allocation_address(handle, &data, &actualBytes,
            &actualDevice)
        if not cudaSucceeded(queried) {
            let _ = seen_cuda_free(&handle)
            return Err<CudaAllocation, CudaError>(cudaError(queried))
        }
        return Ok<CudaAllocation, CudaError>(CudaAllocation{ handle: handle,
            data: data, byteLength: actualBytes, device: actualDevice })
    }

    fun close() r: Result<Bool, CudaError> {
        if this.handle == (0 as UInt64) { return Ok<Bool, CudaError>(false) }
        let status = seen_cuda_free(&this.handle)
        if not cudaSucceeded(status) { return Err<Bool, CudaError>(cudaError(status)) }
        this.data = null as *Void; this.byteLength = 0 as UInt64
        return Ok<Bool, CudaError>(true)
    }
}

@move
class PinnedHostAllocation {
    var handle: UInt64
    var data: *Void
    var byteLength: UInt64

    static fun allocate(bytes: UInt64)
        r: Result<PinnedHostAllocation, CudaError> {
        var handle: UInt64 = 0 as UInt64
        let status = seen_cuda_host_alloc(bytes, &handle)
        if not cudaSucceeded(status) {
            return Err<PinnedHostAllocation, CudaError>(cudaError(status))
        }
        var data: *Void = null as *Void
        var actualBytes: UInt64 = 0 as UInt64
        let queried = seen_cuda_host_allocation_address(handle, &data, &actualBytes)
        if not cudaSucceeded(queried) {
            let _ = seen_cuda_host_free(&handle)
            return Err<PinnedHostAllocation, CudaError>(cudaError(queried))
        }
        return Ok<PinnedHostAllocation, CudaError>(PinnedHostAllocation{
            handle: handle, data: data, byteLength: actualBytes })
    }

    fun close() r: Result<Bool, CudaError> {
        if this.handle == (0 as UInt64) { return Ok<Bool, CudaError>(false) }
        let status = seen_cuda_host_free(&this.handle)
        if not cudaSucceeded(status) { return Err<Bool, CudaError>(cudaError(status)) }
        this.data = null as *Void; this.byteLength = 0 as UInt64
        return Ok<Bool, CudaError>(true)
    }
}

@move
class CudaStream {
    var handle: UInt64
    var device: Int32

    static fun create(device: Int32) r: Result<CudaStream, CudaError> {
        var handle: UInt64 = 0 as UInt64
        let status = seen_cuda_stream_create(device, &handle)
        if not cudaSucceeded(status) { return Err<CudaStream, CudaError>(cudaError(status)) }
        return Ok<CudaStream, CudaError>(CudaStream{ handle: handle, device: device })
    }

    fun synchronize() r: Result<Bool, CudaError> {
        let status = seen_cuda_stream_synchronize(this.handle)
        if not cudaSucceeded(status) { return Err<Bool, CudaError>(cudaError(status)) }
        return Ok<Bool, CudaError>(true)
    }

    fun beginCapture() r: Result<Bool, CudaError> {
        let status = seen_cuda_graph_begin_capture(this.handle)
        if not cudaSucceeded(status) { return Err<Bool, CudaError>(cudaError(status)) }
        return Ok<Bool, CudaError>(true)
    }

    fun endCapture() r: Result<CudaGraph, CudaError> {
        var graph: UInt64 = 0 as UInt64
        let status = seen_cuda_graph_end_capture(this.handle, &graph)
        if not cudaSucceeded(status) { return Err<CudaGraph, CudaError>(cudaError(status)) }
        return Ok<CudaGraph, CudaError>(CudaGraph{ handle: graph, device: this.device })
    }

    fun close() r: Result<Bool, CudaError> {
        if this.handle == (0 as UInt64) { return Ok<Bool, CudaError>(false) }
        let status = seen_cuda_stream_destroy(&this.handle)
        if not cudaSucceeded(status) { return Err<Bool, CudaError>(cudaError(status)) }
        return Ok<Bool, CudaError>(true)
    }
}

@move
