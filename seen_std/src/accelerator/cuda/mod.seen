    fun launch(stream: CudaStream) r: Result<Bool, CudaError> {
        let status = seen_cuda_graph_launch(this.handle, stream.handle)
        if not cudaSucceeded(status) { return Err<Bool, CudaError>(cudaError(status)) }
        return Ok<Bool, CudaError>(true)
    }

    fun update(graph: CudaGraph) r: Result<Bool, CudaError> {
        var updated: Int32 = 0 as Int32
        let status = seen_cuda_graph_exec_update(this.handle, graph.handle, &updated)
        if not cudaSucceeded(status) { return Err<Bool, CudaError>(cudaError(status)) }
        return Ok<Bool, CudaError>(updated == (1 as Int32))
    }

    fun close() r: Result<Bool, CudaError> {
        if this.handle == (0 as UInt64) { return Ok<Bool, CudaError>(false) }
        let status = seen_cuda_graph_exec_destroy(&this.handle)
        if not cudaSucceeded(status) { return Err<Bool, CudaError>(cudaError(status)) }
        return Ok<Bool, CudaError>(true)
    }
}

@move
class CublasLtHandle {
    var handle: UInt64
    var device: Int32

    static fun create(device: Int32) r: Result<CublasLtHandle, CudaError> {
        var handle: UInt64 = 0 as UInt64
        let status = seen_cublaslt_create(device, &handle)
        if not cudaSucceeded(status) { return Err<CublasLtHandle, CudaError>(cudaError(status)) }
        return Ok<CublasLtHandle, CudaError>(CublasLtHandle{ handle: handle, device: device })
    }

    fun selectAlgorithm(descriptor: CudaMatmulDescriptor)
        r: Result<CudaAlgorithm, CudaError> {
        var algorithm = CudaAlgorithm{ algorithmId: 0 as Int32,
            tileId: 0 as Int32, splitK: 0 as Int32,
            reductionScheme: 0 as Int32, workspaceBytes: 0 as UInt64,
            cacheIdentity: 0 as UInt64 }
        let status = seen_cublaslt_select_algorithm(this.handle, &descriptor,
            &algorithm)
        if not cudaSucceeded(status) { return Err<CudaAlgorithm, CudaError>(cudaError(status)) }
        return Ok<CudaAlgorithm, CudaError>(algorithm)
    }

    fun matmul(descriptor: CudaMatmulDescriptor, algorithm: CudaAlgorithm,
        a: *const Void, b: *const Void, c: *Void, workspace: *Void,
        stream: CudaStream) r: Result<Bool, CudaError> {
        let status = seen_cublaslt_matmul(this.handle, &descriptor, &algorithm,
            a, b, c, workspace, stream.handle)
        if not cudaSucceeded(status) { return Err<Bool, CudaError>(cudaError(status)) }
        return Ok<Bool, CudaError>(true)
    }

    fun close() r: Result<Bool, CudaError> {
        if this.handle == (0 as UInt64) { return Ok<Bool, CudaError>(false) }
        let status = seen_cublaslt_destroy(&this.handle)
        if not cudaSucceeded(status) { return Err<Bool, CudaError>(cudaError(status)) }
        return Ok<Bool, CudaError>(true)
    }
}

/// Move-only policy owner for deterministic algorithm qualification. Native
/// selection remains bounded by the descriptor and the copied workspace cap.
@move
class CublasLtPreference {
    var workspaceLimitBytes: UInt64
    var active: Bool

    static fun create(workspaceLimitBytes: UInt64)
        r: Result<CublasLtPreference, CudaError> {
        if workspaceLimitBytes > (0x7FFFFFFFFFFFFFFF as UInt64) {
            return Err<CublasLtPreference, CudaError>(CudaError{
                code: 9 as Int32, nativeCode: 0 as Int32,
                deviceOrdinal: -1 as Int32, maturity: 2 as Int32,
                operation: "cublaslt.preference.create",
                message: "workspace limit exceeds the bounded ABI",
                sourceFile: "<cuda-call>", sourceLine: 0, sourceColumn: 0 })
        }
        return Ok<CublasLtPreference, CudaError>(CublasLtPreference{
            workspaceLimitBytes: workspaceLimitBytes, active: true })
    }

    fun apply(descriptor: CudaMatmulDescriptor)
        r: Result<CudaMatmulDescriptor, CudaError> {
        if not this.active {
            return Err<CudaMatmulDescriptor, CudaError>(CudaError{
                code: 8 as Int32, nativeCode: 0 as Int32,
                deviceOrdinal: -1 as Int32, maturity: 2 as Int32,
                operation: "cublaslt.preference.apply",
                message: "cuBLASLt preference is closed",
                sourceFile: "<cuda-call>", sourceLine: 0, sourceColumn: 0 })
        }
        descriptor.workspaceLimitBytes = this.workspaceLimitBytes
        return Ok<CudaMatmulDescriptor, CudaError>(descriptor)
    }

    fun close() r: Bool {
        if not this.active { return false }
        this.active = false
        this.workspaceLimitBytes = 0 as UInt64
        return true
    }
}
