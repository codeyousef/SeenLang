/// Explicitly linked CUDA resource ABI. Importing declarations never discovers
/// or links a CUDA SDK; projects opt in to libseen_cuda separately.

import accelerator.cuda.error.{CudaNativeStatus, CudaError, cudaSucceeded, cudaError}
import core.result.{Result, Ok, Err}

let CUDA_ABI_VERSION: UInt32 = 1 as UInt32
let CUDA_COPY_HOST_TO_DEVICE: Int32 = 1 as Int32
let CUDA_COPY_DEVICE_TO_HOST: Int32 = 2 as Int32
let CUDA_COPY_DEVICE_TO_DEVICE: Int32 = 3 as Int32

@repr(C)
@trivially_copyable
class CudaMatmulDescriptor {
    var abiVersion: UInt32
    var dataType: Int32
    var transposeA: Int32
    var transposeB: Int32
    var m: UInt64
    var n: UInt64
    var k: UInt64
    var leadingA: Int64
    var leadingB: Int64
    var leadingC: Int64
    var workspaceLimitBytes: UInt64
}

@repr(C)
@trivially_copyable
class CudaAlgorithm {
    var algorithmId: Int32
    var tileId: Int32
    var splitK: Int32
    var reductionScheme: Int32
    var workspaceBytes: UInt64
    var cacheIdentity: UInt64
}

