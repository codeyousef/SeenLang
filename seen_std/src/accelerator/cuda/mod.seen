extern "C" fun seen_cuda_runtime_version(version: *Int32) r: CudaNativeStatus
extern "C" fun seen_cuda_driver_version(version: *Int32) r: CudaNativeStatus
extern "C" fun seen_cuda_device_count(count: *Int32) r: CudaNativeStatus
extern "C" fun seen_cuda_device_capability(device: Int32,
    computeMajor: *Int32, computeMinor: *Int32,
    totalMemoryBytes: *UInt64, freeMemoryBytes: *UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_set_device(device: Int32) r: CudaNativeStatus
extern "C" fun seen_cuda_malloc(device: Int32, bytes: UInt64,
    allocation: *UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_free(allocation: *UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_allocation_address(allocation: UInt64,
    address: **Void, bytes: *UInt64, device: *Int32) r: CudaNativeStatus
extern "C" fun seen_cuda_host_alloc(bytes: UInt64,
    allocation: *UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_host_free(allocation: *UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_host_allocation_address(allocation: UInt64,
    address: **Void, bytes: *UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_stream_create(device: Int32,
    stream: *UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_stream_destroy(stream: *UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_stream_synchronize(stream: UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_event_create(device: Int32,
    event: *UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_event_record(event: UInt64,
    stream: UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_event_synchronize(event: UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_event_elapsed_ms(start: UInt64, finish: UInt64,
    milliseconds: *Float32) r: CudaNativeStatus
extern "C" fun seen_cuda_event_destroy(event: *UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_memcpy_async(destination: *Void, source: *const Void,
    bytes: UInt64, kind: Int32, stream: UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_memset_async(destination: *Void, value: Int32,
    bytes: UInt64, stream: UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_graph_begin_capture(stream: UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_graph_end_capture(stream: UInt64,
    graph: *UInt64) r: CudaNativeStatus
