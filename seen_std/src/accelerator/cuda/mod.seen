        return Ok<CudaEvent, CudaError>(CudaEvent{ handle: handle, device: device })
    }

    fun record(stream: CudaStream) r: Result<Bool, CudaError> {
        let status = seen_cuda_event_record(this.handle, stream.handle)
        if not cudaSucceeded(status) { return Err<Bool, CudaError>(cudaError(status)) }
        return Ok<Bool, CudaError>(true)
