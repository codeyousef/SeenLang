    updated: *Int32) r: CudaNativeStatus
extern "C" fun seen_cuda_graph_exec_destroy(graphExec: *UInt64) r: CudaNativeStatus
extern "C" fun seen_cuda_graph_destroy(graph: *UInt64) r: CudaNativeStatus
extern "C" fun seen_cublaslt_create(device: Int32,
    handle: *UInt64) r: CudaNativeStatus
extern "C" fun seen_cublaslt_destroy(handle: *UInt64) r: CudaNativeStatus
