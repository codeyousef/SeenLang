/// Immutable wire-format codebook data, encoded as one ASCII digit per axis.
/// Data attribution and MIT terms: seen_std/THIRD_PARTY_NOTICES.txt.
/// Decoding and bounds checks are implemented in Seen without native storage.
fun iq3XXSGridMagnitude(index: Int, axis: Int) r: Int {
    if index < 0 or index > 255 or axis < 0 or axis > 3 { abort("IQ3_XXS codebook coordinate outside bounds") }
    let codes = ""
    let code = codes.byteAt(index * 4 + axis) - 48
    if code == 7 { return 62 }
    return 4 + 8 * code
}
