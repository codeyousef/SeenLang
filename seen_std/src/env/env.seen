///
seen_std.env.env
Environment variable helpers and CLI argument accessors.
///

import core.option.{Option, Some, None}

// External runtime intrinsics
extern fun __GetCommandLineArgs() r: Array<String>
extern "C" fun seen_cstr_free(value: *Void) r: Void
extern "C" fun seen_memory_release_bytes(bytes: Int64) r: Void
extern fun __HasEnv(name: String) r: Bool
extern fun __GetEnv(name: String) r: String
extern fun __SetEnv(name: String, value: String) r: Bool
extern fun __RemoveEnv(name: String) r: Bool

fun args() r: Array<String> {
    return __GetCommandLineArgs()
}

/// Consume an unmodified args() snapshot and all strings it owns. Borrowed
/// argument views must stop being used before this function is called.
fun releaseArgs(arguments: Array<String>) r: Void {
    var index = 0
    while index < arguments.length() {
        let value = arguments[index]
        let bytes = value.length() + 1
        // seen-layout-abi-v2 stores String as {Int64 length, pointer data}.
        // Borrow its data word while the local String view is still alive.
        let representation = (&value) as *UInt64
        seen_cstr_free(representation[1] as *Void)
        seen_memory_release_bytes(bytes as Int64)
        index = index + 1
    }
    arguments.free()
}

fun tryGet(name: String) r: Option<String> {
    if __HasEnv(name) {
        return Some(__GetEnv(name))
    }
    return None()
}

fun getOrDefault(name: String, defaultValue: String) r: String {
    if __HasEnv(name) {
        return __GetEnv(name)
    }
    return defaultValue
}

fun get(name: String) r: String {
    return getOrDefault(name, "")
}

fun has(name: String) r: Bool {
    return __HasEnv(name)
}

fun set(name: String, value: String) r: Bool {
    return __SetEnv(name, value)
}

fun removeEnv(name: String) r: Bool {
    return __RemoveEnv(name)
}

fun remove(name: String) r: Bool {
    return removeEnv(name)
}
