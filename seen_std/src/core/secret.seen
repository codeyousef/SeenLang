/// Redaction-safe move-only secret values. Formatting never reveals material;
/// callers must present an explicit typed policy to reveal it.

import core.result.{Result, Ok, Err}
import core.error.{SeenError, RetryClass, RedactionClass, errorLiteral}
import core.operation_context.{OperationContext, validateOperationContext}

let SEEN_SECRET_MAX_BYTES: Int = 4096
let SEEN_SECRET_REDACTED: String = "[redacted]"

enum SecretRevealPolicy {
    Deny
    Allow
}

fun secretFailure(code: String, operation: String, message: String)
    r: SeenError {

    return errorLiteral(code, "secret", operation, message,
        RetryClass.Never, RedactionClass.Public)
}

fun validateSecretContext(context: OperationContext, operation: String)
    r: Result<Bool, SeenError> {

    if context.cancellation {
        return Err<Bool, SeenError>(secretFailure(
            "p0.secret.001.cancelled", operation,
            "secret operation is cancelled"))
    }
    let checked = validateOperationContext(context)
    if checked.isErr() {
        let error = checked.unwrapErr()
        let code = if error.code.value.endsWith(".limit") {
            "p0.secret.001.limit"
        } else {
            "p0.secret.001.invalid"
        }
        return Err<Bool, SeenError>(secretFailure(code, operation,
            "secret operation context is invalid"))
    }
    return Ok<Bool, SeenError>(true)
}

@move
class SecretString {
    var material: String
    var active: Bool

    fun isActive() r: Bool { return this.active }
    fun byteLength() r: Int { return this.material.length() }
    fun toString() r: String { return SEEN_SECRET_REDACTED }
    fun redacted() r: String { return SEEN_SECRET_REDACTED }

    fun reveal(policy: SecretRevealPolicy, context: OperationContext)
        r: Result<String, SeenError> {

        let checked = validateSecretContext(context, "reveal-string")
        if checked.isErr() {
            return Err<String, SeenError>(checked.unwrapErr())
        }
        if not this.active {
            return Err<String, SeenError>(secretFailure(
                "p0.secret.001.invalid", "reveal-string",
                "secret value was cleared"))
        }
        if policy != SecretRevealPolicy.Allow {
            return Err<String, SeenError>(secretFailure(
                "p0.secret.001.denied", "reveal-string",
                "secret reveal requires explicit allow policy"))
        }
        return Ok<String, SeenError>(this.material)
    }

    /// Clears the logical owner. Seen strings are immutable, so overwriting
    /// allocator storage is platform-dependent and not claimed here.
    fun clear() r: Bool {
        if not this.active { return false }
        this.material = ""
        this.active = false
        return true
    }
}

@move
class SecretBytes {
    var material: Array<Int>
    var active: Bool

    fun isActive() r: Bool { return this.active }
    fun byteLength() r: Int { return this.material.length() }
    fun toString() r: String { return SEEN_SECRET_REDACTED }
    fun redacted() r: String { return SEEN_SECRET_REDACTED }

    fun reveal(policy: SecretRevealPolicy, context: OperationContext)
        r: Result<Array<Int>, SeenError> {

        let checked = validateSecretContext(context, "reveal-bytes")
        if checked.isErr() {
            return Err<Array<Int>, SeenError>(checked.unwrapErr())
        }
        if not this.active {
            return Err<Array<Int>, SeenError>(secretFailure(
                "p0.secret.001.invalid", "reveal-bytes",
                "secret value was cleared"))
        }
        if policy != SecretRevealPolicy.Allow {
            return Err<Array<Int>, SeenError>(secretFailure(
                "p0.secret.001.denied", "reveal-bytes",
                "secret reveal requires explicit allow policy"))
        }
        return Ok<Array<Int>, SeenError>(this.material)
    }

    /// Mutable byte storage is overwritten before the logical owner clears.
    fun clear() r: Bool {
        if not this.active { return false }
        var index = 0
        while index < this.material.length() {
            this.material[index] = 0
            index = index + 1
        }
        this.material = Array<Int>()
        this.active = false
        return true
    }
}

fun secretString(value: String, context: OperationContext)
    r: Result<SecretString, SeenError> {

    let checked = validateSecretContext(context, "construct-string")
    if checked.isErr() {
        return Err<SecretString, SeenError>(checked.unwrapErr())
    }
    if value.length() < 1 or value.length() > SEEN_SECRET_MAX_BYTES {
        return Err<SecretString, SeenError>(secretFailure(
            "p0.secret.001.limit", "construct-string",
            "secret string size is outside its bound"))
    }
    return Ok<SecretString, SeenError>(SecretString{
        material: value, active: true
    })
}

fun secretBytes(value: Array<Int>, context: OperationContext)
    r: Result<SecretBytes, SeenError> {

    let checked = validateSecretContext(context, "construct-bytes")
    if checked.isErr() {
        return Err<SecretBytes, SeenError>(checked.unwrapErr())
    }
    if value.length() < 1 or value.length() > SEEN_SECRET_MAX_BYTES {
        return Err<SecretBytes, SeenError>(secretFailure(
            "p0.secret.001.limit", "construct-bytes",
            "secret byte size is outside its bound"))
    }
    var index = 0
    while index < value.length() {
        if value[index] < 0 or value[index] > 255 {
            return Err<SecretBytes, SeenError>(secretFailure(
                "p0.secret.001.invalid", "construct-bytes",
                "secret byte value is invalid"))
        }
        index = index + 1
    }
    return Ok<SecretBytes, SeenError>(SecretBytes{
        material: value, active: true
    })
}
