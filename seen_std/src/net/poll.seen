// Event polling (epoll/kqueue wrapper)
import core.result.{Result, Ok, Err}
import core.unit.{Unit}
import core.option.{Some}
import core.error.{SeenError, SeenErrorKind, RetryClass, RedactionClass,
    seenFailure}

fun pollFailure<T>(operation: String, message: String,
    nativeCode: Int) r: Result<T, SeenError> {

    return seenFailure<T>(SeenErrorKind.Network, operation, message,
        Some<Int64>(nativeCode as Int64), RetryClass.Transient,
        RedactionClass.Public)
}

class PollEvent {
    token: Int
    events: Int
}

class Poll {
    fd: Int
    
    fun new() -> Result<Poll, SeenError> {
        let fd = __PollCreate()
        if fd < 0 {
            return pollFailure<Poll>("create", "failed to create poll instance", fd)
        }
        Ok(Poll { fd: fd })
    }
    
    fun register(fd: Int, token: Int, events: Int) -> Result<Unit, SeenError> {
        let res = __PollRegister(this.fd, fd, token, events)
        if res < 0 {
            return pollFailure<Unit>("register", "failed to register descriptor", res)
        }
        Ok(Unit{})
    }
    
    fun unregister(fd: Int) -> Result<Unit, SeenError> {
        let res = __PollUnregister(this.fd, fd)
        if res < 0 {
            return pollFailure<Unit>("unregister", "failed to unregister descriptor", res)
        }
        Ok(Unit{})
    }
    
    fun poll(timeout_ms: Int) -> Result<Array<PollEvent>, SeenError> {
        // Intrinsics are expected to return Array<PollEvent>
        let events = __PollWait(this.fd, timeout_ms)
        Ok(events)
    }
}

// Constants
let POLLIN: Int = 1
let POLLOUT: Int = 4
let POLLERR: Int = 8
let POLLHUP: Int = 16
