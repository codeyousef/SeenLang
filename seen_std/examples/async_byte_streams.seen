import error.{AsciiString}
import operation_context.{OperationLimits, OperationContext}
import core.result.{Result}
import io.bytes.{AsyncByteReader, ByteBuffer, IoError, asyncRead}

fun exampleContext() r: OperationContext {
    return OperationContext{
        cancellation: false, monotonicDeadline: 1,
        limits: OperationLimits{
            maxTargets: 8, maxIdentityBytes: 128, maxVersionBytes: 128,
            maxManifestBytes: 4096, maxPathBytes: 4096,
            maxGraphModules: 8, maxGraphEdges: 16, maxGraphDepth: 4
        },
        traceId: AsciiString{ value: "async-byte-stream-example" }
    }
}

fun main() r: Int {
    let reader = AsyncByteReader.fromArray([83, 101, 101, 110])
    let destination = ByteBuffer.fromArray([0, 0, 0, 0])
    let viewResult = destination.mutableSlice(0, 4)
    if viewResult.isErr() { return 1 }
    let view = viewResult.unwrap()
    let progress: Result<Int, IoError> = await asyncRead(
        reader, exampleContext(), view)
    let viewClosed = view.close()
    let copied = destination.toArray()
    let readerClosed = reader.close()
    let destinationReleased = destination.release()
    if progress.isErr() or progress.unwrap() != 4 or viewClosed.isErr() or
        copied.isErr() or copied.unwrap()[0] != 83 or readerClosed.isErr() or
        destinationReleased.isErr() {

        return 1
    }
    println("asynchronous checked span read completed")
    return 0
}

main()
