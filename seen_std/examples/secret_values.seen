import error.{AsciiString}
import operation_context.{OperationLimits, OperationContext}
import secret.{SecretRevealPolicy, secretString}

fun main() r: Int {
    let context = OperationContext{
        cancellation: false, monotonicDeadline: 1,
        limits: OperationLimits{
            maxTargets: 1, maxIdentityBytes: 128, maxVersionBytes: 128,
            maxManifestBytes: 4096, maxPathBytes: 4096,
            maxGraphModules: 8, maxGraphEdges: 8, maxGraphDepth: 8
        }, traceId: AsciiString{ value: "secret-example" }
    }
    let created = secretString("example-token", context)
    if created.isErr() { return 1 }
    var token = created.unwrap()
    println(token.toString())
    let explicit = token.reveal(SecretRevealPolicy.Allow, context)
    if explicit.isErr() { return 1 }
    token.clear()
    return 0
}

main()
