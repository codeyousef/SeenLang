import core.error.{AsciiString}
import core.operation_context.{OperationContext, OperationLimits}
import core.result.{Result}
import fs.types.{Path, OpenOptions, DirectIoPolicy, FsError, FileMetadata, SpaceInfo}
import fs.file.{File}
import env.env.{args, releaseArgs}
import io.file.{deleteFile}
extern "C" fun seen_memory_used_bytes() r: Int64

fun fileOwnedTake<T>(result: Result<T, FsError>) r: T {
    if result.isErr() { println(result.unwrapErr().code); println(result.unwrapErr().operation); abort("file ownership setup or native operation failed") }
    let value = result.unwrap(); result.releaseContainer(); return value
}
fun fileOwnedReject<T>(result: Result<T, FsError>, code: String) r: Void {
    if result.isOkay() { abort("invalid file operation was admitted") }
    let error = result.unwrapErr(); result.releaseContainer()
    if error.code != code { println(error.code); abort("file operation changed its typed error") }; error.free()
}
fun fileOwnedSteady(expected: Int64) r: Void {
    if seen_memory_used_bytes() != expected { abort("file operation retained an intermediate Result owner") }
}
fun main() r: Int {
    let baseline = seen_memory_used_bytes(); let arguments = args()
    if arguments.length() != 2 { abort("requires an exclusive file ownership path") }
    let path = fileOwnedTake<Path>(Path.fromString(arguments[1]))
    let op = OperationContext{cancellation: false, monotonicDeadline: 9223372036854775807 as Int64,
        limits: OperationLimits{maxTargets: 8, maxIdentityBytes: 128, maxVersionBytes: 128,
            maxManifestBytes: 4096, maxPathBytes: 4095, maxGraphModules: 8, maxGraphEdges: 16, maxGraphDepth: 4},
        traceId: AsciiString{value: "file-ownership"}}
    let options = OpenOptions{read: true, write: true, create: true, truncate: false,
        append: false, exclusive: true, directory: false, noFollow: true}
    let file = fileOwnedTake<File>(File.open(op, path, options, DirectIoPolicy.Off)); options.free()
    let input = Array<Int>(); let output = Array<Int>(); var i = 0
    while i < 16 { input.push(224 + i); i = i + 1 }
    i = 0; while i < 18 { output.push(77); i = i + 1 }
    let steady = seen_memory_used_bytes()
    if fileOwnedTake<Int>(file.writeAllAt(op, 0 as UInt64, input)) != 16 { abort("write-all lost progress") }; fileOwnedSteady(steady)
    if fileOwnedTake<Int>(file.readAt(op, 0 as UInt64, output, 1, 16)) != 16 { abort("file read lost progress") }
    if output[0] != 77 or output[17] != 77 { abort("file read overwrote a neighboring array element") }
    i = 0; while i < 16 { if output[i + 1] != input[i] { abort("file read narrowed or changed unsigned bytes") }; i = i + 1 }; fileOwnedSteady(steady)
    let metadata = fileOwnedTake<FileMetadata>(file.metadata(op))
    if metadata.size != (16 as UInt64) or metadata.kind != 1 { abort("file metadata changed native geometry") }; metadata.free(); fileOwnedSteady(steady)
    if not fileOwnedTake<Bool>(file.truncate(op, 8192 as UInt64)) { abort("file truncation did not complete") }; fileOwnedSteady(steady)
    if not fileOwnedTake<Bool>(file.preallocate(op, 0 as UInt64, 8192 as UInt64)) { abort("file preallocation did not complete") }; fileOwnedSteady(steady)
    if fileOwnedTake<Int>(file.writeAt(op, 4096 as UInt64, input, 0, 16)) != 16 { abort("hole fixture write lost progress") }; fileOwnedSteady(steady)
    if not fileOwnedTake<Bool>(file.punchHole(op, 4096 as UInt64, 4096 as UInt64)) { abort("file hole punch did not complete") }; fileOwnedSteady(steady)
    if fileOwnedTake<Int>(file.readAt(op, 4096 as UInt64, output, 1, 16)) != 16 { abort("hole read lost progress") }
    i = 1; while i < 17 { if output[i] != 0 { abort("punched file range retained written bytes") }; i = i + 1 }; fileOwnedSteady(steady)
    if not fileOwnedTake<Bool>(file.sync(op, true)) { abort("file data sync did not complete") }; fileOwnedSteady(steady)
    if not fileOwnedTake<Bool>(file.lock(op, true, false)) { abort("exclusive file lock did not complete") }; fileOwnedSteady(steady)
    if not fileOwnedTake<Bool>(file.unlock(op)) { abort("file unlock did not complete") }; fileOwnedSteady(steady)
    let space = fileOwnedTake<SpaceInfo>(file.space(op))
    if space.blockSize == (0 as UInt64) or space.available > space.total { abort("file space result is inconsistent") }; space.free(); fileOwnedSteady(steady)
    fileOwnedReject<Int>(file.readAt(op, 0 as UInt64, output, 17, 2), "fs.range"); fileOwnedSteady(steady)
    fileOwnedReject<Int>(file.writeAt(op, 0 as UInt64, input, 0, 17), "fs.range"); fileOwnedSteady(steady)
    op.cancellation = true
    fileOwnedReject<FileMetadata>(file.metadata(op), "fs.cancelled"); fileOwnedSteady(steady)
    fileOwnedReject<Int>(file.readAt(op, 0 as UInt64, output, 1, 16), "fs.cancelled"); fileOwnedSteady(steady)
    fileOwnedReject<Int>(file.writeAt(op, 0 as UInt64, input, 0, 16), "fs.cancelled"); fileOwnedSteady(steady)
    fileOwnedReject<Int>(file.writeAllAt(op, 0 as UInt64, input), "fs.cancelled"); fileOwnedSteady(steady)
    fileOwnedReject<Bool>(file.sync(op, false), "fs.cancelled"); fileOwnedSteady(steady)
    fileOwnedReject<Bool>(file.preallocate(op, 0 as UInt64, 8192 as UInt64), "fs.cancelled"); fileOwnedSteady(steady)
    fileOwnedReject<Bool>(file.truncate(op, 16 as UInt64), "fs.cancelled"); fileOwnedSteady(steady)
    fileOwnedReject<Bool>(file.punchHole(op, 4096 as UInt64, 4096 as UInt64), "fs.cancelled"); fileOwnedSteady(steady)
    fileOwnedReject<SpaceInfo>(file.space(op), "fs.cancelled"); fileOwnedSteady(steady)
    fileOwnedReject<Bool>(file.lock(op, false, false), "fs.cancelled"); fileOwnedSteady(steady)
    fileOwnedReject<Bool>(file.unlock(op), "fs.cancelled"); fileOwnedSteady(steady)
    op.cancellation = false
    if not fileOwnedTake<Bool>(file.close()) { abort("live file close reported no effect") }
    let afterClose = seen_memory_used_bytes()
    fileOwnedReject<FileMetadata>(file.metadata(op), "fs.invalid"); fileOwnedSteady(afterClose)
    input.free(); output.free(); file.directIo.free(); file.free()
    if not deleteFile(arguments[1]) { abort("file ownership fixture cleanup failed") }
    path.raw.free(); path.free(); op.traceId.free(); op.limits.free(); op.free(); releaseArgs(arguments)
    if seen_memory_used_bytes() != baseline { abort("file ownership fixture retained resources") }
    return 0
}
