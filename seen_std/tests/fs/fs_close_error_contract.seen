import core.error.{AsciiString}
import core.operation_context.{OperationContext, OperationLimits}
import fs.types.{Path, OpenOptions, DirectIoPolicy}
import fs.file.{File}
import env.env.{args, releaseArgs}
extern "C" fun seen_memory_used_bytes() r: Int64

fun main() r: Int {
    let baseline = seen_memory_used_bytes(); let arguments = args()
    if arguments.length() != 2 { abort("requires an exclusive exceptional-close file path") }
    let pathResult = Path.fromString(arguments[1])
    if pathResult.isErr() { abort("exceptional-close fixture path invalid") }
    let path = pathResult.unwrap(); pathResult.releaseContainer()
    let operation = OperationContext{
        cancellation: false, monotonicDeadline: 9223372036854775807 as Int64,
        limits: OperationLimits{maxTargets: 8, maxIdentityBytes: 128, maxVersionBytes: 128,
            maxManifestBytes: 4096, maxPathBytes: 4095, maxGraphModules: 8,
            maxGraphEdges: 16, maxGraphDepth: 4},
        traceId: AsciiString{value: "close-error"}}
    let options = OpenOptions.createNew()
    let opened = File.open(operation, path, options, DirectIoPolicy.Off); options.free()
    if opened.isErr() { abort("exceptional-close fixture could not open its file") }
    let file = opened.unwrap(); opened.releaseContainer()
    let failed = file.close()
    if failed.isOkay() { abort("native exceptional close was hidden") }
    let error = failed.unwrapErr(); failed.releaseContainer()
    if error.code != "fs.io_failed" or file.handle != (0 as UInt64) { abort("failed close did not retire the Seen owner and preserve the I/O failure") }
    error.free()
    let repeated = file.close()
    if repeated.isErr() or repeated.unwrap() { abort("consumed file owner retried native close") }
    repeated.releaseContainer(); file.directIo.free(); file.free()
    path.raw.free(); path.free(); operation.traceId.free(); operation.limits.free(); operation.free()
    releaseArgs(arguments)
    if seen_memory_used_bytes() != baseline { abort("exceptional close retained Seen resources") }
    return 0
}
