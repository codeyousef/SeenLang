import core.result.{Result}
import core.error.{AsciiString}
import core.operation_context.{OperationContext, OperationLimits}
import async.structured.{AsyncError, AsyncLimits, AsyncOperationContext}
import async.multithread.{MultithreadExecutor, ExecutorLimits, ExecutorJob,
    ExecutorTaskContext, ExecutorJoinHandle, spawnExecutorTask}
import async.executor_core.{executorReleaseContext}

extern "C" fun seen_executor_live_threads() r: UInt64
extern "C" fun seen_sync_live_mutexes() r: UInt64
extern "C" fun seen_sync_live_conditions() r: UInt64
extern "C" fun seen_sync_atomic_create(initial: Int64, handle: *UInt64) r: Int32
extern "C" fun seen_sync_atomic_load(handle: UInt64, order: Int32,
    value: *Int64) r: Int32
extern "C" fun seen_sync_atomic_fetch_add(handle: UInt64, amount: Int64,
    order: Int32, previous: *Int64) r: Int32
extern "C" fun seen_sync_atomic_destroy(handle: *UInt64) r: Int32
extern "C" fun __ThreadYield() r: Void

fun must<T>(result: Result<T, AsyncError>) r: T {
    if result.isErr() { abort(result.unwrapErr().code) }
    let value = result.unwrap()
    result.releaseContainer()
    return value
}

fun hasError<T>(result: Result<T, AsyncError>, expected: String) r: Bool {
    if result.isOk() { result.releaseContainer(); return false }
    let error = result.unwrapErr()
    let matches = error.code == expected
    error.free()
    result.releaseContainer()
    return matches
}

fun poolContext() r: AsyncOperationContext {
    return AsyncOperationContext{operation: OperationContext{
        cancellation: false, monotonicDeadline: 9223372036854775807 as Int64,
        limits: OperationLimits{maxTargets: 8, maxIdentityBytes: 128,
            maxVersionBytes: 128, maxManifestBytes: 4096, maxPathBytes: 4095,
            maxGraphModules: 8, maxGraphEdges: 16, maxGraphDepth: 4},
        traceId: AsciiString{value: "async-002a"}}, resourceId: "pool-test",
        fallbackPolicy: 0, limits: AsyncLimits.bounded(16, 16, 8, 8, 128)}
}

fun poolLimits(workers: Int, tasks: Int) r: ExecutorLimits {
    return ExecutorLimits{workers: workers, tasks: tasks, queued: tasks,
        helpDepth: 8, stackBytes: 1048576 as UInt64}
}

@send
class ExecutorProbe {
    var mode: Int
    var number: Int
    var result: Int
    var releases: UInt64
}

impl ExecutorJob for ExecutorProbe {
    fun run(this: ExecutorProbe, context: ExecutorTaskContext) r: Bool {
        if this.mode == 1 {
            let child = must(spawnExecutorTask<ExecutorProbe>(context,
                ExecutorProbe{mode: 0, number: this.number, result: 0,
                    releases: 0 as UInt64}))
            let value = must(child.join(context.operation))
            this.result = value.result + 1
            value.release()
            child.free()
            return true
        }
        if this.mode == 2 {
            while not context.isCancelled() { __ThreadYield() }
            return true
        }
        if this.mode == 3 { return false }
        this.result = this.number * 2
        return true
    }

    fun release(this: ExecutorProbe) r: Bool {
        if this.releases != (0 as UInt64) {
            var previous = 0 as Int64
            if seen_sync_atomic_fetch_add(this.releases, 1 as Int64,
                4 as Int32, &previous) != (0 as Int32) {
                abort("release counter failed")
            }
        }
        this.free()
        return true
    }
}

fun happy(context: AsyncOperationContext) r: Bool {
    let limits = poolLimits(2, 8)
    let pool = must(MultithreadExecutor<ExecutorProbe>.create(limits))
    limits.free()
    if seen_executor_live_threads() != (2 as UInt64) { return false }
    var round = 0
    while round < 100 {
        let first = must(pool.spawn(ExecutorProbe{mode: 0, number: round,
            result: 0, releases: 0 as UInt64}, context))
        let second = must(pool.spawn(ExecutorProbe{mode: 0, number: round + 1,
            result: 0, releases: 0 as UInt64}, context))
        let a = must(first.join(context))
        let b = must(second.join(context))
        if a.result != round * 2 or b.result != (round + 1) * 2 { return false }
        a.release(); b.release()
        if not hasError(first.join(context), "async.invalid") { return false }
        first.free(); second.free()
        if seen_executor_live_threads() != (2 as UInt64) { return false }
        round = round + 1
    }
    must(pool.close())
    must(pool.close())
    must(pool.release())
    return seen_executor_live_threads() == (0 as UInt64)
}

fun nested(context: AsyncOperationContext) r: Bool {
    let limits = poolLimits(1, 4)
    let pool = must(MultithreadExecutor<ExecutorProbe>.create(limits))
    limits.free()
    let handle = must(pool.spawn(ExecutorProbe{mode: 1, number: 20,
        result: 0, releases: 0 as UInt64}, context))
    let value = must(handle.join(context))
    let valid = value.result == 41 and
        seen_executor_live_threads() == (1 as UInt64)
    value.release(); handle.free(); must(pool.release())
    return valid
}

fun limitsAndInvalid(context: AsyncOperationContext) r: Bool {
    let invalid = poolLimits(0, 1)
    if not hasError(MultithreadExecutor<ExecutorProbe>.create(invalid),
        "async.limit") { return false }
    invalid.free()
    let limits = poolLimits(1, 1)
    let pool = must(MultithreadExecutor<ExecutorProbe>.create(limits))
    limits.free()
    let first = must(pool.spawn(ExecutorProbe{mode: 0, number: 1,
        result: 0, releases: 0 as UInt64}, context))
    let rejected = ExecutorProbe{mode: 0, number: 2, result: 0,
        releases: 0 as UInt64}
    if not hasError(pool.spawn(rejected, context), "async.limit") { return false }
    rejected.release()
    let value = must(first.join(context))
    value.release(); first.free()
    must(pool.shutdown(false))
    let late = ExecutorProbe{mode: 0, number: 3, result: 0,
        releases: 0 as UInt64}
    if not hasError(pool.spawn(late, context), "async.invalid") { return false }
    late.release()
    must(pool.release())
    return true
}

fun cancellationAndCleanup(context: AsyncOperationContext) r: Bool {
    var counter = 0 as UInt64
    if seen_sync_atomic_create(0 as Int64, &counter) != (0 as Int32) { return false }
    let limits = poolLimits(1, 2)
    let pool = must(MultithreadExecutor<ExecutorProbe>.create(limits))
    limits.free()
    let handle = must(pool.spawn(ExecutorProbe{mode: 2, number: 0,
        result: 0, releases: counter}, context))
    must(handle.cancel())
    if not hasError(handle.join(context), "async.cancelled") { return false }
    handle.free()
    let failed = must(pool.spawn(ExecutorProbe{mode: 3, number: 0,
        result: 0, releases: counter}, context))
    if not hasError(failed.join(context), "async.unavailable") { return false }
    failed.free()
    let abandoned = must(pool.spawn(ExecutorProbe{mode: 0, number: 3,
        result: 0, releases: counter}, context))
    must(pool.shutdown(false))
    must(pool.close())
    if not hasError(abandoned.join(context), "async.invalid") { return false }
    abandoned.free()
    must(pool.release())
    var released = 0 as Int64
    if seen_sync_atomic_load(counter, 4 as Int32, &released) != (0 as Int32) {
        return false
    }
    if seen_sync_atomic_destroy(&counter) != (0 as Int32) { return false }
    return released == (3 as Int64)
}

fun main() r: Int {
    let mutexes = seen_sync_live_mutexes()
    let conditions = seen_sync_live_conditions()
    let context = poolContext()
    if not happy(context) { return 1 }
    println("PASS: ASYNC-002A_happy")
    if not nested(context) { return 2 }
    println("PASS: ASYNC-002A_partial")
    if not limitsAndInvalid(context) { return 3 }
    println("PASS: ASYNC-002A_invalid")
    println("PASS: ASYNC-002A_limit")
    if not cancellationAndCleanup(context) { return 4 }
    println("PASS: ASYNC-002A_cancel")
    executorReleaseContext(context)
    if seen_sync_live_mutexes() != mutexes or
        seen_sync_live_conditions() != conditions or
        seen_executor_live_threads() != (0 as UInt64) { return 5 }
    println("PASS: ASYNC-002A_cleanup")
    return 0
}
