import core.result.{Result}
import core.error.{AsciiString}
import core.operation_context.{OperationContext, OperationLimits}
import async.structured.{AsyncError, AsyncLimits, AsyncOperationContext}
import async.executor_core.{ExecutorLimits, ExecutorJob, ExecutorTaskContext,
    executorReleaseContext}
import async.pools.{ExecutionPools, TypedWorkerPool}
import async.pool_placement.{PoolPlacement}

extern "C" fun seen_executor_live_threads() r: UInt64
extern "C" fun seen_sync_live_mutexes() r: UInt64
extern "C" fun seen_sync_live_conditions() r: UInt64
extern "C" fun seen_sync_atomic_create(initial: Int64, handle: *UInt64) r: Int32
extern "C" fun seen_sync_atomic_load(handle: UInt64, order: Int32, value: *Int64) r: Int32
extern "C" fun seen_sync_atomic_fetch_add(handle: UInt64, amount: Int64,
    order: Int32, previous: *Int64) r: Int32
extern "C" fun seen_sync_atomic_destroy(handle: *UInt64) r: Int32
extern "C" fun __ThreadYield() r: Void

fun must<T, E>(result: Result<T, E>) r: T {
    if result.isErr() { abort("typed pool fixture failed") }
    let value = result.unwrap(); result.releaseContainer(); return value
}
fun errorIs<T>(result: Result<T, AsyncError>, code: String) r: Bool {
    if result.isOkay() { result.releaseContainer(); return false }
    let error = result.unwrapErr(); result.releaseContainer()
    let matches = error.code == code
    error.free(); return matches
}
fun atomicValue(handle: UInt64) r: Int64 {
    var value = 0 as Int64
    if seen_sync_atomic_load(handle, 4 as Int32, &value) != (0 as Int32) {
        abort("pool counter read failed")
    }
    return value
}
fun context() r: AsyncOperationContext {
    return AsyncOperationContext{operation: OperationContext{
        cancellation: false, monotonicDeadline: 9223372036854775807 as Int64,
        limits: OperationLimits{maxTargets: 8, maxIdentityBytes: 128,
            maxVersionBytes: 128, maxManifestBytes: 4096, maxPathBytes: 4095,
            maxGraphModules: 8, maxGraphEdges: 16, maxGraphDepth: 4},
        traceId: AsciiString{value: "async-002c"}}, resourceId: "pool-test",
        fallbackPolicy: 0, limits: AsyncLimits.bounded(16, 16, 8, 16, 128)}
}
fun limits() r: ExecutorLimits {
    return ExecutorLimits{workers: 1, tasks: 8, queued: 8,
        helpDepth: 8, stackBytes: 1048576 as UInt64}
}
@send
class PoolProbe {
    var mode: Int
    var number: Int
    var result: Int
    var releases: UInt64
    var started: UInt64
}
impl ExecutorJob for PoolProbe {
    fun run(this: PoolProbe, task: ExecutorTaskContext) r: Bool {
        if this.mode == 1 {
            var previous = 0 as Int64
            if seen_sync_atomic_fetch_add(this.started, 1 as Int64,
                4 as Int32, &previous) != (0 as Int32) { return false }
            while not task.isCancelled() { __ThreadYield() }
            return true
        }
        if this.mode == 2 { task.fail(4 as Int32); return true }
        this.result = this.number * 2
        return true
    }
    fun release(this: PoolProbe) r: Bool {
        var previous = 0 as Int64
        if seen_sync_atomic_fetch_add(this.releases, 1 as Int64,
            4 as Int32, &previous) != (0 as Int32) { return false }
        this.free(); return true
    }
}
fun probe(mode: Int, number: Int, releases: UInt64, started: UInt64) r: PoolProbe {
    return PoolProbe{mode: mode, number: number, result: 0,
        releases: releases, started: started}
}
fun main() r: Int {
    let threadBaseline = seen_executor_live_threads()
    let mutexBaseline = seen_sync_live_mutexes()
    let conditionBaseline = seen_sync_live_conditions()
    let ctx = context(); let cpuLimits = limits(); let blockingLimits = limits()
    let inherited = PoolPlacement.inherited()
    if not errorIs(ExecutionPools<PoolProbe>.create(cpuLimits, blockingLimits,
        inherited, inherited, 1), "async.limit") { return 1 }
    if not errorIs(TypedWorkerPool<PoolProbe>.create("invalid", cpuLimits, inherited),
        "async.invalid") { return 2 }
    println("PASS: ASYNC-002C_limit")
    let badCpus = Array<Int>(); badCpus.push(1024)
    let bad = PoolPlacement{cpus: badCpus, numaNode: -1}
    if not errorIs(ExecutionPools<PoolProbe>.create(cpuLimits, blockingLimits,
        inherited, bad, 2), "async.invalid") { return 3 }
    bad.release()
    if seen_executor_live_threads() != threadBaseline { return 4 }
    println("PASS: ASYNC-002C_partial")
    println("PASS: ASYNC-002C_invalid")

    var releases = 0 as UInt64; var started = 0 as UInt64
    if seen_sync_atomic_create(0 as Int64, &releases) != (0 as Int32) or
        seen_sync_atomic_create(0 as Int64, &started) != (0 as Int32) { return 5 }
    let pools = must(ExecutionPools<PoolProbe>.create(cpuLimits, blockingLimits,
        inherited, inherited, 2))
    inherited.release(); cpuLimits.free(); blockingLimits.free()
    let blocked = must(submitPoolProbe(pools.blocking,probe(1, 0, releases, started), ctx))
    var spins = 0
    while atomicValue(started) == (0 as Int64) and spins < 1000000 {
        __ThreadYield(); spins = spins + 1
    }
    if atomicValue(started) == (0 as Int64) { return 6 }
    var i = 0
    while i < 100 {
        let handle = must(submitPoolProbe(pools.cpu,probe(0, i, releases, started), ctx))
        let value = must(handle.join(ctx))
        if value.result != i * 2 { return 7 }
        value.release(); must(handle.release())
        if seen_executor_live_threads() != threadBaseline + (2 as UInt64) { return 8 }
        i = i + 1
    }
    println("PASS: ASYNC-002C_happy")
    let failed = must(submitPoolProbe(pools.cpu,probe(2, 0, releases, started), ctx))
    if not errorIs(failed.join(ctx), "async.unsupported_platform") { return 9 }
    must(failed.release())
    must(blocked.cancel())
    if not errorIs(blocked.join(ctx), "async.cancelled") { return 10 }
    must(blocked.release())
    println("PASS: ASYNC-002C_cancel")
    let abandoned = must(submitPoolProbe(pools.cpu,probe(0, 1, releases, started), ctx))
    if not errorIs(abandoned.release(), "async.invalid") { return 11 }
    must(pools.cpu.close()); must(abandoned.release())
    must(pools.release())
    if atomicValue(releases) != (103 as Int64) { return 12 }
    if seen_sync_atomic_destroy(&releases) != (0 as Int32) or
        seen_sync_atomic_destroy(&started) != (0 as Int32) { return 13 }
    executorReleaseContext(ctx)
    if seen_executor_live_threads() != threadBaseline or
        seen_sync_live_mutexes() != mutexBaseline or
        seen_sync_live_conditions() != conditionBaseline { return 14 }
    println("PASS: ASYNC-002C_cleanup")
    return 0
}


import async.pools.{PoolJoinHandle}
fun submitPoolProbe(pool: TypedWorkerPool<PoolProbe>, task: PoolProbe, context: AsyncOperationContext) r: Result<PoolJoinHandle<PoolProbe>, AsyncError> {
    return pool.submit(task, task, context)
}
