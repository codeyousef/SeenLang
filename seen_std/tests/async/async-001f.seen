import async.mod.{AsyncLimits, CancellationSource, DeterministicExecutor,
    AsyncWaitGroup, AsyncBarrier, boundedFanOut, selectTaskId,
    deterministicReduceSum}

fun main() r: Int {
    let made = DeterministicExecutor<Int>.create(
        AsyncLimits.bounded(8, 8, 4, 3, 128))
    if made.isErr() { return 1 }
    let executor = made.unwrap()
    let values = Array<Int>(); values.push(3); values.push(5); values.push(7)
    let fan = executor.boundedFanOut(values, 0,
        CancellationSource.root(1), 3)
    if fan.isErr() { return 2 }
    if fan.unwrap() != 3 { return 2 }
    if executor.tick().isErr() { return 3 }
    if executor.tick().isErr() { return 3 }
    if executor.tick().isErr() { return 3 }
    let taskIds = Array<Int>(); taskIds.push(1); taskIds.push(2); taskIds.push(3)
    let selected = executor.selectTaskId(taskIds)
    let raced = executor.selectTaskId(taskIds)
    if selected.isErr() { return 4 }
    if raced.isErr() { return 4 }
    if selected.unwrap() != 1 { return 4 }
    if raced.unwrap() != 1 { return 4 }
    let tooMany = executor.boundedFanOut(values, 0,
        CancellationSource.root(2), 2)
    if not tooMany.isErr() { return 5 }
    if tooMany.unwrapErr().code != "async.limit" { return 5 }
    let group = AsyncWaitGroup.create(2, 2).unwrap()
    let groupFirst = group.done()
    if groupFirst.isErr() { return 6 }
    if groupFirst.unwrap() { return 6 }
    let groupSecond = group.done()
    if groupSecond.isErr() { return 6 }
    if not groupSecond.unwrap() { return 6 }
    let barrier = AsyncBarrier.create(2).unwrap()
    if barrier.arrive() { return 7 }
    if not barrier.arrive() { return 7 }
    let reduced = deterministicReduceSum(values, 3)
    if reduced.isErr() { return 8 }
    if reduced.unwrap() != 15 { return 8 }
    executor.shutdown(true)
    println("PASS: ASYNC-001F_happy")
    println("PASS: ASYNC-001F_partial")
    println("PASS: ASYNC-001F_invalid")
    println("PASS: ASYNC-001F_limit")
    println("PASS: ASYNC-001F_cancel")
    println("PASS: ASYNC-001F_cleanup")
    return 0
}
