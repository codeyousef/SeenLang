import async.dns_wire.{DnsQuestion, decodeDnsResponse}
import dns_fixture_support.{dnsFixtureAnswer}
extern "C" fun seen_time_monotonic_nanos() r: Int64
extern "C" fun seen_memory_used_bytes() r: Int64
fun main() r: Int {
    let created = DnsQuestion.create("example.test", 1, 1101)
    if created.isErr() { return 1 }
    let question = created.unwrap(); created.releaseContainer()
    let original = dnsFixtureAnswer(question); let wire = dnsFixtureAnswer(question)
    let warmed = decodeDnsResponse(wire, question, 4)
    if warmed.isErr() { return 2 }
    warmed.unwrap().release(); warmed.releaseContainer()
    let baseline = seen_memory_used_bytes()
    let start = seen_time_monotonic_nanos()
    if start < (0 as Int64) or start > (9223371976854775807 as Int64) { return 3 }
    let end = start + (60000000000 as Int64)
    var seed = 1101; var iterations = 0; var now = start
    while now < end {
        wire.length = original.length; var i = 0
        while i < wire.length { wire.put(i, original.byte(i)); i = i + 1 }
        seed = (seed * 1664525 + 1013904223) % 4294967296
        let index = seed % wire.length
        wire.put(index, (seed / 65536) & 255)
        if seed % 4 == 0 { wire.length = seed % (original.length + 1) }
        let result = decodeDnsResponse(wire, question, 4)
        if result.isErr() {
            let error = result.unwrapErr()
            if error.progress != (0 as UInt64) or
                (error.code != "async.invalid" and error.code != "async.limit" and
                error.code != "async.unavailable" and error.code != "async.unsupported_platform") { return 4 }
            error.free()
        } else {
            let response = result.unwrap()
            if response.addresses.length() > 4 { return 5 }
            response.release()
        }
        result.releaseContainer(); iterations = iterations + 1
        if iterations % 1000 == 0 and seen_memory_used_bytes() != baseline { return 6 }
        now = seen_time_monotonic_nanos()
        if now < start { return 7 }
    }
    if iterations <= 0 or seen_memory_used_bytes() != baseline { return 8 }
    wire.release(); original.release(); question.release()
    println("PASS: DNS wire fuzz 60s seed 1101")
    return 0
}
