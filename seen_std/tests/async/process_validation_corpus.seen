import async.process_arguments.{validProcessProgram, validProcessEnvironment}
import async.owned_strings.{OwnedCStringVector}
import stress_fixture_support.{must, errorHasProgress}
import memory.aligned_buffer.{OwnedBuffer}
extern "C" fun seen_memory_used_bytes() r: Int64
extern "C" fun seen_string_view_bytes(data: *const UInt8, length: Int64) r: String

fun main() r: Int {
    let memory = seen_memory_used_bytes()
    let valid = ["/a", "/bin/cat", "/a/.hidden", "/a/...", "/a-b/c_0"]
    let invalid = ["", "/", "cat", "relative/x", "//cat", "/cat/", "/a//b", "/a/./b", "/a/../b"]
    var index = 0
    while index < valid.length() {
        if not validProcessProgram(valid[index]) { abort("valid process path rejected") }
        index = index + 1
    }
    index = 0
    while index < invalid.length() {
        if validProcessProgram(invalid[index]) { abort("invalid process path accepted") }
        index = index + 1
    }
    valid.free(); invalid.free()
    let environment = Array<String>()
    let keys = ["A=value", "_A0=", "a_z9=hello", "Z=with=equals", "_="]
    let badKeys = ["=value", "missing", "0A=v", "A-B=v", "A B=v", "é=v"]
    environment.push(""); index = 0
    while index < keys.length() {
        environment[0] = keys[index]
        if not validProcessEnvironment(environment) { abort("valid process environment rejected") }
        index = index + 1
    }
    index = 0
    while index < badKeys.length() {
        environment[0] = badKeys[index]
        if validProcessEnvironment(environment) { abort("invalid process environment accepted") }
        index = index + 1
    }
    keys.free(); badKeys.free()
    let storage = must(OwnedBuffer<UInt8>.allocate(65536 as UInt64, 1 as UInt64, 16 as UInt64))
    index = 0
    while index < 65536 { storage.data[index] = 65 as UInt8; index = index + 1 }
    storage.data[0] = 47 as UInt8
    let pathLimit = seen_string_view_bytes(storage.data as *const UInt8, 4095 as Int64)
    let tooLong = seen_string_view_bytes(storage.data as *const UInt8, 4096 as Int64)
    if not validProcessProgram(pathLimit) or validProcessProgram(tooLong) { abort("process path byte limit changed") }
    storage.data[2] = 0 as UInt8
    if validProcessProgram(pathLimit) { abort("NUL process path accepted") }
    storage.data[0] = 65 as UInt8; storage.data[2] = 65 as UInt8
    storage.data[65534] = 61 as UInt8
    environment[0] = seen_string_view_bytes(storage.data as *const UInt8, 65535 as Int64)
    if not validProcessEnvironment(environment) { abort("maximum process environment rejected") }
    environment[0] = seen_string_view_bytes(storage.data as *const UInt8, 65536 as Int64)
    if validProcessEnvironment(environment) { abort("oversized process environment accepted") }
    storage.data[1] = 61 as UInt8; storage.data[2] = 0 as UInt8
    environment[0] = seen_string_view_bytes(storage.data as *const UInt8, 4 as Int64)
    if not errorHasProgress(OwnedCStringVector.pack(environment), "async.invalid", 0 as UInt64) {
        abort("NUL environment escaped owned packing validation")
    }
    environment.free(); storage.close(); storage.free()
    let excess = Array<String>(); index = 0
    while index < 257 { excess.push("A=x"); index = index + 1 }
    if validProcessEnvironment(excess) { abort("environment entry limit changed") }
    excess.free()
    if seen_memory_used_bytes() != memory { abort("process validation corpus leaked allocations") }
    println("PASS: process path/environment boundary corpus and cleanup")
    return 0
}
