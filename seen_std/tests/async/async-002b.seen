import core.result.{Result}
import core.error.{AsciiString}
import core.operation_context.{OperationContext, OperationLimits}
import async.structured.{AsyncError, AsyncLimits, AsyncOperationContext}
import async.multithread.{MultithreadExecutor}
import async.executor_core.{ExecutorLimits, ExecutorJob, ExecutorTaskContext,
    executorReleaseContext}
import async.task_group.{TaskGroup}
import async.wait_group.{AsyncWaitGroup}
import async.barrier.{AsyncBarrier}
import async.queue.{AsyncQueue}
import async.reduction.{AsyncIntReduction}
import sync.atomic.{AtomicInt, MemoryOrder}

extern "C" fun __ThreadYield() r: Void
extern "C" fun seen_executor_live_threads() r: UInt64
extern "C" fun seen_sync_live_mutexes() r: UInt64
extern "C" fun seen_sync_live_conditions() r: UInt64

fun must<T, E>(result: Result<T, E>) r: T {
    if result.isErr() { abort("async synchronization fixture failed") }
    let value = result.unwrap(); result.releaseContainer()
    return value
}

fun errorIs<T>(result: Result<T, AsyncError>, code: String) r: Bool {
    if result.isOkay() { result.releaseContainer(); return false }
    let error = result.unwrapErr(); result.releaseContainer()
    let matches = error.code == code
    error.free()
    return matches
}

fun asyncBool(result: Result<Bool, AsyncError>) r: Bool {
    if result.isErr() {
        result.unwrapErr().free(); result.releaseContainer()
        return false
    }
    result.releaseContainer()
    return true
}

fun context() r: AsyncOperationContext {
    return AsyncOperationContext{operation: OperationContext{
        cancellation: false, monotonicDeadline: 9223372036854775807 as Int64,
        limits: OperationLimits{maxTargets: 8, maxIdentityBytes: 128,
            maxVersionBytes: 128, maxManifestBytes: 4096, maxPathBytes: 4095,
            maxGraphModules: 8, maxGraphEdges: 16, maxGraphDepth: 4},
        traceId: AsciiString{value: "async-002b"}}, resourceId: "sync-test",
        fallbackPolicy: 0, limits: AsyncLimits.bounded(16, 16, 8, 16, 128)}
}

@send
class SyncProbe {
    var mode: Int
    var index: Int
    var result: Int
    var queue: AsyncQueue<Int>
    var group: AsyncWaitGroup
    var phase: AsyncBarrier
    var reduction: AsyncIntReduction
    var started: AtomicInt
    var releases: AtomicInt
}

impl ExecutorJob for SyncProbe {
    fun run(this: SyncProbe, task: ExecutorTaskContext) r: Bool {
        if this.mode == 1 {
            return asyncBool(this.queue.put(this.index, task.operation))
        }
        if this.mode == 2 or this.mode == 4 {
            if this.mode == 4 { must(this.started.store(1 as Int64, MemoryOrder.SeqCst)) }
            let value = this.queue.take(task.operation)
            if value.isErr() {
                value.unwrapErr().free(); value.releaseContainer(); return false
            }
            this.result = value.unwrap(); value.releaseContainer()
            return true
        }
        if this.mode == 3 {
            let phase = this.phase.arrive(task.operation)
            if phase.isErr() {
                phase.unwrapErr().free(); phase.releaseContainer(); return false
            }
            phase.releaseContainer()
            if not asyncBool(this.reduction.submit(this.index, this.index + 5, task.operation)) {
                return false
            }
            return asyncBool(this.group.done())
        }
        if this.mode == 5 { return false }
        this.result = this.index
        return true
    }
    fun release(this: SyncProbe) r: Bool {
        must(this.releases.fetchAdd(1 as Int64, MemoryOrder.SeqCst))
        this.free()
        return true
    }
}

class Fixture {
    var pool: MultithreadExecutor<SyncProbe>
    var queue: AsyncQueue<Int>
    var group: AsyncWaitGroup
    var phase: AsyncBarrier
    var reduction: AsyncIntReduction
    var started: AtomicInt
    var releases: AtomicInt

    static fun create() r: Fixture {
        let limits = ExecutorLimits{workers: 1, tasks: 16, queued: 16,
            helpDepth: 8, stackBytes: 1048576 as UInt64}
        let pool = must(MultithreadExecutor<SyncProbe>.create(limits)); limits.free()
        return Fixture{pool: pool, queue: must(AsyncQueue<Int>.create(pool.core, 1)),
            group: must(AsyncWaitGroup.create(pool.core, 2, 2)),
            phase: must(AsyncBarrier.create(pool.core, 2)),
            reduction: must(AsyncIntReduction.create(pool.core, 2)),
            started: must(AtomicInt.create(0 as Int64)),
            releases: must(AtomicInt.create(0 as Int64))}
    }
    fun job(mode: Int, index: Int) r: SyncProbe {
        return SyncProbe{mode: mode, index: index, result: 0, queue: this.queue,
            group: this.group, phase: this.phase, reduction: this.reduction,
            started: this.started, releases: this.releases}
    }
    fun release(context: AsyncOperationContext, expected: Int64) r: Void {
        must(this.queue.close())
        while this.queue.count > 0 { must(this.queue.take(context)) }
        must(this.queue.release())
        must(this.group.close()); must(this.group.release())
        must(this.phase.close()); must(this.phase.release())
        must(this.reduction.close()); must(this.reduction.release())
        if must(this.releases.load(MemoryOrder.SeqCst)) != expected {
            abort("async synchronization lost a task owner")
        }
        must(this.started.close()); this.started.free()
        must(this.releases.close()); this.releases.free()
        must(this.pool.release())
        this.free()
    }
}

fun releaseJobs(values: Array<SyncProbe>) r: Void {
    var i = 0
    while i < values.length() { values[i].release(); i = i + 1 }
    values.free()
}

fun main() r: Int {
    let mutexes = seen_sync_live_mutexes()
    let conditions = seen_sync_live_conditions()
    let threads = seen_executor_live_threads()
    let ctx = context()
    let happy = Fixture.create()
    var round = 0
    while round < 20 {
        let tasks = must(TaskGroup<SyncProbe>.create(happy.pool.core, 2, ctx))
        must(tasks.spawn(happy.job(2, 0), ctx))
        must(tasks.spawn(happy.job(1, 42), ctx))
        let values = must(tasks.barrier(ctx))
        if values.length() != 2 or values[0].result != 42 { return 1 }
        releaseJobs(values); must(tasks.release())
        round = round + 1
    }
    let phaseTasks = must(TaskGroup<SyncProbe>.create(happy.pool.core, 2, ctx))
    must(phaseTasks.spawn(happy.job(3, 0), ctx))
    must(phaseTasks.spawn(happy.job(3, 1), ctx))
    releaseJobs(must(phaseTasks.barrier(ctx))); must(phaseTasks.release())
    must(happy.group.wait(ctx))
    if must(happy.reduction.finish(ctx)) != 11 { return 2 }
    if not errorIs(happy.reduction.submit(0, 9, ctx), "async.invalid") { return 3 }
    if not errorIs(happy.phase.arrive(ctx), "async.invalid") { return 4 }
    happy.release(ctx, 42 as Int64)
    println("PASS: ASYNC-002B_happy")

    let partial = Fixture.create()
    let failed = must(TaskGroup<SyncProbe>.create(partial.pool.core, 2, ctx))
    must(failed.spawn(partial.job(0, 7), ctx))
    must(failed.spawn(partial.job(5, 0), ctx))
    let result = failed.barrier(ctx)
    if result.isOkay() { return 5 }
    let error = result.unwrapErr(); result.releaseContainer()
    if error.code != "async.unavailable" or error.progress != (1 as UInt64) { return 6 }
    error.free(); must(failed.release())
    partial.release(ctx, 2 as Int64)
    println("PASS: ASYNC-002B_partial")

    let invalid = Fixture.create()
    if not errorIs(AsyncWaitGroup.create(invalid.pool.core, 2, 1), "async.limit") { return 7 }
    if not errorIs(AsyncQueue<Int>.create(invalid.pool.core, 17), "async.limit") { return 8 }
    if not errorIs(invalid.pool.close(), "async.invalid") { return 9 }
    must(invalid.reduction.submit(0, 9223372036854775807, ctx))
    must(invalid.reduction.submit(1, 1, ctx))
    if not errorIs(invalid.reduction.finish(ctx), "async.limit") { return 10 }
    invalid.release(ctx, 0 as Int64)
    println("PASS: ASYNC-002B_invalid")
    println("PASS: ASYNC-002B_limit")

    let cancel = Fixture.create()
    let cancelled = must(TaskGroup<SyncProbe>.create(cancel.pool.core, 1, ctx))
    must(cancelled.spawn(cancel.job(4, 0), ctx))
    var spins = 0
    while must(cancel.started.load(MemoryOrder.SeqCst)) == (0 as Int64) and spins < 1000000 {
        __ThreadYield(); spins = spins + 1
    }
    if must(cancel.started.load(MemoryOrder.SeqCst)) == (0 as Int64) { return 14 }
    cancelled.cancel()
    if not errorIs(cancelled.barrier(ctx), "async.cancelled") { return 11 }
    must(cancelled.release())
    must(cancel.group.cancel())
    if not errorIs(cancel.group.wait(ctx), "async.cancelled") { return 12 }
    cancel.release(ctx, 1 as Int64)
    println("PASS: ASYNC-002B_cancel")
    executorReleaseContext(ctx)
    if seen_sync_live_mutexes() != mutexes or seen_sync_live_conditions() != conditions or
        seen_executor_live_threads() != threads { return 13 }
    println("PASS: ASYNC-002B_cleanup")
    return 0
}
