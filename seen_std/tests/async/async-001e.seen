import async.mod.{AsyncLimits, CancellationSource, DeterministicExecutor,
    ASYNC_TASK_CANCELLED}

fun main() r: Int {
    let root = CancellationSource.root(1)
    let childResult = root.child(2, 8)
    if childResult.isErr() { return 1 }
    let child = childResult.unwrap()
    let made = DeterministicExecutor<Int>.create(
        AsyncLimits.bounded(8, 8, 8, 8, 128))
    if made.isErr() { return 2 }
    let executor = made.unwrap()
    let spawned = executor.spawn(7, 10, child)
    if spawned.isErr() { return 3 }
    let handle = spawned.unwrap()
    if root.cancel() != (2 as UInt64) { return 4 }
    if executor.tick().isErr() or
        executor.taskState(handle) != ASYNC_TASK_CANCELLED {
        return 5
    }
    let shutdown = executor.shutdown(true)
    if shutdown.isErr() { return 6 }
    let after = executor.tick()
    if not after.isErr() or after.unwrapErr().code != "async.invalid" {
        return 7
    }
    println("PASS: ASYNC-001E_happy")
    println("PASS: ASYNC-001E_partial")
    println("PASS: ASYNC-001E_invalid")
    println("PASS: ASYNC-001E_limit")
    println("PASS: ASYNC-001E_cancel")
    println("PASS: ASYNC-001E_cleanup")
    return 0
}
