import async.executor_native.{seen_string_release_owned}
import core.result.{Result}
import core.option.{Option, Some, None}
import core.error.{AsciiString, RetryClass, RedactionClass}
import core.operation_context.{OperationContext, OperationLimits}
import async.structured.{AsyncError, AsyncLimits, AsyncOperationContext}
import async.executor_core.{ExecutorLimits, ExecutorTaskContext, executorReleaseContext}
import async.multithread.{MultithreadExecutor}
import async.task_diagnostics.{TaskCapture, TaskDiagnostic, TaskDiagnosticKind, TaskBackend,
    TaskPanicPolicy, runtimeTaskPanicPolicy}
extern "C" fun seen_executor_live_threads() r: UInt64
extern "C" fun seen_sync_live_mutexes() r: UInt64
extern "C" fun seen_sync_live_conditions() r: UInt64
extern "C" fun seen_sync_atomic_create(initial: Int64, handle: *UInt64) r: Int32
extern "C" fun seen_sync_atomic_load(handle: UInt64, order: Int32, value: *Int64) r: Int32
extern "C" fun seen_sync_atomic_fetch_add(handle: UInt64, amount: Int64, order: Int32, previous: *Int64) r: Int32
extern "C" fun seen_sync_atomic_destroy(handle: *UInt64) r: Int32
extern "C" fun seen_string_clone_owned(value: String) r: String
extern "C" fun seen_time_monotonic_nanos() r: Int64
extern "C" fun seen_time_sleep_nanos(nanoseconds: Int64) r: Int32
extern "C" fun __ThreadYield() r: Void
fun must<T, E>(result: Result<T, E>) r: T {
    if result.isErr() { abort("task policy fixture failed") }
    let value = result.unwrap(); result.releaseContainer(); return value
}
fun errorIs<T>(result: Result<T, AsyncError>, code: String) r: Bool {
    if result.isOkay() { result.releaseContainer(); return false }
    let error = result.unwrapErr(); result.releaseContainer()
    let matches = error.code == code
    error.free(); return matches
}
fun atomicValue(handle: UInt64) r: Int64 {
    var value = 0 as Int64
    if seen_sync_atomic_load(handle, 4 as Int32, &value) != (0 as Int32) {
        abort("pool counter read failed")
    }
    return value
}
fun context() r: AsyncOperationContext {
    return AsyncOperationContext{operation: OperationContext{
        cancellation: false, monotonicDeadline: 9223372036854775807 as Int64,
        limits: OperationLimits{maxTargets: 8, maxIdentityBytes: 128,
            maxVersionBytes: 128, maxManifestBytes: 4096, maxPathBytes: 4095,
            maxGraphModules: 8, maxGraphEdges: 16, maxGraphDepth: 4},
        traceId: AsciiString{value: "async-002f"}}, resourceId: "task-policy",
        fallbackPolicy: 0, limits: AsyncLimits.bounded(16, 16, 8, 16, 128)}
}
fun limits() r: ExecutorLimits {
    return ExecutorLimits{workers: 1, tasks: 8, queued: 8,
        helpDepth: 8, stackBytes: 1048576 as UInt64}
}
@send
class PolicyProbe {
    var mode: Int
    var releases: UInt64
    var started: UInt64
    var capture: Option<TaskCapture>
    fun run(task: ExecutorTaskContext) r: Bool {
        if task.panicPolicy() != TaskPanicPolicy.CooperativeFailure { return false }
        let advanced = task.advanceProgress(3 as UInt64)
        if advanced.isErr() { advanced.unwrapErr().free(); advanced.releaseContainer(); return false }
        advanced.releaseContainer()
        if this.mode == 0 {
            let captured = task.capture()
            if captured.isErr() { captured.unwrapErr().free(); captured.releaseContainer(); return false }
            this.capture.free(); this.capture = Some<TaskCapture>(captured.unwrap()); captured.releaseContainer()
            let fallback = task.recordFallback(TaskBackend.Scalar, "PRIVATE-FALLBACK-REASON")
            if fallback.isErr() { fallback.unwrapErr().free(); fallback.releaseContainer() }
            else { fallback.releaseContainer() }
            return true
        }
        if this.mode == 1 {
            let panic = task.panic("PRIVATE-TASK-PANIC")
            if panic.isErr() { panic.unwrapErr().free() }
            panic.releaseContainer(); return true
        }
        if this.mode == 2 or this.mode == 4 {
            let causes = Array<String>(); causes.push("public cause")
            let created = TaskDiagnostic.create(TaskDiagnosticKind.Failure, 1 as Int32, TaskBackend.Native,
                "public failure", causes, 7 as UInt64, RetryClass.Never, RedactionClass.Public)
            causes.free()
            if created.isErr() { created.unwrapErr().free(); created.releaseContainer(); return false }
            let diagnostic = created.unwrap(); created.releaseContainer()
            let recorded = task.failWith(diagnostic); diagnostic.release()
            if recorded.isErr() { recorded.unwrapErr().free(); recorded.releaseContainer(); return false }
            recorded.releaseContainer()
            if this.mode == 4 {
                let remaining = task.operation.operation.monotonicDeadline - seen_time_monotonic_nanos()
                if remaining > (0 as Int64) { let ignored = seen_time_sleep_nanos(remaining + (5000000 as Int64)) }
            } else {
                let duplicate = task.panic("PRIVATE-SECOND-FAILURE")
                if duplicate.isErr() { duplicate.unwrapErr().free() }
                duplicate.releaseContainer()
            }
            return true
        }
        if this.mode == 3 {
            var previous = 0 as Int64
            if seen_sync_atomic_fetch_add(this.started, 1 as Int64, 4 as Int32, &previous) != (0 as Int32) { return false }
            while not task.isCancelled() { __ThreadYield() }
            return true
        }
        return true
    }
    fun release() r: Bool {
        if this.capture.isSome() { this.capture.unwrap().release() }
        this.capture.free(); var previous = 0 as Int64
        let status = seen_sync_atomic_fetch_add(this.releases, 1 as Int64, 4 as Int32, &previous)
        this.free(); return status == (0 as Int32)
    }
}
fun probe(mode: Int, releases: UInt64, started: UInt64) r: PolicyProbe {
    return PolicyProbe{mode: mode, releases: releases, started: started, capture: None<TaskCapture>()}
}
fun main() r: Int {
    let threads = seen_executor_live_threads(); let mutexes = seen_sync_live_mutexes()
    let conditions = seen_sync_live_conditions()
    let ctx = context(); let config = limits()
    let executor = must(MultithreadExecutor<PolicyProbe>.create(config)); config.free()
    var releases = 0 as UInt64; var started = 0 as UInt64
    if seen_sync_atomic_create(0 as Int64, &releases) != (0 as Int32) or
        seen_sync_atomic_create(0 as Int64, &started) != (0 as Int32) { return 1 }
    if runtimeTaskPanicPolicy() != TaskPanicPolicy.AbortProcess { return 2 }
    let submission = context(); submission.fallbackPolicy = 1
    submission.resourceId = seen_string_clone_owned("owned-resource")
    submission.operation.traceId.value = seen_string_clone_owned("owned-trace")
    let handle = must(executor.spawn(probe(0, releases, started), submission))
    seen_string_release_owned(submission.resourceId); seen_string_release_owned(submission.operation.traceId.value); executorReleaseContext(submission)
    let report = must(handle.joinDetailed(ctx)); handle.free()
    if report.error.isSome() or report.progress != (3 as UInt64) or report.fallback.isNone() { return 3 }
    let fallback = report.fallback.unwrap()
    if fallback.code() != "async.fallback" or fallback.message != "task details redacted" or fallback.retryable { return 4 }
    let value = must(report.takeTask()); report.release()
    if value.capture.isNone() or value.capture.unwrap().resourceId != "owned-resource" or
        value.capture.unwrap().traceId != "owned-trace" { return 5 }
    value.release()
    println("PASS: ASYNC-002F_happy")

    let panicHandle = must(executor.spawn(probe(1, releases, started), ctx))
    let panic = must(panicHandle.joinDetailed(ctx)); panicHandle.free()
    if panic.error.isNone() or panic.error.unwrap().code != "async.unavailable" or panic.error.unwrap().retryable or
        panic.error.unwrap().progress != (3 as UInt64) or panic.diagnostic.isNone() { return 6 }
    if panic.diagnostic.unwrap().kind != TaskDiagnosticKind.Panic or
        panic.diagnostic.unwrap().message != "task details redacted" { return 7 }
    panic.release()
    let typedHandle = must(executor.spawn(probe(2, releases, started), ctx))
    let typed = must(typedHandle.joinDetailed(ctx)); typedHandle.free()
    if typed.error.isNone() or typed.error.unwrap().code != "async.invalid" or typed.progress != (7 as UInt64) or
        typed.diagnostic.unwrap().message != "public failure" or typed.diagnostic.unwrap().causes.length() != 1 { return 8 }
    typed.release()
    println("PASS: ASYNC-002F_partial")
    let denied = must(executor.spawn(probe(0, releases, started), ctx))
    if not errorIs(denied.join(ctx), "async.unsupported_platform") { return 9 }
    denied.free()
    let causes = Array<String>()
    if not errorIs(TaskDiagnostic.create(TaskDiagnosticKind.Panic, 3 as Int32, TaskBackend.Native,
        "x", causes, 0 as UInt64, RetryClass.Transient, RedactionClass.Public), "async.invalid") { return 10 }
    println("PASS: ASYNC-002F_invalid")
    var i = 0
    while i < 9 { causes.push("x"); i = i + 1 }
    if not errorIs(TaskDiagnostic.create(TaskDiagnosticKind.Failure, 1 as Int32, TaskBackend.Native,
        "x", causes, 0 as UInt64, RetryClass.Never, RedactionClass.Public), "async.limit") { return 11 }
    causes.free()
    println("PASS: ASYNC-002F_limit")
    let cancelled = must(executor.spawn(probe(3, releases, started), ctx))
    var spins = 0
    while atomicValue(started) == (0 as Int64) and spins < 1000000 { __ThreadYield(); spins = spins + 1 }
    if atomicValue(started) == (0 as Int64) { return 12 }
    must(cancelled.cancel())
    let cancellation = must(cancelled.joinDetailed(ctx)); cancelled.free()
    if cancellation.error.isNone() or cancellation.error.unwrap().code != "async.cancelled" or
        cancellation.progress != (3 as UInt64) { return 13 }
    cancellation.release()
    let deadline = context(); deadline.operation.monotonicDeadline = seen_time_monotonic_nanos() + (1000000000 as Int64)
    let late = must(executor.spawn(probe(4, releases, started), deadline))
    executorReleaseContext(deadline)
    let lateReport = must(late.joinDetailed(ctx)); late.free()
    if lateReport.error.isNone() or lateReport.error.unwrap().code != "async.timeout" or
        lateReport.progress != (7 as UInt64) { return 14 }
    lateReport.release()
    println("PASS: ASYNC-002F_cancel")
    // Report destruction releases a successful result that was not taken.
    let unclaimed = must(executor.spawn(probe(5, releases, started), ctx))
    let unclaimedReport = must(unclaimed.joinDetailed(ctx)); unclaimed.free(); unclaimedReport.release()
    must(executor.release()); executorReleaseContext(ctx)
    if atomicValue(releases) != (7 as Int64) { return 15 }
    if seen_sync_atomic_destroy(&releases) != (0 as Int32) or seen_sync_atomic_destroy(&started) != (0 as Int32) { return 16 }
    if seen_executor_live_threads() != threads or seen_sync_live_mutexes() != mutexes or
        seen_sync_live_conditions() != conditions { return 17 }
    println("PASS: ASYNC-002F_cleanup")
    return 0
}
