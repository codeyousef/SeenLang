import core.result.{Result}
import core.error.{AsciiString}
import core.operation_context.{OperationContext, OperationLimits}
import async.structured.{AsyncError, AsyncLimits, AsyncOperationContext}
import async.executor_core.{ExecutorLimits, ExecutorTaskContext, executorReleaseContext}
import async.multithread.{MultithreadExecutor}
import async.event_loop.{AsyncIoJob, AsyncIoEvent, ReadyIoJob, AsyncEventLoop}
import async.deadline_heap.{AsyncDeadlineHeap}
import async.sockets.{AsyncTcpSocket, SocketAddress}
import async.completion_io.{AsyncFileCompletionQueue}
import reactor.reactor.{OwnedHandle, Interest}
import memory.aligned_buffer.{OwnedBuffer}
extern "C" fun seen_async_readiness_live_handles() r: UInt64
extern "C" fun seen_reactor_live_handles() r: UInt64
extern "C" fun seen_sync_live_atomics() r: UInt64
extern "C" fun seen_executor_live_threads() r: UInt64
extern "C" fun seen_sync_live_mutexes() r: UInt64
extern "C" fun seen_sync_live_conditions() r: UInt64
extern "C" fun seen_sync_atomic_create(initial: Int64, handle: *UInt64) r: Int32
extern "C" fun seen_sync_atomic_load(handle: UInt64, order: Int32, value: *Int64) r: Int32
extern "C" fun seen_sync_atomic_fetch_add(handle: UInt64, amount: Int64,
    order: Int32, previous: *Int64) r: Int32
extern "C" fun seen_sync_atomic_destroy(handle: *UInt64) r: Int32
fun must<T, E>(result: Result<T, E>) r: T {
    if result.isErr() { abort("reactor fixture failed") }
    let value = result.unwrap(); result.releaseContainer(); return value
}
fun errorIs<T>(result: Result<T, AsyncError>, code: String) r: Bool {
    if result.isOkay() { result.releaseContainer(); return false }
    let error = result.unwrapErr(); result.releaseContainer()
    let matches = error.code == code
    error.free(); return matches
}
fun atomicValue(handle: UInt64) r: Int64 {
    var value = 0 as Int64
    if seen_sync_atomic_load(handle, 4 as Int32, &value) != (0 as Int32) {
        abort("pool counter read failed")
    }
    return value
}
fun context() r: AsyncOperationContext {
    return AsyncOperationContext{operation: OperationContext{
        cancellation: false, monotonicDeadline: 9223372036854775807 as Int64,
        limits: OperationLimits{maxTargets: 8, maxIdentityBytes: 128,
            maxVersionBytes: 128, maxManifestBytes: 4096, maxPathBytes: 4095,
            maxGraphModules: 8, maxGraphEdges: 16, maxGraphDepth: 4},
        traceId: AsciiString{value: "async-002d"}}, resourceId: "io-test",
        fallbackPolicy: 0, limits: AsyncLimits.bounded(16, 16, 8, 16, 128)}
}
fun limits() r: ExecutorLimits {
    return ExecutorLimits{workers: 1, tasks: 8, queued: 8,
        helpDepth: 8, stackBytes: 1048576 as UInt64}
}
@send
class IoProbe {
    var releases: UInt64
    var observed: Bool
    fun onEvent(event: AsyncIoEvent, descriptor: Int64, task: ExecutorTaskContext) r: Bool {
        this.observed = event.timer and descriptor == (-1 as Int64)
        return not task.isCancelled()
    }
    fun release() r: Bool {
        var previous = 0 as Int64
        let status = seen_sync_atomic_fetch_add(this.releases, 1 as Int64, 4 as Int32, &previous)
        this.free(); return status == (0 as Int32)
    }
}
fun emptyHandle() r: OwnedHandle {
    return OwnedHandle{native: -1 as Int64, owned: false, valid: false}
}
fun probe(releases: UInt64) r: IoProbe { return IoProbe{releases: releases, observed: false} }
fun main() r: Int {
    let readiness = seen_async_readiness_live_handles()
    let reactors = seen_reactor_live_handles(); let atomics = seen_sync_live_atomics()
    let threads = seen_executor_live_threads()
    let mutexes = seen_sync_live_mutexes(); let conditions = seen_sync_live_conditions()
    let ctx = context(); let config = limits()
    let executor = must(MultithreadExecutor<ReadyIoJob<IoProbe>>.create(config))
    config.free()
    if not errorIs(AsyncEventLoop<IoProbe>.create(executor, 0), "async.limit") { return 1 }
    let reactor = must(AsyncEventLoop<IoProbe>.create(executor, 2))
    let wake = must(reactor.wakeHandle())
    must(wake.wakeup())
    if not errorIs(reactor.close(), "async.unavailable") { return 18 }
    wake.release()
    var releases = 0 as UInt64
    if seen_sync_atomic_create(0 as Int64, &releases) != (0 as Int32) { return 2 }
    let first = must(reactor.register(probe(releases), emptyHandle(), Interest.Readable, 0 as Int64, ctx))
    must(reactor.pollOnce(2, ctx))
    let joined = must(reactor.dispatchNext()); let completed = must(joined.join(ctx))
    if not completed.task.observed { return 3 }
    completed.release(); joined.free()
    if reactor.matches(first) { return 4 }
    first.free()
    println("PASS: ASYNC-002D_happy")

    let heap = must(AsyncDeadlineHeap.create(4))
    if not heap.insert(3, 8 as Int64) or not heap.insert(1, 2 as Int64) or
        not heap.insert(2, 2 as Int64) or heap.first() != 1 { return 5 }
    if not heap.remove(1) or heap.first() != 2 or not heap.remove(2) or heap.first() != 3 { return 6 }
    if heap.insert(4, 0 as Int64) or heap.insert(3, 9 as Int64) { return 7 }
    heap.release()
    let bytes = Array<Int>(); bytes.push(127); bytes.push(0); bytes.push(0); bytes.push(1)
    let address = must(SocketAddress.fromBytes(bytes, 0)); bytes.free()
    let socket = must(AsyncTcpSocket.create(4, 8 as UInt64))
    must(socket.bind(address, ctx)); must(socket.listen(2))
    if must(socket.boundPort()) <= 0 { return 8 }
    if not errorIs(socket.accept(ctx), "async.unavailable") { return 9 }
    must(socket.release()); address.release()
    // Kernel queue/lease construction is software-only; native mock probes
    // cover in-flight storage, partial completion and deferred cancellation.
    let completion = must(AsyncFileCompletionQueue.create(2, 4096 as UInt64))
    let notification = must(completion.notificationLease())
    if not errorIs(completion.close(), "async.unavailable") { return 19 }
    notification.release()
    let aligned = must(OwnedBuffer<UInt8>.allocate(4096 as UInt64, 1 as UInt64, 4096 as UInt64))
    if (aligned.data as UInt64) % (4096 as UInt64) != (0 as UInt64) { return 20 }
    let noFile = emptyHandle()
    if not errorIs(completion.submit(noFile, aligned, 4096 as UInt64, 0 as Int64,
        false, ctx), "async.invalid") { return 21 }
    noFile.free(); aligned.close(); aligned.free()
    must(completion.close()); must(completion.close()); must(completion.release())
    println("PASS: ASYNC-002D_partial")

    let invalidTask = probe(releases); let invalidDescriptor = emptyHandle()
    if not errorIs(reactor.register(invalidTask, invalidDescriptor, Interest.Readable,
        -1 as Int64, ctx), "async.invalid") { return 10 }
    invalidTask.release(); invalidDescriptor.free()
    let a = must(reactor.register(probe(releases), emptyHandle(), Interest.Readable,
        9223372036854775807 as Int64, ctx))
    let b = must(reactor.register(probe(releases), emptyHandle(), Interest.Readable,
        9223372036854775807 as Int64, ctx))
    let excess = probe(releases); let excessDescriptor = emptyHandle()
    if not errorIs(reactor.register(excess, excessDescriptor, Interest.Readable,
        0 as Int64, ctx), "async.limit") { return 11 }
    excess.release(); excessDescriptor.free()
    if not errorIs(executor.close(), "async.invalid") { return 12 }
    println("PASS: ASYNC-002D_limit")
    must(reactor.cancel(a))
    if not errorIs(reactor.cancel(a), "async.invalid") { return 13 }
    a.free()
    println("PASS: ASYNC-002D_invalid")
    // Removing a ready entry unlinks it in O(1), without stale queue slots.
    must(reactor.cancel(b)); b.free()
    let ready = must(reactor.register(probe(releases), emptyHandle(), Interest.Readable, 0 as Int64, ctx))
    must(reactor.pollOnce(2, ctx)); must(reactor.cancel(ready)); ready.free()
    if not errorIs(reactor.dispatchNext(), "async.unavailable") { return 14 }
    println("PASS: ASYNC-002D_cancel")
    let pending = must(reactor.register(probe(releases), emptyHandle(), Interest.Readable,
        9223372036854775807 as Int64, ctx))
    pending.free()
    must(reactor.close()); must(reactor.close()); must(reactor.release())
    must(executor.release())
    if atomicValue(releases) != (7 as Int64) { return 15 }
    if seen_sync_atomic_destroy(&releases) != (0 as Int32) { return 16 }
    executorReleaseContext(ctx)
    if seen_async_readiness_live_handles() != readiness { return 23 }
    if seen_reactor_live_handles() != reactors or seen_sync_live_atomics() != atomics { return 22 }
    if seen_executor_live_threads() != threads or seen_sync_live_mutexes() != mutexes or
        seen_sync_live_conditions() != conditions { return 17 }
    println("PASS: ASYNC-002D_cleanup")
    return 0
}
