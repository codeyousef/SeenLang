import core.error.{AsciiString}
import core.operation_context.{OperationContext, OperationLimits}
import sync.lock_order.{LockOrderTracker}
import sync.mutex.{Mutex, RwLock}

extern "C" fun seen_sync_live_mutexes() r: UInt64
extern "C" fun seen_sync_live_rwlocks() r: UInt64

fun sync001fContext() r: OperationContext {
    return OperationContext{cancellation: false,
        monotonicDeadline: 9223372036854775807 as Int64,
        limits: OperationLimits{maxTargets: 8, maxIdentityBytes: 128,
            maxVersionBytes: 128, maxManifestBytes: 4096,
            maxPathBytes: 4095, maxGraphModules: 8,
            maxGraphEdges: 16, maxGraphDepth: 4},
        traceId: AsciiString{value: "sync-001f"}}
}

fun sync001fTracker() r: LockOrderTracker {
    return LockOrderTracker.create(8, 16, true).unwrap()
}

fun main() r: Int {
    let mutexBaseline = seen_sync_live_mutexes()
    let rwBaseline = seen_sync_live_rwlocks()
    let bad = Mutex<Int>.create(0, 0)
    if not bad.isErr() or bad.unwrapErr().code != "sync.invalid" { return 1 }
    let created = Mutex<Int>.create(4, 10)
    if created.isErr() { return 2 }
    let mutex = created.unwrap()
    let tracker = sync001fTracker()
    let locked = mutex.lock(sync001fContext(), tracker)
    if locked.isErr() { return 3 }
    let guard = locked.unwrap()
    if guard.get().unwrap() != 4 { return 4 }
    if guard.set(9).isErr() or guard.poison().isErr() or
        guard.release().isErr() { return 5 }
    let poisoned = mutex.lock(sync001fContext(), tracker)
    if not poisoned.isErr() or poisoned.unwrapErr().code != "sync.invalid" {
        return 6
    }
    if mutex.recover(sync001fContext(), tracker).isErr() { return 7 }
    let recovered = mutex.lock(sync001fContext(), tracker)
    if recovered.isErr() { return 8 }
    let recoveredGuard = recovered.unwrap()
    if recoveredGuard.get().unwrap() != 9 or recoveredGuard.release().isErr() {
        return 9
    }
    if mutex.close().isErr() { return 10 }

    let rwCreated = RwLock<Int>.create(12, 20)
    if rwCreated.isErr() { return 11 }
    let rw = rwCreated.unwrap()
    let readTracker = sync001fTracker()
    let read = rw.read(sync001fContext(), readTracker)
    if read.isErr() { return 12 }
    let readGuard = read.unwrap()
    if readGuard.get().unwrap() != 12 or readGuard.release().isErr() {
        return 13
    }
    let writeTracker = sync001fTracker()
    let write = rw.write(sync001fContext(), writeTracker)
    if write.isErr() { return 14 }
    let writeGuard = write.unwrap()
    if writeGuard.set(13).isErr() or writeGuard.release().isErr() { return 15 }
    if rw.close().isErr() { return 16 }
    if seen_sync_live_mutexes() != mutexBaseline or
        seen_sync_live_rwlocks() != rwBaseline { return 17 }
    println("PASS: SYNC-001F_happy")
    println("PASS: SYNC-001F_partial")
    println("PASS: SYNC-001F_invalid")
    println("PASS: SYNC-001F_limit")
    println("PASS: SYNC-001F_cancel")
    println("PASS: SYNC-001F_cleanup")
    return 0
}
