import error.{AsciiString}
import operation_context.{OperationLimits, OperationContext}
import secret.{SEEN_SECRET_REDACTED, SecretRevealPolicy, secretString,
    secretBytes}

fun secretContext(cancelled: Bool) r: OperationContext {
    return OperationContext{
        cancellation: cancelled, monotonicDeadline: 1,
        limits: OperationLimits{
            maxTargets: 4, maxIdentityBytes: 128, maxVersionBytes: 128,
            maxManifestBytes: 4096, maxPathBytes: 4096,
            maxGraphModules: 32, maxGraphEdges: 64, maxGraphDepth: 16
        }, traceId: AsciiString{ value: "p0-secret-001" }
    }
}

fun main() r: Int {
    let created = secretString("do-not-log", secretContext(false))
    if created.isErr() { println("FAIL: P0-SECRET-001_happy"); return 1 }
    var secret = created.unwrap()
    if secret.toString() != SEEN_SECRET_REDACTED or
        secret.redacted() != "[redacted]" or secret.byteLength() != 10 {
        println("FAIL: P0-SECRET-001_happy"); return 1
    }
    let revealed = secret.reveal(SecretRevealPolicy.Allow,
        secretContext(false))
    if revealed.isErr() or revealed.unwrap() != "do-not-log" {
        println("FAIL: P0-SECRET-001_happy"); return 1
    }
    println("PASS: P0-SECRET-001_happy")

    let denied = secret.reveal(SecretRevealPolicy.Deny,
        secretContext(false))
    if not denied.isErr() or
        denied.unwrapErr().code.value != "p0.secret.001.denied" {
        println("FAIL: P0-SECRET-001_invalid"); return 1
    }
    println("PASS: P0-SECRET-001_invalid")

    let limited = secretString("", secretContext(false))
    if not limited.isErr() or
        limited.unwrapErr().code.value != "p0.secret.001.limit" {
        println("FAIL: P0-SECRET-001_limit"); return 1
    }
    println("PASS: P0-SECRET-001_limit")

    let cancelled = secretString("hidden", secretContext(true))
    if not cancelled.isErr() or
        cancelled.unwrapErr().code.value != "p0.secret.001.cancelled" {
        println("FAIL: P0-SECRET-001_cancel"); return 1
    }
    println("PASS: P0-SECRET-001_cancel")

    let byteCreated = secretBytes([115, 101, 99, 114, 101, 116],
        secretContext(false))
    if byteCreated.isErr() {
        println("FAIL: P0-SECRET-001_cleanup"); return 1
    }
    var bytes = byteCreated.unwrap()
    if bytes.toString() != "[redacted]" or not bytes.clear() or
        bytes.isActive() or bytes.byteLength() != 0 or bytes.clear() or
        not secret.clear() or secret.clear() or secret.isActive() {
        println("FAIL: P0-SECRET-001_cleanup"); return 1
    }
    println("PASS: P0-SECRET-001_cleanup")
    return 0
}

main()
