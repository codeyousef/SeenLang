import error.{AsciiString}
import operation_context.{OperationLimits, OperationContext}
import core.result.{Result}
import io.bytes.{ByteBuffer, IoError, tryByteBufferWithCapacity}

fun byteStorageContext(cancelled: Bool) r: OperationContext {
    return OperationContext{
        cancellation: cancelled, monotonicDeadline: 1,
        limits: OperationLimits{
            maxTargets: 8, maxIdentityBytes: 128, maxVersionBytes: 128,
            maxManifestBytes: 4096, maxPathBytes: 4096,
            maxGraphModules: 8, maxGraphEdges: 16, maxGraphDepth: 4
        },
        traceId: AsciiString{ value: "bytes-001b" }
    }
}

fun main() r: Int {
    let created: Result<ByteBuffer, IoError> = tryByteBufferWithCapacity(4, 32)
    if created.isErr() {
        println("FAIL: BYTES-001B_happy"); return 1
    }
    let buffer = created.unwrap()
    let pushedA = buffer.push(17)
    let pushedB = buffer.push(34)
    let copied = buffer.toArray()
    if pushedA.isErr() or pushedB.isErr() or copied.isErr() or
        buffer.length() != 2 or buffer.capacity() != 4 or
        buffer.alignment() != 32 or copied.unwrap()[0] != 17 or
        copied.unwrap()[1] != 34 {

        println("FAIL: BYTES-001B_happy"); return 1
    }
    println("PASS: BYTES-001B_happy")

    let unchanged = buffer.reserve(4)
    let grown = buffer.reserve(9)
    let afterGrowth = buffer.toArray()
    if unchanged.isErr() or grown.isErr() or unchanged.unwrap() or
        not grown.unwrap() or buffer.capacity() != 9 or afterGrowth.isErr() or
        afterGrowth.unwrap()[0] != 17 or afterGrowth.unwrap()[1] != 34 {

        println("FAIL: BYTES-001B_partial"); return 1
    }
    println("PASS: BYTES-001B_partial")

    let badAlignment: Result<ByteBuffer, IoError> =
        tryByteBufferWithCapacity(8, 3)
    let negative: Result<ByteBuffer, IoError> =
        tryByteBufferWithCapacity(-1, 8)
    let badByte = buffer.push(256)
    let borrowedResult = buffer.slice(0, 1)
    if borrowedResult.isErr() {
        println("FAIL: BYTES-001B_invalid"); return 1
    }
    let borrowed = borrowedResult.unwrap()
    let growBorrowed = buffer.reserve(10)
    if not badAlignment.isErr() or not negative.isErr() or
        not badByte.isErr() or not growBorrowed.isErr() or
        badAlignment.unwrapErr().code.value != "byte.invalid" or
        growBorrowed.unwrapErr().code.value != "byte.invalid" {

        println("FAIL: BYTES-001B_invalid"); return 1
    }
    let closedBorrow = borrowed.close()
    if closedBorrow.isErr() { println("FAIL: BYTES-001B_invalid"); return 1 }
    println("PASS: BYTES-001B_invalid")

    let tooLarge: Result<ByteBuffer, IoError> =
        tryByteBufferWithCapacity(1073741825, 32)
    if not tooLarge.isErr() or tooLarge.unwrapErr().code.value != "byte.limit" {
        println("FAIL: BYTES-001B_limit"); return 1
    }
    println("PASS: BYTES-001B_limit")

    let cancelled = buffer.sliceInContext(byteStorageContext(true), 0, 1)
    if not cancelled.isErr() or
        cancelled.unwrapErr().code.value != "byte.cancelled" {

        println("FAIL: BYTES-001B_cancel"); return 1
    }
    println("PASS: BYTES-001B_cancel")

    let staleResult = buffer.slice(0, 1)
    if staleResult.isErr() { println("FAIL: BYTES-001B_cleanup"); return 1 }
    let stale = staleResult.unwrap()
    let firstRelease = buffer.release()
    let secondRelease = buffer.release()
    let staleRead = stale.get(0)
    if firstRelease.isErr() or secondRelease.isErr() or
        not firstRelease.unwrap() or secondRelease.unwrap() or
        buffer.capacity() != 0 or buffer.alignment() != 0 or
        not staleRead.isErr() or staleRead.unwrapErr().code.value != "byte.invalid" {

        println("FAIL: BYTES-001B_cleanup"); return 1
    }
    println("PASS: BYTES-001B_cleanup")
    return 0
}

main()
