import seen_compiler.imports.graph.{ModuleImportGraph,
    GlobalInitializationPlan, newModuleImportGraph,
    moduleImportGraphBeginModule, moduleImportGraphAddEdge,
    planDeterministicGlobalInitialization,
    renderGlobalInitializationPlan}
import core.error.{AsciiString, RetryClass, RedactionClass}
import core.operation_context.{OperationLimits, OperationContext}

fun initializationPaths() r: Array<String> {
    let paths = Array<String>()
    paths.push("app.seen")
    paths.push("lib/alpha.seen")
    paths.push("lib/beta.seen")
    paths.push("lib/leaf.seen")
    return paths
}

fun initializationContext(cancelled: Bool, maxModules: Int)
    r: OperationContext {

    return OperationContext{
        cancellation: cancelled,
        monotonicDeadline: 0,
        limits: OperationLimits{
            maxTargets: 32,
            maxIdentityBytes: 128,
            maxVersionBytes: 64,
            maxManifestBytes: 65536,
            maxPathBytes: 4096,
            maxGraphModules: maxModules,
            maxGraphEdges: 64,
            maxGraphDepth: 16
        },
        traceId: AsciiString{ value: "core-003b-test" }
    }
}

fun initializationDiamond(reverseRootEdges: Bool) r: ModuleImportGraph {
    let graph = newModuleImportGraph(4)
    moduleImportGraphBeginModule(graph, 0)
    if reverseRootEdges {
        moduleImportGraphAddEdge(graph, 0, 2)
        moduleImportGraphAddEdge(graph, 0, 1)
    } else {
        moduleImportGraphAddEdge(graph, 0, 1)
        moduleImportGraphAddEdge(graph, 0, 2)
    }
    moduleImportGraphBeginModule(graph, 1)
    moduleImportGraphAddEdge(graph, 1, 3)
    moduleImportGraphBeginModule(graph, 2)
    moduleImportGraphAddEdge(graph, 2, 3)
    moduleImportGraphBeginModule(graph, 3)
    return graph
}

fun initializationOrderIsDependencyFirst(value: GlobalInitializationPlan)
    r: Bool {

    return value.orderedIndices.length() == 4 and
        value.orderedIndices[0] == 3 and value.orderedIndices[1] == 1 and
        value.orderedIndices[2] == 2 and value.orderedIndices[3] == 0
}

fun main() r: Int {
    let happy = planDeterministicGlobalInitialization(
        initializationPaths(), initializationDiamond(true),
        "linux-x86_64", initializationContext(false, 16))
    if happy.isErr() or
        not initializationOrderIsDependencyFirst(happy.unwrap()) {

        return 1
    }
    let repeated = planDeterministicGlobalInitialization(
        initializationPaths(), initializationDiamond(false),
        "linux-x86_64", initializationContext(false, 16))
    if repeated.isErr() or
        renderGlobalInitializationPlan(repeated.unwrap()) !=
            renderGlobalInitializationPlan(happy.unwrap()) {

        return 2
    }
    println("PASS: CORE-003B_happy")

    let duplicatePaths = initializationPaths()
    duplicatePaths[2] = "lib/alpha.seen"
    let invalid = planDeterministicGlobalInitialization(
        duplicatePaths, initializationDiamond(false), "linux-x86_64",
        initializationContext(false, 16))
    if not invalid.isErr() or
        invalid.unwrapErr().code.value != "core.003b.invalid" or
        invalid.unwrapErr().subsystem.value != "compiler.initialization" or
        invalid.unwrapErr().retry != RetryClass.Never or
        invalid.unwrapErr().redaction != RedactionClass.Public {

        return 3
    }
    let unsupported = planDeterministicGlobalInitialization(
        initializationPaths(), initializationDiamond(false), "plan9",
        initializationContext(false, 16))
    if not unsupported.isErr() or
        unsupported.unwrapErr().code.value != "core.003b.platform" {

        return 4
    }
    println("PASS: CORE-003B_invalid")

    let limited = planDeterministicGlobalInitialization(
        initializationPaths(), initializationDiamond(false),
        "linux-x86_64", initializationContext(false, 1))
    if not limited.isErr() or
        limited.unwrapErr().code.value != "core.003b.limit" {

        return 5
    }
    println("PASS: CORE-003B_limit")

    let cancelled = planDeterministicGlobalInitialization(
        initializationPaths(), initializationDiamond(false),
        "linux-x86_64", initializationContext(true, 16))
    if not cancelled.isErr() or
        cancelled.unwrapErr().code.value != "core.003b.cancelled" {

        return 6
    }
    println("PASS: CORE-003B_cancel")

    let rendered = renderGlobalInitializationPlan(happy.unwrap())
    if rendered != renderGlobalInitializationPlan(repeated.unwrap()) or
        not rendered.contains(
            "\"schema\": \"seen-global-initialization-plan-v1\"") {

        return 7
    }
    println("PASS: CORE-003B_cleanup")
    return 0
}

main()
