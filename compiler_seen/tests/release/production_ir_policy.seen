import seen_compiler.imports.graph.{ProductionIrPlan,
    validateUnmodifiedProductionIr, renderProductionIrPlan}
import release.compatibility.{AsciiString, OperationLimits, OperationContext,
    RetryClass, RedactionClass}

fun irPolicyContext(cancelled: Bool, maxArtifacts: Int) r: OperationContext {
    return OperationContext{
        cancellation: cancelled,
        monotonicDeadline: 0,
        limits: OperationLimits{
            maxTargets: 32,
            maxIdentityBytes: 128,
            maxVersionBytes: 64,
            maxManifestBytes: 65536,
            maxPathBytes: 4096,
            maxGraphModules: maxArtifacts,
            maxGraphEdges: 64,
            maxGraphDepth: 16
        },
        traceId: AsciiString{ value: "core-003c-test" }
    }
}

fun irPaths() r: Array<String> {
    let paths = Array<String>()
    paths.push("modules/zeta.ll")
    paths.push("modules/alpha.ll")
    return paths
}

fun irHashes(secondChanged: Bool) r: Array<String> {
    let hashes = Array<String>()
    hashes.push("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    if secondChanged {
        hashes.push("cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc")
    } else {
        hashes.push("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
    }
    return hashes
}

fun irPlanIsCanonical(value: ProductionIrPlan) r: Bool {
    return value.artifactCount == 2 and not value.repairAllowed and
        value.orderedPaths.length() == 2 and
        value.orderedPaths[0] == "modules/alpha.ll" and
        value.orderedPaths[1] == "modules/zeta.ll"
}

fun main() r: Int {
    let happy = validateUnmodifiedProductionIr(
        irPaths(), irHashes(false), irHashes(false), false,
        "linux-x86_64", irPolicyContext(false, 16))
    if happy.isErr() or not irPlanIsCanonical(happy.unwrap()) {
        return 1
    }
    let repeated = validateUnmodifiedProductionIr(
        irPaths(), irHashes(false), irHashes(false), false,
        "linux-x86_64", irPolicyContext(false, 16))
    if repeated.isErr() or renderProductionIrPlan(repeated.unwrap()) !=
        renderProductionIrPlan(happy.unwrap()) {

        return 2
    }
    println("PASS: CORE-003C_happy")

    let changed = validateUnmodifiedProductionIr(
        irPaths(), irHashes(false), irHashes(true), false,
        "linux-x86_64", irPolicyContext(false, 16))
    if not changed.isErr() or
        changed.unwrapErr().code.value != "core.003c.invalid" or
        changed.unwrapErr().subsystem.value != "compiler.ir" or
        changed.unwrapErr().retry != RetryClass.Never or
        changed.unwrapErr().redaction != RedactionClass.Public {

        return 3
    }
    let repair = validateUnmodifiedProductionIr(
        irPaths(), irHashes(false), irHashes(false), true,
        "linux-x86_64", irPolicyContext(false, 16))
    if not repair.isErr() or
        repair.unwrapErr().code.value != "core.003c.invalid" {

        return 4
    }
    let unsupported = validateUnmodifiedProductionIr(
        irPaths(), irHashes(false), irHashes(false), false,
        "plan9", irPolicyContext(false, 16))
    if not unsupported.isErr() or
        unsupported.unwrapErr().code.value != "core.003c.platform" {

        return 5
    }
    println("PASS: CORE-003C_invalid")

    let limited = validateUnmodifiedProductionIr(
        irPaths(), irHashes(false), irHashes(false), false,
        "linux-x86_64", irPolicyContext(false, 1))
    if not limited.isErr() or
        limited.unwrapErr().code.value != "core.003c.limit" {

        return 6
    }
    println("PASS: CORE-003C_limit")

    let cancelled = validateUnmodifiedProductionIr(
        irPaths(), irHashes(false), irHashes(false), false,
        "linux-x86_64", irPolicyContext(true, 16))
    if not cancelled.isErr() or
        cancelled.unwrapErr().code.value != "core.003c.cancelled" {

        return 7
    }
    println("PASS: CORE-003C_cancel")

    let rendered = renderProductionIrPlan(happy.unwrap())
    if rendered != renderProductionIrPlan(repeated.unwrap()) or
        not rendered.contains("\"repair_allowed\": false") or
        not rendered.contains("\"schema\": \"seen-production-ir-policy-v1\"") {

        return 8
    }
    println("PASS: CORE-003C_cleanup")
    return 0
}

main()
