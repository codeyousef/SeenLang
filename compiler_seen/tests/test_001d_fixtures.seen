import seen_compiler.testing.fixture.{FixtureFile, FixtureEnvironment,
    FixtureRequest, planFixtureChecked, fixtureCleanupPath, renderFixturePlan}
import release.compatibility.{AsciiString, OperationLimits, OperationContext}

fun test001dContext() r: OperationContext {
    return OperationContext{
        cancellation: false, monotonicDeadline: 0,
        limits: OperationLimits{
            maxTargets: 32, maxIdentityBytes: 128, maxVersionBytes: 64,
            maxManifestBytes: 65536, maxPathBytes: 4096,
            maxGraphModules: 64, maxGraphEdges: 32, maxGraphDepth: 16
        }, traceId: AsciiString{ value: "test-001d" }
    }
}

fun test001dRequest() r: FixtureRequest {
    let files = Array<FixtureFile>()
    files.push(FixtureFile{path: "input/a.txt", content: "alpha\n"})
    files.push(FixtureFile{path: "input/b.txt", content: "beta\n"})
    let environment = Array<FixtureEnvironment>()
    environment.push(FixtureEnvironment{name: "LANG", value: "C"})
    environment.push(FixtureEnvironment{name: "SEEN_TEST_MODE", value: "ci"})
    environment.push(FixtureEnvironment{name: "TZ", value: "UTC"})
    return FixtureRequest{
        name: "deterministic-case", seed: 1101, target: "linux-x86_64",
        files: files, environment: environment
    }
}

fun main() r: Int {
    let happy = planFixtureChecked(test001dRequest(), test001dContext())
    if not happy.success or happy.values[0].files.length() != 2 or
        happy.values[0].environment.length() != 3 or
        happy.values[0].root !=
            ".seen_cache/test/fixtures/deterministic-case" {

        println("FAIL: TEST-001D_happy")
        return 1
    }
    println("PASS: TEST-001D_happy")

    var invalidRequest = test001dRequest()
    invalidRequest.files[0].path = "../escape"
    let invalid = planFixtureChecked(invalidRequest, test001dContext())
    if invalid.success or invalid.errors[0].code.value != "test.001d.invalid" {
        println("FAIL: TEST-001D_invalid")
        return 1
    }
    println("PASS: TEST-001D_invalid")

    var limitContext = test001dContext()
    limitContext.limits.maxManifestBytes = 4
    let limited = planFixtureChecked(test001dRequest(), limitContext)
    if limited.success or limited.errors[0].code.value != "test.001d.limit" {
        println("FAIL: TEST-001D_limit")
        return 1
    }
    println("PASS: TEST-001D_limit")

    var cancelContext = test001dContext()
    cancelContext.cancellation = true
    let cancelled = planFixtureChecked(test001dRequest(), cancelContext)
    if cancelled.success or
        cancelled.errors[0].code.value != "test.001d.cancelled" {

        println("FAIL: TEST-001D_cancel")
        return 1
    }
    println("PASS: TEST-001D_cancel")

    let rendered = renderFixturePlan(happy.values[0])
    if not rendered.contains("seen-test-fixture-v1") or
        not rendered.contains("\"seed\":1101") or
        fixtureCleanupPath(happy.values[0]) != happy.values[0].root {

        println("FAIL: TEST-001D_cleanup")
        return 1
    }
    println("PASS: TEST-001D_cleanup")
    return 0
}

main()
