fun testGlobalInferenceProvenance() r: Void {
    let registry = SemanticDeclarationRegistry.new()
    let unresolved = ProgramNode.new()
    let item = ItemNode.new()
    item.itemType = "GlobalVar"
    item.name = "mystery"
    item.visibility = "LUnknown:"
    item.line = 7
    item.column = 5
    unresolved.items.push(item)
    let checked = runLexicalSemanticPass(unresolved, "globals",
        "globals.seen", registry)
    semanticExpect(not checked.success,
        "unresolved top-level global inference fails closed")
    semanticExpect(checked.diagnostics[0].code ==
        "E_GLOBAL_TYPE_INFERENCE", "global inference diagnostic code")
    semanticExpect(checked.diagnostics[0].location.line == 7 and
        checked.diagnostics[0].location.column == 5,
        "global inference diagnostic preserves location")

    let explicitRegistry = SemanticDeclarationRegistry.new()
    let explicit = ProgramNode.new()
    let explicitItem = ItemNode.new()
    explicitItem.itemType = "GlobalVar"
    explicitItem.name = "count"
    explicitItem.visibility = "LInt:"
    explicit.items.push(explicitItem)
    semanticExpect(runLexicalSemanticPass(explicit, "globals",
        "globals.seen", explicitRegistry).success,
        "explicit top-level global type remains valid")
}

