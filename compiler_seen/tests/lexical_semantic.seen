    testRegistryAndScopes()
    testMoveOnlyOwnedBindings()
    testCrossModulePass()
    testForwardCrossModulePass()
    testFailClosedTypes()
    testGenericDefinitionsRemainSymbolic()
    testUserDefinedGenericTypeArity()
    testImportBoundariesAndAmbiguity()
    testImportQualifiedIdentities()
    testEncodedDeclarationKinds()
    testPackageAwareModuleIdentities()
    testSupportedEncodedTypes()
    testGlobalInferenceProvenance()
    testUnresolvedInferenceIdentity()
    testKnownAndUnknownAssignmentTraversal()
    testDiscardBindingsRemainNonbinding()
    testReservedNullValueLiteral()
    testStringBuilderBootstrapBuiltin()
    testTopLevelExtensionReceiverBinding()
    testImplicitOwningFieldBindings()
    testInheritedImplicitFieldBindings()
    testStaticMethodInstanceBindingsRejected()
    testLifecyclePropertyFoundation()
    testCanonicalFoundationResolution()
    testLifecyclePropertyFailures()
    testCrossModuleLifecycleProperties()
    testLifecyclePropertyCyclesAndIndirection()
    testRetainedSendShareGenericBounds()
    testTypedImmutableParallelCaptures()
    testAmbientParallelCaptures()
    return 0
}

main()
