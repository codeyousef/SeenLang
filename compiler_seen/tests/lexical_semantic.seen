import parser.real_parser.{ProgramNode, ItemNode, ClassNode, FunctionNode}
import parser.real_parser.{ParamNode, TypeNode, AnnotationNode, ImportSymbolNode}
import parser.real_parser.{StatementNode, ParserExpressionNode}
import typechecker.lexical_semantic.{runLexicalSemanticPass}
import typechecker.lexical_semantic.{collectLexicalSemanticModule}
import typechecker.lexical_semantic.{checkLexicalSemanticModule}
import typechecker.lexical_semantic.{resolveSemanticType, LexicalSemanticResult}
import typechecker.lexical_semantic.{requireConcreteSemanticType}
import typechecker.semantic_registry.{SemanticDeclarationRegistry}
import typechecker.semantic_registry.{ScopedBindings}
import typechecker.semantic_registry.{semanticNormalizeModuleIdentity}
import typechecker.semantic_registry.{semanticBuiltinLifecycleProperty}
import typechecker.semantic_registry.{semanticFoundationThreadProperty}

fun semanticExpect(condition: Bool, message: String) r: Void {
    if not condition { abort(message) }
}

fun semanticType(name: String) r: TypeNode {
    return TypeNode{ typeName: name, isNullable: false }
}

fun semanticClassProgram(name: String, fieldName: String, fieldType: String,
    decoratorName: String) r: ProgramNode {

    let program = ProgramNode.new()
    let item = ItemNode.new()
    item.itemType = "Class"
    item.name = name
    item.classNode = ClassNode.new()
    item.classNode.name = name
    item.line = 1
    item.column = 1
    let field = ParamNode.new()
    field.name = fieldName
    field.paramType = semanticType(fieldType)
    field.line = 1
    field.column = 20
    item.classNode.fields.push(field)
    if decoratorName != "" {
        let decorator = AnnotationNode.new(decoratorName)
        decorator.arguments.push("wire")
        item.classNode.decorators.push(decorator)
    }
    program.items.push(item)
    return program
}

fun semanticFunctionProgram(name: String, parameterType: String,
    returnType: String) r: ProgramNode {

    let program = ProgramNode.new()
    let item = ItemNode.new()
    item.itemType = "Function"
    item.name = name
    item.function = FunctionNode.new()
    item.function.name = name
    item.function.line = 1
    item.function.column = 1
    item.function.returnType = semanticType(returnType)
    let parameter = ParamNode.new()
    parameter.name = "value"
    parameter.paramType = semanticType(parameterType)
    parameter.line = 1
    parameter.column = 9
    item.function.params.push(parameter)
    program.items.push(item)
    return program
}

fun semanticImport(moduleName: String, symbolName: String, alias: String)
    r: ItemNode {

    let item = ItemNode.new()
    item.itemType = "Import"
    item.name = moduleName
    if symbolName != "" {
        let symbol = ImportSymbolNode.new()
        symbol.name = symbolName
        symbol.alias = alias
        item.importSymbols.push(symbol)
    }
    return item
}

fun semanticVariable(name: String) r: ParserExpressionNode {
    let expression = ParserExpressionNode.new()
    expression.kind = "VarExpr"
    expression.variableName = name
    return expression
}

fun testRegistryAndScopes() r: Void {
    let registry = SemanticDeclarationRegistry.new()
    semanticExpect(registry.registerDeclaration("alpha", "User", "Class",
        "alpha::User", "alpha.seen", 2, 3), "register alpha.User")
    semanticExpect(registry.resolveTypeBase("beta", "User") == "",
        "unimported cross-module type is not visible")
    registry.registerImport("beta", "User", "alpha", "User")
    semanticExpect(registry.resolveTypeBase("beta", "User") == "alpha::User",
        "selected import resolves canonically")

    let args = Array<String>()
    args.push("wire")
    registry.registerDecorator("alpha::User", "derive", args)
    semanticExpect(registry.hasDecorator("alpha::User", "derive"),
        "decorator metadata is queryable")

    let bindings = ScopedBindings.new()
    semanticExpect(bindings.define("value", "Int", false, "scope.seen", 1,
        1), "define outer binding")
    bindings.beginScope()
    semanticExpect(bindings.define("value", "String", false, "scope.seen", 2,
        5), "nested scope may shadow")
    semanticExpect(bindings.lookup("value") == "String",
        "inner binding wins")
    semanticExpect(bindings.markMoved("value") and
        bindings.moveState("value") == 1,
        "inner ownership state is tracked")
    bindings.endScope()
    semanticExpect(bindings.lookup("value") == "Int",
        "ending scope restores outer binding")
    semanticExpect(bindings.moveState("value") == 0,
        "ending scope restores outer ownership state")
}

fun semanticOwnedProgram(decoratorName: String) r: ProgramNode {
    let program = ProgramNode.new()
    let resource = semanticClassProgram("OwnedHandle", "handle", "Int", "")
    resource.items[0].classNode.decorators.push(
        AnnotationNode.new(decoratorName))
    program.items.push(resource.items[0])
    let entry = semanticFunctionProgram("exercise", "OwnedHandle", "Int")
    program.items.push(entry.items[0])
    return program
}

fun semanticConsumeStatement(name: String) r: StatementNode {
    let statement = StatementNode.new()
    statement.kind = "Expression"
    statement.expression.kind = "Call"
    statement.expression.callee = "consumeOwned"
    statement.expression.arguments.push(semanticVariable(name))
    return statement
}

fun semanticOwnedMemberReturn(name: String) r: StatementNode {
    let statement = StatementNode.new()
    statement.kind = "Return"
    statement.returnValue.kind = "MemberAccess"
    statement.returnValue.literalValue = name
    statement.returnValue.variableName = "handle"
    return statement
}

fun testMoveOnlyOwnedBindings() r: Void {
    let registry = SemanticDeclarationRegistry.new()
    let moved = semanticOwnedProgram("move")
    moved.items[1].function.body.statements.push(
        semanticConsumeStatement("value"))
    moved.items[1].function.body.statements.push(
        semanticOwnedMemberReturn("value"))
    let movedChecked = runLexicalSemanticPass(moved, "owned_move",
        "owned-move.seen", registry)
    semanticExpect(not movedChecked.success and
        movedChecked.diagnostics.length() == 1 and
        movedChecked.diagnostics[0].code == "E_OWNERSHIP_USE_AFTER_MOVE",
        "@move arguments reject deterministic use after transfer")

    let conditionalRegistry = SemanticDeclarationRegistry.new()
    let conditional = semanticOwnedProgram("move")
    let branch = StatementNode.new()
    branch.kind = "If"
    branch.condition.kind = "Literal"
    branch.condition.literalType = "Bool"
    branch.condition.literalValue = "true"
    branch.thenBranch.statements.push(semanticConsumeStatement("value"))
    conditional.items[1].function.body.statements.push(branch)
    conditional.items[1].function.body.statements.push(
        semanticOwnedMemberReturn("value"))
    let conditionalChecked = runLexicalSemanticPass(conditional,
        "owned_conditional", "owned-conditional.seen", conditionalRegistry)
    semanticExpect(not conditionalChecked.success and
        conditionalChecked.diagnostics.length() == 1 and
        conditionalChecked.diagnostics[0].code ==
            "E_OWNERSHIP_POSSIBLY_MOVED",
        "control-flow joins retain possible ownership transfer")

    let resourceRegistry = SemanticDeclarationRegistry.new()
    let resource = semanticOwnedProgram("c_resource")
    resource.items[1].function.body.statements.push(
        semanticConsumeStatement("value"))
    resource.items[1].function.body.statements.push(
        semanticOwnedMemberReturn("value"))
    let resourceChecked = runLexicalSemanticPass(resource,
        "owned_resource", "owned-resource.seen", resourceRegistry)
    semanticExpect(not resourceChecked.success and
        resourceChecked.diagnostics[0].code ==
            "E_OWNERSHIP_USE_AFTER_MOVE",
        "@c_resource handles are move-only owners")

    let aliasRegistry = SemanticDeclarationRegistry.new()
    let alias = semanticOwnedProgram("move")
    let transfer = StatementNode.new()
    transfer.kind = "Let"
    transfer.variableName = "transferred"
    transfer.variableType = semanticType("OwnedHandle")
    transfer.initializer = semanticVariable("value")
    alias.items[1].function.body.statements.push(transfer)
    alias.items[1].function.body.statements.push(
        semanticOwnedMemberReturn("value"))
    let aliasChecked = runLexicalSemanticPass(alias, "owned_alias",
        "owned-alias.seen", aliasRegistry)
    semanticExpect(not aliasChecked.success and
        aliasChecked.diagnostics[0].code ==
            "E_OWNERSHIP_USE_AFTER_MOVE",
        "assignment transfers rather than aliases an owned binding")

    let inferenceRegistry = SemanticDeclarationRegistry.new()
    let inferred = semanticOwnedProgram("move")
    inferred.items[1].function.params.pop()
    let acquire = StatementNode.new()
    acquire.kind = "Let"
    acquire.variableName = "created"
    acquire.variableType = semanticType("Unknown")
    acquire.initializer.kind = "Call"
    acquire.initializer.callee = "OwnedHandle"
    inferred.items[1].function.body.statements.push(acquire)
    inferred.items[1].function.body.statements.push(
        semanticConsumeStatement("created"))
    inferred.items[1].function.body.statements.push(
        semanticOwnedMemberReturn("created"))
    let inferredChecked = runLexicalSemanticPass(inferred,
        "owned_inference", "owned-inference.seen", inferenceRegistry)
    semanticExpect(not inferredChecked.success and
        inferredChecked.diagnostics[0].code ==
            "E_OWNERSHIP_USE_AFTER_MOVE",
        "constructor inference retains move-only identity")

    let completionRegistry = SemanticDeclarationRegistry.new()
    let completionCanonical =
        "seen_std.src.reactor.reactor::BlockingCompletion"
    semanticExpect(completionRegistry.registerDeclaration(
        "seen_std.src.reactor.reactor", "BlockingCompletion", "Class",
        completionCanonical, "seen_std/src/reactor/reactor.seen", 557, 1),
        "register canonical blocking completion")
    completionRegistry.registerResolvedImportModule("completion_owner",
        "reactor.reactor", "seen_std.src.reactor.reactor")
    let completion = semanticFunctionProgram("consumeCompletion",
        "CompletionSnapshot", "Int")
    completion.items.push(semanticImport("reactor.reactor",
        "BlockingCompletion", "CompletionSnapshot"))
    completion.items[0].function.body.statements.push(
        semanticConsumeStatement("value"))
    completion.items[0].function.body.statements.push(
        semanticOwnedMemberReturn("value"))
    let completionChecked = runLexicalSemanticPass(completion,
        "completion_owner", "completion-owner.seen", completionRegistry)
    semanticExpect(not completionChecked.success and
        completionChecked.diagnostics.length() == 1 and
        completionChecked.diagnostics[0].code ==
            "E_OWNERSHIP_USE_AFTER_MOVE",
        "canonical mutable completion is Send only through one-owner transfer")

    let genericRegistry = SemanticDeclarationRegistry.new()
    let genericProgram = ProgramNode.new()
    let genericOwner = semanticClassProgram("GenericOwner", "payload", "T",
        "")
    let genericParameter = AnnotationNode.new("generic_parameter")
    genericParameter.arguments.push("T")
    genericParameter.arguments.push("")
    genericOwner.items[0].classNode.decorators.push(genericParameter)
    genericOwner.items[0].classNode.decorators.push(AnnotationNode.new("move"))
    genericProgram.items.push(genericOwner.items[0])
    let genericFunction = semanticFunctionProgram("consumeGeneric",
        "GenericOwner<Int>", "Int")
    genericFunction.items[0].function.body.statements.push(
        semanticConsumeStatement("value"))
    genericFunction.items[0].function.body.statements.push(
        semanticOwnedMemberReturn("value"))
    genericProgram.items.push(genericFunction.items[0])
    let genericChecked = runLexicalSemanticPass(genericProgram,
        "generic_owner", "generic-owner.seen", genericRegistry)
    semanticExpect(not genericChecked.success and
        genericChecked.diagnostics.length() == 1 and
        genericChecked.diagnostics[0].code ==
            "E_OWNERSHIP_USE_AFTER_MOVE",
        "generic canonical identity retains its declaration move marker")
}

fun testCrossModulePass() r: Void {
    let registry = SemanticDeclarationRegistry.new()
    let alphaProgram = semanticClassProgram("User", "id", "Int", "derive")
    let alpha = runLexicalSemanticPass(alphaProgram,
        "alpha", "alpha.seen", registry)
    semanticExpect(alpha.success, "alpha semantic pass succeeds")
    semanticExpect(registry.hasDecorator("alpha::User", "derive"),
        "class decorator registered")

    let betaProgram = semanticClassProgram("Box", "item", "User", "")
    betaProgram.items.push(semanticImport("alpha", "User", ""))
    let identityItem = semanticFunctionProgram("identity", "User", "User")
    betaProgram.items.push(identityItem.items[0])
    let beta = runLexicalSemanticPass(betaProgram,
        "beta", "beta.seen", registry)
    semanticExpect(beta.success, "beta resolves alpha.User before lowering")
    semanticExpect(registry.resolveTypeBase("beta", "User") == "alpha::User",
        "cross-module identity remains canonical")
    semanticExpect(registry.findCanonical("beta::Box") >= 0,
        "beta declaration registered")
}

fun testForwardCrossModulePass() r: Void {
    let registry = SemanticDeclarationRegistry.new()
    let firstProgram = semanticClassProgram("Envelope", "payload", "Later",
        "")
    firstProgram.items.push(semanticImport("later", "Later", ""))
    let laterProgram = semanticClassProgram("Later", "value", "Int", "")

    let firstCollected = collectLexicalSemanticModule(firstProgram, "first",
        "first.seen", registry)
    let laterCollected = collectLexicalSemanticModule(laterProgram, "later",
        "later.seen", registry)
    semanticExpect(firstCollected.success and laterCollected.success,
        "all module declarations collect before validation")

    let firstChecked = checkLexicalSemanticModule(firstProgram, "first",
        "first.seen", registry)
    let laterChecked = checkLexicalSemanticModule(laterProgram, "later",
        "later.seen", registry)
    semanticExpect(firstChecked.success and laterChecked.success,
        "forward cross-module type resolves from complete registry")
    semanticExpect(registry.resolveTypeBase("first", "Later") ==
        "later::Later", "forward type gets canonical later-module identity")
}

fun testFailClosedTypes() r: Void {
    let registry = SemanticDeclarationRegistry.new()
    let unknownProgram = semanticFunctionProgram("bad", "Missing", "Int")
    let unknown = runLexicalSemanticPass(unknownProgram,
        "bad", "unknown.seen", registry)
    semanticExpect(not unknown.success, "unknown type must fail")
    semanticExpect(unknown.diagnostics.length() == 1,
        "unknown type emits one focused diagnostic")
    semanticExpect(unknown.diagnostics[0].code == "E_TYPE_UNKNOWN",
        "unknown type diagnostic code")
    semanticExpect(unknown.diagnostics[0].location.file == "unknown.seen",
        "unknown type preserves source file")

    let genericRegistry = SemanticDeclarationRegistry.new()
    let genericResult = LexicalSemanticResult.new(genericRegistry)
    let genericNames = Array<String>()
    genericNames.push("T")
    genericRegistry.registerGenericParameter("generic::root", "T", "")
    let identity = requireConcreteSemanticType(genericResult, "Option<T>",
        "generic.seen", 8, 12, "generic", "generic::root", genericNames)
    semanticExpect(identity == "", "open generic has no lowering identity")
    semanticExpect(not genericResult.success,
        "open generic fails before lowering")
    semanticExpect(genericResult.diagnostics[0].code ==
        "E_TYPE_OPEN_GENERIC", "open generic diagnostic code")
    semanticExpect(genericResult.diagnostics[0].location.line == 8 and
        genericResult.diagnostics[0].location.column == 12,
        "open generic preserves source coordinates")
    semanticExpect(genericRegistry.isGenericParameter("generic::root", "T"),
        "explicit generic parameter metadata is preserved")

    let concreteRegistry = SemanticDeclarationRegistry.new()
    let concreteT = semanticClassProgram("T", "value", "Int", "")
    semanticExpect(runLexicalSemanticPass(concreteT, "concrete",
        "concrete.seen", concreteRegistry).success,
        "one-letter concrete T is not guessed to be an open generic")
}

fun testGenericDefinitionsRemainSymbolic() r: Void {
    let registry = SemanticDeclarationRegistry.new()
    let box = semanticClassProgram("Box", "value", "T", "")
    let typeParameter = AnnotationNode.new("generic_parameter")
    typeParameter.arguments.push("T")
    typeParameter.arguments.push("")
    box.items[0].classNode.decorators.push(typeParameter)

    let identity = semanticFunctionProgram("id", "U", "U")
    let functionParameter = AnnotationNode.new("generic_parameter")
    functionParameter.arguments.push("U")
    functionParameter.arguments.push("comptime")
    identity.items[0].function.decorators.push(functionParameter)
    box.items.push(identity.items[0])

    let collected = collectLexicalSemanticModule(box, "generics",
        "generics.seen", registry)
    let checked = checkLexicalSemanticModule(box, "generics",
        "generics.seen", registry)
    semanticExpect(collected.success and checked.success,
        "generic definitions preserve symbolic types during checking")
    semanticExpect(registry.isGenericParameter("generics::Box", "T"),
        "class generic belongs to its declaration")
    semanticExpect(registry.isGenericParameter("generics::id", "U"),
        "function generic belongs to its declaration")
    semanticExpect(registry.genericParameterModifier("generics::id", "U") ==
        "comptime", "structured generic modifier is preserved")

    let demand = LexicalSemanticResult.new(registry)
    let names = Array<String>()
    names.push("T")
    let concrete = requireConcreteSemanticType(demand, "Box<T>",
        "root.seen", 9, 4, "generics", "generics::Box", names)
    semanticExpect(concrete == "" and not demand.success,
        "unspecialized generic concrete demand fails")
    semanticExpect(demand.diagnostics[0].code == "E_TYPE_OPEN_GENERIC",
        "concrete-demand diagnostic is explicit")
}

fun testUserDefinedGenericTypeArity() r: Void {
    let registry = SemanticDeclarationRegistry.new()
    semanticExpect(registry.registerDeclaration("types", "Envelope", "Class",
        "types::Envelope", "types.seen", 1, 1), "register generic Envelope")
    registry.registerGenericParameter("types::Envelope", "T", "")
    semanticExpect(registry.registerDeclaration("types", "Plain", "Class",
        "types::Plain", "types.seen", 2, 1), "register non-generic Plain")
    semanticExpect(registry.registerDeclaration("types", "Matrix", "Class",
        "types::Matrix", "types.seen", 3, 1), "register generic Matrix")
    registry.registerGenericParameter("types::Matrix", "T", "")
    registry.registerGenericParameter("types::Matrix", "N", "const")
    registry.registerGenericParameter("types::Matrix", "Mode", "comptime")
    semanticExpect(registry.registerDeclaration("types", "Bundle", "Class",
        "types::Bundle", "types.seen", 4, 1), "register variadic Bundle")
    registry.registerGenericParameter("types::Bundle", "Head", "")
    registry.registerGenericParameter("types::Bundle", "Tail", "variadic")

    registry.registerImport("consumer", "Envelope", "types", "Envelope")
    registry.registerImport("consumer", "Parcel", "types", "Envelope")
    registry.registerImport("consumer", "Plain", "types", "Plain")
    registry.registerImport("consumer", "Matrix", "types", "Matrix")
    registry.registerImport("consumer", "Bundle", "types", "Bundle")
    let noGenerics = Array<String>()

    let fixed = LexicalSemanticResult.new(registry)
    semanticExpect(resolveSemanticType(fixed, "Envelope<Int>", "use.seen",
        5, 7, "consumer", noGenerics) == "types::Envelope<Int>" and
        fixed.success, "user generic accepts its declared arity")
    let aliased = LexicalSemanticResult.new(registry)
    semanticExpect(resolveSemanticType(aliased, "Parcel<String>", "use.seen",
        6, 7, "consumer", noGenerics) == "types::Envelope<String>" and
        aliased.success, "import alias uses canonical declaration arity")

    let missing = LexicalSemanticResult.new(registry)
    semanticExpect(resolveSemanticType(missing, "Envelope", "use.seen", 11,
        13, "consumer", noGenerics) == "" and not missing.success,
        "missing user generic argument fails")
    semanticExpect(missing.diagnostics.length() == 1 and
        missing.diagnostics[0].code == "E_TYPE_ARITY",
        "missing user generic argument has one arity diagnostic")
    semanticExpect(missing.diagnostics[0].location.line == 11 and
        missing.diagnostics[0].location.column == 13,
        "user generic arity diagnostic preserves source coordinates")

    let surplus = LexicalSemanticResult.new(registry)
    semanticExpect(resolveSemanticType(surplus, "Envelope<Int,String>",
        "use.seen", 12, 3, "consumer", noGenerics) == "" and
        surplus.diagnostics[0].code == "E_TYPE_ARITY",
        "surplus user generic argument fails")
    let nongeneric = LexicalSemanticResult.new(registry)
    semanticExpect(resolveSemanticType(nongeneric, "Plain<Int>", "use.seen",
        13, 3, "consumer", noGenerics) == "" and
        nongeneric.diagnostics[0].code == "E_TYPE_ARITY",
        "type arguments on a non-generic declaration fail")

    semanticExpect(registry.genericParameterCountForOwner("types::Matrix") ==
        3 and registry.genericParameterModifierAtForOwner("types::Matrix", 1) ==
        "const" and registry.genericParameterModifierAtForOwner(
        "types::Matrix", 2) == "comptime",
        "const and comptime generic parameters occupy arity slots")
    let qualified = LexicalSemanticResult.new(registry)
    semanticExpect(resolveSemanticType(qualified, "Matrix<Int,4,8>",
        "use.seen", 14, 3, "consumer", noGenerics) ==
        "types::Matrix<Int,4,8>" and qualified.success,
        "const and comptime arguments satisfy user generic arity")
    let qualifiedMissing = LexicalSemanticResult.new(registry)
    semanticExpect(resolveSemanticType(qualifiedMissing, "Matrix<Int,4>",
        "use.seen", 14, 9, "consumer", noGenerics) == "" and
        qualifiedMissing.diagnostics[0].code == "E_TYPE_ARITY",
        "missing const or comptime argument fails user generic arity")

    semanticExpect(registry.hasFinalVariadicGenericParameter("types::Bundle"),
        "final variadic generic metadata is queryable")
    let variadicMinimum = LexicalSemanticResult.new(registry)
    semanticExpect(resolveSemanticType(variadicMinimum, "Bundle<Int>",
        "use.seen", 15, 3, "consumer", noGenerics) ==
        "types::Bundle<Int>" and variadicMinimum.success,
        "final variadic generic accepts its fixed minimum")
    let variadic = LexicalSemanticResult.new(registry)
    semanticExpect(resolveSemanticType(variadic, "Bundle<Int,String,Bool>",
        "use.seen", 15, 3, "consumer", noGenerics) ==
        "types::Bundle<Int,String,Bool>" and variadic.success,
        "final variadic generic accepts surplus arguments")
    let variadicMissing = LexicalSemanticResult.new(registry)
    semanticExpect(resolveSemanticType(variadicMissing, "Bundle", "use.seen",
        16, 3, "consumer", noGenerics) == "" and
        variadicMissing.diagnostics[0].code == "E_TYPE_ARITY",
        "final variadic generic still requires fixed parameters")

    semanticExpect(registry.registerDeclaration("consumer", "Box", "Class",
        "consumer::Box", "use.seen", 20, 1), "register shadowing Box")
    let builtin = LexicalSemanticResult.new(registry)
    semanticExpect(resolveSemanticType(builtin, "Box<Int>", "use.seen", 21,
        3, "consumer", noGenerics) == "Box<Int>" and builtin.success,
        "builtin generic names explicitly retain precedence")
}

fun testImportBoundariesAndAmbiguity() r: Void {
    let registry = SemanticDeclarationRegistry.new()
    let left = semanticClassProgram("Shared", "value", "Int", "")
    let right = semanticClassProgram("Shared", "value", "String", "")
    semanticExpect(collectLexicalSemanticModule(left, "left", "left.seen",
        registry).success, "collect left.Shared")
    semanticExpect(collectLexicalSemanticModule(right, "right", "right.seen",
        registry).success, "collect right.Shared")

    let consumer = semanticClassProgram("Consumer", "value", "Shared", "")
    semanticExpect(collectLexicalSemanticModule(consumer, "consumer",
        "consumer.seen", registry).success, "collect consumer")
    let checked = checkLexicalSemanticModule(consumer, "consumer",
        "consumer.seen", registry)
    semanticExpect(not checked.success, "unimported type must fail")
    semanticExpect(checked.diagnostics[0].code == "E_TYPE_UNKNOWN",
        "unimported type diagnostic code")

    let ambiguous = semanticClassProgram("Ambiguous", "value", "Shared", "")
    ambiguous.items.push(semanticImport("left", "Shared", ""))
    ambiguous.items.push(semanticImport("right", "Shared", ""))
    semanticExpect(collectLexicalSemanticModule(ambiguous, "ambiguous",
        "ambiguous.seen", registry).success, "collect ambiguous consumer")
    let ambiguousChecked = checkLexicalSemanticModule(ambiguous,
        "ambiguous", "ambiguous.seen", registry)
    semanticExpect(not ambiguousChecked.success,
        "two selected imports with one local alias must fail")
    semanticExpect(ambiguousChecked.diagnostics[0].code ==
        "E_TYPE_AMBIGUOUS", "ambiguous import diagnostic code")
}

fun testImportQualifiedIdentities() r: Void {
    let registry = SemanticDeclarationRegistry.new()
    let alpha = semanticClassProgram("User", "id", "Int", "")
    semanticExpect(collectLexicalSemanticModule(alpha, "alpha", "alpha.seen",
        registry).success, "collect imported declaration")

    let qualified = semanticClassProgram("Qualified", "user", "a.User", "")
    qualified.items.push(semanticImport("alpha", "*", "a"))
    semanticExpect(collectLexicalSemanticModule(qualified, "qualified",
        "qualified.seen", registry).success, "collect module alias")
    semanticExpect(checkLexicalSemanticModule(qualified, "qualified",
        "qualified.seen", registry).success,
        "module-qualified import resolves")

    let selected = semanticClassProgram("Selected", "user", "Person", "")
    selected.items.push(semanticImport("alpha", "User", "Person"))
    semanticExpect(collectLexicalSemanticModule(selected, "selected",
        "selected.seen", registry).success, "collect symbol alias")
    semanticExpect(checkLexicalSemanticModule(selected, "selected",
        "selected.seen", registry).success,
        "selected import identity resolves")
}

fun testEncodedDeclarationKinds() r: Void {
    let registry = SemanticDeclarationRegistry.new()
    let alias = semanticClassProgram("Meters", "", "", "type_alias")
    let traitProgram = semanticClassProgram("Drawable", "", "", "trait")
    semanticExpect(collectLexicalSemanticModule(alias, "types", "types.seen",
        registry).success, "collect type alias")
    semanticExpect(collectLexicalSemanticModule(traitProgram, "types",
        "types.seen", registry).success, "collect trait")
    let aliasIndex = registry.findCanonical("types::Meters")
    let traitIndex = registry.findCanonical("types::Drawable")
    semanticExpect(registry.kinds[aliasIndex] == "TypeAlias",
        "type alias kind exposed")
    semanticExpect(registry.kinds[traitIndex] == "Trait",
        "trait kind exposed")
}

fun testPackageAwareModuleIdentities() r: Void {
    let rootPath = semanticNormalizeModuleIdentity(
        "project/src/models/user.seen")
    let leftPath = semanticNormalizeModuleIdentity(
        "project/.seen/views/alice-left/source/src/models/user.seen")
    let rightPath = semanticNormalizeModuleIdentity(
        "project/.seen/views/bob-right/source/src/models/user.seen")
    semanticExpect(rootPath != leftPath and leftPath != rightPath and
        rootPath != rightPath,
        "same relative module paths retain package/view identity")

    let registry = SemanticDeclarationRegistry.new()
    semanticExpect(registry.registerDeclaration(leftPath, "User", "Class",
        leftPath + "::User", "left-user.seen", 1, 1),
        "register left package type")
    semanticExpect(registry.registerDeclaration(rightPath, "User", "Class",
        rightPath + "::User", "right-user.seen", 1, 1),
        "register right package type without collision")

    let owner = semanticNormalizeModuleIdentity("project/src/main.seen")
    registry.registerResolvedImportModule(owner, "left.models.user",
        leftPath)
    registry.registerResolvedImportModule(owner, "right.models.user",
        rightPath)
    registry.registerImport(owner, "LeftUser",
        registry.resolveImportedModule(owner, "left.models.user"), "User")
    registry.registerImport(owner, "RightUser",
        registry.resolveImportedModule(owner, "right.models.user"), "User")
    semanticExpect(registry.resolveTypeBase(owner, "LeftUser") ==
        leftPath + "::User", "left package import keeps physical identity")
    semanticExpect(registry.resolveTypeBase(owner, "RightUser") ==
        rightPath + "::User", "right package import keeps physical identity")
    semanticExpect(registry.resolveTypeBase(owner, "User") == "",
        "same-leaf package type cannot bypass imports")
}

