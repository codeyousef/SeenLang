fun testKnownAndUnknownAssignmentTraversal() r: Void {
    let failureRegistry = SemanticDeclarationRegistry.new()
    let failure = semanticFunctionProgram("badWalk", "Int", "Int")
    let unknownAssignment = StatementNode.new()
    unknownAssignment.kind = "Expression"
    let unknownExpression = ParserExpressionNode.new()
    unknownExpression.kind = "Assignment"
    unknownExpression.variableName = "missing"
    unknownAssignment.expression = unknownExpression
    failure.items[0].function.body.statements.push(unknownAssignment)
    let checked = runLexicalSemanticPass(failure, "failure",
        "failure.seen", failureRegistry)
    semanticExpect(not checked.success and
        checked.diagnostics[0].code == "E_BINDING_UNKNOWN",
        "known assignment semantics fail closed")
}

fun testDiscardBindingsRemainNonbinding() r: Void {
    let registry = SemanticDeclarationRegistry.new()
    let program = semanticFunctionProgram("discard", "Int", "Int")
    let first = StatementNode.new()
    first.kind = "Let"
    first.variableName = "_"
    first.variableType = semanticType("Int")
    first.initializer.kind = "Literal"
    first.initializer.literalValue = "1"
    first.initializer.literalType = "Int"
    program.items[0].function.body.statements.push(first)
    let second = StatementNode.new()
    second.kind = "Let"
    second.variableName = "_"
    second.variableType = semanticType("Int")
    second.initializer.kind = "Literal"
    second.initializer.literalValue = "2"
    second.initializer.literalType = "Int"
    program.items[0].function.body.statements.push(second)
    semanticExpect(runLexicalSemanticPass(program, "discard", "discard.seen",
        registry).success, "repeated discard bindings do not collide")

    let failureRegistry = SemanticDeclarationRegistry.new()
    let failure = semanticFunctionProgram("discardFailure", "Int", "Int")
    let discarded = StatementNode.new()
    discarded.kind = "Let"
    discarded.variableName = "_"
    discarded.variableType = semanticType("Int")
    discarded.initializer = semanticVariable("missing")
    failure.items[0].function.body.statements.push(discarded)
    let checked = runLexicalSemanticPass(failure, "discard_failure",
        "discard-failure.seen", failureRegistry)
    semanticExpect(not checked.success and
        checked.diagnostics[0].code == "E_BINDING_UNKNOWN",
        "discard initializers still undergo semantic traversal")
}

