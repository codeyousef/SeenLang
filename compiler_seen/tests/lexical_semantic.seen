fun testImplicitOwningFieldBindings() r: Void {
    let registry = SemanticDeclarationRegistry.new()
    let program = semanticClassProgram("Counter", "stored", "Int", "")
    program.items[0].classNode.fields[0].isMutable = true

    let read = FunctionNode.new()
    read.name = "read"
    read.returnType = semanticType("Int")
    let readReturn = StatementNode.new()
    readReturn.kind = "Return"
    readReturn.returnValue = semanticVariable("stored")
    read.body.statements.push(readReturn)
    program.items[0].classNode.methods.push(read)

    let write = FunctionNode.new()
    write.name = "write"
    let writeStatement = StatementNode.new()
    writeStatement.kind = "Expression"
    writeStatement.expression.kind = "Assignment"
    writeStatement.expression.variableName = "stored"
    write.body.statements.push(writeStatement)
    program.items[0].classNode.methods.push(write)

    let parameterShadow = FunctionNode.new()
    parameterShadow.name = "parameterShadow"
    parameterShadow.returnType = semanticType("Int")
    let shadowingParameter = ParamNode.new()
    shadowingParameter.name = "stored"
    shadowingParameter.paramType = semanticType("Int")
    parameterShadow.params.push(shadowingParameter)
    let parameterReturn = StatementNode.new()
    parameterReturn.kind = "Return"
    parameterReturn.returnValue = semanticVariable("stored")
    parameterShadow.body.statements.push(parameterReturn)
    program.items[0].classNode.methods.push(parameterShadow)

    let localShadow = FunctionNode.new()
    localShadow.name = "localShadow"
    localShadow.returnType = semanticType("Int")
    let local = StatementNode.new()
    local.kind = "Let"
    local.variableName = "stored"
    local.variableType = semanticType("Int")
    local.initializer.kind = "Literal"
    local.initializer.literalValue = "1"
    local.initializer.literalType = "Int"
    localShadow.body.statements.push(local)
    let localReturn = StatementNode.new()
    localReturn.kind = "Return"
    localReturn.returnValue = semanticVariable("stored")
    localShadow.body.statements.push(localReturn)
    program.items[0].classNode.methods.push(localShadow)

    let explicitReceiver = FunctionNode.new()
    explicitReceiver.name = "explicitReceiver"
    explicitReceiver.returnType = semanticType("Int")
    let receiverParameter = ParamNode.new()
    receiverParameter.name = "this"
    receiverParameter.paramType = semanticType("Counter")
    explicitReceiver.params.push(receiverParameter)
    let receiverReturn = StatementNode.new()
    receiverReturn.kind = "Return"
    receiverReturn.returnValue.kind = "MemberAccess"
    receiverReturn.returnValue.literalValue = "this"
    receiverReturn.returnValue.variableName = "stored"
    explicitReceiver.body.statements.push(receiverReturn)
    program.items[0].classNode.methods.push(explicitReceiver)

    let checked = runLexicalSemanticPass(program, "fields", "fields.seen",
        registry)
    semanticExpect(checked.success,
        "owning methods resolve implicit fields after locals and parameters")
    semanticExpect(registry.hasDeclaredField("fields::Counter", "stored"),
        "declared field metadata is queryable by canonical owner")
    semanticExpect(registry.hasVisibleInstanceField("fields::Counter",
        "stored"), "direct fields are visible in instance scope")

    let outside = semanticFunctionProgram("outside", "Int", "Int")
    let outsideReturn = StatementNode.new()
    outsideReturn.kind = "Return"
    outsideReturn.returnValue = semanticVariable("stored")
    outside.items[0].function.body.statements.push(outsideReturn)
    let outsideChecked = runLexicalSemanticPass(outside, "fields",
        "outside-fields.seen", registry)
    semanticExpect(not outsideChecked.success and
        outsideChecked.diagnostics.length() == 1 and
        outsideChecked.diagnostics[0].code == "E_BINDING_UNKNOWN",
        "a class field name remains unknown outside its owning class")

    let duplicateRegistry = SemanticDeclarationRegistry.new()
    let duplicate = semanticFunctionProgram("duplicate", "Int", "Int")
    let duplicateParameter = ParamNode.new()
    duplicateParameter.name = "value"
    duplicateParameter.paramType = semanticType("Int")
    duplicate.items[0].function.params.push(duplicateParameter)
    let duplicateChecked = runLexicalSemanticPass(duplicate, "duplicates",
        "duplicates.seen", duplicateRegistry)
    semanticExpect(not duplicateChecked.success and
        duplicateChecked.diagnostics.length() == 1 and
        duplicateChecked.diagnostics[0].code == "E_BINDING_DUPLICATE",
        "explicit receiver shadowing does not permit duplicate parameters")
}

fun testInheritedImplicitFieldBindings() r: Void {
    let registry = SemanticDeclarationRegistry.new()
    let program = ProgramNode.new()
    let base = semanticClassProgram("Base", "inherited", "Int", "")
    program.items.push(base.items[0])
    let child = semanticClassProgram("Child", "own", "Int", "")
    child.items[0].classNode.parentName = "Base"
    let inheritedRead = FunctionNode.new()
    inheritedRead.name = "inheritedRead"
    inheritedRead.returnType = semanticType("Int")
    let inheritedReturn = StatementNode.new()
    inheritedReturn.kind = "Return"
    inheritedReturn.returnValue = semanticVariable("inherited")
    inheritedRead.body.statements.push(inheritedReturn)
    child.items[0].classNode.methods.push(inheritedRead)
    program.items.push(child.items[0])

    let checked = runLexicalSemanticPass(program, "inheritance",
        "inheritance.seen", registry)
    semanticExpect(checked.success and
        registry.hasVisibleInstanceField("inheritance::Child", "inherited"),
        "instance scope resolves fields through the declared parent chain")

    let importedRegistry = SemanticDeclarationRegistry.new()
    let provider = semanticClassProgram("Parent", "remoteField", "Int", "")
    let importedChild = semanticClassProgram("ImportedChild", "own", "Int",
        "")
    importedChild.items[0].classNode.parentName = "RemoteBase"
    importedChild.items.push(semanticImport("provider", "Parent",
        "RemoteBase"))
    let remoteRead = FunctionNode.new()
    remoteRead.name = "remoteRead"
    remoteRead.returnType = semanticType("Int")
    let remoteReturn = StatementNode.new()
    remoteReturn.kind = "Return"
    remoteReturn.returnValue = semanticVariable("remoteField")
    remoteRead.body.statements.push(remoteReturn)
    importedChild.items[0].classNode.methods.push(remoteRead)
    let providerCollected = collectLexicalSemanticModule(provider, "provider",
        "provider.seen", importedRegistry)
    let childCollected = collectLexicalSemanticModule(importedChild,
        "consumer", "consumer.seen", importedRegistry)
    let providerChecked = checkLexicalSemanticModule(provider, "provider",
        "provider.seen", importedRegistry)
    let childChecked = checkLexicalSemanticModule(importedChild, "consumer",
        "consumer.seen", importedRegistry)
    semanticExpect(providerCollected.success and childCollected.success and
        providerChecked.success and childChecked.success and
        importedRegistry.hasVisibleInstanceField("consumer::ImportedChild",
            "remoteField"),
        "import aliases resolve inherited fields in the child module")

    let cycleRegistry = SemanticDeclarationRegistry.new()
    semanticExpect(cycleRegistry.registerDeclaration("cycle", "A", "Class",
        "cycle::A", "cycle.seen", 1, 1), "register cycle A")
    semanticExpect(cycleRegistry.registerDeclaration("cycle", "B", "Class",
        "cycle::B", "cycle.seen", 2, 1), "register cycle B")
    cycleRegistry.registerLifecycleField("cycle::A", "cycle", "@parent",
        "B", "cycle.seen", 1, 1)
    cycleRegistry.registerLifecycleField("cycle::B", "cycle", "@parent",
        "A", "cycle.seen", 2, 1)
    semanticExpect(not cycleRegistry.hasVisibleInstanceField("cycle::A",
        "missing"), "cyclic parent metadata terminates without a match")
}

fun testStaticMethodInstanceBindingsRejected() r: Void {
    let bareRegistry = SemanticDeclarationRegistry.new()
    let bareProgram = semanticClassProgram("StaticBare", "stored", "Int", "")
    let bareMethod = FunctionNode.new()
    bareMethod.name = "badBare"
    bareMethod.isStatic = true
    bareMethod.returnType = semanticType("Int")
    let bareReturn = StatementNode.new()
    bareReturn.kind = "Return"
    bareReturn.returnValue = semanticVariable("stored")
    bareMethod.body.statements.push(bareReturn)
    bareProgram.items[0].classNode.methods.push(bareMethod)
    let bareChecked = runLexicalSemanticPass(bareProgram, "static_bare",
        "static-bare.seen", bareRegistry)
    semanticExpect(not bareChecked.success and
        bareChecked.diagnostics.length() == 1 and
        bareChecked.diagnostics[0].code == "E_BINDING_UNKNOWN",
        "static methods cannot resolve a bare instance field")

    let thisRegistry = SemanticDeclarationRegistry.new()
    let thisProgram = semanticClassProgram("StaticThis", "stored", "Int", "")
    let thisMethod = FunctionNode.new()
    thisMethod.name = "badThis"
    thisMethod.isStatic = true
    thisMethod.returnType = semanticType("Int")
    let thisReturn = StatementNode.new()
    thisReturn.kind = "Return"
    thisReturn.returnValue.kind = "MemberAccess"
    thisReturn.returnValue.literalValue = "this"
    thisReturn.returnValue.variableName = "stored"
    thisMethod.body.statements.push(thisReturn)
    thisProgram.items[0].classNode.methods.push(thisMethod)
    let thisChecked = runLexicalSemanticPass(thisProgram, "static_this",
        "static-this.seen", thisRegistry)
    semanticExpect(not thisChecked.success and
        thisChecked.diagnostics.length() == 1 and
        thisChecked.diagnostics[0].code == "E_BINDING_UNKNOWN" and
        thisChecked.diagnostics[0].message.contains("this"),
        "static methods cannot resolve an explicit this receiver")

    let shadowRegistry = SemanticDeclarationRegistry.new()
    let shadowProgram = semanticClassProgram("StaticShadow", "stored", "Int",
        "")
    let shadowMethod = FunctionNode.new()
    shadowMethod.name = "shadow"
    shadowMethod.isStatic = true
    shadowMethod.returnType = semanticType("Int")
    let shadowParameter = ParamNode.new()
    shadowParameter.name = "stored"
    shadowParameter.paramType = semanticType("Int")
    shadowMethod.params.push(shadowParameter)
    let shadowReturn = StatementNode.new()
    shadowReturn.kind = "Return"
    shadowReturn.returnValue = semanticVariable("stored")
    shadowMethod.body.statements.push(shadowReturn)
    shadowProgram.items[0].classNode.methods.push(shadowMethod)
    semanticExpect(runLexicalSemanticPass(shadowProgram, "static_shadow",
        "static-shadow.seen", shadowRegistry).success,
        "a static parameter may shadow an instance field name")
}

fun testLifecyclePropertyFoundation() r: Void {
    semanticExpect(semanticBuiltinLifecycleProperty("Int", "Copy") == 1 and
        semanticBuiltinLifecycleProperty("Int", "Drop") == 0,
        "scalar builtin lifecycle properties are explicit")
    semanticExpect(semanticBuiltinLifecycleProperty("String", "Copy") == 0 and
        semanticBuiltinLifecycleProperty("String", "Equatable") == 1 and
        semanticBuiltinLifecycleProperty("String", "Drop") == 1,
        "owning String is non-Copy with explicit equality and cleanup metadata")
    semanticExpect(semanticBuiltinLifecycleProperty("ptr", "Send") == 0,
        "raw pointers do not gain thread-safety properties")
    semanticExpect(semanticBuiltinLifecycleProperty("StringBuilder",
        "Share") == 0,
        "mutable StringBuilder storage is not Share")
    semanticExpect(semanticFoundationThreadProperty(
            "seen_std.src.sync.arc::Arc<Int>", "Share") == 1 and
        semanticFoundationThreadProperty(
            "seen_std.src.sync.mutex::Mutex<Int>", "Share") == 1 and
        semanticFoundationThreadProperty(
            "seen_std.src.sync.mutex::RwLock<Int>", "Send") == 1,
        "canonical synchronization owners prove their thread properties")
    semanticExpect(semanticFoundationThreadProperty("Arc<Int>",
            "Share") == -1 and
        semanticFoundationThreadProperty("application.sync::Arc<Int>",
            "Share") == -1,
        "unqualified and application-owned names cannot spoof Arc")
    semanticExpect(semanticFoundationThreadProperty(
            "seen_std.src.reactor.reactor::BlockingCompletion", "Send") == 1
        and semanticFoundationThreadProperty(
            "seen_std.src.reactor.reactor::BlockingCompletion", "Share") == 0
        and semanticFoundationThreadProperty(
            "seen_std.src.io.direct::GatherCompletion", "Send") == 1 and
        semanticFoundationThreadProperty(
            "seen_std.src.io.direct::GatherCompletion", "Share") == 0,
        "canonical completion records are Send but not Share")

    let registry = SemanticDeclarationRegistry.new()
    let program = ProgramNode.new()

    let leaf = semanticClassProgram("Leaf", "value", "Int", "")
    leaf.items[0].classNode.decorators.push(
        AnnotationNode.new("trivially_copyable"))
    leaf.items[0].classNode.decorators.push(AnnotationNode.new("send"))
    leaf.items[0].classNode.decorators.push(AnnotationNode.new("share"))
    let equality = AnnotationNode.new("derive")
    equality.arguments.push("Eq")
    leaf.items[0].classNode.decorators.push(equality)
    program.items.push(leaf.items[0])

    let resource = semanticClassProgram("Resource", "handle", "Int", "")
    resource.items[0].classNode.decorators.push(
        AnnotationNode.new("c_resource"))
    program.items.push(resource.items[0])
    let holder = semanticClassProgram("Holder", "resource", "Resource", "")
    program.items.push(holder.items[0])
    let resourceChild = semanticClassProgram("ResourceChild", "tag", "Int", "")
    resourceChild.items[0].classNode.parentName = "Resource"
    program.items.push(resourceChild.items[0])
    let sendChild = semanticClassProgram("SendChild", "tag", "Int", "")
    sendChild.items[0].classNode.parentName = "Leaf"
    sendChild.items[0].classNode.decorators.push(AnnotationNode.new("send"))
    program.items.push(sendChild.items[0])

    let checked = runLexicalSemanticPass(program, "lifecycle",
        "lifecycle.seen", registry)
    semanticExpect(checked.success,
        "proved lifecycle markers and transitive Drop metadata pass")
    semanticExpect(registry.hasLifecycleProperty("lifecycle::Leaf", "Copy") and
        registry.hasLifecycleProperty("lifecycle::Leaf", "Equatable") and
        registry.hasLifecycleProperty("lifecycle::Leaf", "Send") and
        registry.hasLifecycleProperty("lifecycle::Leaf", "Share"),
        "existing declaration markers produce queryable proved properties")
    semanticExpect(not registry.hasLifecycleProperty("lifecycle::Leaf", "Drop"),
        "scalar-only Copy declaration does not require Drop")
    semanticExpect(registry.hasLifecycleProperty("lifecycle::Resource", "Drop") and
        not registry.hasLifecycleProperty("lifecycle::Resource", "Copy"),
        "c_resource is Drop and non-Copy")
    semanticExpect(registry.hasLifecycleProperty("lifecycle::Holder", "Drop"),
        "Drop requirement derives transitively through aggregate fields")
    semanticExpect(not registry.hasLifecycleProperty("lifecycle::Holder", "Copy"),
        "unmarked owning class handles do not gain Copy")
    semanticExpect(registry.hasLifecycleProperty("lifecycle::ResourceChild",
        "Drop") and registry.hasLifecycleProperty("lifecycle::SendChild",
        "Send"), "parent declarations participate in transitive properties")

    let enumRegistry = SemanticDeclarationRegistry.new()
    semanticExpect(enumRegistry.registerDeclaration("lifecycle", "State",
        "Enum", "lifecycle::State", "state.seen", 1, 1),
        "register unit enum lifecycle fixture")
    semanticExpect(enumRegistry.hasLifecycleProperty("lifecycle::State", "Copy") and
        enumRegistry.hasLifecycleProperty("lifecycle::State", "Equatable") and
        not enumRegistry.hasLifecycleProperty("lifecycle::State", "Drop"),
        "unit enum properties are explicit and cleanup-free")
}

fun testCanonicalFoundationResolution() r: Void {
    let trustedRegistry = SemanticDeclarationRegistry.new()
    let canonicalArc = "seen_std.src.sync.arc::Arc"
    semanticExpect(trustedRegistry.registerDeclaration(
        "seen_std.src.sync.arc", "Arc", "Class", canonicalArc,
        "seen_std/src/sync/arc.seen", 14, 1),
        "register canonical standard-library Arc")
    trustedRegistry.registerGenericParameter(canonicalArc, "T",
        "bound:Share")
    trustedRegistry.registerResolvedImportModule("foundation_user",
        "sync.arc", "seen_std.src.sync.arc")

    let trusted = semanticClassProgram("TrustedHolder", "owner",
        "SharedArc<Int>", "")
    trusted.items[0].classNode.decorators.push(AnnotationNode.new("share"))
    trusted.items.push(semanticImport("sync.arc", "Arc", "SharedArc"))
    let trustedChecked = runLexicalSemanticPass(trusted, "foundation_user",
        "foundation-user.seen", trustedRegistry)
    semanticExpect(trustedChecked.success and
        trustedRegistry.hasLifecycleProperty(
            "foundation_user::TrustedHolder", "Share"),
        "resolved canonical foundation identity is trusted after import lookup")

    let spoofRegistry = SemanticDeclarationRegistry.new()
    let spoof = ProgramNode.new()
    let applicationArc = semanticClassProgram("Arc", "values",
        "Array<Int>", "")
    spoof.items.push(applicationArc.items[0])
    let spoofHolder = semanticClassProgram("SpoofHolder", "owner", "Arc", "")
    spoofHolder.items[0].classNode.decorators.push(AnnotationNode.new("share"))
    spoof.items.push(spoofHolder.items[0])
    let spoofChecked = runLexicalSemanticPass(spoof, "application",
        "application.seen", spoofRegistry)
    semanticExpect(not spoofChecked.success and
        spoofChecked.diagnostics.length() == 1 and
        spoofChecked.diagnostics[0].code == "E_PROPERTY_FIELD" and
        not spoofRegistry.hasLifecycleProperty(
            "application::SpoofHolder", "Share"),
        "application class named Arc cannot acquire foundation trust")
}

fun testLifecyclePropertyFailures() r: Void {
    let fieldRegistry = SemanticDeclarationRegistry.new()
    let fieldProgram = ProgramNode.new()
    let plain = semanticClassProgram("Plain", "value", "Int", "")
    fieldProgram.items.push(plain.items[0])
    let carrier = semanticClassProgram("Carrier", "plain", "Plain", "")
    carrier.items[0].classNode.decorators.push(AnnotationNode.new("send"))
    fieldProgram.items.push(carrier.items[0])
    let fieldChecked = runLexicalSemanticPass(fieldProgram, "properties",
        "properties.seen", fieldRegistry)
    semanticExpect(not fieldChecked.success and
        fieldChecked.diagnostics.length() == 1 and
        fieldChecked.diagnostics[0].code == "E_PROPERTY_FIELD",
        "explicit Send cannot override a non-Send field")
    semanticExpect(fieldChecked.diagnostics[0].location.column == 20,
        "property field diagnostic keeps the field source location")

    let arrayRegistry = SemanticDeclarationRegistry.new()
    let arrayOwner = semanticClassProgram("ArrayOwner", "values",
        "Array<Int>", "")
    arrayOwner.items[0].classNode.decorators.push(
        AnnotationNode.new("trivially_copyable"))
    let arrayChecked = runLexicalSemanticPass(arrayOwner, "array_property",
        "array-property.seen", arrayRegistry)
    semanticExpect(not arrayChecked.success and
        arrayChecked.diagnostics[0].code == "E_PROPERTY_FIELD" and
        not arrayRegistry.hasLifecycleProperty("array_property::ArrayOwner",
            "Copy"),
        "owning Array fields remain Drop and cannot be forced Copy")

    let shareArrayRegistry = SemanticDeclarationRegistry.new()
    let shareArray = semanticClassProgram("ShareArray", "values",
        "Array<Int>", "")
    shareArray.items[0].classNode.decorators.push(AnnotationNode.new("share"))
    let shareArrayChecked = runLexicalSemanticPass(shareArray,
        "share_array_property", "share-array-property.seen",
        shareArrayRegistry)
    semanticExpect(not shareArrayChecked.success and
        shareArrayChecked.diagnostics[0].code == "E_PROPERTY_FIELD",
        "mutable Array handles cannot smuggle Share through element properties")

    let sendArrayRegistry = SemanticDeclarationRegistry.new()
    let sendArray = semanticClassProgram("SendArray", "values",
        "Array<Int>", "")
    sendArray.items[0].classNode.decorators.push(AnnotationNode.new("send"))
    let sendArrayChecked = runLexicalSemanticPass(sendArray,
        "send_array_property", "send-array-property.seen", sendArrayRegistry)
    semanticExpect(not sendArrayChecked.success and
        sendArrayChecked.diagnostics[0].code == "E_PROPERTY_UNPROVEN",
        "mutable Array Send stays unproven before uniqueness analysis")

    let genericRegistry = SemanticDeclarationRegistry.new()
    let generic = semanticClassProgram("GenericBox", "value", "T", "")
    let parameter = AnnotationNode.new("generic_parameter")
    parameter.arguments.push("T")
    parameter.arguments.push("")
    generic.items[0].classNode.decorators.push(parameter)
    generic.items[0].classNode.decorators.push(AnnotationNode.new("send"))
    let genericChecked = runLexicalSemanticPass(generic, "generic_property",
        "generic-property.seen", genericRegistry)
    semanticExpect(not genericChecked.success and
        genericChecked.diagnostics[0].code == "E_PROPERTY_UNPROVEN",
        "generic-dependent property stays unproven before specialization")
    semanticExpect(genericChecked.diagnostics[0].location.column == 20,
        "unproven generic property points to the dependent field")

    let conflictRegistry = SemanticDeclarationRegistry.new()
    let conflict = semanticClassProgram("BadResource", "handle", "Int", "")
    conflict.items[0].classNode.decorators.push(
        AnnotationNode.new("trivially_copyable"))
    conflict.items[0].classNode.decorators.push(
        AnnotationNode.new("c_resource"))
    let conflictChecked = runLexicalSemanticPass(conflict, "conflict",
        "conflict.seen", conflictRegistry)
    semanticExpect(not conflictChecked.success and
        conflictChecked.diagnostics.length() == 1 and
        conflictChecked.diagnostics[0].code == "E_PROPERTY_CONFLICT",
        "Copy and Drop declarations are mutually exclusive")
}

fun testCrossModuleLifecycleProperties() r: Void {
    let registry = SemanticDeclarationRegistry.new()
    let provider = semanticClassProgram("Transfer", "value", "Int", "")
    provider.items[0].classNode.decorators.push(AnnotationNode.new("send"))

    let consumer = semanticClassProgram("Envelope", "payload", "Remote", "")
    consumer.items[0].classNode.decorators.push(AnnotationNode.new("send"))
    consumer.items.push(semanticImport("provider", "Transfer", "Remote"))

    let providerCollected = collectLexicalSemanticModule(provider, "provider",
        "provider.seen", registry)
    let consumerCollected = collectLexicalSemanticModule(consumer, "consumer",
        "consumer.seen", registry)
    semanticExpect(providerCollected.success and consumerCollected.success,
        "lifecycle declarations collect across modules")
    let providerChecked = checkLexicalSemanticModule(provider, "provider",
        "provider.seen", registry)
    let consumerChecked = checkLexicalSemanticModule(consumer, "consumer",
        "consumer.seen", registry)
    semanticExpect(providerChecked.success and consumerChecked.success and
        registry.hasLifecycleProperty("consumer::Envelope", "Send"),
        "import aliases retain canonical transitive lifecycle properties")
}

fun testLifecyclePropertyCyclesAndIndirection() r: Void {
    let cycleRegistry = SemanticDeclarationRegistry.new()
    let cycle = ProgramNode.new()
    let left = semanticClassProgram("Left", "right", "Right", "")
    left.items[0].classNode.decorators.push(AnnotationNode.new("send"))
    cycle.items.push(left.items[0])
    let right = semanticClassProgram("Right", "left", "Left", "")
    right.items[0].classNode.decorators.push(AnnotationNode.new("send"))
    cycle.items.push(right.items[0])
    let cycleChecked = runLexicalSemanticPass(cycle, "cycle", "cycle.seen",
        cycleRegistry)
    semanticExpect(not cycleChecked.success and
        cycleChecked.diagnostics[0].code == "E_PROPERTY_CYCLE",
        "mutual direct lifecycle dependency fails closed")
    semanticExpect(cycleRegistry.lifecyclePropertyState("cycle::Left",
        "Send") == -2, "cyclic property remains queryably unproved")

    let pointerRegistry = SemanticDeclarationRegistry.new()
    let pointerNode = semanticClassProgram("Node", "next", "*Node", "")
    pointerNode.items[0].classNode.decorators.push(
        AnnotationNode.new("trivially_copyable"))
    let pointerChecked = runLexicalSemanticPass(pointerNode, "pointer_cycle",
        "pointer-cycle.seen", pointerRegistry)
    semanticExpect(pointerChecked.success and
        pointerRegistry.hasLifecycleProperty("pointer_cycle::Node", "Copy"),
        "explicit pointer indirection breaks direct Copy recursion")
}

fun semanticParallelForReading(name: String) r: StatementNode {
    let statement = StatementNode.new()
    statement.kind = "ParallelFor"
    statement.variableName = "index"
    statement.line = 4
    statement.column = 5
    statement.expression.kind = "Range"
    let start = ParserExpressionNode.new()
    start.kind = "Literal"
    start.literalType = "Int"
    start.literalValue = "0"
    let end = ParserExpressionNode.new()
    end.kind = "Literal"
    end.literalType = "Int"
    end.literalValue = "4"
    statement.expression.operands.push(start)
    statement.expression.operands.push(end)
    let read = StatementNode.new()
    read.kind = "Expression"
    read.expression = semanticVariable(name)
    statement.loopBody.statements.push(read)
    return statement
}

fun semanticParallelForMemberReading(ownerName: String, fieldName: String)
    r: StatementNode {

    let statement = semanticParallelForReading(fieldName)
    let read = statement.loopBody.statements[0].expression
    read.kind = "MemberAccess"
    read.literalValue = ownerName
    read.variableName = fieldName
    return statement
}

fun semanticGlobalItem(name: String, typeName: String, mutable: Bool)
    r: ItemNode {

    let item = ItemNode.new()
    item.itemType = "GlobalVar"
    item.name = name
    var prefix = "L"
    if mutable { prefix = "V" }
    item.visibility = prefix + typeName + ":"
    item.line = 1
    item.column = 1
    return item
}

fun testRetainedSendShareGenericBounds() r: Void {
    let registry = SemanticDeclarationRegistry.new()
    let program = ProgramNode.new()
    let shared = semanticClassProgram("SharedValue", "value", "Int", "")
    shared.items[0].classNode.decorators.push(AnnotationNode.new("share"))
    program.items.push(shared.items[0])

    let holder = semanticClassProgram("Holder", "value", "T", "")
    let parameter = AnnotationNode.new("generic_parameter")
    parameter.arguments.push("T")
    parameter.arguments.push("bound:Share")
    holder.items[0].classNode.decorators.push(parameter)
    holder.items[0].classNode.decorators.push(AnnotationNode.new("share"))
    program.items.push(holder.items[0])
    let accepted = semanticFunctionProgram("accept",
        "Holder<SharedValue>", "Int")
    program.items.push(accepted.items[0])

    let checked = runLexicalSemanticPass(program, "bounds",
        "bounds.seen", registry)
    semanticExpect(checked.success and
        registry.genericParameterModifier("bounds::Holder", "T") ==
            "bound:Share" and
        registry.hasLifecycleProperty("bounds::Holder", "Share"),
        "retained Share bound proves the generic field and valid argument")

    let rejectedRegistry = SemanticDeclarationRegistry.new()
    let rejected = ProgramNode.new()
    rejected.items.push(shared.items[0])
    rejected.items.push(holder.items[0])
    let bad = semanticFunctionProgram("reject", "Holder<Array<Int>>", "Int")
    rejected.items.push(bad.items[0])
    let badChecked = runLexicalSemanticPass(rejected, "bad_bounds",
        "bad-bounds.seen", rejectedRegistry)
    semanticExpect(not badChecked.success and
        badChecked.diagnostics[0].code == "E_TYPE_BOUND",
        "a concrete argument that lacks Share fails the retained bound")
}

fun testTypedImmutableParallelCaptures() r: Void {
    let immutableRegistry = SemanticDeclarationRegistry.new()
    let immutable = semanticFunctionProgram("immutable", "Int", "Int")
    immutable.items[0].function.params[0].name = "offset"
    immutable.items[0].function.body.statements.push(
        semanticParallelForReading("offset"))
    semanticExpect(runLexicalSemanticPass(immutable, "capture_ok",
        "capture-ok.seen", immutableRegistry).success,
        "immutable Share capture is accepted")

    let mutableRegistry = SemanticDeclarationRegistry.new()
    let mutableProgram = semanticFunctionProgram("mutable", "Int", "Int")
    mutableProgram.items[0].function.params[0].name = "offset"
    mutableProgram.items[0].function.params[0].isMutable = true
    mutableProgram.items[0].function.body.statements.push(
        semanticParallelForReading("offset"))
    let mutableChecked = runLexicalSemanticPass(mutableProgram,
        "capture_mutable", "capture-mutable.seen", mutableRegistry)
    semanticExpect(not mutableChecked.success and
        mutableChecked.diagnostics[0].code == "E_CAPTURE_MUTABLE",
        "mutable parallel capture is rejected before lowering")

    let arrayRegistry = SemanticDeclarationRegistry.new()
    let arrayProgram = semanticFunctionProgram("arrayCapture", "Array<Int>",
        "Int")
    arrayProgram.items[0].function.params[0].name = "values"
    arrayProgram.items[0].function.body.statements.push(
        semanticParallelForReading("values"))
    let arrayChecked = runLexicalSemanticPass(arrayProgram,
        "capture_array", "capture-array.seen", arrayRegistry)
    semanticExpect(not arrayChecked.success and
        arrayChecked.diagnostics[0].code == "E_CAPTURE_SHARE",
        "non-Share parallel capture is rejected before lowering")

    let legacyRegistry = SemanticDeclarationRegistry.new()
    let legacy = semanticClassProgram("Legacy", "value", "Int", "")
    legacy.items[0].classNode.decorators.push(AnnotationNode.new("sync"))
    let legacyChecked = runLexicalSemanticPass(legacy, "legacy_sync",
        "legacy-sync.seen", legacyRegistry)
    semanticExpect(not legacyChecked.success and
        legacyChecked.diagnostics[0].code == "E_PROPERTY_LEGACY",
        "legacy @sync is rejected rather than treated as a Share alias")
}

fun testAmbientParallelCaptures() r: Void {
    let immutableRegistry = SemanticDeclarationRegistry.new()
    let immutable = ProgramNode.new()
    immutable.items.push(semanticGlobalItem("sharedOffset", "Int", false))
    let immutableFunction = semanticFunctionProgram("readShared", "Int",
        "Int")
    immutableFunction.items[0].function.body.statements.push(
        semanticParallelForReading("sharedOffset"))
    immutable.items.push(immutableFunction.items[0])
    semanticExpect(runLexicalSemanticPass(immutable, "immutable_global",
        "immutable-global.seen", immutableRegistry).success,
        "immutable Share global is accepted in parallel_for")

    let mutableRegistry = SemanticDeclarationRegistry.new()
    let mutableProgram = ProgramNode.new()
    mutableProgram.items.push(semanticGlobalItem("sharedOffset", "Int", true))
    let mutableFunction = semanticFunctionProgram("readMutable", "Int",
        "Int")
    mutableFunction.items[0].function.body.statements.push(
        semanticParallelForReading("sharedOffset"))
    mutableProgram.items.push(mutableFunction.items[0])
    let mutableChecked = runLexicalSemanticPass(mutableProgram,
        "mutable_global", "mutable-global.seen", mutableRegistry)
    semanticExpect(not mutableChecked.success and
        mutableChecked.diagnostics.length() == 1 and
        mutableChecked.diagnostics[0].code == "E_CAPTURE_MUTABLE" and
        mutableChecked.diagnostics[0].message.contains("mutable global"),
        "mutable global capture is rejected with an exact diagnostic")

    let shadowRegistry = SemanticDeclarationRegistry.new()
    let shadowProgram = ProgramNode.new()
    shadowProgram.items.push(semanticGlobalItem("sharedOffset", "Int", true))
    let shadowFunction = semanticFunctionProgram("readSnapshot", "Int",
        "Int")
    shadowFunction.items[0].function.params[0].name = "sharedOffset"
    shadowFunction.items[0].function.body.statements.push(
        semanticParallelForReading("sharedOffset"))
    shadowProgram.items.push(shadowFunction.items[0])
    semanticExpect(runLexicalSemanticPass(shadowProgram, "shadow_global",
        "shadow-global.seen", shadowRegistry).success,
        "immutable local snapshot shadows a mutable global capture")

    let arrayRegistry = SemanticDeclarationRegistry.new()
    let arrayProgram = ProgramNode.new()
    arrayProgram.items.push(semanticGlobalItem("sharedValues", "Array<Int>",
        false))
    let arrayFunction = semanticFunctionProgram("readArray", "Int", "Int")
    arrayFunction.items[0].function.body.statements.push(
        semanticParallelForReading("sharedValues"))
    arrayProgram.items.push(arrayFunction.items[0])
    let arrayChecked = runLexicalSemanticPass(arrayProgram, "array_global",
        "array-global.seen", arrayRegistry)
    semanticExpect(not arrayChecked.success and
        arrayChecked.diagnostics.length() == 1 and
        arrayChecked.diagnostics[0].code == "E_CAPTURE_SHARE",
        "immutable global still requires a Share type")

    let bareRegistry = SemanticDeclarationRegistry.new()
    let bareProgram = semanticClassProgram("SharedOwner", "offset", "Int", "")
    bareProgram.items[0].classNode.decorators.push(AnnotationNode.new("share"))
    let bareMethod = FunctionNode.new()
    bareMethod.name = "runBare"
    bareMethod.returnType = semanticType("Int")
    bareMethod.body.statements.push(semanticParallelForReading("offset"))
    bareProgram.items[0].classNode.methods.push(bareMethod)
    let bareChecked = runLexicalSemanticPass(bareProgram, "bare_field",
        "bare-field.seen", bareRegistry)
    semanticExpect(not bareChecked.success and
        bareChecked.diagnostics.length() == 1 and
        bareChecked.diagnostics[0].code == "E_CAPTURE_FIELD",
        "bare instance field capture is rejected before lowering")

    let explicitRegistry = SemanticDeclarationRegistry.new()
    let explicitProgram = semanticClassProgram("SharedOwner", "offset", "Int",
        "")
    explicitProgram.items[0].classNode.decorators.push(
        AnnotationNode.new("share"))
    let explicitMethod = FunctionNode.new()
    explicitMethod.name = "runExplicit"
    explicitMethod.returnType = semanticType("Int")
    explicitMethod.body.statements.push(
        semanticParallelForMemberReading("this", "offset"))
    explicitProgram.items[0].classNode.methods.push(explicitMethod)
    semanticExpect(runLexicalSemanticPass(explicitProgram, "explicit_field",
        "explicit-field.seen", explicitRegistry).success,
        "explicit this.field capture is checked through the Share owner")
}

