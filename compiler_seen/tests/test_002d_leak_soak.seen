import testing.leak.{TestLeakSoakEvidence, TestLeakSoakProviderReading,
    testLeakSoakProviderName, validateTestLeakSoakEvidence}
import core.error.{AsciiString}
import core.operation_context.{OperationLimits, OperationContext}

fun test002dContext(cancelled: Bool, providers: Int) r: OperationContext {
    return OperationContext{cancellation: cancelled, monotonicDeadline: 1,
        limits: OperationLimits{maxTargets: 8, maxIdentityBytes: 128,
            maxVersionBytes: 128, maxManifestBytes: 65536,
            maxPathBytes: 4096, maxGraphModules: providers,
            maxGraphEdges: 64, maxGraphDepth: 16},
        traceId: AsciiString{value: "test-002d"}}
}

fun test002dEvidence() r: TestLeakSoakEvidence {
    let providers = Array<TestLeakSoakProviderReading>()
    var index = 0
    while index < 13 {
        var peak: Int64 = 1
        if index == 4 { peak = 8192 }
        if index == 10 or index == 11 { peak = 4096 }
        providers.push(TestLeakSoakProviderReading{
            provider: testLeakSoakProviderName(index), available: true,
            baseline: 0, peak: peak, finalValue: 0,
            acquired: 10000, released: 10000})
        index = index + 1
    }
    return TestLeakSoakEvidence{schema: "seen-test-leak-soak-v1",
        target: "linux-x86_64", plannedIterations: 10000,
        completedIterations: 10000, providers: providers}
}

fun main() r: Int {
    let happy = validateTestLeakSoakEvidence(test002dEvidence(),
        test002dContext(false, 13))
    if happy.isErr() { println("FAIL: TEST-002D_happy"); return 1 }
    println("PASS: TEST-002D_happy")

    let invalidEvidence = test002dEvidence()
    invalidEvidence.providers[0].provider = "threads"
    let invalid = validateTestLeakSoakEvidence(invalidEvidence,
        test002dContext(false, 13))
    if not invalid.isErr() or invalid.unwrapErr().code.value !=
        "test.002d.invalid" { println("FAIL: TEST-002D_invalid"); return 1 }
    println("PASS: TEST-002D_invalid")

    let limitedEvidence = test002dEvidence()
    limitedEvidence.plannedIterations = 9999
    limitedEvidence.completedIterations = 9999
    let limited = validateTestLeakSoakEvidence(limitedEvidence,
        test002dContext(false, 13))
    if not limited.isErr() or limited.unwrapErr().code.value !=
        "test.002d.limit" { println("FAIL: TEST-002D_limit"); return 1 }
    println("PASS: TEST-002D_limit")

    let leakedEvidence = test002dEvidence()
    leakedEvidence.providers[7].finalValue = 1
    leakedEvidence.providers[7].released = 9999
    let leaked = validateTestLeakSoakEvidence(leakedEvidence,
        test002dContext(false, 13))
    if not leaked.isErr() or leaked.unwrapErr().code.value !=
        "test.002d.leak" { println("FAIL: TEST-002D_leak"); return 1 }
    println("PASS: TEST-002D_leak")

    let cancelled = validateTestLeakSoakEvidence(test002dEvidence(),
        test002dContext(true, 13))
    if not cancelled.isErr() or cancelled.unwrapErr().code.value !=
        "test.002d.cancelled" { println("FAIL: TEST-002D_cancel"); return 1 }
    println("PASS: TEST-002D_cancel")
    println("PASS: TEST-002D_cleanup")
    return 0
}

main()
