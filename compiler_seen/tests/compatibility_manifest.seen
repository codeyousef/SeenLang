import seen_compiler.release.compatibility.{AsciiString, RetryClass,
    RedactionClass, OperationLimits, OperationContext,
    CompatibilityCompiler, CompatibilityComponents, CompatibilityTarget,
    CompatibilityPlatforms, CompatibilityManifest,
    validateCompatibilityManifest, compatibilityInputsFromManifest,
    generateCompatibilityManifestBytes, parseCompatibilityManifest,
    consumeCompatibilityManifest, writeCompatibilityManifest,
    readAndConsumeCompatibilityManifest}
import io.file.{exists, deleteFile}

fun compatibilityTestManifest() r: CompatibilityManifest {
    let targets = Array<CompatibilityTarget>()
    targets.push(CompatibilityTarget{
        name: "linux-x86_64",
        triple: "x86_64-unknown-linux-gnu",
        support: "required"
    })
    return CompatibilityManifest{
        schema: "seen-compatibility-manifest-v1",
        schemaVersion: 1,
        releaseVersion: "0.10.1",
        components: CompatibilityComponents{
            compiler: CompatibilityCompiler{
                version: "0.10.1",
                layoutAbi: "seen-layout-abi-v2",
                objectCacheAbi: "seen-object-cache-abi-v2",
                prebuiltPackageSchema: "seen-prebuilt-package-v2",
                packageInterfaceSchema: "seen-package-interface-v2",
                packageObjectManifestSchema: "seen-package-object-manifest-v2"
            },
            runtimeAbi: "runtime-v2",
            standardLibraryVersion: "0.2.0",
            standardLibraryModuleManifestVersion: 1,
            packageClientVersion: "0.10.1",
            packageClientProtocol: "SEENPKG1",
            llvmMinimumMajor: 18
        },
        platforms: CompatibilityPlatforms{
            linuxArm64: "declared-toolchain-dependent",
            linuxX8664: "required",
            macos: "declared-toolchain-dependent",
            windows: "declared-toolchain-dependent"
        },
        targets: targets
    }
}

fun compatibilityTestContext(cancelled: Bool, maxTargets: Int)
    r: OperationContext {

    return OperationContext{
        cancellation: cancelled,
        monotonicDeadline: 0,
        limits: OperationLimits{
            maxTargets: maxTargets,
            maxIdentityBytes: 128,
            maxVersionBytes: 64,
            maxManifestBytes: 65536,
            maxPathBytes: 4096
        },
        traceId: AsciiString{ value: "core-002a-test" }
    }
}

fun main() r: Int {
    let happy = validateCompatibilityManifest(
        compatibilityTestManifest(), compatibilityTestContext(false, 32))
    if happy.isErr() { return 1 }

    let invalid = compatibilityTestManifest()
    invalid.schemaVersion = 2
    let invalidResult = validateCompatibilityManifest(
        invalid, compatibilityTestContext(false, 32))
    if not invalidResult.isErr() or
        invalidResult.unwrapErr().code.value != "core.002a.invalid" {

        return 2
    }

    let limited = validateCompatibilityManifest(
        compatibilityTestManifest(), compatibilityTestContext(false, 0))
    if not limited.isErr() or
        limited.unwrapErr().code.value != "core.002a.limit" {

        return 3
    }

    let cancelled = validateCompatibilityManifest(
        compatibilityTestManifest(), compatibilityTestContext(true, 32))
    if not cancelled.isErr() or
        cancelled.unwrapErr().code.value != "core.002a.cancelled" {

        return 4
    }

    let unsupported = compatibilityTestManifest()
    unsupported.targets[0].name = "plan9-amd64"
    let unsupportedResult = validateCompatibilityManifest(
        unsupported, compatibilityTestContext(false, 32))
    if not unsupportedResult.isErr() or
        unsupportedResult.unwrapErr().code.value != "core.002a.platform" {

        return 5
    }

    let inputs = compatibilityInputsFromManifest(compatibilityTestManifest())
    let generated = generateCompatibilityManifestBytes(
        inputs, compatibilityTestContext(false, 32))
    if generated.isErr() { return 6 }
    let generatedAgain = generateCompatibilityManifestBytes(
        inputs, compatibilityTestContext(false, 32))
    if generatedAgain.isErr() or generated.unwrap() != generatedAgain.unwrap() {
        return 7
    }
    let parsed = parseCompatibilityManifest(
        generated.unwrap(), compatibilityTestContext(false, 32))
    if parsed.isErr() or parsed.unwrap().releaseVersion != "0.10.1" {
        return 8
    }
    let consumed = consumeCompatibilityManifest(
        generated.unwrap(), inputs, compatibilityTestContext(false, 32))
    if consumed.isErr() { return 9 }
    let noncanonical = consumeCompatibilityManifest(
        " " + generated.unwrap(), inputs,
        compatibilityTestContext(false, 32))
    if not noncanonical.isErr() or
        noncanonical.unwrapErr().code.value != "core.002b.invalid" {

        return 19
    }
    println("PASS: CORE-002B_happy")

    let mismatchedManifest = compatibilityTestManifest()
    mismatchedManifest.components.runtimeAbi = "runtime-v3"
    let mismatchedInputs = compatibilityInputsFromManifest(mismatchedManifest)
    let mismatch = consumeCompatibilityManifest(
        generated.unwrap(), mismatchedInputs,
        compatibilityTestContext(false, 32))
    if not mismatch.isErr() or
        mismatch.unwrapErr().code.value != "core.002b.mismatch" {

        return 10
    }

    let malformed = parseCompatibilityManifest(
        "{\"schema\":\"seen-compatibility-manifest-v1\"}",
        compatibilityTestContext(false, 32))
    if not malformed.isErr() or
        malformed.unwrapErr().code.value != "core.002b.invalid" {

        return 11
    }
    println("PASS: CORE-002B_invalid")

    let limitedContext = compatibilityTestContext(false, 32)
    limitedContext.limits.maxManifestBytes = 1
    let tooLarge = parseCompatibilityManifest(generated.unwrap(), limitedContext)
    if not tooLarge.isErr() or
        tooLarge.unwrapErr().code.value != "core.002b.limit" {

        return 12
    }
    println("PASS: CORE-002B_limit")

    let cancelledRuntime = parseCompatibilityManifest(
        generated.unwrap(), compatibilityTestContext(true, 32))
    if not cancelledRuntime.isErr() or
        cancelledRuntime.unwrapErr().code.value != "core.002b.cancelled" {

        return 13
    }
    println("PASS: CORE-002B_cancel")

    let outputPath = "/tmp/seen-core-002b-compatibility-manifest.json"
    let _ = deleteFile(outputPath)
    let written = writeCompatibilityManifest(
        outputPath, inputs, compatibilityTestContext(false, 32))
    if written.isErr() or not exists(outputPath) { return 14 }
    let loaded = readAndConsumeCompatibilityManifest(
        outputPath, inputs, compatibilityTestContext(false, 32))
    if loaded.isErr() { return 15 }
    if not deleteFile(outputPath) or exists(outputPath) { return 16 }

    let missingInput = readAndConsumeCompatibilityManifest(
        outputPath, inputs, compatibilityTestContext(false, 32))
    if not missingInput.isErr() or
        missingInput.unwrapErr().code.value != "core.002b.io" or
        missingInput.unwrapErr().retry != RetryClass.Transient or
        missingInput.unwrapErr().redaction != RedactionClass.Sensitive {

        return 20
    }

    let cancelledWrite = writeCompatibilityManifest(
        outputPath, inputs, compatibilityTestContext(true, 32))
    if not cancelledWrite.isErr() or exists(outputPath) or
        cancelledWrite.unwrapErr().code.value != "core.002b.cancelled" {

        return 17
    }
    let unsafeWrite = writeCompatibilityManifest(
        "/tmp/../seen-core-002b-invalid.json", inputs,
        compatibilityTestContext(false, 32))
    if not unsafeWrite.isErr() or
        unsafeWrite.unwrapErr().code.value != "core.002b.invalid" {

        return 18
    }
    println("PASS: CORE-002B_cleanup")
    return 0
}

main()
