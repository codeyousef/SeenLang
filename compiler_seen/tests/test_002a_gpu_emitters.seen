import env.env.{args, releaseArgs}
import io.file.{writeTextAtomically}
import codegen.gpu_source.{lowerGpuSource}
import codegen.gpu_options.{GpuOptions}
import codegen.gpu.spirv_emitter.{emitGpuSpirv}
extern "C" fun seen_memory_used_bytes() r: Int64

fun main() r: Int {
    let initial = seen_memory_used_bytes()
    let source = "@compute(64) fun test002aVectorAdd(a: ReadBuffer<Float32>, b: ReadBuffer<Float32>, result: WriteBuffer<Float32>) { let index = globalInvocationId.x; result[index] = a[index] + b[index] }"
    let lowered = lowerGpuSource(source, "test-002a-gpu.seen")
    if lowered.isErr() { abort("instrumented GPU frontend failed") }
    let module = lowered.unwrap(); lowered.releaseContainer()
    let options = GpuOptions.create(); options.backend = "spirv"; options.target = "vulkan1.3"
    let emitted = emitGpuSpirv(module, options)
    if emitted.isErr() { abort("instrumented SPIR-V emitter failed") }
    let words = emitted.unwrap(); emitted.releaseContainer()
    if words.length() < 5 or words[0] != 0x07230203 { abort("SPIR-V artifact header is invalid") }
    words.free(); options.release(); module.release()
    let arguments = args()
    if arguments.length() > 2 { abort("expected at most one GPU source output path") }
    if arguments.length() == 2 and not writeTextAtomically(arguments[1], source) {
        abort("instrumentation GPU source output failed")
    }
    releaseArgs(arguments)
    if seen_memory_used_bytes() != initial { abort("GPU instrumentation probe leaked allocations") }
    println("PASS: TEST-002A_gpu_emitters_software")
    return 0
}
