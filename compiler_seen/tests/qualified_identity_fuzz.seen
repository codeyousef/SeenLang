import typechecker.type_ref.{parseTypeRef}
import bootstrap.allocation_owner.{FrontendAllocationOwner}
import memory.aligned_buffer.{OwnedBuffer}
extern "C" fun seen_string_view_bytes(data: *const UInt8, length: Int64) r: String
extern "C" fun seen_time_monotonic_nanos() r: Int64
extern "C" fun seen_memory_used_bytes() r: Int64
extern "C" fun seen_string_release_owned(value: String) r: Void

fun main() r: Int {
    let corpus = ["pkg.worker-pool::Wrapper<tests.async-002e::Notice>",
        "Option<borrow:*const Int>", "(Int)->Result<Int,Error>", "Array<Int[16]>",
        "generic:bound:Send+ExecutorJob:module.file-name::T"]
    let memory = seen_memory_used_bytes()
    let start = seen_time_monotonic_nanos()
    if start < (0 as Int64) or start > (9223371976854775807 as Int64) { return 1 }
    let deadline = start + (60000000000 as Int64)
    var now = start; var seed = 1101; var cases = 0
    while now < deadline {
        let owner = FrontendAllocationOwner.create(); owner.attach()
        var batch = 0
        while batch < 32 {
            seed = (seed * 48271) % 2147483647
            let source = corpus[seed % corpus.length()]
            let allocated = OwnedBuffer<UInt8>.allocate(source.length() as UInt64, 1 as UInt64, 16 as UInt64)
            if allocated.isErr() { abort("type reference fuzz allocation failed") }
            let bytes = allocated.unwrap(); allocated.releaseContainer()
            var index = 0
            while index < source.length() { bytes.data[index] = source.byteAt(index) as UInt8; index = index + 1 }
            let at = seed % source.length()
            seed = (seed * 48271) % 2147483647
            bytes.data[at] = (seed % 256) as UInt8
            let mutated = seen_string_view_bytes(bytes.data as *const UInt8, source.length() as Int64)
            let parsed = parseTypeRef(mutated, 0, 0)
            if parsed.valid {
                let canonical = parsed.canonical(); let replay = parseTypeRef(canonical, 0, 0)
                if not replay.valid or replay.canonical() != canonical { abort("type reference canonical replay changed") }
            }
            batch = batch + 1; cases = cases + 1
        }
        owner.release()
        if seen_memory_used_bytes() != memory { abort("type reference fuzz leaked temporary allocations") }
        let next = seen_time_monotonic_nanos()
        if next < now { return 2 }; now = next
    }
    corpus.free()
    if cases < 32 { return 3 }
    let count = cases.toString(); println(count); seen_string_release_owned(count)
    println("PASS: type reference fuzz 60s seed=1101 preserves canonical replay and allocation baseline")
    return 0
}
