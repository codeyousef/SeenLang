// Exercise the shipped lexer API, including token spelling and EOF.
import lexer.lexer.{SeenLexer}
import lexer.token_type.{SeenTokenType}

fun main() r: Int {
    let lexer = SeenLexer.new("& | ^ ~ << >>", 1, "en")
    let tokens = lexer.tokenize()
    if tokens.length() != 7 {
        println("FAIL: expected six bitwise tokens and EOF")
        return 1
    }
    if tokens[0].tokenType != SeenTokenType.BitwiseAnd or
        tokens[1].tokenType != SeenTokenType.BitwiseOr or
        tokens[2].tokenType != SeenTokenType.BitwiseXor or
        tokens[3].tokenType != SeenTokenType.BitwiseNot or
        tokens[4].tokenType != SeenTokenType.LeftShift or
        tokens[5].tokenType != SeenTokenType.RightShift or
        tokens[6].tokenType != SeenTokenType.EndOfFile {

        println("FAIL: incorrect bitwise token kinds or EOF")
        return 2
    }
    if tokens[0].value != "&" or tokens[1].value != "|" or
        tokens[2].value != "^" or tokens[3].value != "~" or
        tokens[4].value != "<<" or tokens[5].value != ">>" {

        println("FAIL: incorrect bitwise token spelling")
        return 3
    }
    println("PASS: bitwise lexer kinds, spellings and EOF")
    return 0
}

main()
