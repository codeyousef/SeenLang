/// Resolve a bounded import graph through the public CORE-003A Result API.

import seen_compiler.imports.graph.{newModuleImportGraph,
    moduleImportGraphBeginModule, moduleImportGraphAddEdge,
    resolveRecursiveImportGraph, renderImportGraphResolution}
import release.compatibility.{AsciiString, OperationLimits, OperationContext}

fun exampleContext() r: OperationContext {
    return OperationContext{
        cancellation: false,
        monotonicDeadline: 0,
        limits: OperationLimits{
            maxTargets: 32,
            maxIdentityBytes: 128,
            maxVersionBytes: 64,
            maxManifestBytes: 65536,
            maxPathBytes: 4096,
            maxGraphModules: 16,
            maxGraphEdges: 64,
            maxGraphDepth: 16
        },
        traceId: AsciiString{ value: "import-graph-example" }
    }
}

fun main() r: Int {
    let modules = Array<String>()
    modules.push("app.seen")
    modules.push("lib/api.seen")
    modules.push("lib/model.seen")

    let graph = newModuleImportGraph(modules.length())
    moduleImportGraphBeginModule(graph, 0)
    moduleImportGraphAddEdge(graph, 0, 2)
    moduleImportGraphAddEdge(graph, 0, 1)
    moduleImportGraphBeginModule(graph, 1)
    moduleImportGraphAddEdge(graph, 1, 2)
    moduleImportGraphBeginModule(graph, 2)

    let resolved = resolveRecursiveImportGraph(
        modules, graph, "linux-x86_64", exampleContext())
    if resolved.isErr() {
        println(resolved.unwrapErr().code.value)
        return 1
    }
    println(renderImportGraphResolution(resolved.unwrap()))
    return 0
}

main()
