import seen_compiler.imports.graph.{validateUnmodifiedProductionSources,
    renderProductionSourcePlan}
import core.error.{AsciiString}
import core.operation_context.{OperationLimits, OperationContext}

fun main() r: Int {
    let paths = Array<String>()
    paths.push("src/main.seen")
    let checkout = Array<String>()
    checkout.push(
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    let compilerInput = Array<String>()
    compilerInput.push(
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    let context = OperationContext{
        cancellation: false,
        monotonicDeadline: 0,
        limits: OperationLimits{
            maxTargets: 32,
            maxIdentityBytes: 128,
            maxVersionBytes: 64,
            maxManifestBytes: 65536,
            maxPathBytes: 4096,
            maxGraphModules: 16,
            maxGraphEdges: 64,
            maxGraphDepth: 16
        },
        traceId: AsciiString{ value: "production-source-example" }
    }
    let plan = validateUnmodifiedProductionSources(
        paths, checkout, compilerInput, false, "linux-x86_64", context)
    if plan.isErr() {
        println(plan.unwrapErr().code.value + ": " +
            plan.unwrapErr().message)
        return 1
    }
    println(renderProductionSourcePlan(plan.unwrap()))
    return 0
}

main()
