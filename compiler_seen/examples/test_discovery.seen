import testing.discovery.{TestDiscoveryCandidate, discoverTestsChecked,
    renderTestDiscoveryManifest}
import release.compatibility.{AsciiString, OperationLimits, OperationContext}
import testing.categories.{TestPrimaryCategory, TestPlatformCategory}

fun exampleTestContext() r: OperationContext {
    return OperationContext{
        cancellation: false,
        monotonicDeadline: 0,
        limits: OperationLimits{
            maxTargets: 32, maxIdentityBytes: 128, maxVersionBytes: 64,
            maxManifestBytes: 65536, maxPathBytes: 4096,
            maxGraphModules: 1000, maxGraphEdges: 2000, maxGraphDepth: 64
        },
        traceId: AsciiString{ value: "test-discovery-example" }
    }
}

fun main() r: Int {
    let candidates = Array<TestDiscoveryCandidate>()
    candidates.push(TestDiscoveryCandidate{
        path: "compiler_seen/tests/example_test.seen",
        category: TestPrimaryCategory.Unit,
        ignored: false,
        slow: false,
        platform: TestPlatformCategory.All,
        privileged: false
    })
    let result = discoverTestsChecked(
        candidates, exampleTestContext())
    if not result.success { return 1 }
    print(renderTestDiscoveryManifest(result.values[0]))
    return 0
}

main()
