import seen_compiler.testing.runner.{TestExecutionResult, TestRunReport}
import seen_compiler.testing.reporters.{TestReporterFormat,
    TestReporterRequest, renderTestReportChecked}
import release.compatibility.{AsciiString, OperationLimits, OperationContext}

fun main() r: Int {
    let results = Array<TestExecutionResult>()
    results.push(TestExecutionResult{
        path: "compiler_seen/tests/example.seen",
        status: "passed", exitCode: 0
    })
    let rendered = renderTestReportChecked(TestRunReport{
        schema: "seen-test-run-v1", results: results,
        passed: 1, failed: 0, skipped: 0, exitCode: 0
    }, TestReporterRequest{
        format: TestReporterFormat.Human, suiteName: "seen"
    }, OperationContext{
        cancellation: false, monotonicDeadline: 0,
        limits: OperationLimits{
            maxTargets: 8, maxIdentityBytes: 128, maxVersionBytes: 64,
            maxManifestBytes: 65536, maxPathBytes: 4096,
            maxGraphModules: 8, maxGraphEdges: 16, maxGraphDepth: 8
        }, traceId: AsciiString{ value: "reporter-example" }
    })
    if not rendered.success { return 1 }
    print(rendered.values[0].content)
    return 0
}

main()
