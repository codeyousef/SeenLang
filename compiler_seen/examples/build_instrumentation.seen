import seen_compiler.release.build_instrumentation.{BuildInstrumentationPolicy,
    BuildInstrumentationEvidence,
    sourceOnlyInstrumentationEvidence, compileOnlyInstrumentationEvidence,
    validateBuildInstrumentation, renderBuildInstrumentationEvidence}
import release.compatibility.{AsciiString, OperationLimits, OperationContext}

fun main() r: Int {
    let policy = BuildInstrumentationPolicy{
        debugInfo: true,
        coverage: false,
        sanitizer: "address",
        target: "linux-x86_64",
        reportPath: "reports/instrumentation.json"
    }
    let context = OperationContext{
        cancellation: false,
        monotonicDeadline: 0,
        limits: OperationLimits{
            maxTargets: 32, maxIdentityBytes: 128, maxVersionBytes: 64,
            maxManifestBytes: 65536, maxPathBytes: 4096,
            maxGraphModules: 64, maxGraphEdges: 128, maxGraphDepth: 16
        },
        traceId: AsciiString{ value: "instrumentation-example" }
    }
    let checked = validateBuildInstrumentation(policy, context)
    if checked.isErr() {
        println(checked.unwrapErr().code.value + ": " +
            checked.unwrapErr().message)
        return 1
    }
    println(renderBuildInstrumentationEvidence(BuildInstrumentationEvidence{
        policy: checked.unwrap(),
        compilerHost: sourceOnlyInstrumentationEvidence(),
        seenModules: compileOnlyInstrumentationEvidence(),
        nativeRuntime: compileOnlyInstrumentationEvidence(),
        abiShims: compileOnlyInstrumentationEvidence()
    }))
    return 0
}

main()
