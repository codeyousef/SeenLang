import seen_compiler.testing.runner.{TestRunnerOptions, buildTestRunPlanChecked,
    finalizeTestRunChecked}
import seen_compiler.testing.reporters.{renderTestRunJson}
import seen_compiler.testing.discovery.{TestDiscoveryCandidate,
    TestDiscoveryManifest}
import testing.categories.{TestPrimaryCategory, TestPlatformCategory}
import core.error.{AsciiString}
import core.operation_context.{OperationLimits, OperationContext}

fun main() r: Int {
    let context = OperationContext{
        cancellation: false, monotonicDeadline: 0,
        limits: OperationLimits{
            maxTargets: 32, maxIdentityBytes: 128, maxVersionBytes: 64,
            maxManifestBytes: 65536, maxPathBytes: 4096,
            maxGraphModules: 64, maxGraphEdges: 128, maxGraphDepth: 16
        }, traceId: AsciiString{ value: "test-runner-example" }
    }
    let tests = Array<TestDiscoveryCandidate>()
    tests.push(TestDiscoveryCandidate{
        path: "compiler_seen/tests/example_test.seen",
        category: TestPrimaryCategory.Unit, ignored: false, slow: false,
        platform: TestPlatformCategory.All, privileged: false
    })
    let plan = buildTestRunPlanChecked(TestDiscoveryManifest{
        schema: "seen-test-discovery-v1", tests: tests
    }, TestRunnerOptions{
        filter: "", profile: "ci", jobs: 1, timeoutSeconds: 600,
        includeIgnored: false, includeSlow: false, allowPrivileged: false,
        target: "linux-x86_64"
    }, context)
    if not plan.success { return 1 }
    let exits = Array<Int>()
    exits.push(0)
    let report = finalizeTestRunChecked(plan.values[0], exits, context)
    if not report.success { return 1 }
    print(renderTestRunJson(report.values[0]))
    return report.values[0].exitCode
}

main()
