import seen_compiler.testing.fixture.{FixtureFile, FixtureEnvironment,
    FixtureRequest, planFixtureChecked, renderFixturePlan}
import release.compatibility.{AsciiString, OperationLimits, OperationContext}

fun main() r: Int {
    let files = Array<FixtureFile>()
    files.push(FixtureFile{path: "input.txt", content: "deterministic\n"})
    let environment = Array<FixtureEnvironment>()
    environment.push(FixtureEnvironment{name: "TZ", value: "UTC"})
    let planned = planFixtureChecked(FixtureRequest{
        name: "example", seed: 1101, target: "linux-x86_64",
        files: files, environment: environment
    }, OperationContext{
        cancellation: false, monotonicDeadline: 0,
        limits: OperationLimits{
            maxTargets: 8, maxIdentityBytes: 128, maxVersionBytes: 64,
            maxManifestBytes: 65536, maxPathBytes: 4096,
            maxGraphModules: 16, maxGraphEdges: 8, maxGraphDepth: 8
        }, traceId: AsciiString{ value: "fixture-example" }
    })
    if not planned.success { return 1 }
    print(renderFixturePlan(planned.values[0]))
    return 0
}

main()
