// Canonical Boolean array storage. Array<Bool> uses a zero-extended word slot;
// Boolean values are never addresses of elements for the generic copy ABI.
import str.string.{StringBuilder}
import codegen.ir_optimization.{getNextRegFn}

fun emitArrayBooleanPushImpl(output: StringBuilder, regBox: Array<Int>,
    array: String, value: String) r: Void {
    let widened = getNextRegFn(regBox)
    output.append("  " + widened + " = zext i1 " + value + " to i64\n")
    output.append("  call void @seen_arr_push_i64(ptr " + array + ", i64 " + widened + ")\n")
}

/// Plain Float uses the same scalar array storage as its Float64 alias.
fun arrayScalarStorageTypeImpl(elementType: String) r: String {
    if elementType == "Float" { return "Float64" }
    return elementType
}
