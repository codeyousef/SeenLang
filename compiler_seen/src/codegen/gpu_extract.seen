///
GPU Function Extraction - Identifies @compute/@vertex/@fragment functions in AST
Used by the main compiler to determine which functions need GLSL generation
///

import parser.real_parser.{ProgramNode, ItemNode, FunctionNode, ClassNode}
import typechecker.gpu_types.{gpuParseParameterType, gpuTypeResource}
import typechecker.gpu_workgroup.{gpuParseWorkgroup}
import json.builder.{seen_string_release_owned}

// Check if a program contains any GPU shader functions
fun hasGpuFunctions(program: ProgramNode) r: Bool {
    var i = 0
    while i < program.items.length() {
        if program.items[i].itemType == "Function" {
            let fn = program.items[i].function
            var di = 0
            while di < fn.decorators.length() {
                if fn.decorators[di].name == "compute" or fn.decorators[di].name == "vertex" or fn.decorators[di].name == "fragment" {
                    return true
                }
                di = di + 1
            }
        }
        if program.items[i].itemType == "Class" {
            var methodIndex = 0
            while methodIndex < program.items[i].classNode.methods.length() {
                if getShaderStage(program.items[i].classNode.methods[methodIndex]) >= 0 { return true }
                methodIndex = methodIndex + 1
            }
        }
        i = i + 1
    }
    return false
}

// Get the shader stage for a function (-1 = not a shader)
fun getShaderStage(fn: FunctionNode) r: Int {
    var di = 0
    while di < fn.decorators.length() {
        if fn.decorators[di].name == "compute" {
            return 0
        }
        if fn.decorators[di].name == "vertex" {
            return 1
        }
        if fn.decorators[di].name == "fragment" {
            return 2
        }
        di = di + 1
    }
    return -1
}

// Count validated storage/uniform resources in a typed GPU signature.
fun inferBindingCount(fn: FunctionNode) r: Int {
    var count = 0; var i = 0
    while i < fn.params.length() {
        if gpuTypeResource(gpuParseParameterType(fn.params[i].paramType.typeName)) > 0 { count = count + 1 }
        i = i + 1
    }
    return count
}

///
Extract workgroup size from @compute decorator
Returns "X,Y,Z" string
///
fun extractWorkgroupSize(fn: FunctionNode) r: String {
    var i = 0
    while i < fn.decorators.length() {
        if fn.decorators[i].name == "compute" {
            let group = gpuParseWorkgroup(fn.decorators[i].arguments)
            if not group.valid { group.free(); return "" }
            let x = group.x.toString(); let y = group.y.toString(); let z = group.z.toString()
            let first = x + ","; let second = first + y; let third = second + ","; let result = third + z
            seen_string_release_owned(x); seen_string_release_owned(y); seen_string_release_owned(z)
            seen_string_release_owned(first); seen_string_release_owned(second); seen_string_release_owned(third)
            group.free(); return result
        }
        i = i + 1
    }
    return ""
}

// Get names of all GPU shader functions in a program (pipe-delimited)
fun getGpuFunctionNames(program: ProgramNode) r: String {
    var names = ""
    var count = 0
    var i = 0
    while i < program.items.length() {
        if program.items[i].itemType == "Function" {
            let fn = program.items[i].function
            let stage = getShaderStage(fn)
            if stage >= 0 {
                if count > 0 {
                    names = names + "|"
                }
                names = names + fn.name
                count = count + 1
            }
        }
        i = i + 1
    }
    return names
}

// Get stages of all GPU shader functions (pipe-delimited, parallel to names)
fun getGpuFunctionStages(program: ProgramNode) r: String {
    var stages = ""
    var count = 0
    var i = 0
    while i < program.items.length() {
        if program.items[i].itemType == "Function" {
            let fn = program.items[i].function
            let stage = getShaderStage(fn)
            if stage >= 0 {
                if count > 0 {
                    stages = stages + "|"
                }
                stages = stages + stage.toString()
                count = count + 1
            }
        }
        i = i + 1
    }
    return stages
}

// Count GPU shader functions
fun countGpuFunctions(program: ProgramNode) r: Int {
    var count = 0
    var i = 0
    while i < program.items.length() {
        if program.items[i].itemType == "Function" {
            let fn = program.items[i].function
            let stage = getShaderStage(fn)
            if stage >= 0 {
                count = count + 1
            }
        }
        i = i + 1
    }
    return count
}
