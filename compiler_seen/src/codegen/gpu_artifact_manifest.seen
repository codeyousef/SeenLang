/// Integrity metadata binds the current bytes and reflection to the creator's
/// digest snapshot. Structural checks do not replace the official validator;
/// this manifest always records official validation as not run.
import core.result.{Result, Ok, Err}
import codegen.gpu_ir_model.{GpuIrDiagnostic, gpuIrDiagnostic}
import codegen.gpu_artifact_model.{GpuArtifact}
import codegen.gpu_reflection.{gpuReflectionHash}
import json.builder.{JsonBuilder_new, destroyJsonBuilder, releaseJsonText}
import codegen.gpu.amdgpu_target.{amdTargetValid, amdTargetAttribute}

fun gpuSpirvWordAt(binary: String, index: Int) r: Int {
    let offset = index * 4
    return binary.byteAt(offset) | (binary.byteAt(offset + 1) << 8) | (binary.byteAt(offset + 2) << 16) | (binary.byteAt(offset + 3) << 24)
}
fun gpuSpirvArtifactShape(borrow artifact: GpuArtifact) r: Bool {
    let binary = artifact.binary; let bytes = binary.length()
    if bytes < 20 or bytes > 33554432 or bytes % 4 != 0 or artifact.reflection.length() > 4194304 or
        (artifact.target != "vulkan1.2" and artifact.target != "vulkan1.3") { return false }
    var version = 66816; if artifact.target == "vulkan1.3" { version = 67072 }
    if gpuSpirvWordAt(binary, 0) != 119734787 or gpuSpirvWordAt(binary, 1) != version or
        gpuSpirvWordAt(binary, 2) != 0 or gpuSpirvWordAt(binary, 4) != 0 { return false }
    let bound = gpuSpirvWordAt(binary, 3); if bound < 1 or bound > 1048576 { return false }
    let words = bytes / 4; var cursor = 5
    while cursor < words {
        let count = gpuSpirvWordAt(binary, cursor) >> 16
        if count < 1 or count > words - cursor { return false }; cursor = cursor + count
    }; return true
}
fun gpuTextArtifactBytesValid(borrow artifact: GpuArtifact) r: Bool {
    if artifact.binary.length() < 32 or artifact.binary.length() > 33554432 or artifact.reflection.length() > 4194304 { return false }
    var i = 0
    while i < artifact.binary.length() {
        let byte = artifact.binary.byteAt(i); if byte != 10 and byte != 9 and (byte < 32 or byte > 126) { return false }; i = i + 1
    }; return true
}
fun gpuPtxArtifactShape(borrow artifact: GpuArtifact) r: Bool {
    if artifact.binary.length() < 32 or artifact.binary.length() > 33554432 or artifact.reflection.length() > 4194304 { return false }
    var target = ""; var version = ".version 8.0\n"
    if artifact.target == "sm_70" { target = "\n.target sm_70\n" }; if artifact.target == "sm_75" { target = "\n.target sm_75\n" }
    if artifact.target == "sm_80" { target = "\n.target sm_80\n" }; if artifact.target == "sm_86" { target = "\n.target sm_86\n" }
    if artifact.target == "sm_89" { target = "\n.target sm_89\n" }; if artifact.target == "sm_90" { target = "\n.target sm_90\n" }
    if artifact.target == "sm_100" { target = "\n.target sm_100\n"; version = ".version 8.7\n" }
    if target == "" or not artifact.binary.startsWith(version) or not artifact.binary.contains(target) or
        not artifact.binary.contains("\n.address_size 64\n") or not artifact.binary.contains("// seen-ptx-kernel-v1;") { return false }
    return gpuTextArtifactBytesValid(artifact)
}
fun gpuAmdgpuArtifactShape(borrow artifact: GpuArtifact) r: Bool {
    if artifact.target == "" or not amdTargetValid(artifact.target) or not gpuTextArtifactBytesValid(artifact) { return false }
    if not artifact.binary.startsWith("; seen-amdgpu-kernel-v1; HSA code-object-v5;") or
        not artifact.binary.contains("target triple = \"amdgcn-amd-amdhsa\"") or not artifact.binary.contains("\ndefine amdgpu_kernel void @") { return false }
    return artifact.binary.contains(amdTargetAttribute(artifact.target))
}
fun gpuArtifactIntegrityDiagnostic(backend: String, message: String) r: GpuIrDiagnostic {
    var code = "E_GPU_SPIRV_ARTIFACT"; if backend == "cuda" { code = "E_GPU_PTX_ARTIFACT" }
    if backend == "hip" { code = "E_GPU_AMDGPU_ARTIFACT" }
    return gpuIrDiagnostic(code, message)
}
fun gpuArtifactManifest(borrow artifact: GpuArtifact) r: Result<String, GpuIrDiagnostic> {
    if (artifact.backend == "spirv" and not gpuSpirvArtifactShape(artifact)) or (artifact.backend == "cuda" and not gpuPtxArtifactShape(artifact)) or
        (artifact.backend == "hip" and not gpuAmdgpuArtifactShape(artifact)) or
        (artifact.backend != "spirv" and artifact.backend != "cuda" and artifact.backend != "hip") {
        return Err<String, GpuIrDiagnostic>(gpuArtifactIntegrityDiagnostic(artifact.backend, "GPU artifact header, shape or target is invalid"))
    }
    let binaryResult = gpuReflectionHash(artifact.binary)
    if binaryResult.isErr() { let error = binaryResult.unwrapErr(); binaryResult.releaseContainer(); return Err<String, GpuIrDiagnostic>(error) }
    let binaryHash = binaryResult.unwrap(); binaryResult.releaseContainer(); let reflectionResult = gpuReflectionHash(artifact.reflection)
    if reflectionResult.isErr() {
        let error = reflectionResult.unwrapErr(); reflectionResult.releaseContainer(); releaseJsonText(binaryHash); return Err<String, GpuIrDiagnostic>(error)
    }
    let reflectionHash = reflectionResult.unwrap(); reflectionResult.releaseContainer()
    let matches = binaryHash == artifact.binaryHash and reflectionHash == artifact.reflectionHash
    releaseJsonText(binaryHash); releaseJsonText(reflectionHash)
    if not matches { return Err<String, GpuIrDiagnostic>(gpuArtifactIntegrityDiagnostic(artifact.backend, "artifact bytes or reflection no longer match their digest snapshot")) }
    let builder = JsonBuilder_new(); builder.startObject()
    builder.stringProp("schema", "seen-gpu-artifact-manifest-v1"); builder.stringProp("backend", artifact.backend)
    builder.stringProp("target", artifact.target)
    var order = "little"; var words = artifact.binary.length() / 4
    if artifact.backend == "cuda" { order = "utf-8"; words = 0; builder.stringProp("parameter_abi", "seen-ptx-kernel-v1") }
    if artifact.backend == "hip" { order = "utf-8"; words = 0; builder.stringProp("parameter_abi", "seen-amdgpu-kernel-v1") }
    builder.stringProp("byte_order", order)
    builder.intProp("byte_count", artifact.binary.length()); builder.intProp("word_count", words)
    builder.stringProp("sha256", artifact.binaryHash); builder.stringProp("reflection_sha256", artifact.reflectionHash)
    builder.stringProp("classification", "compile-only"); builder.stringProp("official_validation", "not-run")
    builder.boolProp("hardware_verified", 0); builder.boolProp("gpu_execution_verified", 0); builder.endObject()
    let text = builder.build(); destroyJsonBuilder(builder); return Ok<String, GpuIrDiagnostic>(text)
}
