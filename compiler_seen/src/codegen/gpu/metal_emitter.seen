/// Deterministic offline MSL source. AIR/metallib compilation is a separate
/// official-toolchain boundary and must not be inferred from source emission.
import core.result.{Result, Ok, Err}
import codegen.gpu_ir_model.{GpuIrModule, GpuIrValidation}
import codegen.gpu_ir_verify.{verifyGpuIr}
import codegen.gpu_options.{GpuOptions, validateGpuOptions}
import codegen.gpu_reflection.{gpuReflectionSelection}
import codegen.gpu_reflection_layout.{gpuBackendEntryRequirements}
import codegen.gpu_emission_frame.{createGpuEmissionFrame}
import codegen.gpu.text_buffer.{GpuTextBuffer}
import codegen.gpu.metal_target.{metalTargetValid, metalLanguageVersion, metalSupportedCapabilities}
import codegen.gpu.metal_abi.{metalEntryName, metalEntryLayoutAdmitted}
import codegen.gpu.metal_context.{createGpuMetalFunction}
import codegen.gpu.metal_layout.{metalEntryParameters, metalLoadEntryResource, metalValidateLaunch}
import codegen.gpu.metal_regions.{metalInitializeFrame, metalLowerRegion}

fun metalEmitEntry(borrow module: GpuIrModule, index: Int, text: GpuTextBuffer) r: Void {
    let source = module.functions[index]; let requirements = gpuBackendEntryRequirements(module, index, "metal")
    if (requirements.capabilities & metalSupportedCapabilities()) != requirements.capabilities {
        text.validation.reject("E_GPU_METAL_CAPABILITY", "Metal entry requires an unsupported capability", index, -1, -1); requirements.free(); return
    }
    if not metalEntryLayoutAdmitted(source, requirements.sharedBytes) {
        text.validation.reject("E_GPU_METAL_LAYOUT", "Metal entry exceeds its name, buffer-slot or threadgroup-storage ceiling", index, -1, -1); requirements.free(); return
    }
    let function = createGpuMetalFunction(text.validation, index, source.workgroupX, source.workgroupY, source.workgroupZ)
    let arguments = Array<Int>(); let resources = Array<Int>(); var i = 0
    while i < source.parameterTypes.length() {
        arguments.push(0); resources.push(metalLoadEntryResource(function, source.parameterTypes[i], i)); i = i + 1
    }
    let frame = createGpuEmissionFrame(module, index, arguments, resources); arguments.free(); resources.free()
    metalInitializeFrame(function, frame, 0); metalLowerRegion(module, function, frame, 0, 0); frame.release()
    if text.validation.valid {
        text.literal("\nkernel void "); metalEntryName(text, source.name); text.literal("(\n"); metalEntryParameters(text, source); text.literal(" {\n")
        metalValidateLaunch(text, source); text.owned(function.declarations.finish()); text.owned(function.initializers.finish())
        text.owned(function.body.finish()); text.literal("}\n")
    }; function.release(); requirements.free()
}
fun emitGpuMetal(borrow module: GpuIrModule, borrow options: GpuOptions) r: Result<String, GpuIrValidation> {
    let validation = verifyGpuIr(module)
    if not validation.valid { return Err<String, GpuIrValidation>(validation) }
    let policy = validateGpuOptions(options)
    if policy.code != "" { validation.reject(policy.code, policy.message, -1, -1, -1) }; policy.free()
    if options.backend != "metal" or not metalTargetValid(options.target) {
        validation.reject("E_GPU_METAL_TARGET", "Metal emission requires a supported macOS target", -1, -1, -1)
    }
    if not validation.valid { return Err<String, GpuIrValidation>(validation) }
    let selection = gpuReflectionSelection(module, options)
    if selection.isErr() {
        let error = selection.unwrapErr(); selection.releaseContainer(); validation.reject(error.code, error.message, -1, -1, -1)
        error.free(); return Err<String, GpuIrValidation>(validation)
    }
    let selected = selection.unwrap(); selection.releaseContainer(); let text = GpuTextBuffer.create(validation, "E_GPU_METAL_LIMIT")
    text.literal("// seen-metal-kernel-v1; compile-only; official SDK and device execution unverified\n// msl-version: ")
    text.literal(metalLanguageVersion(options.target)); text.literal("\n#include <metal_stdlib>\nusing namespace metal;\n#pragma clang fp contract(off)\n")
    var i = 0; while i < selected.length() and validation.valid { metalEmitEntry(module, selected[i], text); i = i + 1 }; selected.free()
    if not validation.valid { text.release(); return Err<String, GpuIrValidation>(validation) }
    let output = text.finish(); text.release(); validation.release(); return Ok<String, GpuIrValidation>(output)
}
