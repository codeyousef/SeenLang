import codegen.gpu_ir_model.{GpuIrInstruction}
import codegen.gpu_ir_ops.{GPU_IR_PARAM, GPU_IR_INT, GPU_IR_FLOAT, GPU_IR_BOOL, GPU_IR_BUILTIN, GPU_IR_EXTRACT, GPU_IR_VECTOR, GPU_IR_CAST, GPU_IR_BITCAST, GPU_IR_UNARY, GPU_IR_BINARY, GPU_IR_INTRINSIC, GPU_IR_LENGTH, GPU_IR_LOAD, GPU_IR_STORE, GPU_IR_UNIFORM, GPU_IR_LOCAL_INIT, GPU_IR_LOCAL_LOAD, GPU_IR_LOCAL_STORE, GPU_IR_INDUCTION, GPU_IR_SHARED, GPU_IR_FAULT, GPU_IR_SELECT, GPU_IR_BARRIER, GPU_IR_MEMORY_BARRIER}
import codegen.gpu_emission_frame.{GpuEmissionFrame, gpuEmissionVectorSource}
import codegen.gpu_float_literals.{gpuFloatLiteralWord}
import codegen.gpu.metal_context.{GpuMetalFunction, metalWord, metalAssignment}
import codegen.gpu.metal_layout.{metalBuiltin}
import codegen.gpu.metal_memory.{metalCheckedMemory, metalSharedResource, metalResourceIndex}
import codegen.gpu.metal_math.{metalBinary, metalUnary, metalCast}
import codegen.gpu.metal_intrinsics.{metalIntrinsic}
import codegen.gpu.metal_packed.{metalPacked}
import codegen.gpu.metal_atomics.{metalAtomic}
import codegen.gpu.metal_sync.{metalSynchronization}
import codegen.gpu_ir_ops.{GPU_IR_ATOMIC_LOAD, GPU_IR_ATOMIC_COMPARE}
import codegen.gpu_ir_ops.{GPU_IR_UNPACK, GPU_IR_PACK, GPU_IR_SPECIALIZE}
import typechecker.gpu_types.{gpuTypeLanes}

fun metalLowerValue(function: GpuMetalFunction, frame: GpuEmissionFrame, borrow op: GpuIrInstruction) r: Void {
    let code = op.opcode; var result = 0; let text = function.body
    if code == GPU_IR_PARAM {
        frame.registers[op.result] = frame.arguments[op.immediate]; frame.resourceIndices[op.result] = frame.argumentResources[op.immediate]; return
    }
    if code == GPU_IR_INT { result = function.word(op.text.toInt()) }
    else if code == GPU_IR_FLOAT { result = function.word(gpuFloatLiteralWord(op.text)) }
    else if code == GPU_IR_BOOL { var bits = 0; if op.text == "true" { bits = 1 }; result = function.word(bits) }
    else if code == GPU_IR_BUILTIN { result = metalBuiltin(function, op.immediate) }
    else if code == GPU_IR_EXTRACT { result = frame.registers[op.operands[0]] + op.immediate }
    else if code == GPU_IR_VECTOR {
        result = function.allocate(gpuTypeLanes(op.typeCode)); var lane = 0
        while lane < gpuTypeLanes(op.typeCode) { function.copy(result + lane, gpuEmissionVectorSource(frame, op, lane), 1); lane = lane + 1 }
    } else if code == GPU_IR_CAST or code == GPU_IR_BITCAST {
        let source = op.operands[0]; result = metalCast(function, frame.registerTypes[source], op.typeCode, frame.registers[source], code == GPU_IR_BITCAST)
    } else if code == GPU_IR_UNARY { result = metalUnary(function, op.immediate, op.typeCode, frame.registers[op.operands[0]]) }
    else if code == GPU_IR_BINARY {
        let source = op.operands[0]; result = metalBinary(function, op.immediate, frame.registerTypes[source], frame.registers[source], frame.registers[op.operands[1]])
    } else if code == GPU_IR_INTRINSIC {
        let arguments = Array<Int>(); var i = 0
        while i < op.operands.length() { arguments.push(frame.registers[op.operands[i]]); i = i + 1 }
        result = metalIntrinsic(function, op.immediate, op.typeCode, arguments); arguments.free()
    } else if code == GPU_IR_LENGTH or code == GPU_IR_UNIFORM {
        let resource = metalResourceIndex(function, frame, op.operands[0]); if resource < 0 { return }
        if code == GPU_IR_LENGTH { result = function.resources[resource].length } else { result = function.resources[resource].uniformBase }
    } else if code == GPU_IR_LOAD or code == GPU_IR_STORE {
        let resource = metalResourceIndex(function, frame, op.operands[0]); if resource < 0 { return }
        var value = 0; if code == GPU_IR_STORE { value = frame.registers[op.operands[2]] }
        let position = op.operands[1]
        result = metalCheckedMemory(function, resource, frame.registers[position], frame.registerTypes[position], value, code == GPU_IR_STORE)
    } else if code == GPU_IR_LOCAL_INIT {
        let source = op.operands[0]; let count = gpuTypeLanes(frame.registerTypes[source]); let slot = function.allocate(count)
        frame.localPointers[op.immediate] = slot; function.copy(slot, frame.registers[source], count)
    } else if code == GPU_IR_LOCAL_LOAD {
        result = function.allocate(gpuTypeLanes(op.typeCode)); function.copy(result, frame.localPointers[op.immediate], gpuTypeLanes(op.typeCode))
    } else if code == GPU_IR_LOCAL_STORE {
        let source = op.operands[0]; function.copy(frame.localPointers[op.immediate], frame.registers[source], gpuTypeLanes(frame.registerTypes[source]))
    } else if code == GPU_IR_INDUCTION {
        if frame.inductionPointers.length() == 0 { function.error("E_GPU_METAL_CONTROL", "Metal induction lacks its loop frame"); return }
        result = function.allocate(1); function.copy(result, frame.inductionPointers[frame.inductionPointers.length() - 1], 1)
    } else if code == GPU_IR_SHARED { frame.resourceIndices[op.result] = metalSharedResource(function, op.typeCode, op.immediate); return }
    else if code == GPU_IR_FAULT { function.fault(op.immediate) }
    else if code == GPU_IR_SELECT {
        result = function.allocate(gpuTypeLanes(op.typeCode)); var lane = 0
        while lane < gpuTypeLanes(op.typeCode) {
            metalAssignment(text, result + lane); metalWord(text, frame.registers[op.operands[0]]); text.literal(" != 0u ? ")
            metalWord(text, frame.registers[op.operands[1]] + lane); text.literal(" : "); metalWord(text, frame.registers[op.operands[2]] + lane); text.literal(";\n"); lane = lane + 1
        }
    } else if code == GPU_IR_UNPACK or code == GPU_IR_PACK { result = metalPacked(function, frame, op) }
    else if code == GPU_IR_SPECIALIZE { result = frame.registers[op.operands[0]] }
    else if code >= GPU_IR_ATOMIC_LOAD and code <= GPU_IR_ATOMIC_COMPARE {
        let resource = metalResourceIndex(function, frame, op.operands[0]); if resource < 0 { return }
        result = metalAtomic(function, frame, resource, op)
    } else if code == GPU_IR_BARRIER or code == GPU_IR_MEMORY_BARRIER {
        metalSynchronization(function, op); return
    } else { function.error("E_GPU_METAL_CAPABILITY", "Metal instruction requires unavailable capability lowering"); return }
    if op.result > 0 { frame.registers[op.result] = result }
}
