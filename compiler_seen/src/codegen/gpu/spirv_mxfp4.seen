/// Bootstrap-compatible entry points delegate to the shared scalar policy.
import codegen.gpu.spirv_function.{GpuSpirvFunction}
import codegen.gpu.spirv_scalar_plan.{spirvScalarPlanValue}
import codegen.gpu.scalar_packed.{scalarPayloadPlan}
import codegen.gpu_precision_formats.{GPU_FORMAT_MXFP4}

fun spirvPackMxfp4(function: GpuSpirvFunction, value: Int, scale: Int) r: Int {
    return spirvScalarPlanValue(function, scalarPayloadPlan(GPU_FORMAT_MXFP4, value, scale, true))
}
fun spirvUnpackMxfp4(function: GpuSpirvFunction, payload: Int, scale: Int) r: Int {
    return spirvScalarPlanValue(function, scalarPayloadPlan(GPU_FORMAT_MXFP4, payload, scale, false))
}
