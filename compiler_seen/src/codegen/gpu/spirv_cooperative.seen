/// Native KHR cooperative matrices. Packed input offsets/strides use UInt32
/// words; accumulator stores use their 32-bit element units. Bounds predicates
/// are subgroup-uniform and checked before forming any matrix data pointer.
import codegen.gpu_ir_model.{GpuIrInstruction}
import codegen.gpu_ir_ops.{GPU_IR_COOP_LOAD, GPU_IR_COOP_FILL, GPU_IR_COOP_MMA}
import codegen.gpu.spirv_function.{GpuSpirvFunction}
import codegen.gpu_emission_frame.{GpuEmissionFrame}
import codegen.gpu.spirv_memory.{spirvResourceLength, spirvElementPointer}
import codegen.gpu.spirv_math.{spirvBinaryValue}
import codegen.gpu_matrix_types.{gpuMatrixRows, gpuMatrixColumns, gpuMatrixFormat}
import codegen.gpu_precision_formats.{gpuPrecisionBits, gpuPrecisionValueType}

fun spirvMatrixBounds(function: GpuSpirvFunction, resourceIndex: Int, offset: Int, stride: Int,
    rows: Int, columns: Int, bits: Int, store: Bool) r: Int {
    let context = function.context
    if resourceIndex < 0 or resourceIndex >= function.resources.length() or rows < 2 or columns < 1 or
        (bits != 8 and bits != 16 and bits != 32) {
        context.error("E_GPU_SPIRV_LAYOUT", "SPIR-V cooperative resource or geometry is unsupported"); return 0
    }
    let length = spirvResourceLength(function, function.resources[resourceIndex])
    let rowWords = context.constant(3, (columns * bits + 31) / 32)
    let offsetValid = spirvBinaryValue(function, 178, 1, offset, length)
    let available = spirvBinaryValue(function, 130, 3, length, offset)
    let rowFits = spirvBinaryValue(function, 178, 1, rowWords, available)
    let remainder = spirvBinaryValue(function, 130, 3, available, rowWords)
    let maximumStride = spirvBinaryValue(function, 134, 3, remainder, context.constant(3, rows - 1))
    let strideFits = spirvBinaryValue(function, 178, 1, stride, maximumStride)
    var valid = spirvBinaryValue(function, 167, 1, offsetValid, rowFits)
    valid = spirvBinaryValue(function, 167, 1, valid, strideFits)
    if store {
        let disjoint = spirvBinaryValue(function, 174, 1, stride, rowWords)
        valid = spirvBinaryValue(function, 167, 1, valid, disjoint)
    }; return valid
}
fun spirvCooperativeMemory(function: GpuSpirvFunction, frame: GpuEmissionFrame, borrow op: GpuIrInstruction) r: Int {
    let context = function.context; let load = op.opcode == GPU_IR_COOP_LOAD
    var resourceOperand = 0; var offsetOperand = 1; var strideOperand = 2; var matrixType = op.typeCode
    if not load { resourceOperand = 1; offsetOperand = 2; strideOperand = 3; matrixType = frame.registerTypes[op.operands[0]] }
    let resourceIndex = frame.resourceIndices[op.operands[resourceOperand]]
    let offset = frame.registers[op.operands[offsetOperand]]; let stride = frame.registers[op.operands[strideOperand]]
    var rows = gpuMatrixRows(matrixType); var columns = gpuMatrixColumns(matrixType)
    if op.immediate == 2 { let saved = rows; rows = columns; columns = saved }
    let typeId = context.valueType(matrixType)
    if not context.validation.valid { return 0 }
    let valid = spirvMatrixBounds(function, resourceIndex, offset, stride, rows, columns, gpuPrecisionBits(gpuMatrixFormat(matrixType)), not load)
    if not context.validation.valid { return 0 }
    let yes = context.id(); let no = context.id(); let merge = context.id(); var loaded = 0
    function.emit(247, [merge, 0]); function.conditional(valid, yes, no); function.label(yes)
    let pointer = spirvElementPointer(function, function.resources[resourceIndex], offset)
    let layout = context.constant(3, op.immediate - 1)
    if load { loaded = context.id(); function.emit(4457, [typeId, loaded, pointer, layout, stride]) }
    else { function.emit(4458, [pointer, frame.registers[op.operands[0]], layout, stride]) }
    function.branch(merge); function.label(no); function.faultKind(1); function.branch(merge); function.label(merge)
    if not load { return 0 }
    let result = context.id(); function.emit(245, [typeId, result, loaded, yes, context.zero(matrixType), no]); return result
}
fun spirvCooperative(function: GpuSpirvFunction, frame: GpuEmissionFrame, borrow op: GpuIrInstruction) r: Int {
    let context = function.context
    if op.opcode == GPU_IR_COOP_LOAD or (op.opcode != GPU_IR_COOP_FILL and op.opcode != GPU_IR_COOP_MMA) {
        return spirvCooperativeMemory(function, frame, op)
    }
    let typeId = context.valueType(op.typeCode); if not context.validation.valid { return 0 }; let result = context.id()
    if op.opcode == GPU_IR_COOP_FILL { function.emit(80, [typeId, result, frame.registers[op.operands[0]]]); return result }
    var signed = 0; var i = 0
    while i < 3 {
        if gpuPrecisionValueType(gpuMatrixFormat(frame.registerTypes[op.operands[i]])) == 2 { signed = signed | (1 << i) }; i = i + 1
    }
    if gpuPrecisionValueType(gpuMatrixFormat(op.typeCode)) == 2 { signed = signed | 8 }
    function.emit(4459, [typeId, result, frame.registers[op.operands[0]], frame.registers[op.operands[1]], frame.registers[op.operands[2]], signed]); return result
}
