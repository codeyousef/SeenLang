/// Verified non-control instructions map to private word slots. Resource
/// identities borrow the entry table; unsupported instructions always reject.
import codegen.gpu_ir_model.{GpuIrInstruction}
import codegen.gpu_ir_ops.{GPU_IR_PARAM, GPU_IR_INT, GPU_IR_FLOAT, GPU_IR_BOOL, GPU_IR_BUILTIN, GPU_IR_EXTRACT, GPU_IR_VECTOR, GPU_IR_CAST, GPU_IR_BITCAST, GPU_IR_UNARY, GPU_IR_BINARY, GPU_IR_INTRINSIC, GPU_IR_LENGTH, GPU_IR_LOAD, GPU_IR_STORE, GPU_IR_UNIFORM, GPU_IR_LOCAL_INIT, GPU_IR_LOCAL_LOAD, GPU_IR_LOCAL_STORE, GPU_IR_INDUCTION, GPU_IR_SHARED, GPU_IR_FAULT, GPU_IR_SELECT, GPU_IR_BARRIER, GPU_IR_MEMORY_BARRIER}
import codegen.gpu_emission_frame.{GpuEmissionFrame, gpuEmissionVectorSource}
import codegen.gpu_float_literals.{gpuFloatLiteralWord}
import codegen.gpu.amdgpu_context.{GpuAmdFunction}
import codegen.gpu.amdgpu_builtins.{amdBuiltin}
import codegen.gpu.amdgpu_memory.{amdCheckedMemory, amdSharedResource, amdResourceIndex}
import codegen.gpu.amdgpu_math.{amdBinary, amdUnary}
import codegen.gpu.amdgpu_casts.{amdCast}
import codegen.gpu.amdgpu_intrinsics.{amdIntrinsic}
import codegen.gpu.amdgpu_sync.{amdSynchronization}
import codegen.gpu.amdgpu_atomics.{amdAtomic}
import codegen.gpu_ir_ops.{GPU_IR_ATOMIC_LOAD, GPU_IR_ATOMIC_COMPARE}
import codegen.gpu.amdgpu_packed.{amdPacked}
import codegen.gpu_ir_ops.{GPU_IR_UNPACK, GPU_IR_PACK, GPU_IR_SPECIALIZE}
import codegen.gpu.amdgpu_subgroup.{amdSubgroup}
import codegen.gpu_ir_ops.{GPU_IR_SUBGROUP}
import typechecker.gpu_types.{gpuTypeLanes}
import codegen.gpu.amdgpu_matrix_plan.{amdValueWords}
import codegen.gpu.amdgpu_cooperative.{amdCooperative}
import codegen.gpu_ir_ops.{GPU_IR_COOP_LOAD, GPU_IR_COOP_FILL}
fun amdLowerValue(function: GpuAmdFunction, frame: GpuEmissionFrame, borrow op: GpuIrInstruction) r: Void {
    let code = op.opcode; var result = 0
    if code == GPU_IR_PARAM {
        frame.registers[op.result] = frame.arguments[op.immediate]; frame.resourceIndices[op.result] = frame.argumentResources[op.immediate]; return
    }
    if code == GPU_IR_INT { result = function.word(op.text.toInt()) }
    else if code == GPU_IR_FLOAT { result = function.word(gpuFloatLiteralWord(op.text)) }
    else if code == GPU_IR_BOOL { var word = 0; if op.text == "true" { word = 1 }; result = function.word(word) }
    else if code == GPU_IR_BUILTIN { result = amdBuiltin(function, op.immediate) }
    else if code == GPU_IR_EXTRACT { result = frame.registers[op.operands[0]] + op.immediate }
    else if code == GPU_IR_VECTOR {
        result = function.allocate(gpuTypeLanes(op.typeCode)); var lane = 0
        while lane < gpuTypeLanes(op.typeCode) { function.copy(result + lane, gpuEmissionVectorSource(frame, op, lane), 1); lane = lane + 1 }
    } else if code == GPU_IR_CAST or code == GPU_IR_BITCAST {
        let source = op.operands[0]; result = amdCast(function, frame.registerTypes[source], op.typeCode, frame.registers[source], code == GPU_IR_BITCAST)
    } else if code == GPU_IR_UNARY { result = amdUnary(function, op.immediate, op.typeCode, frame.registers[op.operands[0]]) }
    else if code == GPU_IR_BINARY {
        let left = op.operands[0]; result = amdBinary(function, op.immediate, frame.registerTypes[left], frame.registers[left], frame.registers[op.operands[1]])
    } else if code == GPU_IR_INTRINSIC {
        let arguments = Array<Int>(); var i = 0
        while i < op.operands.length() { arguments.push(frame.registers[op.operands[i]]); i = i + 1 }
        result = amdIntrinsic(function, op.immediate, op.typeCode, arguments); arguments.free()
    } else if code == GPU_IR_LENGTH or code == GPU_IR_UNIFORM {
        let index = amdResourceIndex(function, frame, op.operands[0]); if index < 0 { return }
        if code == GPU_IR_LENGTH { result = function.resources[index].length } else { result = function.resources[index].uniformBase }
    } else if code == GPU_IR_LOAD or code == GPU_IR_STORE {
        let index = amdResourceIndex(function, frame, op.operands[0]); if index < 0 { return }
        let position = op.operands[1]; var value = 0; if code == GPU_IR_STORE { value = frame.registers[op.operands[2]] }
        result = amdCheckedMemory(function, index, frame.registers[position], frame.registerTypes[position], value, code == GPU_IR_STORE)
    } else if code == GPU_IR_LOCAL_INIT {
        let source = op.operands[0]; let count = amdValueWords(frame.registerTypes[source]); let slot = function.allocate(count)
        frame.localPointers[op.immediate] = slot; function.copy(slot, frame.registers[source], count)
    } else if code == GPU_IR_LOCAL_LOAD {
        result = function.allocate(amdValueWords(op.typeCode)); function.copy(result, frame.localPointers[op.immediate], amdValueWords(op.typeCode))
    } else if code == GPU_IR_LOCAL_STORE {
        let source = op.operands[0]; function.copy(frame.localPointers[op.immediate], frame.registers[source], amdValueWords(frame.registerTypes[source]))
    } else if code == GPU_IR_INDUCTION {
        if frame.inductionPointers.length() == 0 { function.error("E_GPU_AMDGPU_CONTROL", "AMDGPU induction lacks its loop frame"); return }
        result = function.allocate(1); function.copy(result, frame.inductionPointers[frame.inductionPointers.length() - 1], 1)
    } else if code == GPU_IR_SHARED { frame.resourceIndices[op.result] = amdSharedResource(function, op.typeCode, op.immediate); return }
    else if code == GPU_IR_FAULT { function.fault(op.immediate) }
    else if code == GPU_IR_SELECT {
        let predicate = function.compare("ne", frame.registers[op.operands[0]], function.word(0), false)
        result = function.allocate(amdValueWords(op.typeCode)); var lane = 0
        while lane < amdValueWords(op.typeCode) {
            function.select(result + lane, frame.registers[op.operands[1]] + lane, frame.registers[op.operands[2]] + lane, predicate); lane = lane + 1
        }
    } else if code >= GPU_IR_ATOMIC_LOAD and code <= GPU_IR_ATOMIC_COMPARE { result = amdAtomic(function, frame, op) }
    else if code == GPU_IR_UNPACK or code == GPU_IR_PACK { result = amdPacked(function, frame, op) }
    else if code == GPU_IR_SPECIALIZE { result = frame.registers[op.operands[0]] }
    else if code == GPU_IR_SUBGROUP { result = amdSubgroup(function, frame, op) }
    else if code >= GPU_IR_COOP_LOAD and code <= GPU_IR_COOP_FILL { result = amdCooperative(function, frame, op) }
    else if code == GPU_IR_BARRIER or code == GPU_IR_MEMORY_BARRIER { amdSynchronization(function, op); return }
    else { function.error("E_GPU_AMDGPU_CAPABILITY", "AMDGPU instruction requires unavailable capability lowering"); return }
    if op.result > 0 { frame.registers[op.result] = result }
}
