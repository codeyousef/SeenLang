/// Artifact construction borrows one verified module and options. It returns
/// owned bytes/reflection/digests together, or one owned validation. Every
/// partially completed phase is released before a typed error is propagated.
import core.result.{Result, Ok, Err}
import codegen.gpu_ir_model.{GpuIrModule, GpuIrDiagnostic, GpuIrValidation}
import codegen.gpu_options.{GpuOptions}
import codegen.gpu.spirv_emitter.{emitGpuSpirv}
import codegen.gpu.spirv_binary.{encodeGpuSpirvBinary}
import codegen.gpu.spirv_artifact_model.{GpuSpirvArtifact}
import codegen.gpu_reflection.{reflectGpuModule, gpuReflectionHash}
import json.builder.{releaseJsonText}

fun gpuArtifactDiagnostic(error: GpuIrDiagnostic) r: GpuIrValidation {
    let validation = GpuIrValidation.create(); validation.reject(error.code, error.message, -1, -1, -1); error.free(); return validation
}
fun buildGpuSpirvArtifact(borrow module: GpuIrModule, borrow options: GpuOptions) r: Result<GpuSpirvArtifact, GpuIrValidation> {
    let emitted = emitGpuSpirv(module, options)
    if emitted.isErr() { let error = emitted.unwrapErr(); emitted.releaseContainer(); return Err<GpuSpirvArtifact, GpuIrValidation>(error) }
    let words = emitted.unwrap(); emitted.releaseContainer(); let encoded = encodeGpuSpirvBinary(words); words.free()
    if encoded.isErr() {
        let error = encoded.unwrapErr(); encoded.releaseContainer(); return Err<GpuSpirvArtifact, GpuIrValidation>(gpuArtifactDiagnostic(error))
    }
    let binary = encoded.unwrap(); encoded.releaseContainer(); let reflected = reflectGpuModule(module, options)
    if reflected.isErr() {
        let error = reflected.unwrapErr(); reflected.releaseContainer(); releaseJsonText(binary); return Err<GpuSpirvArtifact, GpuIrValidation>(error)
    }
    let reflection = reflected.unwrap(); reflected.releaseContainer(); let hashed = gpuReflectionHash(binary)
    if hashed.isErr() {
        let error = hashed.unwrapErr(); hashed.releaseContainer(); releaseJsonText(binary); releaseJsonText(reflection)
        return Err<GpuSpirvArtifact, GpuIrValidation>(gpuArtifactDiagnostic(error))
    }
    let binaryHash = hashed.unwrap(); hashed.releaseContainer(); let reflectedHash = gpuReflectionHash(reflection)
    if reflectedHash.isErr() {
        let error = reflectedHash.unwrapErr(); reflectedHash.releaseContainer(); releaseJsonText(binary); releaseJsonText(reflection); releaseJsonText(binaryHash)
        return Err<GpuSpirvArtifact, GpuIrValidation>(gpuArtifactDiagnostic(error))
    }
    let reflectionHash = reflectedHash.unwrap(); reflectedHash.releaseContainer(); var target = "vulkan1.2"
    if options.target == "vulkan1.3" { target = "vulkan1.3" }
    return Ok<GpuSpirvArtifact, GpuIrValidation>(GpuSpirvArtifact{binary: binary, reflection: reflection,
        binaryHash: binaryHash, reflectionHash: reflectionHash, target: target})
}
