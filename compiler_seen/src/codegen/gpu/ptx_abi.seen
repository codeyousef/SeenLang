/// CUDA's physical argument plan is versioned and included in the entry ABI
/// digest. Logical bindings remain backend-independent; offsets describe the
/// packed launch buffer alternative to CUDA's array-of-argument-pointers API.
import json.builder.{JsonBuilder}
import codegen.gpu_ir_model.{GpuIrFunction}
import typechecker.gpu_types.{gpuTypeResource}
fun ptxAlignParameter(offset: Int, alignment: Int) r: Int { return ((offset + alignment - 1) / alignment) * alignment }
fun ptxKernelParameterBytes(borrow source: GpuIrFunction, fault: Bool) r: Int {
    var offset = 0; var index = 0
    while index < source.parameterTypes.length() {
        if gpuTypeResource(source.parameterTypes[index]) == 4 { offset = ptxAlignParameter(offset, 16) + 16 }
        else { offset = ptxAlignParameter(offset, 8) + 8; offset = ptxAlignParameter(offset, 4) + 4 }; index = index + 1
    }; if fault { offset = ptxAlignParameter(offset, 8) + 8 }; return offset
}
fun ptxWriteParameter(builder: JsonBuilder, index: Int, binding: Int, kind: String, offset: Int, bytes: Int, alignment: Int) r: Void {
    builder.startObject(); builder.intProp("index", index); builder.intProp("binding", binding); builder.stringProp("kind", kind)
    builder.intProp("offset", offset); builder.intProp("bytes", bytes); builder.intProp("alignment", alignment); builder.endObject()
}
fun ptxReflectionEntryAbi(builder: JsonBuilder, borrow source: GpuIrFunction, fault: Bool) r: Void {
    builder.stringProp("parameter_abi", "seen-ptx-kernel-v1"); builder.intProp("packed_parameter_bytes", ptxKernelParameterBytes(source, fault))
    builder.key("parameters"); builder.startArray(); var physical = 0; var offset = 0; var binding = 0
    while binding < source.parameterTypes.length() {
        if gpuTypeResource(source.parameterTypes[binding]) == 4 {
            offset = ptxAlignParameter(offset, 16); ptxWriteParameter(builder, physical, binding, "uniform_value", offset, 16, 16)
            offset = offset + 16; physical = physical + 1
        } else {
            offset = ptxAlignParameter(offset, 8); ptxWriteParameter(builder, physical, binding, "storage_address", offset, 8, 8)
            offset = offset + 8; physical = physical + 1
            offset = ptxAlignParameter(offset, 4); ptxWriteParameter(builder, physical, binding, "storage_length", offset, 4, 4)
            offset = offset + 4; physical = physical + 1
        }; binding = binding + 1
    }
    if fault { offset = ptxAlignParameter(offset, 8); ptxWriteParameter(builder, physical, binding, "fault_address", offset, 8, 8); physical = physical + 1 }
    builder.endArray(); builder.intProp("parameter_count", physical)
}
