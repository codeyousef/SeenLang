/// PTX rendering of portable scalar plans. Registers contain raw 32-bit words;
/// comparisons normalize predicates to Boolean words before a later select.
import codegen.gpu.scalar_plan.{GpuScalarPlan, GpuScalarValues}
import codegen.gpu.ptx_context.{GpuPtxFunction}
import codegen.gpu.scalar_ops.{SCALAR_BITCAST, SCALAR_FLOAT_TO_UINT, SCALAR_UINT_TO_FLOAT,
    SCALAR_ADD, SCALAR_SUBTRACT, SCALAR_MULTIPLY, SCALAR_FLOAT_MULTIPLY,
    SCALAR_SHIFT_RIGHT, SCALAR_SHIFT_LEFT, SCALAR_BIT_OR, SCALAR_BIT_XOR, SCALAR_BIT_AND,
    SCALAR_BOOL_OR, SCALAR_BOOL_AND, SCALAR_EQUAL, SCALAR_NOT_EQUAL,
    SCALAR_UNSIGNED_GREATER, SCALAR_UNSIGNED_GREATER_EQUAL, SCALAR_UNSIGNED_LESS, SCALAR_UNSIGNED_LESS_EQUAL,
    SCALAR_SIGNED_GREATER_EQUAL, SCALAR_SIGNED_LESS, SCALAR_SIGNED_LESS_EQUAL}

fun scalarPtxArithmetic(operation: Int) r: String {
    if operation == SCALAR_ADD { return "add.u32" }; if operation == SCALAR_SUBTRACT { return "sub.u32" }
    if operation == SCALAR_MULTIPLY { return "mul.lo.u32" }; if operation == SCALAR_FLOAT_MULTIPLY { return "mul.rn.f32" }
    if operation == SCALAR_SHIFT_RIGHT { return "shr.u32" }; if operation == SCALAR_SHIFT_LEFT { return "shl.b32" }
    if operation == SCALAR_BIT_OR or operation == SCALAR_BOOL_OR { return "or.b32" }
    if operation == SCALAR_BIT_XOR { return "xor.b32" }
    if operation == SCALAR_BIT_AND or operation == SCALAR_BOOL_AND { return "and.b32" }; return ""
}
fun scalarPtxComparison(operation: Int) r: String {
    if operation == SCALAR_EQUAL { return "setp.eq.u32" }; if operation == SCALAR_NOT_EQUAL { return "setp.ne.u32" }
    if operation == SCALAR_UNSIGNED_GREATER { return "setp.gt.u32" }; if operation == SCALAR_UNSIGNED_GREATER_EQUAL { return "setp.ge.u32" }
    if operation == SCALAR_UNSIGNED_LESS { return "setp.lt.u32" }; if operation == SCALAR_UNSIGNED_LESS_EQUAL { return "setp.le.u32" }
    if operation == SCALAR_SIGNED_GREATER_EQUAL { return "setp.ge.s32" }; if operation == SCALAR_SIGNED_LESS { return "setp.lt.s32" }
    if operation == SCALAR_SIGNED_LESS_EQUAL { return "setp.le.s32" }; return ""
}
fun ptxScalarBinary(function: GpuPtxFunction, operation: Int, left: Int, right: Int) r: Int {
    let result = function.allocate(0, 1); let arithmetic = scalarPtxArithmetic(operation)
    if arithmetic != "" { function.body.binary(arithmetic, result, left, right); return result }
    let comparison = scalarPtxComparison(operation)
    if comparison == "" { function.error("E_GPU_PTX_PRECISION", "PTX scalar operation is unsupported"); return 0 }
    let predicate = function.allocate(2, 1); function.body.predicate(comparison, predicate, left, right)
    function.body.select(result, function.word(1), function.word(0), predicate); return result
}
fun emitPtxScalarPlan(function: GpuPtxFunction, plan: GpuScalarPlan) r: GpuScalarValues {
    let output = GpuScalarValues{value: 0, laneValid: 0, scaleValid: 0}; let text = function.body
    if not plan.validate() {
        function.error("E_GPU_PTX_PRECISION", plan.message); plan.release(); return output
    }
    let values = Array<Int>.withLength(plan.codes.length() + 1); var index = 0
    while index < plan.codes.length() and function.validation.valid {
        let code = plan.codes[index]; let first = plan.first[index]; var value = 0
        if code == 0 { value = first }
        else if code == 1 { value = function.word(first) }
        else if code == 2 {
            value = function.allocate(0, 1); let predicate = function.allocate(2, 1)
            text.predicate("setp.ne.u32", predicate, values[first], function.word(0))
            text.select(value, values[plan.second[index]], values[plan.third[index]], predicate)
        } else if code == 3 {
            value = function.allocate(0, 1); text.unary("cvt.rni.f32.f32", value, values[first])
        } else if code >= 4 and code <= 6 {
            value = function.allocate(0, 1)
            if code == 4 { text.literal("bfe.u32 ") }
            else if code == 5 { text.literal("bfe.s32 ") }
            else { text.literal("bfi.b32 ") }
            text.reg("r", value); text.literal(", ")
            if code == 6 {
                // PTX places the inserted payload before the preserved base.
                text.reg("r", values[plan.second[index]]); text.literal(", "); text.reg("r", values[first])
            } else { text.reg("r", values[first]); text.literal(", "); text.reg("r", values[plan.second[index]]) }
            text.literal(", "); text.reg("r", values[plan.third[index]])
            if code == 6 { text.literal(", "); text.reg("r", values[plan.fourth[index]]) }; text.literal(";\n")
        } else if code >= 100 and code < 200 {
            let operation = code - 100
            if operation == SCALAR_BITCAST { value = values[first] }
            else {
                value = function.allocate(0, 1); var instruction = "cvt.rzi.u32.f32"
                if operation == SCALAR_UINT_TO_FLOAT { instruction = "cvt.rn.f32.u32" }
                else if operation != SCALAR_FLOAT_TO_UINT { function.error("E_GPU_PTX_PRECISION", "PTX scalar conversion is unsupported"); break }
                text.unary(instruction, value, values[first])
            }
        } else { value = ptxScalarBinary(function, code - 200, values[first], values[plan.second[index]]) }
        values[index + 1] = value; index = index + 1
    }
    if function.validation.valid {
        output.value = values[plan.result]
        if plan.laneValid > 0 { output.laneValid = values[plan.laneValid] }
        if plan.scaleValid > 0 { output.scaleValid = values[plan.scaleValid] }
    }
    values.free(); plan.release(); return output
}
fun ptxScalarPlanValue(function: GpuPtxFunction, plan: GpuScalarPlan) r: Int {
    let output = emitPtxScalarPlan(function, plan); let result = output.value; output.free(); return result
}
