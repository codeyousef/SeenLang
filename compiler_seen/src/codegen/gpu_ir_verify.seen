/// The only backend entry gate: bounded headers, structure, definitions, uses,
/// types, exits, call graph, convergence, then exact derived requirements.
/// Validation borrows the module and owns only its bounded diagnostic records.
import codegen.gpu_ir_model.{GpuIrModule, GpuIrFunction, GpuIrValidation}
import codegen.gpu_ir_facts.{GpuIrFacts}
import codegen.gpu_ir_structure.{gpuIrModuleCountsValid, gpuIrFunctionStructure}
import codegen.gpu_ir_definitions.{gpuIrFunctionDefinitions, gpuIrFunctionUses}
import codegen.gpu_ir_instruction_types.{gpuIrInstructionValueTypes}
import codegen.gpu_ir_memory_rules.{gpuIrMemoryTypesValid, gpuIrSubgroupTypesValid}
import codegen.gpu_ir_regions.{gpuIrRegionExits, gpuIrFunctionSharedBytes}
import codegen.gpu_ir_call_graph.{GpuIrCallFacts, gpuIrCallGraphValid}
import codegen.gpu_ir_convergence.{gpuIrConvergenceBlock}
import codegen.gpu_ir_requirements.{gpuIrInstructionCapabilities, gpuIrInstructionNeedsFaultBuffer}
import codegen.gpu_ir_ops.{gpuIrMemory, GPU_IR_SUBGROUP}

fun gpuIrFunctionTypesValid(borrow module: GpuIrModule, borrow function: GpuIrFunction,
    borrow facts: GpuIrFacts, validation: GpuIrValidation, functionIndex: Int) r: Bool {
    var blockIndex = 0
    while blockIndex < function.blocks.length() {
        let block = function.blocks[blockIndex]; var opIndex = 0
        while opIndex < block.instructions.length() {
            let op = block.instructions[opIndex]; var valid = false
            if gpuIrMemory(op.opcode) { valid = gpuIrMemoryTypesValid(op, facts) }
            else if op.opcode == GPU_IR_SUBGROUP { valid = gpuIrSubgroupTypesValid(op, facts) }
            else { valid = gpuIrInstructionValueTypes(module, function, op, facts) }
            if not valid {
                validation.reject("E_GPU_IR_TYPE", "GPU operation types, access or semantic immediate are invalid", functionIndex, blockIndex, opIndex); return false
            }
            opIndex = opIndex + 1
        }
        blockIndex = blockIndex + 1
    }
    let exits = gpuIrRegionExits(function, facts, validation, functionIndex, 0)
    if exits == 0 { return false }
    if (exits != 1 and exits != 2 and exits != 3) or (function.returnType != 0 and exits != 2) {
        validation.reject("E_GPU_IR_RETURN", "GPU function has an escaping region exit or missing return", functionIndex, 0, -1); return false
    }
    return true
}
fun gpuIrPrepareFunction(borrow module: GpuIrModule, borrow function: GpuIrFunction,
    borrow facts: GpuIrFacts, validation: GpuIrValidation, functionIndex: Int) r: Bool {
    return gpuIrFunctionStructure(function, facts, validation, functionIndex) and
        gpuIrFunctionDefinitions(function, facts, validation, functionIndex) and
        gpuIrFunctionUses(function, facts, validation, functionIndex) and
        gpuIrFunctionTypesValid(module, function, facts, validation, functionIndex)
}
fun gpuIrReleaseFacts(facts: Array<GpuIrFacts>) r: Void {
    var i = 0
    while i < facts.length() { facts[i].release(); i = i + 1 }; facts.free()
}
fun verifyGpuIr(borrow module: GpuIrModule) r: GpuIrValidation {
    let validation = GpuIrValidation.create()
    if not gpuIrModuleCountsValid(module, validation) { return validation }
    let facts = Array<GpuIrFacts>(); var i = 0; var sharedBytes = 0; var needsFaultBuffer = false
    while i < module.functions.length() {
        let function = module.functions[i]
        let localFacts = GpuIrFacts.create(function.registerCount, function.localCount, function.blocks.length())
        facts.push(localFacts)
        if not gpuIrPrepareFunction(module, function, localFacts, validation, i) { gpuIrReleaseFacts(facts); return validation }
        let shared = gpuIrFunctionSharedBytes(function, validation, i)
        if shared < 0 { gpuIrReleaseFacts(facts); return validation }
        if shared > sharedBytes { sharedBytes = shared }
        var blockIndex = 0
        while blockIndex < function.blocks.length() {
            let block = function.blocks[blockIndex]; var opIndex = 0
            while opIndex < block.instructions.length() {
                let op = block.instructions[opIndex]
                validation.capabilities = validation.capabilities | gpuIrInstructionCapabilities(op)
                if gpuIrInstructionNeedsFaultBuffer(op) { needsFaultBuffer = true }
                opIndex = opIndex + 1
            }
            blockIndex = blockIndex + 1
        }
        i = i + 1
    }
    let calls = GpuIrCallFacts.create(module.functions.length())
    if gpuIrCallGraphValid(module, calls, validation) {
        i = 0
        while i < module.functions.length() and validation.valid {
            if gpuIrConvergenceBlock(module.functions[i], facts[i], calls, validation, i, 0, 0) < 0 { validation.valid = false }
            i = i + 1
        }
    }
    calls.release(); gpuIrReleaseFacts(facts)
    if validation.valid and (module.requiredCapabilities != validation.capabilities or
        module.sharedBytes != (sharedBytes as UInt64) or module.requiresFaultBuffer != needsFaultBuffer) {
        validation.reject("E_GPU_IR_REQUIREMENTS", "GPU module requirements disagree with its verified instructions", -1, -1, -1)
    }
    return validation
}
