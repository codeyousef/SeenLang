///
SIMD type and swizzle helper functions
Extracted from ir_type_mapping.seen
///

import simd.ir_types.{simdBuiltinLanes, simdBuiltinLane,
    simdLaneLlvmType, simdMaskLanes}

fun isSimdVectorTypeImpl(t: String) r: Int {
    if simdBuiltinLanes(t) > 0 { return 1 }
    return 0
}

fun isSimdValueTypeImpl(t: String) r: Int {
    if simdBuiltinLanes(t) > 0 or simdMaskLanes(t) > 0 { return 1 }
    return 0
}

fun simdScalarTypeImpl(t: String) r: String {
    if simdMaskLanes(t) > 0 { return "i1" }
    return simdLaneLlvmType(simdBuiltinLane(t))
}

fun simdLaneCountImpl(t: String) r: Int {
    let masks = simdMaskLanes(t)
    if masks > 0 { return masks }
    return simdBuiltinLanes(t)
}

fun isSwizzlePatternImpl(s: String, lanes: Int) r: Int {
    if s.length() == 0 { return 0 }
    if s.length() > lanes { return 0 }
    var swzI = 0
    while swzI < s.length() {
        let swzC = s.substring(swzI, swzI + 1)
        var swzOk = false
        if lanes <= 4 {
            if swzC == "x" {
                swzOk = true
            } else if swzC == "y" {
                swzOk = true
            } else if swzC == "z" {
                swzOk = true
            } else if swzC == "w" {
                swzOk = true
            }
        } else {
            if swzC == "a" {
                swzOk = true
            } else if swzC == "b" {
                swzOk = true
            } else if swzC == "c" {
                swzOk = true
            } else if swzC == "d" {
                swzOk = true
            } else if swzC == "e" {
                swzOk = true
            } else if swzC == "f" {
                swzOk = true
            } else if swzC == "g" {
                swzOk = true
            } else if swzC == "h" {
                swzOk = true
            }
        }
        if not swzOk { return 0 }
        swzI = swzI + 1
    }
    return 1
}

fun swizzleLaneIndexImpl(c: String) r: Int {
    if c == "x" { return 0 }
    if c == "a" { return 0 }
    if c == "y" { return 1 }
    if c == "b" { return 1 }
    if c == "z" { return 2 }
    if c == "c" { return 2 }
    if c == "w" { return 3 }
    if c == "d" { return 3 }
    if c == "e" { return 4 }
    if c == "f" { return 5 }
    if c == "g" { return 6 }
    if c == "h" { return 7 }
    return 0
}

fun simdLlvmSuffixImpl(t: String) r: String {
    let lanes = simdBuiltinLanes(t)
    if lanes == 0 { return "" }
    return "v" + lanes.toString() + t.substring(0, 3)
}
