// Binary comparison operator emission helpers.

import str.string.{StringBuilder}
import codegen.ir_optimization.{getNextRegFn}
import codegen.ir_type_info.{charToCodeStr}
import codegen.ir_literal_gen.{normalizeDoubleLiteralForLlvmImpl}

fun isBoxedOptionSeenTypeImpl(seenType: String) r: Bool {
    return seenType == "Option" or seenType == "Optional" or
        seenType.startsWith("Option<") or
        seenType.startsWith("Optional<") or seenType.endsWith("?")
}

// A nullable value is an i64 handle to the boxed Option payload.  None is a
// real box whose tag is false, not the integer zero used by a null literal.
fun emitBoxedOptionNullComparisonImpl(output: StringBuilder,
    regBox: Array<Int>, optionReg: String, equalsNull: Bool) r: String {

    let optionPtrReg = getNextRegFn(regBox)
    output.append("  " + optionPtrReg + " = inttoptr i64 " + optionReg +
        " to ptr\n")
    let tagPtrReg = getNextRegFn(regBox)
    output.append("  " + tagPtrReg +
        " = getelementptr inbounds { i1, i64 }, ptr " + optionPtrReg +
        ", i32 0, i32 0\n")
    let hasValueReg = getNextRegFn(regBox)
    output.append("  " + hasValueReg + " = load i1, ptr " + tagPtrReg +
        "\n")
    if not equalsNull {
        return hasValueReg
    }
    let resultReg = getNextRegFn(regBox)
    output.append("  " + resultReg + " = xor i1 " + hasValueReg +
        ", true\n")
    return resultReg
}

fun emitComparisonBinaryOpImpl(output: StringBuilder, regBox: Array<Int>,
    operator: String, resultReg: String, leftReg: String, rightReg: String,
    leftType: String, rightType: String,
    leftExprKind: String, leftLiteralValue: String,
    rightExprKind: String, rightLiteralValue: String,
    leftMappedType: String) r: String {

    if leftType == "Float32" and rightType == "Float32" {
        var float32Predicate = ""
        if operator == "==" { float32Predicate = "oeq" }
        if operator == "!=" { float32Predicate = "une" }
        if operator == "<" { float32Predicate = "olt" }
        if operator == "<=" { float32Predicate = "ole" }
        if operator == ">" { float32Predicate = "ogt" }
        if operator == ">=" { float32Predicate = "oge" }
        if float32Predicate != "" {
            output.append("  " + resultReg + " = fcmp " +
                float32Predicate + " float " + leftReg + ", " +
                rightReg + "\n")
            return resultReg
        }
    }

    if operator == "==" {
        if isBoxedOptionSeenTypeImpl(leftType) and rightReg == "0" {
            return emitBoxedOptionNullComparisonImpl(output, regBox,
                leftReg, true)
        }
        if isBoxedOptionSeenTypeImpl(rightType) and leftReg == "0" {
            return emitBoxedOptionNullComparisonImpl(output, regBox,
                rightReg, true)
        }
        if leftType == "Char" or rightType == "Char" {
            var leftVal = leftReg
            var rightVal = rightReg
            var charComparable = true
            if leftType == "Char" and rightType == "String" and
                rightExprKind == "Literal" and rightLiteralValue.length() == 1 {
                rightVal = charToCodeStr(rightLiteralValue)
            }
            if leftType == "Char" and rightType == "String" and
                not (rightExprKind == "Literal" and rightLiteralValue.length() == 1) {
                charComparable = false
            }
            if rightType == "Char" and leftType == "String" and
                leftExprKind == "Literal" and leftLiteralValue.length() == 1 {
                leftVal = charToCodeStr(leftLiteralValue)
            }
            if rightType == "Char" and leftType == "String" and
                not (leftExprKind == "Literal" and leftLiteralValue.length() == 1) {
                charComparable = false
            }
            if charComparable {
                output.append("  " + resultReg + " = icmp eq i64 " + leftVal +
                    ", " + rightVal + "\n")
            } else {
                output.append("  " + resultReg + " = icmp eq i64 0, 1 ; incompatible string/char equality\n")
            }
            return resultReg
        }
        var eqIsChar = leftType == "Char" or rightType == "Char"
        if not eqIsChar and (leftType == "String" or rightType == "String") {
            var leftStrReg = leftReg
            var rightStrReg = rightReg
            if leftReg == "0" { leftStrReg = "zeroinitializer" }
            if rightReg == "0" { rightStrReg = "zeroinitializer" }
            if leftType == "String" and rightType == "String" {
                output.append("  " + resultReg + " = call i1 @seen_str_eq_ss(%SeenString " + leftStrReg + ", %SeenString " + rightStrReg + ")\n")
            } else {
                output.append("  " + resultReg + " = icmp eq i64 0, 1 ; incompatible string equality operand\n")
            }
            return resultReg
        }
        if not eqIsChar and not (leftType == "String" or rightType == "String") {
            if leftType == "Float" or rightType == "Float" {
                if leftType == "Float" and rightType == "Float" {
                    let fLeft = normalizeDoubleLiteralForLlvmImpl(leftReg)
                    let fRight = normalizeDoubleLiteralForLlvmImpl(rightReg)
                    output.append("  " + resultReg + " = fcmp oeq double " + fLeft + ", " + fRight + "\n")
                } else {
                    var fcmpEqLeft = leftReg
                    var fcmpEqRight = rightReg
                    if leftType != "Float" {
                        let cvtL = getNextRegFn(regBox)
                        output.append("  " + cvtL + " = sitofp i64 " + leftReg + " to double\n")
                        fcmpEqLeft = cvtL
                    }
                    if rightType != "Float" {
                        let cvtR = getNextRegFn(regBox)
                        output.append("  " + cvtR + " = sitofp i64 " + rightReg + " to double\n")
                        fcmpEqRight = cvtR
                    }
                    let fcmpEqRes = getNextRegFn(regBox)
                    let fcmpEqLeftNorm = normalizeDoubleLiteralForLlvmImpl(fcmpEqLeft)
                    let fcmpEqRightNorm = normalizeDoubleLiteralForLlvmImpl(fcmpEqRight)
                    output.append("  " + fcmpEqRes + " = fcmp oeq double " + fcmpEqLeftNorm + ", " + fcmpEqRightNorm + "\n")
                    return fcmpEqRes
                }
            }
            if not (leftType == "Float" or rightType == "Float") {
                if leftMappedType == "ptr" {
                    var rightNullVal = rightReg
                    if rightReg == "0" { rightNullVal = "null" }
                    output.append("  " + resultReg + " = icmp eq ptr " + leftReg + ", " + rightNullVal + "\n")
                }
                if leftMappedType != "ptr" {
                    if leftType == "Bool" or rightType == "Bool" {
                        var eqLeftReg = leftReg
                        var eqRightReg = rightReg
                        if leftType == "Bool" {
                            output.append("  " + resultReg + " = zext i1 " + leftReg + " to i64\n")
                            eqLeftReg = resultReg
                        }
                        if rightType == "Bool" {
                            if leftType == "Bool" {
                                let cvtR = getNextRegFn(regBox)
                                output.append("  " + cvtR + " = zext i1 " + rightReg + " to i64\n")
                                eqRightReg = cvtR
                            } else {
                                output.append("  " + resultReg + " = zext i1 " + rightReg + " to i64\n")
                                eqRightReg = resultReg
                            }
                        }
                        let eqBoolRes = getNextRegFn(regBox)
                        output.append("  " + eqBoolRes + " = icmp eq i64 " + eqLeftReg + ", " + eqRightReg + "\n")
                        return eqBoolRes
                    }
                    output.append("  " + resultReg + " = icmp eq i64 " + leftReg + ", " + rightReg + "\n")
                }
            }
        }
        return resultReg
    }

    if operator == "!=" {
        if isBoxedOptionSeenTypeImpl(leftType) and rightReg == "0" {
            return emitBoxedOptionNullComparisonImpl(output, regBox,
                leftReg, false)
        }
        if isBoxedOptionSeenTypeImpl(rightType) and leftReg == "0" {
            return emitBoxedOptionNullComparisonImpl(output, regBox,
                rightReg, false)
        }
        if leftType == "Char" or rightType == "Char" {
            var leftVal = leftReg
            var rightVal = rightReg
            var charComparable = true
            if leftType == "Char" and rightType == "String" and
                rightExprKind == "Literal" and rightLiteralValue.length() == 1 {
                rightVal = charToCodeStr(rightLiteralValue)
            }
            if leftType == "Char" and rightType == "String" and
                not (rightExprKind == "Literal" and rightLiteralValue.length() == 1) {
                charComparable = false
            }
            if rightType == "Char" and leftType == "String" and
                leftExprKind == "Literal" and leftLiteralValue.length() == 1 {
                leftVal = charToCodeStr(leftLiteralValue)
            }
            if rightType == "Char" and leftType == "String" and
                not (leftExprKind == "Literal" and leftLiteralValue.length() == 1) {
                charComparable = false
            }
            if charComparable {
                output.append("  " + resultReg + " = icmp ne i64 " + leftVal +
                    ", " + rightVal + "\n")
            } else {
                output.append("  " + resultReg + " = icmp eq i64 0, 0 ; incompatible string/char inequality\n")
            }
            return resultReg
        }
        var neIsChar = leftType == "Char" or rightType == "Char"
        if not neIsChar and (leftType == "String" or rightType == "String") {
            var leftStrReg = leftReg
            var rightStrReg = rightReg
            if leftReg == "0" { leftStrReg = "zeroinitializer" }
            if rightReg == "0" { rightStrReg = "zeroinitializer" }
            if leftType == "String" and rightType == "String" {
                output.append("  " + resultReg + " = call i1 @seen_str_ne_ss(%SeenString " + leftStrReg + ", %SeenString " + rightStrReg + ")\n")
            } else {
                output.append("  " + resultReg + " = icmp eq i64 0, 0 ; incompatible string inequality operand\n")
            }
            return resultReg
        }
        if not neIsChar and not (leftType == "String" or rightType == "String") {
            if leftType == "Float" or rightType == "Float" {
                if leftType == "Float" and rightType == "Float" {
                    let fLeft = normalizeDoubleLiteralForLlvmImpl(leftReg)
                    let fRight = normalizeDoubleLiteralForLlvmImpl(rightReg)
                    output.append("  " + resultReg + " = fcmp une double " + fLeft + ", " + fRight + "\n")
                } else {
                    var fcmpNeLeft = leftReg
                    var fcmpNeRight = rightReg
                    if leftType != "Float" {
                        let cvtL = getNextRegFn(regBox)
                        output.append("  " + cvtL + " = sitofp i64 " + leftReg + " to double\n")
                        fcmpNeLeft = cvtL
                    }
                    if rightType != "Float" {
                        let cvtR = getNextRegFn(regBox)
                        output.append("  " + cvtR + " = sitofp i64 " + rightReg + " to double\n")
                        fcmpNeRight = cvtR
                    }
                    let fcmpNeRes = getNextRegFn(regBox)
                    let fcmpNeLeftNorm = normalizeDoubleLiteralForLlvmImpl(fcmpNeLeft)
                    let fcmpNeRightNorm = normalizeDoubleLiteralForLlvmImpl(fcmpNeRight)
                    output.append("  " + fcmpNeRes + " = fcmp une double " + fcmpNeLeftNorm + ", " + fcmpNeRightNorm + "\n")
                    return fcmpNeRes
                }
            }
            if not (leftType == "Float" or rightType == "Float") {
                if leftMappedType == "ptr" {
                    var rightNullVal = rightReg
                    if rightReg == "0" { rightNullVal = "null" }
                    output.append("  " + resultReg + " = icmp ne ptr " + leftReg + ", " + rightNullVal + "\n")
                }
                if leftMappedType != "ptr" {
                    if leftType == "Bool" or rightType == "Bool" {
                        var neLeftReg = leftReg
                        var neRightReg = rightReg
                        if leftType == "Bool" {
                            output.append("  " + resultReg + " = zext i1 " + leftReg + " to i64\n")
                            neLeftReg = resultReg
                        }
                        if rightType == "Bool" {
                            if leftType == "Bool" {
                                let cvtR = getNextRegFn(regBox)
                                output.append("  " + cvtR + " = zext i1 " + rightReg + " to i64\n")
                                neRightReg = cvtR
                            } else {
                                output.append("  " + resultReg + " = zext i1 " + rightReg + " to i64\n")
                                neRightReg = resultReg
                            }
                        }
                        let neBoolRes = getNextRegFn(regBox)
                        output.append("  " + neBoolRes + " = icmp ne i64 " + neLeftReg + ", " + neRightReg + "\n")
                        return neBoolRes
                    }
                    output.append("  " + resultReg + " = icmp ne i64 " + leftReg + ", " + rightReg + "\n")
                }
            }
        }
        return resultReg
    }

    if operator == "<" or operator == "<=" or operator == ">" or
        operator == ">=" {

        var leftVal = leftReg
        var rightVal = rightReg
        if leftType == "Char" and rightType == "String" and
            rightExprKind == "Literal" and rightLiteralValue.length() == 1 {
            rightVal = charToCodeStr(rightLiteralValue)
        }
        if rightType == "Char" and leftType == "String" and
            leftExprKind == "Literal" and leftLiteralValue.length() == 1 {
            leftVal = charToCodeStr(leftLiteralValue)
        }

        var intPredicate = "slt"
        var floatPredicate = "olt"
        if operator == "<=" {
            intPredicate = "sle"
            floatPredicate = "ole"
        }
        if operator == ">" {
            intPredicate = "sgt"
            floatPredicate = "ogt"
        }
        if operator == ">=" {
            intPredicate = "sge"
            floatPredicate = "oge"
        }

        // FEL-1553: unsigned integer semantics. UInt64 values with bit 63 set
        // must compare unsigned; signed predicates misclassify them.
        if leftType == "UInt64" or rightType == "UInt64" {
            if operator == "<" {
                intPredicate = "ult"
            }
            if operator == "<=" {
                intPredicate = "ule"
            }
            if operator == ">" {
                intPredicate = "ugt"
            }
            if operator == ">=" {
                intPredicate = "uge"
            }
        }

        if leftType == "String" and rightType == "String" {
            var leftStrReg = leftReg
            var rightStrReg = rightReg
            if leftReg == "0" { leftStrReg = "zeroinitializer" }
            if rightReg == "0" { rightStrReg = "zeroinitializer" }
            let leftCharReg = getNextRegFn(regBox)
            output.append("  " + leftCharReg + " = call i64 @seen_char_at(%SeenString " + leftStrReg + ", i64 0)\n")
            let rightCharReg = getNextRegFn(regBox)
            output.append("  " + rightCharReg + " = call i64 @seen_char_at(%SeenString " + rightStrReg + ", i64 0)\n")
            let strCmpReg = getNextRegFn(regBox)
            output.append("  " + strCmpReg + " = icmp " + intPredicate +
                " i64 " + leftCharReg + ", " + rightCharReg + "\n")
            return strCmpReg
        }
        if leftType == "Float" or rightType == "Float" {
            if leftType == "Float" and rightType == "Float" {
                let fcmpLeftNorm = normalizeDoubleLiteralForLlvmImpl(leftVal)
                let fcmpRightNorm = normalizeDoubleLiteralForLlvmImpl(rightVal)
                output.append("  " + resultReg + " = fcmp " + floatPredicate +
                    " double " + fcmpLeftNorm + ", " + fcmpRightNorm + "\n")
            } else {
                // FEL-1553: mixed Float/UInt64 must convert unsigned (uitofp),
                // not signed (sitofp), or values with bit 63 set go negative.
                var fcmpLeft = leftVal
                var fcmpRight = rightVal
                var leftConv = "sitofp"
                var rightConv = "sitofp"
                if leftType == "UInt64" {
                    leftConv = "uitofp"
                }
                if rightType == "UInt64" {
                    rightConv = "uitofp"
                }
                if leftType != "Float" {
                    let cvtL = getNextRegFn(regBox)
                    output.append("  " + cvtL + " = " + leftConv + " i64 " + leftVal +
                        " to double\n")
                    fcmpLeft = cvtL
                }
                if rightType != "Float" {
                    let cvtR = getNextRegFn(regBox)
                    output.append("  " + cvtR + " = " + rightConv + " i64 " + rightVal +
                        " to double\n")
                    fcmpRight = cvtR
                }
                let fcmpRes = getNextRegFn(regBox)
                let fcmpLeftNorm = normalizeDoubleLiteralForLlvmImpl(fcmpLeft)
                let fcmpRightNorm = normalizeDoubleLiteralForLlvmImpl(fcmpRight)
                output.append("  " + fcmpRes + " = fcmp " + floatPredicate +
                    " double " + fcmpLeftNorm + ", " + fcmpRightNorm + "\n")
                return fcmpRes
            }
        } else {
            output.append("  " + resultReg + " = icmp " + intPredicate +
                " i64 " + leftVal + ", " + rightVal + "\n")
        }
        return resultReg
    }

    return ""
}
