// ir_call_regular_emit.seen - prepared regular function-call emission helpers.

import str.string.{StringBuilder}
import codegen.ir_call_args.{promoteFloatArgsImpl}
import codegen.ir_call_dispatch.{emitUserFunctionCallImpl}
import codegen.ir_call_regular_plan.{shouldPromoteRegularCallFloatArgsImpl, shouldRecordRegularLateDeclareImpl, regularCallTailFlagImpl}
import codegen.ir_codegen_feature_state.{getFeatureRegBoxImpl, getFeatureFloatParamFuncNamesImpl, getFeatureFloatParamParamIdxsImpl}
import codegen.ir_decl_registry.{LateUserDeclareState, recordLateUserDeclareIntoStateImpl}
import codegen.ir_decl_state_driver.{captureLateUserDeclareState, applyLateUserDeclareState}
import codegen.ir_method_receiver.{quoteIdentIfNeededImpl}
import codegen.ir_codegen_target_state.{findForeignScalarAbiImpl, foreignScalarReturnPrefixImpl, foreignScalarParameterSuffixImpl}
import json.builder.{seen_string_release_owned}

fun promoteRegularCallFloatArgsIfNeededState(output: StringBuilder,
    regBox: Array<Int>, funcName: String, argRegs: Array<String>,
    argTypeStrs: Array<String>, floatParamFuncNames: Array<String>,
    floatParamParamIdxs: Array<Int>) r: Void {

    if shouldPromoteRegularCallFloatArgsImpl(argRegs.length(),
        argTypeStrs.length(), floatParamFuncNames.length(),
        floatParamParamIdxs.length()) {

        promoteFloatArgsImpl(output, regBox, funcName, argRegs, argTypeStrs,
            floatParamFuncNames, floatParamParamIdxs)
    }
}

fun recordRegularLateDeclareIfNeededState(funcName: String,
    llvmReturnType: String, argTypeStrs: Array<String>,
    lateState: LateUserDeclareState) r: Bool {

    if not shouldRecordRegularLateDeclareImpl(funcName) {
        return false
    }
    recordLateUserDeclareIntoStateImpl(funcName, llvmReturnType, argTypeStrs,
        0, lateState)
    return true
}

fun emitPreparedRegularFunctionCallState(output: StringBuilder,
    regBox: Array<Int>, funcName: String, llvmReturnType: String,
    argRegs: Array<String>, argTypeStrs: Array<String>,
    shouldTailCall: Bool) r: String {

    let tailFlag = regularCallTailFlagImpl(shouldTailCall)
    if findForeignScalarAbiImpl(funcName) < 0 {
        return emitUserFunctionCallImpl(output, regBox,
            quoteIdentIfNeededImpl(funcName), llvmReturnType, argRegs,
            argTypeStrs, tailFlag)
    }
    let abiArgTypes = Array<String>()
    var abiIdx = 0
    while abiIdx < argTypeStrs.length() {
        let suffix = foreignScalarParameterSuffixImpl(funcName, abiIdx)
        if suffix == "" { abiArgTypes.push(argTypeStrs[abiIdx]) }
        else { abiArgTypes.push(argTypeStrs[abiIdx] + suffix) }
        abiIdx = abiIdx + 1
    }
    let returnPrefix = foreignScalarReturnPrefixImpl(funcName)
    var decoratedReturn = llvmReturnType
    if returnPrefix != "" { decoratedReturn = returnPrefix + llvmReturnType }
    let result = emitUserFunctionCallImpl(output, regBox,
        quoteIdentIfNeededImpl(funcName), decoratedReturn, argRegs,
        abiArgTypes, tailFlag)
    abiIdx = 0
    while abiIdx < abiArgTypes.length() {
        if foreignScalarParameterSuffixImpl(funcName, abiIdx) != "" {
            seen_string_release_owned(abiArgTypes[abiIdx])
        }
        abiIdx = abiIdx + 1
    }
    if returnPrefix != "" { seen_string_release_owned(decoratedReturn) }
    abiArgTypes.free()
    return result
}

fun emitRegularFunctionCallTailState(output: StringBuilder, funcName: String,
    llvmReturnType: String, argRegs: Array<String>,
    argTypeStrs: Array<String>, shouldTailCall: Bool) r: String {

    promoteRegularCallFloatArgsIfNeededState(output, getFeatureRegBoxImpl(),
        funcName, argRegs, argTypeStrs, getFeatureFloatParamFuncNamesImpl(),
        getFeatureFloatParamParamIdxsImpl())

    let lateState = captureLateUserDeclareState()
    if recordRegularLateDeclareIfNeededState(funcName, llvmReturnType,
        argTypeStrs, lateState) {

        applyLateUserDeclareState(lateState)
    }
    return emitPreparedRegularFunctionCallState(output, getFeatureRegBoxImpl(),
        funcName, llvmReturnType, argRegs, argTypeStrs, shouldTailCall)
}
