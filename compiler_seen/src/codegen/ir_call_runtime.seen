///
ir_call_runtime.seen — runtime/builtin call emission helpers
Extracted from llvm_ir_gen.seen so runtime call lowering stays separate
from higher-level call orchestration and AST dispatch.
///

import str.string.{StringBuilder}
import codegen.ir_optimization.{getNextRegFn}
import codegen.ir_declarations.{emitMathBuiltinImpl, emitNoneConstructorImpl}
import codegen.ir_option_constructor_state.{emitTypedSomeConstructorState}
import codegen.ir_literal_gen.{normalizeDoubleLiteralForLlvmImpl}
import codegen.ir_codegen_global_state.{getGlobalStructNamesImpl, getGlobalStructLayoutsImpl, getGlobalStructSizesImpl}
import codegen.ir_type_layout.{getLlvmTypeSizeImpl}
import codegen.ir_method_gen.{emitToStringMethodImpl}

// The stable C command boundary returns a pointer; Seen expressions consume
// the CommandResult aggregate. This ABI bridge is not a math optimization.
fun emitCommandResultRuntimeBridgeImpl(output: StringBuilder,
    regBox: Array<Int>, argument: String) r: String {

    let pointer = getNextRegFn(regBox)
    output.append("  " + pointer + " = call ptr @__ExecuteCommand(%SeenString " + argument + ")\n")
    let result = getNextRegFn(regBox)
    output.append("  " + result + " = load %CommandResult, ptr " + pointer + "\n")
    return result
}

fun normalizeRuntimeDoubleOperandImpl(argReg: String) r: String {
    if argReg.startsWith("%") {
        return argReg
    }
    if argReg == "undef" {
        return argReg
    }
    return normalizeDoubleLiteralForLlvmImpl(argReg)
}

fun emitPrintLikeCallImpl(output: StringBuilder, regBox: Array<Int>, printName: String, argReg: String, argType: String) r: String {
    var strReg = argReg
    let integer = argType == "Int" or argType == "Integer" or argType == "Int64" or
        argType == "Int32" or argType == "Int16" or argType == "Int8" or
        argType == "UInt" or argType == "UInt64" or argType == "UInt32" or
        argType == "UInt16" or argType == "UInt8"
    let floating = argType == "Float" or argType == "Float64" or argType == "Float32"
    if integer or floating or argType == "Bool" or argType == "Char" {
        // Reuse the scalar method conversion: it widens narrow integers with
        // the correct signedness and promotes Float32 before the runtime ABI.
        strReg = emitToStringMethodImpl(output, regBox, argReg, argType, 0)
    }
    output.append("  call void @" + printName + "(%SeenString " + strReg + ")\n")
    // Only these conversions create owned temporaries. Bool is static and
    // String arguments remain borrowed from their caller.
    if integer or floating or argType == "Char" {
        let data = getNextRegFn(regBox)
        let length = getNextRegFn(regBox)
        let bytes = getNextRegFn(regBox)
        output.append("  " + data + " = extractvalue %SeenString " + strReg + ", 1\n")
        output.append("  " + length + " = extractvalue %SeenString " + strReg + ", 0\n")
        output.append("  " + bytes + " = add i64 " + length + ", 1\n")
        output.append("  call void @seen_pool_free(ptr " + data + ", i64 " + bytes + ")\n")
    }
    return "0"
}

fun emitOptionRuntimeBuiltinCallImpl(output: StringBuilder, regBox: Array<Int>, funcName: String, argReg: String, argType: String, isClassArg: Int) r: String {
    if funcName == "Some" {
        return emitTypedSomeConstructorState(output, regBox, argReg, argType, isClassArg)
    }
    if funcName == "None" {
        return emitNoneConstructorImpl(output, regBox)
    }
    return ""
}

fun emitResultRuntimeBuiltinCallImpl(output: StringBuilder, regBox: Array<Int>,
    funcName: String, argReg: String, argLlvmType: String) r: String {

    if funcName != "Ok" and funcName != "Err" {
        return ""
    }

    if argLlvmType == "i64" {
        return argReg
    }

    if argLlvmType == "ptr" {
        let resultReg = getNextRegFn(regBox)
        output.append("  " + resultReg + " = ptrtoint ptr " + argReg + " to i64\n")
        return resultReg
    }

    if argLlvmType == "i1" {
        let resultReg = getNextRegFn(regBox)
        output.append("  " + resultReg + " = zext i1 " + argReg + " to i64\n")
        return resultReg
    }

    if argLlvmType == "i8" or argLlvmType == "i16" or
        argLlvmType == "i32" {

        // Result's generic storage slot is one erased i64 word. Preserve the
        // scalar's low bits explicitly instead of emitting an ill-typed call
        // such as @Ok(i64 %an_i32_value). Signedness is restored by the
        // concrete payload type after truncation at the unwrap boundary.
        let resultReg = getNextRegFn(regBox)
        output.append("  " + resultReg + " = zext " + argLlvmType + " " +
            argReg + " to i64\n")
        return resultReg
    }

    if argLlvmType == "%SeenString" {
        let slotReg = getNextRegFn(regBox)
        output.append("  " + slotReg + " = call ptr @seen_checked_malloc(i64 16)\n")
        output.append("  store %SeenString " + argReg + ", ptr " + slotReg + "\n")
        let resultReg = getNextRegFn(regBox)
        output.append("  " + resultReg + " = ptrtoint ptr " + slotReg + " to i64\n")
        return resultReg
    }

    if argLlvmType.startsWith("%") {
        // Call preparation presents repr(C) literals and other aggregate
        // expressions as concrete values. Result's generic payload slot is an
        // escaping erased i64 handle, so every aggregate value must first be
        // copied into owned storage before it crosses the Ok/Err ABI.
        let aggregateSize = getLlvmTypeSizeImpl(argLlvmType,
            getGlobalStructNamesImpl(), getGlobalStructLayoutsImpl(),
            getGlobalStructSizesImpl())
        if aggregateSize <= 0 {
            return ""
        }
        let slotReg = getNextRegFn(regBox)
        output.append("  " + slotReg + " = call ptr @seen_checked_malloc(i64 " +
            aggregateSize.toString() + ")\n")
        output.append("  store " + argLlvmType + " " + argReg +
            ", ptr " + slotReg + "\n")
        let resultReg = getNextRegFn(regBox)
        output.append("  " + resultReg + " = ptrtoint ptr " + slotReg +
            " to i64\n")
        return resultReg
    }

    if argLlvmType == "double" {
        // Float/Float64 occupy exactly one erased Result word. Bit-preserving
        // scalar boxing avoids both an escaping allocation and a pointer value
        // being mistaken for the floating-point payload during unwrap.
        let doubleArg = normalizeRuntimeDoubleOperandImpl(argReg)
        let resultReg = getNextRegFn(regBox)
        output.append("  " + resultReg + " = bitcast double " + doubleArg +
            " to i64\n")
        return resultReg
    }

    if argLlvmType == "float" {
        let floatArg = normalizeRuntimeDoubleOperandImpl(argReg)
        let bitsReg = getNextRegFn(regBox)
        output.append("  " + bitsReg + " = bitcast float " + floatArg +
            " to i32\n")
        let resultReg = getNextRegFn(regBox)
        output.append("  " + resultReg + " = zext i32 " + bitsReg +
            " to i64\n")
        return resultReg
    }

    return argReg
}

fun emitSuperRuntimeBuiltinCallImpl(output: StringBuilder, regBox: Array<Int>, parentInitName: String, thisAlloca: String) r: String {
    let thisVal = getNextRegFn(regBox)
    output.append("  " + thisVal + " = load ptr, ptr " + thisAlloca + "\n")
    output.append("  call void @" + parentInitName + "(ptr " + thisVal + ")\n")
    return "0"
}

fun emitReadTextRuntimeCallImpl(output: StringBuilder, regBox: Array<Int>, pathReg: String) r: String {
    let resultReg = getNextRegFn(regBox)
    output.append("  " + resultReg + " = call %SeenString @readText(%SeenString " + pathReg + ")\n")
    return resultReg
}

fun emitWriteTextRuntimeCallImpl(output: StringBuilder, regBox: Array<Int>, pathReg: String, contentReg: String) r: String {
    let resultReg = getNextRegFn(regBox)
    output.append("  " + resultReg + " = call i1 @writeText(%SeenString " + pathReg + ", %SeenString " + contentReg + ")\n")
    return resultReg
}

fun emitArgsRuntimeCallImpl(output: StringBuilder, regBox: Array<Int>) r: String {
    let resultReg = getNextRegFn(regBox)
    output.append("  " + resultReg + " = call ptr @args()\n")
    return resultReg
}

fun emitReadFileBytesPathRuntimeCallImpl(output: StringBuilder, regBox: Array<Int>, pathReg: String) r: String {
    let resultReg = getNextRegFn(regBox)
    output.append("  " + resultReg + " = call ptr @__ReadFileBytesPath(%SeenString " + pathReg + ")\n")
    return resultReg
}

fun emitPanicRuntimeCallImpl(output: StringBuilder, regBox: Array<Int>, argReg: String) r: String {
    let lenReg = getNextRegFn(regBox)
    let dataReg = getNextRegFn(regBox)
    output.append("  " + lenReg + " = extractvalue %SeenString " + argReg + ", 0\n")
    output.append("  " + dataReg + " = extractvalue %SeenString " + argReg + ", 1\n")
    output.append("  call void @__panic(i64 " + lenReg + ", ptr " + dataReg + ") noreturn\n")
    output.append("  unreachable\n")
    return "0"
}

fun emitMathBuiltinCallImpl(output: StringBuilder, regBox: Array<Int>, funcName: String, arg0: String, arg1: String) r: String {
    return emitMathBuiltinImpl(output, regBox, funcName, arg0, arg1)
}
