// ir_value_coercion.seen - shared LLVM value coercion emitters.

import str.string.{StringBuilder}
import codegen.ir_optimization.{getNextRegFn}
import codegen.ir_literal_gen.{normalizeDoubleLiteralForLlvmImpl}

/// Preserve floating bit patterns when storing a scalar in a generic word.
fun eraseFloatingWordImpl(output: StringBuilder, regBox: Array<Int>,
    source: String, value: String) r: String {
    let bits = getNextRegFn(regBox)
    if source == "double" {
        output.append("  " + bits + " = bitcast double " +
            normalizeDoubleLiteralForLlvmImpl(value) + " to i64\n")
        return bits
    }
    output.append("  " + bits + " = bitcast float " + value + " to i32\n")
    let word = getNextRegFn(regBox)
    output.append("  " + word + " = zext i32 " + bits + " to i64\n")
    return word
}

/// Restore scalar/pointer bit patterns from the generic single-word ABI.
/// This is representation conversion, rather than numeric conversion.
fun reifyErasedWordImpl(output: StringBuilder, regBox: Array<Int>,
    target: String, word: String) r: String {
    if target == "i64" { return word }
    if target == "float" {
        let bits = getNextRegFn(regBox)
        output.append("  " + bits + " = trunc i64 " + word + " to i32\n")
        let result = getNextRegFn(regBox)
        output.append("  " + result + " = bitcast i32 " + bits + " to float\n"); return result
    }
    if target != "ptr" and target != "double" and target != "i1" and target != "i8" and target != "i16" and target != "i32" { return word }
    let result = getNextRegFn(regBox)
    if target == "ptr" { output.append("  " + result + " = inttoptr i64 " + word + " to ptr\n"); return result }
    if target == "double" { output.append("  " + result + " = bitcast i64 " + word + " to double\n"); return result }
    if target == "i1" or target == "i8" or target == "i16" or target == "i32" {
        output.append("  " + result + " = trunc i64 " + word + " to " + target + "\n"); return result
    }
    return word
}

fun coerceValueForLlvmTargetImpl(output: StringBuilder, regBox: Array<Int>,
    targetLlvmType: String, sourceSeenType: String, sourceLlvmType: String,
    valueReg: String) r: String {

    if targetLlvmType == "ptr" and valueReg == "0" {
        return "null"
    }
    if targetLlvmType == "i64" and sourceLlvmType == "ptr" and
        valueReg == "0" {

        return "0"
    }
    if sourceLlvmType == "" or sourceLlvmType == targetLlvmType {
        return valueReg
    }
    if targetLlvmType == "double" and sourceLlvmType == "float" {
        let coercedReg = getNextRegFn(regBox)
        output.append("  " + coercedReg + " = fpext float " + valueReg +
            " to double\n")
        return coercedReg
    }
    if targetLlvmType == "float" and sourceLlvmType == "double" {
        let coercedReg = getNextRegFn(regBox)
        let doubleValue = normalizeDoubleLiteralForLlvmImpl(valueReg)
        output.append("  " + coercedReg + " = fptrunc double " +
            doubleValue + " to float\n")
        return coercedReg
    }
    if (targetLlvmType == "i8" or targetLlvmType == "i16" or
        targetLlvmType == "i32") and sourceLlvmType == "i64" {

        let coercedReg = getNextRegFn(regBox)
        output.append("  " + coercedReg + " = trunc i64 " + valueReg +
            " to " + targetLlvmType + "\n")
        return coercedReg
    }
    if targetLlvmType == "double" and sourceLlvmType == "i64" {
        let coercedReg = getNextRegFn(regBox)
        output.append("  " + coercedReg + " = sitofp i64 " + valueReg +
            " to double\n")
        return coercedReg
    }
    if targetLlvmType == "double" and sourceLlvmType == "i1" {
        let intReg = getNextRegFn(regBox)
        output.append("  " + intReg + " = zext i1 " + valueReg +
            " to i64\n")
        let coercedReg = getNextRegFn(regBox)
        output.append("  " + coercedReg + " = sitofp i64 " + intReg +
            " to double\n")
        return coercedReg
    }
    if targetLlvmType == "i64" and sourceLlvmType == "double" {
        let coercedReg = getNextRegFn(regBox)
        let doubleValue = normalizeDoubleLiteralForLlvmImpl(valueReg)
        output.append("  " + coercedReg + " = fptosi double " + doubleValue +
            " to i64\n")
        return coercedReg
    }
    if targetLlvmType == "i64" and sourceLlvmType == "i1" {
        let coercedReg = getNextRegFn(regBox)
        output.append("  " + coercedReg + " = zext i1 " + valueReg +
            " to i64\n")
        return coercedReg
    }
    if targetLlvmType == "i64" and
        (sourceLlvmType == "i8" or sourceLlvmType == "i16" or
            sourceLlvmType == "i32") {

        let coercedReg = getNextRegFn(regBox)
        var extendOp = "sext"
        if sourceSeenType == "UInt8" or sourceSeenType == "UInt16" or
            sourceSeenType == "UInt32" {

            extendOp = "zext"
        }
        output.append("  " + coercedReg + " = " + extendOp + " " +
            sourceLlvmType + " " + valueReg + " to i64\n")
        return coercedReg
    }
    if targetLlvmType == "i64" and sourceLlvmType == "ptr" {
        let coercedReg = getNextRegFn(regBox)
        output.append("  " + coercedReg + " = ptrtoint ptr " + valueReg +
            " to i64\n")
        return coercedReg
    }
    if targetLlvmType == "ptr" and sourceLlvmType == "i64" {
        if valueReg == "0" {
            return "null"
        }
        let coercedReg = getNextRegFn(regBox)
        output.append("  " + coercedReg + " = inttoptr i64 " + valueReg +
            " to ptr\n")
        return coercedReg
    }
    if targetLlvmType == "i1" and sourceLlvmType == "i64" {
        let coercedReg = getNextRegFn(regBox)
        output.append("  " + coercedReg + " = icmp ne i64 " + valueReg +
            ", 0\n")
        return coercedReg
    }
    if targetLlvmType == "i1" and sourceLlvmType == "double" {
        let coercedReg = getNextRegFn(regBox)
        let doubleValue = normalizeDoubleLiteralForLlvmImpl(valueReg)
        output.append("  " + coercedReg + " = fcmp one double " +
            doubleValue + ", 0.0\n")
        return coercedReg
    }
    return valueReg
}

/// Literal construction owns temporary storage; aggregate value consumers keep
/// a copy and release that storage using the allocator's minimum eight bytes.
fun releaseLiteralStorageImpl(output: StringBuilder, storage: String, bytes: Int) r: Void {
    var allocationBytes = bytes
    if allocationBytes < 8 { allocationBytes = 8 }
    output.append("  call void @seen_pool_free(ptr " + storage + ", i64 " +
        allocationBytes.toString() + ") ; release copied literal storage\n")
}
fun loadOwnedLiteralValueImpl(output: StringBuilder, regBox: Array<Int>,
    llvmType: String, storage: String, bytes: Int) r: String {
    let value = getNextRegFn(regBox)
    output.append("  " + value + " = load " + llvmType + ", ptr " + storage + "\n")
    releaseLiteralStorageImpl(output, storage, bytes)
    return value
}
