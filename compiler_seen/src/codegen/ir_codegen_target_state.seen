// ir_codegen_target_state.seen - host target triple and data layout state.

import process.process.{runCommand, CommandResult, commandWasSuccessful}
import str.string.{StringBuilder}
import codegen.ir_optimization.{pipeGet}
import codegen.ir_type_mapping.{normalizeSeenTypeNameImpl}
import json.builder.{seen_string_clone_owned, seen_string_release_owned}

var g_hostTargetTriple: String = ""
var g_hostDataLayout: String = ""
var g_llvmCoroEndReturnsVoid: Bool = false

fun configureLlvmCoroutineEndAbi(versionText: String) r: Void {
    let marker = "LLVM version "
    let markerIndex = versionText.indexOf(marker, 0)
    if markerIndex < 0 {
        g_llvmCoroEndReturnsVoid = false
        return
    }

    var cursor = markerIndex + marker.length()
    var major = 0
    var foundDigit = false
    while cursor < versionText.length() {
        let byte = versionText.byteAt(cursor)
        if byte < 48 or byte > 57 {
            break
        }
        foundDigit = true
        major = major * 10 + byte - 48
        cursor = cursor + 1
    }
    g_llvmCoroEndReturnsVoid = foundDigit and major >= 22
}

fun llvmCoroutineEndReturnsVoid() r: Bool {
    return g_llvmCoroEndReturnsVoid
}

fun getIrgenTraceTimeSeconds() r: Int {
    let result: CommandResult = runCommand("date +%s")
    if commandWasSuccessful(result) {
        let out = result.output.trim()
        if out.length() > 0 {
            return out.toInt()
        }
    }
    return 0
}

fun detectHostPlatform() r: Void {
    if g_hostTargetTriple != "" {
        return
    }
    let unameS: CommandResult = runCommand("uname -s")
    let unameM: CommandResult = runCommand("uname -m")
    var os = "linux"
    var arch = "x86_64"
    if commandWasSuccessful(unameS) {
        if unameS.output.contains("Darwin") {
            os = "darwin"
        }
    }
    if commandWasSuccessful(unameM) {
        if unameM.output.contains("arm64") or unameM.output.contains("aarch64") {
            arch = "arm64"
        }
        if unameM.output.contains("riscv64") {
            arch = "riscv64"
        }
    }
    if os == "darwin" {
        if arch == "arm64" {
            g_hostTargetTriple = "arm64-apple-macosx14.0"
            g_hostDataLayout = "e-m:o-i64:64-i128:128-n32:64-S128"
        } else {
            g_hostTargetTriple = "x86_64-apple-macosx14.0"
            g_hostDataLayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
        }
    } else {
        if arch == "arm64" {
            g_hostTargetTriple = "aarch64-unknown-linux-gnu"
            g_hostDataLayout = "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
        } else if arch == "riscv64" {
            g_hostTargetTriple = "riscv64-unknown-linux-gnu"
            g_hostDataLayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
        } else {
            g_hostTargetTriple = "x86_64-unknown-linux-gnu"
            g_hostDataLayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
        }
    }
}

fun emitTargetModuleHeaderImpl(output: StringBuilder) r: Void {
    detectHostPlatform()
    output.append("; Generated by Seen Stage1 Compiler (LLVM backend)\n")
    output.append("target datalayout = \"" + g_hostDataLayout + "\"\n")
    output.append("target triple = \"" + g_hostTargetTriple + "\"\n\n")
}

fun overrideTargetTripleImpl(triple: String, layout: String) r: Void {
    g_hostTargetTriple = triple
    g_hostDataLayout = layout
}

fun getCodegenTargetTripleImpl() r: String {
    detectHostPlatform()
    return g_hostTargetTriple
}
// C scalar extension attributes belong to the target ABI, not Seen's internal
// calling convention. Snapshot only declaration metadata: streamed ASTs expire.
var g_foreignScalarNames: Array<String> = Array<String>()
var g_foreignScalarParams: Array<String> = Array<String>()
var g_foreignScalarReturns: Array<String> = Array<String>()
var g_foreignScalarBytes: Int = 0

fun foreignScalarExtensionImpl(seenType: String, llvmType: String,
    triple: String) r: String {
    let narrow = llvmType == "i1" or llvmType == "i8" or llvmType == "i16"
    let riscv = triple.startsWith("riscv64-")
    // Win64 and standard AAPCS64 do not use these attributes. Darwin ARM64
    // differs from AAPCS64; RV64 extends even unsigned 32-bit scalars signed.
    let sysv = triple.startsWith("x86_64-") and
        not triple.contains("windows") and not triple.contains("mingw")
    let darwinArm = (triple.startsWith("arm64-") or
        triple.startsWith("aarch64-")) and triple.contains("apple")
    if riscv and llvmType == "i32" { return "signext" }
    if not narrow or not (sysv or darwinArm or riscv) { return "" }
    let name = normalizeSeenTypeNameImpl(seenType)
    if name == "Bool" or name == "Boolean" or name == "UInt8" or
        name == "UInt16" { return "zeroext" }
    if name == "Int8" or name == "Int16" { return "signext" }
    return ""
}

fun foreignScalarAliasImpl(spelling: String, names: String,
    targets: String, count: Int) r: String {
    var name = seen_string_clone_owned(spelling)
    var depth = 0
    while depth < 32 {
        var found = false; var i = 0
        while i < count and not found {
            let key = pipeGet(names, i)
            let matches = key == name
            if key.length() > 0 { seen_string_release_owned(key) }
            if matches {
                let target = pipeGet(targets, i)
                seen_string_release_owned(name)
                name = target
                found = true
            }
            i = i + 1
        }
        if not found { return name }
        depth = depth + 1
    }
    abort("Error: [E_TYPE_LIMIT] foreign scalar alias depth exceeded")
    return ""
}

fun resetForeignScalarAbiImpl() r: Void {
    var i = 0
    while i < g_foreignScalarNames.length() {
        seen_string_release_owned(g_foreignScalarNames[i])
        if g_foreignScalarParams[i] != "" {
            seen_string_release_owned(g_foreignScalarParams[i])
        }
        i = i + 1
    }
    g_foreignScalarNames.free(); g_foreignScalarParams.free()
    g_foreignScalarReturns.free()
    g_foreignScalarNames = Array<String>()
    g_foreignScalarParams = Array<String>()
    g_foreignScalarReturns = Array<String>()
    g_foreignScalarBytes = 0
}

fun findForeignScalarAbiImpl(name: String) r: Int {
    var i = g_foreignScalarNames.length() - 1
    while i >= 0 {
        if g_foreignScalarNames[i] == name { return i }
        i = i - 1
    }
    return -1
}

fun registerForeignScalarAbiImpl(name: String, isExtern: Bool,
    returned: String, llvmReturned: String, parameters: Array<String>,
    llvmParameters: Array<String>, aliases: String, targets: String,
    aliasCount: Int) r: Void {
    let index = findForeignScalarAbiImpl(name)
    var encoded = ""; var returnedAttr = ""; var hasAttributes = false
    if isExtern {
        let triple = getCodegenTargetTripleImpl()
        let concreteReturn = foreignScalarAliasImpl(returned, aliases, targets, aliasCount)
        returnedAttr = foreignScalarExtensionImpl(concreteReturn, llvmReturned, triple)
        seen_string_release_owned(concreteReturn)
        hasAttributes = returnedAttr != ""
        if parameters.length() > 1024 or parameters.length() != llvmParameters.length() {
            abort("Error: [E_TYPE_LIMIT] foreign scalar parameter metadata limit")
        }
        var i = 0
        let builder = StringBuilder.new()
        while i < parameters.length() {
            let concrete = foreignScalarAliasImpl(parameters[i], aliases, targets, aliasCount)
            let attr = foreignScalarExtensionImpl(concrete, llvmParameters[i], triple)
            seen_string_release_owned(concrete)
            if attr != "" { hasAttributes = true }
            builder.append(attr); builder.append("|")
            i = i + 1
        }
        if builder.parts.length() > 0 {
            let flat = builder.toString()
            encoded = seen_string_clone_owned(flat)
            if builder.parts.length() > 1 { seen_string_release_owned(flat) }
        }
        builder.parts.free(); builder.free()
    }
    if not hasAttributes {
        if encoded != "" { seen_string_release_owned(encoded); encoded = "" }
        if index < 0 { return }
    }
    if index >= 0 {
        let updatedBytes = g_foreignScalarBytes -
            g_foreignScalarParams[index].length() + encoded.length()
        if updatedBytes > 8388608 {
            abort("Error: [E_TYPE_LIMIT] foreign scalar metadata byte ceiling")
        }
        g_foreignScalarBytes = updatedBytes
        if g_foreignScalarParams[index] != "" {
            seen_string_release_owned(g_foreignScalarParams[index])
        }
        g_foreignScalarParams[index] = encoded
        g_foreignScalarReturns[index] = returnedAttr
    } else {
        if name.length() > 4096 or g_foreignScalarNames.length() >= 65536 {
            abort("Error: [E_TYPE_LIMIT] foreign scalar signature metadata limit")
        }
        if g_foreignScalarBytes + name.length() + encoded.length() > 8388608 {
            abort("Error: [E_TYPE_LIMIT] foreign scalar metadata byte ceiling")
        }
        g_foreignScalarBytes = g_foreignScalarBytes + name.length() + encoded.length()
        g_foreignScalarNames.push(seen_string_clone_owned(name))
        g_foreignScalarParams.push(encoded)
        g_foreignScalarReturns.push(returnedAttr)
    }
}

fun foreignScalarReturnPrefixImpl(name: String) r: String {
    let index = findForeignScalarAbiImpl(name)
    if index < 0 or g_foreignScalarReturns[index] == "" { return "" }
    if g_foreignScalarReturns[index] == "signext" { return "signext " }
    return "zeroext "
}

fun foreignScalarParameterSuffixImpl(name: String, parameter: Int) r: String {
    let index = findForeignScalarAbiImpl(name)
    if index < 0 or parameter < 0 { return "" }
    let attr = pipeGet(g_foreignScalarParams[index], parameter)
    if attr == "" { return "" }
    let signed = attr == "signext"
    seen_string_release_owned(attr)
    if signed { return " signext" }
    return " zeroext"
}
