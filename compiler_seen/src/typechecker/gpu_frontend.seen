/// Validation of parsed compute bodies. No source-text recognition, host-call
/// fallback, shader-name substitution or backend code generation occurs here.
import parser.real_parser.{FunctionNode, ParserExpressionNode, BlockNode, AnnotationNode, genericParameterCount}
import typechecker.semantic_registry.{SemanticDiagnostic}
import typechecker.gpu_scope.{GpuCheckContext}
import typechecker.gpu_types.{gpuParseType, gpuValueType, gpuTypeValue, gpuTypeScalar, gpuTypeLanes,
    gpuTypeResource, gpuTypeStorage, gpuTypeReadable, gpuTypeWritable, gpuBoundedDecimal, gpuFloatLiteralValid, gpuParseParameterType}
import typechecker.gpu_workgroup.{gpuParseWorkgroup}

fun gpuHasCompute(function: FunctionNode) r: Bool {
    var i = 0
    while i < function.decorators.length() {
        if function.decorators[i].name == "compute" { return true }; i = i + 1
    }
    return false
}
fun gpuVariableName(expression: ParserExpressionNode) r: String {
    if expression.variableName != "" { return expression.variableName }; return expression.literalValue
}
fun gpuBindingType(context: GpuCheckContext, name: String) r: Int {
    if name == "globalInvocationId" or name == "localInvocationId" or name == "workgroupId" or
        name == "numWorkgroups" or name == "workgroupSize" { return 35 }
    let index = context.find(name)
    if index < 0 { context.error("E_GPU_BINDING", "unbound GPU value"); return 0 }
    return context.types[index]
}
fun gpuReadValue(context: GpuCheckContext, typeCode: Int) r: Int {
    if gpuTypeStorage(typeCode) { context.error("E_GPU_RESOURCE", "storage buffers require an explicit element index"); return 0 }
    return gpuTypeValue(typeCode)
}
fun gpuIndexType(context: GpuCheckContext, expression: ParserExpressionNode, depth: Int, write: Bool) r: Int {
    if expression.operands.length() != 2 { context.error("E_GPU_EXPRESSION", "malformed GPU index"); return 0 }
    let owner = expression.operands[0]
    if owner.kind != "Variable" and owner.kind != "VarExpr" {
        context.error("E_GPU_RESOURCE", "GPU storage indexing requires a declared resource"); return 0
    }
    let resource = gpuBindingType(context, gpuVariableName(owner))
    let index = gpuExpressionType(context, expression.operands[1], depth + 1)
    if index != 2 and index != 3 { context.error("E_GPU_TYPE", "GPU buffer index must be Int32 or UInt32") }
    if not gpuTypeStorage(resource) or (write and not gpuTypeWritable(resource)) or
        (not write and not gpuTypeReadable(resource)) {
        context.error("E_GPU_ACCESS", "GPU resource access violates its declared address space or access mode"); return 0
    }
    return gpuTypeValue(resource)
}
fun gpuAssignmentType(context: GpuCheckContext, expression: ParserExpressionNode, depth: Int) r: Int {
    var target = 0; var sourceIndex = 0
    if expression.kind == "Assignment" {
        if expression.operands.length() != 1 { context.error("E_GPU_EXPRESSION", "malformed GPU assignment"); return 0 }
        let index = context.find(expression.variableName)
        if index < 0 or not context.mutable[index] {
            context.error("E_GPU_ACCESS", "GPU assignment requires a mutable local"); return 0
        }
        target = context.types[index]
        if gpuTypeResource(target) != 0 { context.error("E_GPU_RESOURCE", "GPU resource identities cannot be reassigned"); return 0 }
    } else {
        if expression.operands.length() != 2 { context.error("E_GPU_EXPRESSION", "malformed GPU element assignment"); return 0 }
        let left = expression.operands[0]
        if expression.kind != "IndexAssignment" or left.kind != "IndexAccess" {
            context.error("E_GPU_ACCESS", "GPU member or address-space mutation is unsupported"); return 0
        }
        target = gpuIndexType(context, left, depth + 1, true); sourceIndex = 1
    }
    let source = gpuExpressionType(context, expression.operands[sourceIndex], depth + 1)
    if target != 0 and source != 0 and target != source { context.error("E_GPU_TYPE", "GPU assignment types differ; use an explicit supported cast") }
    return target
}
fun gpuCallType(context: GpuCheckContext, expression: ParserExpressionNode, depth: Int) r: Int {
    // Only pure typed intrinsics are admitted in this frontend revision.
    // Helper calls, synchronization and atomics require the shared IR pass.
    let name = expression.callee
    let constructor = gpuValueType(name)
    if constructor >= 16 {
        if expression.arguments.length() != 1 and expression.arguments.length() != gpuTypeLanes(constructor) {
            context.error("E_GPU_TYPE", "GPU vector constructor requires a scalar splat or one value per lane"); return 0
        }
        var argumentIndex = 0
        while argumentIndex < expression.arguments.length() {
            if gpuExpressionType(context, expression.arguments[argumentIndex], depth + 1) != gpuTypeScalar(constructor) {
                context.error("E_GPU_TYPE", "GPU vector constructor scalar type differs")
            }
            argumentIndex = argumentIndex + 1
        }
        return constructor
    }
    var arity = 0
    if name == "min" or name == "max" { arity = 2 }
    else if name == "clamp" { arity = 3 }
    else if name == "abs" or name == "sqrt" { arity = 1 }
    if arity == 0 or expression.arguments.length() != arity {
        context.error("E_GPU_UNSUPPORTED", "unsupported GPU call or intrinsic arity"); return 0
    }
    var typeCode = 0; var i = 0
    while i < arity {
        let argument = gpuExpressionType(context, expression.arguments[i], depth + 1)
        if i == 0 { typeCode = argument }
        else if typeCode != argument { context.error("E_GPU_TYPE", "GPU intrinsic operand types differ") }
        i = i + 1
    }
    if typeCode == 0 or gpuTypeScalar(typeCode) == 1 or (name == "sqrt" and gpuTypeScalar(typeCode) != 4) {
        context.error("E_GPU_TYPE", "GPU intrinsic does not support this operand type"); return 0
    }
    return typeCode
}
fun gpuExpressionType(context: GpuCheckContext, expression: ParserExpressionNode, depth: Int) r: Int {
    if not context.visit(depth) { return 0 }
    let kind = expression.kind
    if kind == "Variable" or kind == "VarExpr" { return gpuReadValue(context, gpuBindingType(context, gpuVariableName(expression))) }
    if kind == "Literal" {
        if expression.literalType == "Bool" { return 1 }
        if expression.literalType == "Int" {
            if gpuBoundedDecimal(expression.literalValue, 2147483647) < 0 { context.error("E_GPU_LITERAL", "GPU integer literal exceeds Int32; use an explicit fixed-width literal") }
            return 2
        }
        if expression.literalType == "Float" {
            if not gpuFloatLiteralValid(expression.literalValue) { context.error("E_GPU_LITERAL", "GPU floating literal is invalid or outside finite Float32 range"); return 0 }
            return 4
        }
        context.error("E_GPU_TYPE", "GPU bodies do not support host strings or dynamic literals"); return 0
    }
    if kind == "IndexAccess" { return gpuIndexType(context, expression, depth, false) }
    if kind == "Assignment" or kind == "IndexAssignment" or kind == "MemberAssignment" { return gpuAssignmentType(context, expression, depth) }
    if kind == "MemberAccess" {
        var owner = 0
        if expression.operands.length() == 1 { owner = gpuExpressionType(context, expression.operands[0], depth + 1) }
        else if expression.operands.length() == 0 { owner = gpuBindingType(context, expression.literalValue) }
        else { context.error("E_GPU_EXPRESSION", "malformed GPU member access"); return 0 }
        if expression.variableName == "length" and gpuTypeStorage(owner) { return 3 }
        var component = -1
        if expression.variableName == "x" { component = 0 }
        else if expression.variableName == "y" { component = 1 }
        else if expression.variableName == "z" { component = 2 }
        else if expression.variableName == "w" { component = 3 }
        if gpuTypeResource(owner) == 4 { owner = gpuTypeValue(owner) }
        if gpuTypeResource(owner) != 0 or component < 0 or gpuTypeLanes(owner) <= 1 or component >= gpuTypeLanes(owner) {
            context.error("E_GPU_TYPE", "unsupported GPU resource member or vector component"); return 0
        }
        return gpuTypeScalar(owner)
    }
    if kind == "Cast" and expression.operands.length() == 1 {
        let target = gpuValueType(expression.literalValue)
        let operand = expression.operands[0]
        if target == 3 and operand.kind == "Literal" and operand.literalType == "Int" {
            if not context.visit(depth + 1) { return 0 }
            if gpuBoundedDecimal(operand.literalValue, 4294967295) < 0 { context.error("E_GPU_LITERAL", "GPU unsigned integer literal exceeds UInt32") }
            return target
        }
        let source = gpuExpressionType(context, operand, depth + 1)
        if source == 0 or target == 0 or gpuTypeLanes(source) != gpuTypeLanes(target) or
            gpuTypeScalar(source) == 1 or gpuTypeScalar(target) == 1 {
            context.error("E_GPU_TYPE", "unsupported GPU cast"); return 0
        }
        return target
    }
    if kind == "Unary" and expression.operands.length() == 1 {
        if expression.operator == "-" and expression.operands[0].kind == "Literal" and expression.operands[0].literalType == "Int" {
            if not context.visit(depth + 1) { return 0 }
            if gpuBoundedDecimal(expression.operands[0].literalValue, 2147483648) < 0 { context.error("E_GPU_LITERAL", "GPU negative integer literal exceeds Int32") }
            return 2
        }
        let operand = gpuExpressionType(context, expression.operands[0], depth + 1)
        if expression.operator == "not" or expression.operator == "!" {
            if operand != 1 { context.error("E_GPU_TYPE", "GPU logical negation requires Bool") }; return 1
        }
        if expression.operator == "-" and operand != 0 and gpuTypeScalar(operand) != 1 and gpuTypeScalar(operand) != 3 { return operand }
        if expression.operator == "~" and (gpuTypeScalar(operand) == 2 or gpuTypeScalar(operand) == 3) { return operand }
        context.error("E_GPU_UNSUPPORTED", "unsupported GPU unary operation"); return 0
    }
    if kind == "Binary" and expression.operands.length() == 2 {
        let left = gpuExpressionType(context, expression.operands[0], depth + 1)
        let right = gpuExpressionType(context, expression.operands[1], depth + 1)
        if left == 0 or right == 0 { return 0 }
        if left != right { context.error("E_GPU_TYPE", "GPU binary operand types differ"); return 0 }
        let operation = expression.operator
        if operation == "and" or operation == "or" or operation == "&&" or operation == "||" {
            if left != 1 { context.error("E_GPU_TYPE", "GPU logical operation requires Bool") }; return 1
        }
        if operation == "==" or operation == "!=" { if gpuTypeLanes(left) == 1 { return 1 } }
        if operation == "<" or operation == "<=" or operation == ">" or operation == ">=" {
            if left != 1 and gpuTypeLanes(left) == 1 { return 1 }
        }
        if operation == "+" or operation == "-" or operation == "*" or operation == "/" {
            if gpuTypeScalar(left) != 1 { return left }
        }
        if operation == "%" or operation == "&" or operation == "|" or operation == "^" or operation == "<<" or operation == ">>" {
            if gpuTypeScalar(left) == 2 or gpuTypeScalar(left) == 3 { return left }
        }
        context.error("E_GPU_UNSUPPORTED", "unsupported GPU binary operation"); return 0
    }
    if kind == "Call" or kind == "CallExpr" { return gpuCallType(context, expression, depth) }
    context.error("E_GPU_UNSUPPORTED", "unsupported GPU expression; host effects cannot execute inside a compute kernel"); return 0
}

fun gpuCheckBlock(context: GpuCheckContext, block: BlockNode, depth: Int) r: Void {
    if not context.visit(depth) { return }
    let originalLength = context.names.length(); let originalStart = context.scopeStart
    context.scopeStart = originalLength
    var i = 0
    while i < block.statements.length() and context.nodes < 65536 {
        let statement = block.statements[i]
        context.line = statement.line; context.column = statement.column
        if not context.visit(depth + 1) { break }
        if statement.kind == "Let" or statement.kind == "Var" {
            let inferred = gpuExpressionType(context, statement.initializer, depth + 1)
            var declared = inferred
            if statement.variableType.typeName != "Unknown" and statement.variableType.typeName != "" {
                declared = gpuValueType(statement.variableType.typeName)
                if declared == 0 or statement.variableType.isNullable { context.error("E_GPU_TYPE", "unsupported GPU local type") }
                else if inferred != 0 and declared != inferred { context.error("E_GPU_TYPE", "GPU local initializer and declared types differ") }
            }
            context.define(statement.variableName, declared, statement.kind == "Var")
        } else if statement.kind == "If" {
            if gpuExpressionType(context, statement.condition, depth + 1) != 1 { context.error("E_GPU_TYPE", "GPU branch condition requires Bool") }
            gpuCheckBlock(context, statement.thenBranch, depth + 1); gpuCheckBlock(context, statement.elseBranch, depth + 1)
        } else if statement.kind == "While" {
            if gpuExpressionType(context, statement.loopCondition, depth + 1) != 1 { context.error("E_GPU_TYPE", "GPU loop condition requires Bool") }
            gpuCheckBlock(context, statement.loopBody, depth + 1)
        } else if statement.kind == "Return" {
            if statement.returnValue.kind != "None" { context.error("E_GPU_TYPE", "compute kernels return Void and cannot return resource or host values") }
        } else if statement.kind == "Expression" or statement.kind == "Assignment" {
            gpuExpressionType(context, statement.expression, depth + 1)
        } else {
            context.error("E_GPU_UNSUPPORTED", "unsupported GPU statement; host effects and unlowered control constructs are forbidden")
        }
        i = i + 1
    }
    if i < block.statements.length() { context.error("E_GPU_LIMIT", "GPU statement count exceeds its ceiling") }
    context.restoreBindings(originalLength); context.scopeStart = originalStart
}

fun gpuCheckWorkgroup(context: GpuCheckContext, annotation: AnnotationNode) r: Void {
    let workgroup = gpuParseWorkgroup(annotation.arguments)
    if not workgroup.valid { context.error("E_GPU_WORKGROUP", "workgroup dimensions exceed supported syntax, axis or invocation limits") }
    workgroup.free()
}

/// The returned diagnostics own their records/locations and borrow static
/// messages plus the caller's module path. The caller transfers or frees them.
fun gpuCheckFunction(function: FunctionNode, file: String) r: Array<SemanticDiagnostic> {
    let context = GpuCheckContext.create(file, function.line, function.column)
    if function.decorators.length() > 16 {
        context.error("E_GPU_LIMIT", "GPU decorator count exceeds its ceiling"); return context.takeDiagnostics()
    }
    if function.params.length() > 64 or function.isAsync or function.isExtern or genericParameterCount(function.decorators) > 0 {
        context.error("E_GPU_SIGNATURE", "compute kernels require a bounded concrete synchronous definition")
    }
    if function.returnType.isNullable or (function.returnType.typeName != "Void" and function.returnType.typeName != "Unknown" and function.returnType.typeName != "") {
        context.error("E_GPU_SIGNATURE", "compute kernels return Void")
    }
    var count = 0; var i = 0
    while i < function.decorators.length() {
        let annotation = function.decorators[i]
        if annotation.name == "compute" { count = count + 1; gpuCheckWorkgroup(context, annotation) }
        else if annotation.name != "pub" and annotation.name != "export" {
            context.error("E_GPU_UNSUPPORTED", "unsupported compute decorator")
        }
        i = i + 1
    }
    if count != 1 { context.error("E_GPU_SIGNATURE", "exactly one compute decorator is required") }
    i = 0
    while i < function.params.length() and i < 64 {
        let parameter = function.params[i]
        context.line = parameter.line; context.column = parameter.column
        let typeCode = gpuParseParameterType(parameter.paramType.typeName)
        if typeCode == 0 or gpuTypeResource(typeCode) == 0 or parameter.paramType.isNullable or parameter.isMutable {
            context.error("E_GPU_RESOURCE", "compute parameters require a supported nonnullable storage buffer or Uniform value")
        }
        context.define(parameter.name, typeCode, false); i = i + 1
    }
    gpuCheckBlock(context, function.body, 0)
    return context.takeDiagnostics()
}
