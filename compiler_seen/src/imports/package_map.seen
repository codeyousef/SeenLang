/// Byte framing for the version-coupled package-map v2 transport.
/// Filesystem/provenance validation remains with the import-graph owner.
@repr(C)
class PackageMapColumns {
    var firstTab: Int
    var secondTab: Int
    var thirdTab: Int
    var valid: Bool
}

fun decodePackageMapColumns(line: String) r: PackageMapColumns {
    let first = line.indexOf("\t", 0)
    var second = -1
    var third = -1
    if first > 0 {
        second = line.indexOf("\t", first + 1)
        if second > first + 1 {
            third = line.indexOf("\t", second + 1)
        }
    }
    let valid = first > 0 and second > first + 1 and third > second + 1 and
        line.indexOf("\t", third + 1) < 0 and
        line.indexOf("\r", 0) < 0 and line.indexOf("\n", 0) < 0
    return PackageMapColumns{firstTab: first, secondTab: second,
        thirdTab: third, valid: valid}
}
